TauCeti.Toric.specMap_smul_eq_lift_comp_affineToricSchemeAction.{u_3} {N : Type} {V : Type u_3} [AddCommGroup N]
  [AddCommGroup V] [Module ℝ V] {i : N →+ V} (hi : IsIntegralLattice i) (σ : PointedCone ℝ V) (t : ComplexTorus N)
  (x : AffineSemigroupComplexPoint ↥(dualSemigroup hi σ)) :
  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (t • x).toRingHom) =
    CategoryTheory.CategoryStruct.comp
      (CategoryTheory.Limits.pullback.lift (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (t • default).toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom x.toRingHom)) ⋯)
      (affineToricSchemeAction hi σ)
TauCeti.Toric.Fan.AlgebraicComplexPoint.coe_smul {N V : Type} [AddCommGroup N] [AddCommGroup V] [Module ℝ V]
  {i : N →+ V} {Φ : Fan i} (t : ComplexTorus N) (p : Φ.AlgebraicComplexPoint) :
  ↑(t • p) =
    CategoryTheory.CategoryStruct.comp
      (CategoryTheory.Limits.pullback.lift (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (t • default).toRingHom)) ↑p
        ⋯)
      Φ.algebraicRealizationAction
