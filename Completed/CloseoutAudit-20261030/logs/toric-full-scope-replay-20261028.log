  Φ.AlgebraicComplexPoint
TauCeti.Toric.Fan.AlgebraicComplexPoint.ofAffinePoint_eq_ofAffinePoint_iff.{u_1} {N : Type} {V : Type u_1}
  [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V} {Φ : Fan i} {σ τ : ↑Φ.cones}
  (x : AffineSemigroupComplexPoint ↥(dualSemigroup ⋯ ↑σ)) (y : AffineSemigroupComplexPoint ↥(dualSemigroup ⋯ ↑τ)) :
  Fan.AlgebraicComplexPoint.ofAffinePoint σ x = Fan.AlgebraicComplexPoint.ofAffinePoint τ y ↔
    ∃ z, faceAffinePointMap ⋯ ⋯ z = x ∧ faceAffinePointMap ⋯ ⋯ z = y
TauCeti.Toric.FanHom.algebraicAnalyticEquiv_naturality {N N' V V' : Type} [AddCommGroup N] [AddCommGroup N']
  [AddCommGroup V] [AddCommGroup V'] [Module ℝ V] [Module ℝ V'] {i : N →+ V} {i' : N' →+ V'} {Φ : Fan i} {Ψ : Fan i'}
  (f : FanHom Φ Ψ) (hΦ : Φ.IsRegular) (hΨ : Ψ.IsRegular) (p : Φ.AlgebraicComplexPoint) :
  (Fan.algebraicAnalyticEquiv hΨ) (f.algebraicComplexPointMap p) =
    (CategoryTheory.ConcreteCategory.hom (f.analyticMap hΦ hΨ)) ((Fan.algebraicAnalyticEquiv hΦ) p)
