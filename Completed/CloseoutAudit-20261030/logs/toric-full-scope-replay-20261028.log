TauCeti.Toric.Fan.exists_partialDiffeomorph_analyticBoundaryComponent_normalForm.{u} {N V : Type u} [AddCommGroup N]
  [AddCommGroup V] [Module ℝ V] {i : N →+ V} (Φ : Fan i) (hΦ : Φ.IsRegular) (x : ↑(Φ.analyticRealization hΦ))
  (n : WithTop ℕ∞) :
  ∃ s j e,
    x ∈ e.source ∧
      (∀ (ρ : Φ.Ray), x ∈ Φ.analyticBoundaryComponent hΦ ρ ↔ ρ ∈ s) ∧
        ∀ y ∈ e.source,
          ∀ (ρ : Φ.Ray), y ∈ Φ.analyticBoundaryComponent hΦ ρ ↔ ∃ (hρ : ρ ∈ s), ↑e.toPartialEquiv y (j ⟨ρ, hρ⟩) = 0
TauCeti.Toric.Fan.exists_contMDiffOn_analyticBoundaryComponent_eq_zero_transverse_curve.{u} {N V : Type u}
  [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V} (Φ : Fan i) (hΦ : Φ.IsRegular) (ρ : Φ.Ray)
  {x : ↑(Φ.analyticRealization hΦ)} (hx : x ∈ Φ.analyticBoundaryComponent hΦ ρ) :
  ∃ U F γ,
    IsOpen U ∧
      x ∈ U ∧
        ContMDiffOn (modelWithCornersSelf ℂ (Fin (Module.finrank ℤ N) → ℂ)) (modelWithCornersSelf ℂ ℂ) (↑⊤) F U ∧
          ContMDiff (modelWithCornersSelf ℂ ℂ) (modelWithCornersSelf ℂ (Fin (Module.finrank ℤ N) → ℂ)) (↑⊤) γ ∧
            γ 0 = x ∧
              (∀ (t : ℂ), γ t ∈ U) ∧ (∀ y ∈ U, y ∈ Φ.analyticBoundaryComponent hΦ ρ ↔ F y = 0) ∧ ∀ (t : ℂ), F (γ t) = t
TauCeti.Toric.Fan.exists_contMDiffOn_analyticBoundaryComponent_eq_zero_mvfderiv_surjective.{u} {N V : Type u}
  [AddCommGroup N] [AddCommGroup V] [Module ℝ V] {i : N →+ V} (Φ : Fan i) (hΦ : Φ.IsRegular)
  (x : ↑(Φ.analyticRealization hΦ)) :
  ∃ U F,
    IsOpen U ∧
      x ∈ U ∧
        ContMDiffOn (modelWithCornersSelf ℂ (Fin (Module.finrank ℤ N) → ℂ))
            (modelWithCornersSelf ℂ ({ ρ // x ∈ Φ.analyticBoundaryComponent hΦ ρ } → ℂ)) (↑⊤) F U ∧
          (∀ y ∈ U, Function.Surjective ⇑(d% F y)) ∧
            ∀ y ∈ U,
              ∀ (ρ : Φ.Ray),
                y ∈ Φ.analyticBoundaryComponent hΦ ρ ↔ ∃ (hρ : x ∈ Φ.analyticBoundaryComponent hΦ ρ), F y ⟨ρ, hρ⟩ = 0
TauCeti.Toric.FanHom.isProperMap_analyticMap_iff.{u} {N N' V V' : Type u} [AddCommGroup N] [AddCommGroup N']
  [AddCommGroup V] [AddCommGroup V'] [Module ℝ V] [Module ℝ V'] {i : N →+ V} {i' : N' →+ V'} {Φ : Fan i} {Ψ : Fan i'}
  (f : FanHom Φ Ψ) (hΦ : Φ.IsRegular) (hΨ : Ψ.IsRegular) (hΦ0 : Nonempty ↑Φ.cones) :
  IsProperMap ⇑(CategoryTheory.ConcreteCategory.hom (f.analyticMap hΦ hΨ)) ↔
    ∀ (τ : ↑Ψ.cones), ⇑f.realMap ⁻¹' ↑↑τ = ⋃ σ, ⋃ (_ : PointedCone.map f.realMap ↑σ ≤ ↑τ), ↑↑σ
