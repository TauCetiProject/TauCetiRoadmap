TauCeti.Peripheral.exists_peripheralPowerAutomorphism_two.{u_1} {F : Type u_1} [Group F] [TopologicalSpace F]
  [IsTopologicalGroup F] [CompactSpace F] [TotallyDisconnectedSpace F] (hF : IsProP 2 F) (e : F ≃ₜ* freeProP 2 (Fin 2))
  (u : ℤ_[2]ˣ) :
  ∃ φ cP cT cC,
    cP = 1 ∧
      φ (periphP e) = cP⁻¹ * hF.padicPow (periphP e) ↑u * cP ∧
        φ (periphT e) = cT⁻¹ * hF.padicPow (periphT e) ↑u * cT ∧ φ (periphC e) = cC⁻¹ * hF.padicPow (periphC e) ↑u * cC
TauCeti.Peripheral.exists_peripheralPowerAutomorphism_two_opposite.{u_1} {F : Type u_1} [Group F] [TopologicalSpace F]
  [IsTopologicalGroup F] [CompactSpace F] [TotallyDisconnectedSpace F] (hF : IsProP 2 F) (e : F ≃ₜ* freeProP 2 (Fin 2))
  (u : ℤ_[2]ˣ) :
  ∃ φ cP cT cC,
    cP = 1 ∧
      φ (periphP e) = cP⁻¹ * hF.padicPow (periphP e) ↑u * cP ∧
        φ (periphT e) = cT⁻¹ * hF.padicPow (periphT e) ↑u * cT ∧
          φ (periphC e) = cC⁻¹ * hF.padicPow (periphC e) ↑u * cC ∧
            have cC' := (periphP e)⁻¹ * cC * (φ (periphP e)⁻¹)⁻¹;
            φ (periphT e * periphP e)⁻¹ = cC'⁻¹ * hF.padicPow (periphT e * periphP e)⁻¹ ↑u * cC'
TauCeti.Peripheral.exists_peripheral_identity_two.{u_1} {F : Type u_1} [Group F] [TopologicalSpace F]
  [IsTopologicalGroup F] [CompactSpace F] [TotallyDisconnectedSpace F] (hF : IsProP 2 F) (e : F ≃ₜ* freeProP 2 (Fin 2))
  (u : ℤ_[2]ˣ) :
  ∃ cP cT cC,
    cP = 1 ∧
      cP⁻¹ * hF.padicPow (periphP e) ↑u * cP * (cT⁻¹ * hF.padicPow (periphT e) ↑u * cT) *
          (cC⁻¹ * hF.padicPow (periphC e) ↑u * cC) =
        1
