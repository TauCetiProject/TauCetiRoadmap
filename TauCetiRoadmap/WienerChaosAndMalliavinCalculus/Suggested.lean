module

public import Mathlib
public import TauCeti.Probability.Distributions.Gaussian.Hermite.Basis

/-!
# Wiener chaos and Malliavin calculus: target signatures

This file is not the roadmap: the roadmap is `README.md`, and this file is not an exhaustive
checklist. It states, against the pinned Mathlib and each with `sorry`, the headlines of the README
that carry a Lean name, each with every conclusion the README attaches to it, together with the
definitions their statements need. The README's other headlines are targets of the same standing,
stated there in prose with their locators or proof routes, and are not stated here. In
particular the pinned libraries have Brownian motion (`ProbabilityTheory.IsBrownianReal`) but no
Itô integral, so the iterated Itô integrals, the identification of the Skorokhod integral of an
adapted process with its Itô integral and the Clark–Ocone formula of Layer 7 cannot be stated.

The conventions of the README are used throughout. `H` is a real Hilbert space and `W : H → Ω → ℝ`
an isonormal Gaussian process on a probability space `(Ω, P)`. Square-integrable functionals are
elements of `Lp ℝ 2 P`, and `H`-valued ones elements of `Lp H 2 P`. A function is turned into an
`L²` class by `toL2`, whose value is `0` when the function is not square integrable; every
statement that uses `toL2` either proves or assumes the square integrability it needs. Hermite
polynomials are Mathlib's probabilists' `Polynomial.hermite`, monic, with `He₂ = X² − 1`.
Statements that need the value of the divergence to be unique assume that the σ-algebra of `Ω`
is generated by `W` up to null sets, in the form `gaussianL2 W P = ⊤`. Layer 3 takes
`H = L²(T, μ)`, and its kernels of order `q` are the elements of `L²(μ^q)` on `Fin q → T`. The
theorems of Layers 4–5, and those of Layer 6 that use `𝔻^{1,2}`, assume `[CompleteSpace H]`: for
an incomplete `H` the closed derivative takes values in `Lp H 2 P` and misses the limits that
leave `H`, and the chaos description of `𝔻^{1,2}` fails.

The implementation namespace of the README is `TauCeti`; the prototypes live in this roadmap's
namespace.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped ENNReal NNReal InnerProductSpace

namespace TauCetiRoadmap.WienerChaosAndMalliavinCalculus

attribute [local instance] Classical.propDecidable

universe u

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}

/-- The `L²` class of a function, and `0` when the function is not square integrable. -/
def toL2 {E : Type*} [NormedAddCommGroup E] (P : Measure Ω) (f : Ω → E) : Lp E 2 P :=
  if h : MemLp f 2 P then h.toLp f else 0

/-! ## Layer 1: isonormal Gaussian processes -/

section Isonormal

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- 1.1: an isonormal Gaussian process on `H`: a centred Gaussian family of measurable random
variables indexed by `H` whose covariance is the inner product. -/
structure IsIsonormal (W : H → Ω → ℝ) (P : Measure Ω) : Prop where
  /-- Each `W h` is measurable. -/
  measurable : ∀ h, Measurable (W h)
  /-- The family is jointly Gaussian. -/
  isGaussianProcess : IsGaussianProcess W P
  /-- The family is centred. -/
  integral_eq_zero : ∀ h, ∫ ω, W h ω ∂P = 0
  /-- The covariance is the inner product. -/
  integral_mul : ∀ h g, ∫ ω, W h ω * W g ω ∂P = ⟪h, g⟫_ℝ

/-- 1.1: the σ-algebra generated by an isonormal process. -/
@[instance_reducible]
def isonormalSigma (W : H → Ω → ℝ) : MeasurableSpace Ω :=
  ⨆ h, MeasurableSpace.comap (W h) inferInstance

/-- 1.1: the square-integrable functionals of `W`, the classes measurable for `σ(W)` up to null
sets. -/
def gaussianL2 (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P) :=
  lpMeas ℝ ℝ (isonormalSigma W) 2 P

/-- 1.1: existence of an isonormal Gaussian process on every real Hilbert space. -/
theorem exists_isIsonormal (H : Type u) [NormedAddCommGroup H] [InnerProductSpace ℝ H] :
    ∃ (Ω : Type u) (_ : MeasurableSpace Ω) (P : Measure Ω) (W : H → Ω → ℝ),
      IsProbabilityMeasure P ∧ IsIsonormal W P := by
  sorry

variable [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 1.1: each `W h` is centred Gaussian with variance `‖h‖²`. -/
theorem IsIsonormal.hasLaw (hW : IsIsonormal W P) (h : H) :
    HasLaw (W h) (gaussianReal 0 (‖h‖₊ ^ 2)) P := by
  sorry

/-- 1.1: `h ↦ W h` is linear up to null sets. -/
theorem IsIsonormal.ae_eq_add (hW : IsIsonormal W P) (a b : ℝ) (h g : H) :
    W (a • h + b • g) =ᵐ[P] fun ω ↦ a * W h ω + b * W g ω := by
  sorry

/-- 1.1: two isonormal coordinates are independent exactly when their indices are orthogonal. -/
theorem IsIsonormal.indepFun_iff (hW : IsIsonormal W P) (h g : H) :
    IndepFun (W h) (W g) P ↔ ⟪h, g⟫_ℝ = 0 := by
  sorry

/-- 1.2: the Wick power `:W(h)ⁿ: = ‖h‖ⁿ Heₙ(W(h)/‖h‖)`, the homogeneous Hermite polynomial of
`W h` with parameter `‖h‖²`; at `h = 0` it is `1` for `n = 0` and `0` otherwise. -/
def wickPower (W : H → Ω → ℝ) (n : ℕ) (h : H) (ω : Ω) : ℝ :=
  ‖h‖ ^ n * Polynomial.aeval (W h ω / ‖h‖) (Polynomial.hermite n)

/-- 1.2: the covariance of two Wick powers: `E[:W(h)ⁿ: :W(g)ᵐ:] = δₙₘ n! ⟪h, g⟫ⁿ`. -/
theorem IsIsonormal.integral_wickPower_mul (hW : IsIsonormal W P) (n m : ℕ) (h g : H) :
    ∫ ω, wickPower W n h ω * wickPower W m g ω ∂P =
      if n = m then (n.factorial : ℝ) * ⟪h, g⟫_ℝ ^ n else 0 := by
  sorry

/-- 1.2: the exponentials `exp (W h)` span a dense subspace of `gaussianL2 W P`. -/
theorem IsIsonormal.closure_span_exp (hW : IsIsonormal W P) :
    (Submodule.span ℝ (Set.range fun h : H ↦ toL2 P fun ω ↦ Real.exp (W h ω))).topologicalClosure =
      gaussianL2 W P := by
  sorry

end Isonormal

/-- Sanity check of the definition: on a finite-dimensional inner product space with its standard
Gaussian measure, the coordinates `x ↦ ⟪h, x⟫` form an isonormal process. -/
theorem isIsonormal_inner_stdGaussian {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] :
    IsIsonormal (fun h x : E ↦ ⟪h, x⟫_ℝ) (stdGaussian E) := by
  sorry

/-! ## Layer 2: Wiener chaos -/

section Chaos

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 2.1: the Wiener chaos of order `n`, the closed span of the Wick powers `:W(h)ⁿ:`. -/
def wienerChaos (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (Set.range fun h : H ↦ toL2 P (wickPower W n h))).topologicalClosure

instance (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) :
    (wienerChaos W P n).HasOrthogonalProjection := by
  unfold wienerChaos; infer_instance

/-- 2.1: the orthogonal projection `Jₙ` onto the chaos of order `n`. -/
def chaosProj (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) : Lp ℝ 2 P →L[ℝ] Lp ℝ 2 P :=
  (wienerChaos W P n).starProjection

/-- 2.1: chaoses of different orders are orthogonal. -/
theorem IsIsonormal.orthogonalFamily_wienerChaos (hW : IsIsonormal W P) :
    OrthogonalFamily ℝ (fun n ↦ wienerChaos W P n) (fun n ↦ (wienerChaos W P n).subtypeₗᵢ) := by
  sorry

/-- 2.1: the Wiener–Itô chaos decomposition: the chaoses span a dense subspace of
`gaussianL2 W P`. -/
theorem IsIsonormal.closure_iSup_wienerChaos (hW : IsIsonormal W P) :
    (⨆ n, wienerChaos W P n).topologicalClosure = gaussianL2 W P := by
  sorry

/-- 2.1: every functional of `W` is the sum of its chaos components. -/
theorem IsIsonormal.hasSum_chaosProj (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ gaussianL2 W P) : HasSum (fun n ↦ chaosProj W P n F) F := by
  sorry

/-- Sanity check of the definition: the chaos of order `0` is the constants, also when `H = 0`,
so `J₀ F` is the mean of `F`; this holds for every `W`, since every Wick power of order `0` is the
constant `1`. -/
theorem chaosProj_zero (F : Lp ℝ 2 P) :
    chaosProj W P 0 F = toL2 P fun _ ↦ ∫ ω, F ω ∂P := by
  sorry

/-- 2.2: the normalized Hermite product `Φₐ = ∏ᵢ Heₐᵢ(W(eᵢ))/√(aᵢ!)` along a Hilbert basis. -/
def hermiteProduct (W : H → Ω → ℝ) (P : Measure Ω) {ι : Type*} (e : HilbertBasis ι ℝ H)
    (a : ι →₀ ℕ) : Lp ℝ 2 P :=
  toL2 P fun ω ↦ ∏ i ∈ a.support,
    Polynomial.aeval (W (e i) ω) (Polynomial.hermite (a i)) / Real.sqrt (a i).factorial

/-- 2.2: the Hermite products form an orthonormal basis of `gaussianL2 W P`, and `Φₐ` lies in the
chaos of order `|a| = ∑ᵢ aᵢ`. -/
theorem IsIsonormal.hermiteProduct_spec (hW : IsIsonormal W P) {ι : Type*}
    (e : HilbertBasis ι ℝ H) :
    Orthonormal ℝ (hermiteProduct W P e) ∧
      (Submodule.span ℝ (Set.range (hermiteProduct W P e))).topologicalClosure = gaussianL2 W P ∧
      ∀ a, hermiteProduct W P e a ∈ wienerChaos W P (a.sum fun _ k ↦ k) := by
  sorry

end Chaos

/-! ## Layer 3: multiple Wiener–Itô integrals -/

section MultipleIntegrals

variable {T : Type*} [MeasurableSpace T] (μ : Measure T) [SigmaFinite μ]

/-- 3.1: the product measure `μ^q` on `Fin q → T`, on which kernels of order `q` live. -/
def kernelMeasure (q : ℕ) : Measure (Fin q → T) :=
  Measure.pi fun _ ↦ μ

/-- 3.1: the tensor power `h^{⊗q}(t) = ∏ᵢ h(tᵢ)`. -/
def tensorPow (h : Lp ℝ 2 μ) (q : ℕ) : Lp ℝ 2 (kernelMeasure μ q) :=
  toL2 _ fun t ↦ ∏ i, h (t i)

/-- 3.1: the symmetric kernels of order `q`, the closed span of the tensor powers. -/
def symmetricKernels (q : ℕ) : Submodule ℝ (Lp ℝ 2 (kernelMeasure μ q)) :=
  (Submodule.span ℝ (Set.range fun h : Lp ℝ 2 μ ↦ tensorPow μ h q)).topologicalClosure

/-- 3.1: a family `I q` of continuous linear maps is the family of multiple Wiener–Itô integrals of
`W` if it sends `h^{⊗q}` to the Wick power `:W(h)^q:` and vanishes on the kernels orthogonal to
every symmetric kernel. -/
structure IsMultipleWienerIntegral (W : Lp ℝ 2 μ → Ω → ℝ) (P : Measure Ω)
    (I : (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q) →L[ℝ] Lp ℝ 2 P) : Prop where
  /-- Tensor powers go to Wick powers. -/
  apply_tensorPow : ∀ q h, I q (tensorPow μ h q) = toL2 P (wickPower W q h)
  /-- The integral only sees the symmetric part of a kernel. -/
  apply_eq_zero : ∀ q f, f ∈ (symmetricKernels μ q)ᗮ → I q f = 0

variable [IsProbabilityMeasure P] {W : Lp ℝ 2 μ → Ω → ℝ}

/-- 3.1: the multiple Wiener–Itô integrals exist and are unique. -/
theorem IsIsonormal.existsUnique_isMultipleWienerIntegral (hW : IsIsonormal W P) :
    ∃! I, IsMultipleWienerIntegral μ W P I := by
  sorry

variable {μ} {I : (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q) →L[ℝ] Lp ℝ 2 P}

/-- 3.1: the isometry `E[I_q(f) I_q(g)] = q! ⟪f, g⟫` on symmetric kernels, and orthogonality of
integrals of different orders. -/
theorem IsMultipleWienerIntegral.inner_eq (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) :
    (∀ q (f g : Lp ℝ 2 (kernelMeasure μ q)), f ∈ symmetricKernels μ q →
      g ∈ symmetricKernels μ q → ⟪I q f, I q g⟫_ℝ = q.factorial * ⟪f, g⟫_ℝ) ∧
    ∀ p q (f : Lp ℝ 2 (kernelMeasure μ p)) (g : Lp ℝ 2 (kernelMeasure μ q)), p ≠ q →
      ⟪I p f, I q g⟫_ℝ = 0 := by
  sorry

/-- 3.1: the image of the symmetric kernels of order `q` is the chaos of order `q`. -/
theorem IsMultipleWienerIntegral.map_symmetricKernels (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) (q : ℕ) :
    (symmetricKernels μ q).map (I q).toLinearMap = wienerChaos W P q := by
  sorry

/-- 3.2: the chaos expansion in multiple integrals, with unique symmetric kernels. -/
theorem IsMultipleWienerIntegral.existsUnique_hasSum (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {F : Lp ℝ 2 P} (hF : F ∈ gaussianL2 W P) :
    ∃! f : (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q),
      (∀ q, f q ∈ symmetricKernels μ q) ∧ HasSum (fun q ↦ I q (f q)) F := by
  sorry

/-- 3.3: the variables of `f` in the contraction: the first `p − r` come from `x`, the last `r`
from the integration variable `u`. Used only for `r ≤ min p q`. -/
def contractionArgLeft (p q r : ℕ) (x : Fin (p + q - 2 * r) → T) (u : Fin r → T) : Fin p → T :=
  fun i ↦ if hi : (i : ℕ) < p - r ∧ (i : ℕ) < p + q - 2 * r then x ⟨i, hi.2⟩
    else u ⟨i - (p - r), by have := i.isLt; omega⟩

/-- 3.3: the variables of `g` in the contraction: the first `q − r` come from the last `q − r`
coordinates of `x`, the last `r` from `u`. Used only for `r ≤ min p q`. -/
def contractionArgRight (p q r : ℕ) (x : Fin (p + q - 2 * r) → T) (u : Fin r → T) : Fin q → T :=
  fun j ↦ if hj : (j : ℕ) < q - r ∧ p - r + (j : ℕ) < p + q - 2 * r then x ⟨p - r + j, hj.2⟩
    else u ⟨j - (q - r), by have := j.isLt; omega⟩

variable (μ) in
/-- 3.3: the contraction `f ⊗ᵣ g` of `r` variables,
`(f ⊗ᵣ g)(s, t) = ∫ f(s, u) g(t, u) dμ^r(u)` for `s ∈ T^{p−r}`, `t ∈ T^{q−r}`. -/
def contraction (r : ℕ) {p q : ℕ} (f : Lp ℝ 2 (kernelMeasure μ p))
    (g : Lp ℝ 2 (kernelMeasure μ q)) : Lp ℝ 2 (kernelMeasure μ (p + q - 2 * r)) :=
  toL2 _ fun x ↦ ∫ u, f (contractionArgLeft p q r x u) * g (contractionArgRight p q r x u)
    ∂(kernelMeasure μ r)

/-- 3.3: the product formula
`I_p(f) I_q(g) = ∑_{r ≤ min p q} r! (p choose r) (q choose r) I_{p+q−2r}(f ⊗ᵣ g)`. -/
theorem IsMultipleWienerIntegral.mul_ae_eq (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {p q : ℕ} {f : Lp ℝ 2 (kernelMeasure μ p)}
    {g : Lp ℝ 2 (kernelMeasure μ q)} (hf : f ∈ symmetricKernels μ p)
    (hg : g ∈ symmetricKernels μ q) :
    (fun ω ↦ I p f ω * I q g ω) =ᵐ[P]
      ⇑(∑ r ∈ Finset.range (min p q + 1),
        ((r.factorial * p.choose r * q.choose r : ℕ) : ℝ) •
          I (p + q - 2 * r) (contraction μ r f g)) := by
  sorry

end MultipleIntegrals

/-! ## Layer 4: the Malliavin derivative -/

section Derivative

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- 4.1: smooth functions of `n` variables all of whose derivatives grow at most polynomially. -/
def IsSmoothPolyGrowth {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) : Prop :=
  ContDiff ℝ (⊤ : ℕ∞) f ∧
    ∀ k : ℕ, ∃ (C : ℝ) (m : ℕ), ∀ x, ‖iteratedFDeriv ℝ k f x‖ ≤ C * (1 + ‖x‖) ^ m

/-- 4.1: the vector `(W h₁, …, W hₙ)`. -/
def wVec (W : H → Ω → ℝ) {n : ℕ} (h : Fin n → H) (ω : Ω) : EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 fun i ↦ W (h i) ω

/-- 4.1: the gradient part `∑ᵢ ∂ᵢ f(W h₁, …, W hₙ) hᵢ` of the derivative of a cylinder
functional. -/
def cylinderGrad (W : H → Ω → ℝ) {n : ℕ} (h : Fin n → H) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (ω : Ω) : H :=
  ∑ i, fderiv ℝ f (wVec W h ω) (EuclideanSpace.single i 1) • h i

/-- 4.1: the pairs `(F, DF)` with `F = f(W h₁, …, W hₙ)` a smooth cylinder functional. -/
def smoothGraph (W : H → Ω → ℝ) (P : Measure Ω) : Set (Lp ℝ 2 P × Lp H 2 P) :=
  {x | ∃ (n : ℕ) (h : Fin n → H) (f : EuclideanSpace ℝ (Fin n) → ℝ), IsSmoothPolyGrowth f ∧
    x.1 = toL2 P (fun ω ↦ f (wVec W h ω)) ∧ x.2 = toL2 P (cylinderGrad W h f)}

/-- 4.2: the graph of the closed Malliavin derivative, the closure of the smooth graph. -/
def malliavinGraph (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P × Lp H 2 P) :=
  (Submodule.span ℝ (smoothGraph W P)).topologicalClosure

/-- 4.2: the Sobolev space `𝔻^{1,2}`, the domain of the closed derivative. -/
def sobolev12 (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P) :=
  (malliavinGraph W P).map (LinearMap.fst ℝ _ _)

/-- 4.2: the Malliavin derivative `DF ∈ L²(Ω; H)` of `F ∈ 𝔻^{1,2}`, and `0` outside
`𝔻^{1,2}`. -/
def malliavinDeriv (W : H → Ω → ℝ) (P : Measure Ω) (F : Lp ℝ 2 P) : Lp H 2 P :=
  if h : ∃ G, (F, G) ∈ malliavinGraph W P then h.choose else 0

variable [CompleteSpace H] [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 4.1: Gaussian integration by parts for smooth cylinder functionals:
`E⟪DF, h⟫ = E[F W(h)]`. -/
theorem IsIsonormal.integral_inner_cylinderGrad (hW : IsIsonormal W P) {n : ℕ} (k : Fin n → H)
    {f : EuclideanSpace ℝ (Fin n) → ℝ} (hf : IsSmoothPolyGrowth f) (h : H) :
    ∫ ω, ⟪cylinderGrad W k f ω, h⟫_ℝ ∂P = ∫ ω, f (wVec W k ω) * W h ω ∂P := by
  sorry

/-- 4.2: closability: the closed graph is the graph of a function. -/
theorem IsIsonormal.malliavinGraph_closable (hW : IsIsonormal W P) {G : Lp H 2 P}
    (hG : (0, G) ∈ malliavinGraph W P) : G = 0 := by
  sorry

/-- 4.2: `D` on smooth cylinder functionals is given by the gradient formula, independently of
the representation. -/
theorem IsIsonormal.malliavinDeriv_cylinder (hW : IsIsonormal W P) {n : ℕ} (k : Fin n → H)
    {f : EuclideanSpace ℝ (Fin n) → ℝ} (hf : IsSmoothPolyGrowth f) :
    toL2 P (fun ω ↦ f (wVec W k ω)) ∈ sobolev12 W P ∧
      malliavinDeriv W P (toL2 P fun ω ↦ f (wVec W k ω)) = toL2 P (cylinderGrad W k f) := by
  sorry

/-- 4.2: integration by parts on `𝔻^{1,2}`: `E⟪DF, h⟫ = E[F W(h)]`. -/
theorem IsIsonormal.integral_inner_malliavinDeriv (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) (h : H) :
    ∫ ω, ⟪malliavinDeriv W P F ω, h⟫_ℝ ∂P = ∫ ω, F ω * W h ω ∂P := by
  sorry

/-- 4.3: the chain rule for a `C¹` function with bounded derivative of finitely many elements of
`𝔻^{1,2}`. -/
theorem IsIsonormal.malliavinDeriv_comp (hW : IsIsonormal W P) {m : ℕ} {F : Fin m → Lp ℝ 2 P}
    (hF : ∀ i, F i ∈ sobolev12 W P) {φ : EuclideanSpace ℝ (Fin m) → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφ' : ∃ C, ∀ x, ‖fderiv ℝ φ x‖ ≤ C) :
    toL2 P (fun ω ↦ φ (WithLp.toLp 2 fun i ↦ F i ω)) ∈ sobolev12 W P ∧
      malliavinDeriv W P (toL2 P fun ω ↦ φ (WithLp.toLp 2 fun i ↦ F i ω)) =
        toL2 P fun ω ↦ ∑ i, fderiv ℝ φ (WithLp.toLp 2 fun i ↦ F i ω)
          (EuclideanSpace.single i 1) • malliavinDeriv W P (F i) ω := by
  sorry

/-- 4.4: the chaos characterization of `𝔻^{1,2}` and `E‖DF‖² = ∑ₙ n ‖Jₙ F‖²`. -/
theorem IsIsonormal.mem_sobolev12_iff (hW : IsIsonormal W P) (F : Lp ℝ 2 P) :
    (F ∈ sobolev12 W P ↔ F ∈ gaussianL2 W P ∧
      Summable fun n : ℕ ↦ (n : ℝ) * ‖chaosProj W P n F‖ ^ 2) ∧
    (F ∈ sobolev12 W P →
      ‖malliavinDeriv W P F‖ ^ 2 = ∑' n : ℕ, (n : ℝ) * ‖chaosProj W P n F‖ ^ 2) := by
  sorry

/-- 4.4: the Gaussian Poincaré inequality on Wiener space, `Var F ≤ E‖DF‖²`. -/
theorem IsIsonormal.variance_le (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) : variance (⇑F) P ≤ ‖malliavinDeriv W P F‖ ^ 2 := by
  sorry

/-- 4.5: an element of `𝔻^{1,2}` with zero derivative is constant. -/
theorem IsIsonormal.malliavinDeriv_eq_zero_iff (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) :
    malliavinDeriv W P F = 0 ↔ F = toL2 P fun _ ↦ ∫ ω, F ω ∂P := by
  sorry

/-- 4.5: an indicator lies in `𝔻^{1,2}` only when its event has probability `0` or `1`. -/
theorem IsIsonormal.indicator_mem_sobolev12_iff (hW : IsIsonormal W P) {A : Set Ω}
    (hA : MeasurableSet A) :
    toL2 P (A.indicator fun _ ↦ (1 : ℝ)) ∈ sobolev12 W P ↔ P A = 0 ∨ P A = 1 := by
  sorry

end Derivative

/-! ## Layer 5: the divergence -/

section Divergence

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- 5.1: `G` is a divergence of `u`: `E[F G] = E⟪DF, u⟫` for every `F ∈ 𝔻^{1,2}`. -/
def IsDivergence (W : H → Ω → ℝ) (P : Measure Ω) (u : Lp H 2 P) (G : Lp ℝ 2 P) : Prop :=
  ∀ F ∈ sobolev12 W P, ⟪F, G⟫_ℝ = ⟪malliavinDeriv W P F, u⟫_ℝ

/-- 5.1: the domain of the divergence. -/
def divergenceDom (W : H → Ω → ℝ) (P : Measure Ω) : Set (Lp H 2 P) :=
  {u | ∃ G, IsDivergence W P u G}

/-- 5.1: the divergence (Skorokhod integral) `δ u`, and `0` outside its domain. -/
def divergence (W : H → Ω → ℝ) (P : Measure Ω) (u : Lp H 2 P) : Lp ℝ 2 P :=
  if h : ∃ G, IsDivergence W P u G then h.choose else 0

variable [CompleteSpace H] [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 5.1: the domain of `δ` is the set of `u` with `|E⟪DF, u⟫| ≤ c ‖F‖₂` on `𝔻^{1,2}`, and `δ u`
is then the unique divergence of `u`. -/
theorem IsIsonormal.mem_divergenceDom_iff (hW : IsIsonormal W P) (hgen : gaussianL2 W P = ⊤)
    (u : Lp H 2 P) :
    (u ∈ divergenceDom W P ↔
      ∃ c, ∀ F ∈ sobolev12 W P, |⟪malliavinDeriv W P F, u⟫_ℝ| ≤ c * ‖F‖) ∧
    (u ∈ divergenceDom W P → ∀ G, IsDivergence W P u G ↔ G = divergence W P u) := by
  sorry

/-- 5.1: divergences are centred; this needs no generation hypothesis, since the constant `1` is
a smooth cylinder functional with derivative `0`. -/
theorem IsIsonormal.integral_divergence (hW : IsIsonormal W P) {u : Lp H 2 P}
    (hu : u ∈ divergenceDom W P) : ∫ ω, divergence W P u ω ∂P = 0 := by
  sorry

/-- 5.2: `δ(F h) = F W(h) − ⟪DF, h⟫` for `F ∈ 𝔻^{1,2}` and a deterministic `h`. -/
theorem IsIsonormal.divergence_smul_const (hW : IsIsonormal W P) (hgen : gaussianL2 W P = ⊤)
    {F : Lp ℝ 2 P} (hF : F ∈ sobolev12 W P) (h : H) :
    MemLp (fun ω ↦ F ω * W h ω - ⟪malliavinDeriv W P F ω, h⟫_ℝ) 2 P ∧
      toL2 P (fun ω ↦ F ω • h) ∈ divergenceDom W P ∧
      divergence W P (toL2 P fun ω ↦ F ω • h) =
        toL2 P fun ω ↦ F ω * W h ω - ⟪malliavinDeriv W P F ω, h⟫_ℝ := by
  sorry

/-- 5.2: factoring a scalar out of a divergence, `δ(F u) = F δ(u) − ⟪DF, u⟫`. -/
theorem IsIsonormal.divergence_smul (hW : IsIsonormal W P) (hgen : gaussianL2 W P = ⊤)
    {F : Lp ℝ 2 P} (hF : F ∈ sobolev12 W P) {u : Lp H 2 P} (hu : u ∈ divergenceDom W P)
    (hFu : MemLp (fun ω ↦ F ω • u ω) 2 P)
    (hr : MemLp (fun ω ↦ F ω * divergence W P u ω - ⟪malliavinDeriv W P F ω, u ω⟫_ℝ) 2 P) :
    toL2 P (fun ω ↦ F ω • u ω) ∈ divergenceDom W P ∧
      divergence W P (toL2 P fun ω ↦ F ω • u ω) =
        toL2 P fun ω ↦ F ω * divergence W P u ω - ⟪malliavinDeriv W P F ω, u ω⟫_ℝ := by
  sorry

/-- 5.3: the divergence of an elementary process `u = ∑ⱼ Fⱼ hⱼ` with smooth cylinder `Fⱼ`, and
the Skorokhod isometry `E δ(u)² = E‖u‖² + ∑ᵢⱼ E[⟪DFᵢ, hⱼ⟫ ⟪DFⱼ, hᵢ⟫]`. -/
theorem IsIsonormal.divergence_elementary (hW : IsIsonormal W P) (hgen : gaussianL2 W P = ⊤)
    {n m : ℕ} (k : Fin n → H) {f : Fin m → EuclideanSpace ℝ (Fin n) → ℝ}
    (hf : ∀ j, IsSmoothPolyGrowth (f j)) (g : Fin m → H) :
    let u : Lp H 2 P := toL2 P fun ω ↦ ∑ j, f j (wVec W k ω) • g j
    u ∈ divergenceDom W P ∧
      divergence W P u = toL2 P (fun ω ↦
        ∑ j, (f j (wVec W k ω) * W (g j) ω - ⟪cylinderGrad W k (f j) ω, g j⟫_ℝ)) ∧
      ‖divergence W P u‖ ^ 2 = ‖u‖ ^ 2 + ∑ i, ∑ j,
        ∫ ω, ⟪cylinderGrad W k (f i) ω, g j⟫_ℝ * ⟪cylinderGrad W k (f j) ω, g i⟫_ℝ ∂P := by
  sorry

end Divergence

/-! ## Layer 6: the Ornstein–Uhlenbeck semigroup on Wiener space -/

section OrnsteinUhlenbeck

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- 6.1: the Ornstein–Uhlenbeck semigroup `P_t F = ∑ₙ e^{−nt} Jₙ F`. -/
def ouSemigroup (W : H → Ω → ℝ) (P : Measure Ω) (t : ℝ) (F : Lp ℝ 2 P) : Lp ℝ 2 P :=
  ∑' n : ℕ, Real.exp (-(n * t)) • chaosProj W P n F

/-- 6.2: the domain of the generator, `∑ₙ n² ‖Jₙ F‖² < ∞`. -/
def ouGeneratorDom (W : H → Ω → ℝ) (P : Measure Ω) : Set (Lp ℝ 2 P) :=
  {F | F ∈ gaussianL2 W P ∧ Summable fun n : ℕ ↦ (n : ℝ) ^ 2 * ‖chaosProj W P n F‖ ^ 2}

/-- 6.2: the generator `L F = −∑ₙ n Jₙ F`. -/
def ouGenerator (W : H → Ω → ℝ) (P : Measure Ω) (F : Lp ℝ 2 P) : Lp ℝ 2 P :=
  -∑' n : ℕ, (n : ℝ) • chaosProj W P n F

/-- 6.2: the pseudo-inverse `L⁻¹ F = −∑_{n ≥ 1} n⁻¹ Jₙ F`. -/
def ouPseudoInverse (W : H → Ω → ℝ) (P : Measure Ω) (F : Lp ℝ 2 P) : Lp ℝ 2 P :=
  -∑' n : ℕ, (n : ℝ)⁻¹ • chaosProj W P n F

variable [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 6.1: `P_t` is a symmetric, strongly continuous contraction semigroup on `gaussianL2 W P`. -/
theorem IsIsonormal.ouSemigroup_semigroup (hW : IsIsonormal W P) :
    (∀ F ∈ gaussianL2 W P, ouSemigroup W P 0 F = F) ∧
    (∀ s t, 0 ≤ s → 0 ≤ t → ∀ F,
      ouSemigroup W P (s + t) F = ouSemigroup W P s (ouSemigroup W P t F)) ∧
    (∀ t, 0 ≤ t → ∀ F, ‖ouSemigroup W P t F‖ ≤ ‖F‖) ∧
    (∀ t, 0 ≤ t → ∀ F G, ⟪ouSemigroup W P t F, G⟫_ℝ = ⟪F, ouSemigroup W P t G⟫_ℝ) ∧
    (∀ F ∈ gaussianL2 W P, Tendsto (fun t ↦ ouSemigroup W P t F) (𝓝[≥] 0) (𝓝 F)) := by
  sorry

/-- Sanity check of the definition: `P_t` multiplies the chaos of order `n` by `e^{−nt}`. -/
theorem IsIsonormal.ouSemigroup_of_mem_wienerChaos (hW : IsIsonormal W P) {n : ℕ}
    {F : Lp ℝ 2 P} (hF : F ∈ wienerChaos W P n) (t : ℝ) :
    ouSemigroup W P t F = Real.exp (-(n * t)) • F := by
  sorry

/-- 6.1: Mehler's formula on cylinder functionals of an orthonormal family. -/
theorem IsIsonormal.ouSemigroup_cylinder (hW : IsIsonormal W P) {n : ℕ} {k : Fin n → H}
    (hk : Orthonormal ℝ k) {f : EuclideanSpace ℝ (Fin n) → ℝ}
    (hf : MemLp f 2 (stdGaussian (EuclideanSpace ℝ (Fin n)))) {t : ℝ} (ht : 0 ≤ t) :
    ouSemigroup W P t (toL2 P fun ω ↦ f (wVec W k ω)) =
      toL2 P fun ω ↦ ∫ y, f (Real.exp (-t) • wVec W k ω + Real.sqrt (1 - Real.exp (-(2 * t))) • y)
        ∂(stdGaussian (EuclideanSpace ℝ (Fin n))) := by
  sorry

/-- 6.1: `P_t` preserves nonnegativity. -/
theorem IsIsonormal.ae_nonneg_ouSemigroup (hW : IsIsonormal W P) {t : ℝ} (ht : 0 ≤ t)
    {F : Lp ℝ 2 P} (hF : 0 ≤ᵐ[P] F) : 0 ≤ᵐ[P] ouSemigroup W P t F := by
  sorry

/-- 6.1: `P_t` is a contraction for every `Lᵖ` norm, `1 ≤ p ≤ ∞`. -/
theorem IsIsonormal.eLpNorm_ouSemigroup_le (hW : IsIsonormal W P) {p : ℝ≥0∞} (hp : 1 ≤ p)
    {t : ℝ} (ht : 0 ≤ t) {F : Lp ℝ 2 P} (hF : F ∈ gaussianL2 W P) :
    eLpNorm (ouSemigroup W P t F) p P ≤ eLpNorm F p P := by
  sorry

/-- 6.2: `L` is the generator of `P_t`: the difference quotients converge exactly on the domain
of `L`, to `L F`. -/
theorem IsIsonormal.tendsto_ouSemigroup_iff (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ gaussianL2 W P) (G : Lp ℝ 2 P) :
    Tendsto (fun t ↦ t⁻¹ • (ouSemigroup W P t F - F)) (𝓝[>] 0) (𝓝 G) ↔
      F ∈ ouGeneratorDom W P ∧ G = ouGenerator W P F := by
  sorry

/-- 6.2: `L = −δD`: `F ∈ Dom L` exactly when `F ∈ 𝔻^{1,2}` and `DF ∈ Dom δ`, and then
`δ(DF) = −L F`. -/
theorem IsIsonormal.mem_ouGeneratorDom_iff [CompleteSpace H] (hW : IsIsonormal W P)
    (hgen : gaussianL2 W P = ⊤) (F : Lp ℝ 2 P) :
    (F ∈ ouGeneratorDom W P ↔
      F ∈ sobolev12 W P ∧ malliavinDeriv W P F ∈ divergenceDom W P) ∧
    (F ∈ ouGeneratorDom W P →
      divergence W P (malliavinDeriv W P F) = -ouGenerator W P F) := by
  sorry

/-- 6.2: `L` on smooth cylinder functionals,
`L F = ∑ᵢⱼ ∂ᵢ∂ⱼ f ⟪hᵢ, hⱼ⟫ − ∑ᵢ ∂ᵢ f W(hᵢ)`. -/
theorem IsIsonormal.ouGenerator_cylinder (hW : IsIsonormal W P) {n : ℕ} (k : Fin n → H)
    {f : EuclideanSpace ℝ (Fin n) → ℝ} (hf : IsSmoothPolyGrowth f) :
    toL2 P (fun ω ↦ f (wVec W k ω)) ∈ ouGeneratorDom W P ∧
      ouGenerator W P (toL2 P fun ω ↦ f (wVec W k ω)) = toL2 P fun ω ↦
        ∑ i, ∑ j, iteratedFDeriv ℝ 2 f (wVec W k ω)
            ![EuclideanSpace.single i 1, EuclideanSpace.single j 1] * ⟪k i, k j⟫_ℝ -
          ∑ i, fderiv ℝ f (wVec W k ω) (EuclideanSpace.single i 1) * W (k i) ω := by
  sorry

/-- 6.2: `L⁻¹` inverts `L` on centred functionals: `L L⁻¹ F = F − E F` and
`L⁻¹ L F = F − E F`. -/
theorem IsIsonormal.ouPseudoInverse_spec (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ gaussianL2 W P) :
    ouPseudoInverse W P F ∈ ouGeneratorDom W P ∧
      ouGenerator W P (ouPseudoInverse W P F) = F - toL2 P (fun _ ↦ ∫ ω, F ω ∂P) ∧
      (F ∈ ouGeneratorDom W P →
        ouPseudoInverse W P (ouGenerator W P F) = F - toL2 P (fun _ ↦ ∫ ω, F ω ∂P)) := by
  sorry

/-- 6.3: commutation `D P_t = e^{−t} P_t D`, tested against a direction `h`. -/
theorem IsIsonormal.malliavinDeriv_ouSemigroup [CompleteSpace H] (hW : IsIsonormal W P)
    {F : Lp ℝ 2 P} (hF : F ∈ sobolev12 W P) {t : ℝ} (ht : 0 ≤ t) (h : H) :
    ouSemigroup W P t F ∈ sobolev12 W P ∧
      toL2 P (fun ω ↦ ⟪malliavinDeriv W P (ouSemigroup W P t F) ω, h⟫_ℝ) =
        Real.exp (-t) • ouSemigroup W P t (toL2 P fun ω ↦ ⟪malliavinDeriv W P F ω, h⟫_ℝ) := by
  sorry

/-- 6.3: the integration-by-parts formula
`E[F g(G)] = E F · E g(G) + E[g'(G) ⟪DG, −DL⁻¹F⟫]`. -/
theorem IsIsonormal.integral_mul_comp [CompleteSpace H] (hW : IsIsonormal W P) {F G : Lp ℝ 2 P}
    (hF : F ∈ gaussianL2 W P) (hG : G ∈ sobolev12 W P) {g : ℝ → ℝ} (hg : ContDiff ℝ 1 g)
    (hg' : ∃ C, ∀ x, |deriv g x| ≤ C) :
    ∫ ω, F ω * g (G ω) ∂P = (∫ ω, F ω ∂P) * (∫ ω, g (G ω) ∂P) +
      ∫ ω, deriv g (G ω) *
        ⟪malliavinDeriv W P G ω, -(malliavinDeriv W P (ouPseudoInverse W P F) ω)⟫_ℝ ∂P := by
  sorry

/-- 6.4: the Gaussian logarithmic Sobolev inequality on Wiener space,
`E[F² log F²] − E F² log E F² ≤ 2 E‖DF‖²`, with the integrability of `F² log F²`. -/
theorem IsIsonormal.integral_sq_mul_log_le [CompleteSpace H] (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) :
    Integrable (fun ω ↦ F ω ^ 2 * Real.log (F ω ^ 2)) P ∧
      ∫ ω, F ω ^ 2 * Real.log (F ω ^ 2) ∂P -
          (∫ ω, F ω ^ 2 ∂P) * Real.log (∫ ω, F ω ^ 2 ∂P) ≤ 2 * ‖malliavinDeriv W P F‖ ^ 2 := by
  sorry

/-- 6.4: Nelson's hypercontractivity: `‖P_t F‖_q ≤ ‖F‖_p` when `1 ≤ p`, `t ≥ 0` and
`q ≤ 1 + e^{2t}(p − 1)`. -/
theorem IsIsonormal.eLpNorm_ouSemigroup_le_of_le (hW : IsIsonormal W P) {p q t : ℝ}
    (hp : 1 ≤ p) (ht : 0 ≤ t) (hq : q ≤ 1 + Real.exp (2 * t) * (p - 1)) {F : Lp ℝ 2 P}
    (hF : F ∈ gaussianL2 W P) :
    eLpNorm (ouSemigroup W P t F) (ENNReal.ofReal q) P ≤ eLpNorm F (ENNReal.ofReal p) P := by
  sorry

/-- 6.4: equivalence of moments on a fixed chaos:
`‖F‖_r ≤ ((r − 1)/(q − 1))^{n/2} ‖F‖_q` for `F` in the chaos of order `n` and `1 < q ≤ r`. -/
theorem IsIsonormal.eLpNorm_le_of_mem_wienerChaos (hW : IsIsonormal W P) {n : ℕ}
    {F : Lp ℝ 2 P} (hF : F ∈ wienerChaos W P n) {q r : ℝ} (hq : 1 < q) (hqr : q ≤ r) :
    eLpNorm F (ENNReal.ofReal r) P ≤
      ENNReal.ofReal (((r - 1) / (q - 1)) ^ ((n : ℝ) / 2)) * eLpNorm F (ENNReal.ofReal q) P := by
  sorry

end OrnsteinUhlenbeck

