module

public import Mathlib
public import TauCeti.Probability.Process.PathLaw.Basic
public import TauCeti.Analysis.InnerProductSpace.SingularValues

/-!
# Subadditive and multiplicative ergodic theorems: target signatures

This file is not the roadmap: the roadmap is `README.md`, and this file is not an exhaustive
checklist. It states, against the pinned Mathlib and Tau Ceti and each with `sorry`, the
headlines of the README that carry a Lean name, each with every conclusion the README attaches
to it, together with the definitions their statements need. The README's other headlines are
targets of the same standing, stated there in prose with their locators or proof routes, and are
not stated here. One of them, Furstenberg's formula in 6.3, is left in prose because the pinned
Mathlib has no measurable structure on the projective space `ℙ ℝ E` (it has the quotient
topology only), so its stationary measures would have to be stated for `borel (ℙ ℝ E)` by hand.

The conventions of the README are used throughout. A system is a measure-preserving map `T` of a
probability space `(Ω, μ)`. A subadditive process is indexed by `n ≥ 1`; its value at `0` is never
used. Limits that can be `−∞` are stated in `EReal`, rates that can be `+∞` in `ℝ≥0∞`. A linear
cocycle is generated by `A : Ω → E →L[ℝ] E` on a finite-dimensional real inner product space `E`,
invertible almost everywhere, with `log⁺ ‖A‖` and `log⁺ ‖A⁻¹‖` integrable; the inverse is
`Ring.inverse`. The `k`-volume growth of an operator is the operator norm of its `k`-th exterior
power for Mathlib's inner product on `⋀[ℝ]^k E`; its product formula in singular values and its
submultiplicativity are owned by EigenvalueAndSingularValueInequalities §2.4. Lyapunov exponents are
indexed from `0` and listed with multiplicity in decreasing order. The implementation namespace of
the README is `TauCeti`; the prototypes live in this roadmap's namespace.
-/

@[expose] public section

noncomputable section

open MeasureTheory Filter Set Finset Topology Module
open scoped ENNReal NNReal

namespace TauCetiRoadmap.SubadditiveAndMultiplicativeErgodicTheorems

attribute [local instance] Classical.propDecidable

/-! ## Layer 1: subadditive sequences -/

/-- 1.1: Fekete's lemma without a lower bound. For a subadditive real sequence, `u n / n`
converges in `EReal` to the infimum of `u n / n` over `n ≥ 1`, which may be `⊥`. -/
theorem tendsto_div_ereal_of_subadditive {u : ℕ → ℝ} (hu : Subadditive u) :
    Tendsto (fun n : ℕ ↦ ((u n / n : ℝ) : EReal)) atTop
      (𝓝 (⨅ (n : ℕ) (_ : 0 < n), ((u n / n : ℝ) : EReal))) := by
  sorry

/-! ## Layer 2: Kingman's subadditive ergodic theorem -/

section Kingman

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {T : Ω → Ω}

/-- 2.1: a subadditive process over `T`: almost everywhere strongly measurable functions `f n`,
`n ≥ 1`, with `f (m + n) ≤ f m + f n ∘ T^[m]` almost everywhere for `m, n ≥ 1`. The term `f 0` is
unconstrained. -/
structure IsSubadditiveProcess (μ : Measure Ω) (T : Ω → Ω) (f : ℕ → Ω → ℝ) : Prop where
  aestronglyMeasurable : ∀ n, 0 < n → AEStronglyMeasurable (f n) μ
  ae_le : ∀ m n, 0 < m → 0 < n → ∀ᵐ x ∂μ, f (m + n) x ≤ f m x + f n (T^[m] x)

/-- 2.1: the growth constant `γ = inf_{n ≥ 1} (∫ f n) / n` of a process, in `EReal`. It is used for
processes whose terms are integrable. -/
def subadditiveRate (μ : Measure Ω) (f : ℕ → Ω → ℝ) : EReal :=
  ⨅ (n : ℕ) (_ : 0 < n), (((∫ x, f n x ∂μ) / n : ℝ) : EReal)

/-- 2.1: Birkhoff sums form a subadditive (indeed additive) process. -/
theorem isSubadditiveProcess_birkhoffSum (hT : MeasurePreserving T μ μ) {φ : Ω → ℝ}
    (hφ : AEStronglyMeasurable φ μ) : IsSubadditiveProcess μ T (fun n ↦ birkhoffSum T φ n) := by
  sorry

/-- 2.2: the expectations of an integrable subadditive process grow at the rate `γ`. -/
theorem IsSubadditiveProcess.tendsto_integral_div [IsProbabilityMeasure μ]
    (hT : MeasurePreserving T μ μ) {f : ℕ → Ω → ℝ} (hf : IsSubadditiveProcess μ T f)
    (hint : ∀ n, 0 < n → Integrable (f n) μ) :
    Tendsto (fun n : ℕ ↦ ((((∫ x, f n x ∂μ) / n : ℝ)) : EReal)) atTop
      (𝓝 (subadditiveRate μ f)) := by
  sorry

/-- 2.3: **Kingman's subadditive ergodic theorem**, almost everywhere form. If the positive part of
`f 1` is integrable, `f n / n` converges almost everywhere in `EReal` to a `T`-invariant limit
`g` with values in `[−∞, ∞)` whose positive part is integrable. -/
theorem IsSubadditiveProcess.ae_tendsto [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {f : ℕ → Ω → ℝ} (hf : IsSubadditiveProcess μ T f)
    (hf1 : Integrable (fun x ↦ max (f 1 x) 0) μ) :
    ∃ g : Ω → EReal, AEMeasurable g μ ∧ g ∘ T =ᵐ[μ] g ∧ (∀ᵐ x ∂μ, g x ≠ ⊤) ∧
      Integrable (fun x ↦ (max (g x) 0).toReal) μ ∧
      ∀ᵐ x ∂μ, Tendsto (fun n : ℕ ↦ ((f n x / n : ℝ) : EReal)) atTop (𝓝 (g x)) := by
  sorry

/-- 2.4: **Kingman's theorem, `L¹` form.** For an integrable process with `γ > −∞` the limit is
real, integrable and invariant, `f n / n` converges to it almost everywhere and in `L¹`, and its
integral is `γ`. -/
theorem IsSubadditiveProcess.tendsto_L1 [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {f : ℕ → Ω → ℝ} (hf : IsSubadditiveProcess μ T f) (hint : ∀ n, 0 < n → Integrable (f n) μ)
    (hγ : ⊥ < subadditiveRate μ f) :
    ∃ g : Ω → ℝ, Integrable g μ ∧ g ∘ T =ᵐ[μ] g ∧
      (∀ᵐ x ∂μ, Tendsto (fun n : ℕ ↦ f n x / n) atTop (𝓝 (g x))) ∧
      Tendsto (fun n : ℕ ↦ ∫ x, |f n x / n - g x| ∂μ) atTop (𝓝 0) ∧
      (((∫ x, g x ∂μ : ℝ)) : EReal) = subadditiveRate μ f := by
  sorry

/-- 2.5: **Kingman's theorem, ergodic case.** For ergodic `T` and an integrable process,
`f n / n → γ` almost everywhere in `EReal`, including the case `γ = ⊥`. -/
theorem IsSubadditiveProcess.ae_tendsto_rate_of_ergodic [IsProbabilityMeasure μ]
    (hT : Ergodic T μ) {f : ℕ → Ω → ℝ} (hf : IsSubadditiveProcess μ T f)
    (hint : ∀ n, 0 < n → Integrable (f n) μ) :
    ∀ᵐ x ∂μ, Tendsto (fun n : ℕ ↦ ((f n x / n : ℝ) : EReal)) atTop
      (𝓝 (subadditiveRate μ f)) := by
  sorry

end Kingman

/-! ## Layer 3: volume growth of linear maps -/

section Wedge

variable {E F G : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [NormedAddCommGroup F] [InnerProductSpace ℝ F] [FiniteDimensional ℝ F]
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [FiniteDimensional ℝ G]

/-- 3.1: the `k`-volume growth `‖⋀ᵏ B‖` of a linear map: the operator norm of its `k`-th exterior
power, for Mathlib's inner product on `⋀[ℝ]^k`. The body is the expression
`‖LinearMap.toContinuousLinearMap (exteriorPower.map k A)‖` of the roadmap
EigenvalueAndSingularValueInequalities §2.4, which owns its product formula in singular values and
its submultiplicativity; those theorems apply to `wedgeNorm` by unfolding. -/
def wedgeNorm (k : ℕ) (B : E →L[ℝ] F) : ℝ :=
  ‖LinearMap.toContinuousLinearMap (exteriorPower.map k (B : E →ₗ[ℝ] F))‖

/-- 3.2: the first exterior power recovers the operator norm. -/
theorem wedgeNorm_one (B : E →L[ℝ] F) : wedgeNorm 1 B = ‖B‖ := by
  sorry

/-- 3.2: the top exterior power of an endomorphism recovers `|det B|`. -/
theorem wedgeNorm_finrank (B : E →L[ℝ] E) :
    wedgeNorm (finrank ℝ E) B = |LinearMap.det (B : E →ₗ[ℝ] E)| := by
  sorry

/-- 3.2: `k ↦ log ‖⋀ᵏ B‖` is concave. -/
theorem wedgeNorm_mul_wedgeNorm_le_sq (k : ℕ) (B : E →L[ℝ] F) :
    wedgeNorm k B * wedgeNorm (k + 2) B ≤ wedgeNorm (k + 1) B ^ 2 := by
  sorry

/-- 3.2: an invertible endomorphism has positive `k`-volume growth for `k ≤ dim E`. -/
theorem wedgeNorm_pos {B : E →L[ℝ] E} (hB : IsUnit B) {k : ℕ} (hk : k ≤ finrank ℝ E) :
    0 < wedgeNorm k B := by
  sorry

end Wedge

/-! ## Layer 4: linear cocycles and the Furstenberg–Kesten theorem -/

section Cocycle

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} {T : Ω → Ω}
  {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- 4.1: the linear cocycle `A_n(x) = A(T^{n-1} x) ∘ ⋯ ∘ A(x)` generated by `A` over `T`. -/
def cocycle (A : Ω → E →L[ℝ] E) (T : Ω → Ω) : ℕ → Ω → E →L[ℝ] E
  | 0, _ => ContinuousLinearMap.id ℝ E
  | n + 1, x => (A (T^[n] x)).comp (cocycle A T n x)

/-- 4.1: the cocycle identity `A_{m+n}(x) = A_n(T^m x) ∘ A_m(x)`. -/
theorem cocycle_add (A : Ω → E →L[ℝ] E) (T : Ω → Ω) (m n : ℕ) (x : Ω) :
    cocycle A T (m + n) x = (cocycle A T n (T^[m] x)).comp (cocycle A T m x) := by
  sorry

/-- 4.1: the logarithms of the `k`-volume growths of an invertible cocycle form a subadditive
process. -/
theorem isSubadditiveProcess_log_wedgeNorm (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (k : ℕ) :
    IsSubadditiveProcess μ T (fun n x ↦ Real.log (wedgeNorm k (cocycle A T n x))) := by
  sorry

/-- 4.2: the sum of the `k` largest Lyapunov exponents at `x`, the limit of
`(1/n) log ‖⋀ᵏ A_n(x)‖` (Mathlib's `limUnder`; meaningful where the limit exists). -/
def lyapunovSum (A : Ω → E →L[ℝ] E) (T : Ω → Ω) (k : ℕ) (x : Ω) : ℝ :=
  limUnder atTop fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log (wedgeNorm k (cocycle A T n x))

/-- 4.2: the `i`-th Lyapunov exponent at `x`, indexed from `0` and counted with multiplicity. -/
def lyapunovExponent (A : Ω → E →L[ℝ] E) (T : Ω → Ω) (i : ℕ) (x : Ω) : ℝ :=
  lyapunovSum A T (i + 1) x - lyapunovSum A T i x

/-- 4.2: **Furstenberg–Kesten**, for every exterior power. The growth rate of `‖⋀ᵏ A_n‖`
exists almost everywhere and in `L¹`; it is invariant and integrable, and its integral is the
limit of the averaged logarithms. -/
theorem tendsto_lyapunovSum [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) (k : ℕ) :
    (∀ᵐ x ∂μ, Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log (wedgeNorm k (cocycle A T n x))) atTop
      (𝓝 (lyapunovSum A T k x))) ∧
    Integrable (lyapunovSum A T k) μ ∧ lyapunovSum A T k ∘ T =ᵐ[μ] lyapunovSum A T k ∧
    Tendsto (fun n : ℕ ↦ ∫ x, |(n : ℝ)⁻¹ * Real.log (wedgeNorm k (cocycle A T n x)) -
      lyapunovSum A T k x| ∂μ) atTop (𝓝 0) ∧
    Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * ∫ x, Real.log (wedgeNorm k (cocycle A T n x)) ∂μ) atTop
      (𝓝 (∫ x, lyapunovSum A T k x ∂μ)) := by
  sorry

/-- 4.2: the extremal exponents. The top exponent is the growth rate of `‖A_n‖` and the bottom
one that of the conorm `‖A_n⁻¹‖⁻¹`. -/
theorem tendsto_log_norm_cocycle [Nontrivial E] [IsProbabilityMeasure μ]
    (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ,
      Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log ‖cocycle A T n x‖) atTop
        (𝓝 (lyapunovExponent A T 0 x)) ∧
      Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log ‖Ring.inverse (cocycle A T n x)‖⁻¹) atTop
        (𝓝 (lyapunovExponent A T (finrank ℝ E - 1) x)) := by
  sorry

/-- 4.3: the exponents are in decreasing order. -/
theorem lyapunovExponent_antitone [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ, ∀ i j, i ≤ j → j < finrank ℝ E →
      lyapunovExponent A T j x ≤ lyapunovExponent A T i x := by
  sorry

/-- 4.3: the sum of all exponents is the invariant conditional expectation of `log |det A|`. -/
theorem sum_lyapunovExponent [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    (fun x ↦ ∑ i ∈ Finset.range (finrank ℝ E), lyapunovExponent A T i x) =ᵐ[μ]
      μ[fun y ↦ Real.log |LinearMap.det (A y : E →ₗ[ℝ] E)| |
        MeasurableSpace.invariants T] := by
  sorry

/-- 4.3: the exponents are invariant, and constant almost everywhere when `T` is ergodic. -/
theorem lyapunovExponent_comp_ae [IsProbabilityMeasure μ] (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    (∀ᵐ x ∂μ, ∀ i, lyapunovExponent A T i (T x) = lyapunovExponent A T i x) ∧
    (Ergodic T μ → ∃ c : ℕ → ℝ, ∀ᵐ x ∂μ, ∀ i, lyapunovExponent A T i x = c i) := by
  sorry

end Cocycle

/-! ## Layer 5: the multiplicative ergodic theorem -/

section Oseledets

variable {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
  {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- 5.1: the slow subspace `V_t(x)` of vectors whose forward growth rate is at most `t`: for every
`ε > 0`, `‖A_n(x) v‖ ≤ C e^{n (t + ε)}` for some `C` and all `n`. -/
def slowSubspace (A : Ω → E →L[ℝ] E) (T : Ω → Ω) (x : Ω) (t : ℝ) : Submodule ℝ E where
  carrier := {v | ∀ ε > 0, ∃ C : ℝ, ∀ n : ℕ,
    ‖cocycle A T n x v‖ ≤ C * Real.exp (n * (t + ε))}
  zero_mem' := by
    intro ε _
    refine ⟨0, fun n ↦ ?_⟩
    simp
  add_mem' := by
    intro a b ha hb ε hε
    obtain ⟨C₁, h₁⟩ := ha ε hε
    obtain ⟨C₂, h₂⟩ := hb ε hε
    refine ⟨C₁ + C₂, fun n ↦ ?_⟩
    calc ‖cocycle A T n x (a + b)‖
        = ‖cocycle A T n x a + cocycle A T n x b‖ := by rw [map_add]
      _ ≤ ‖cocycle A T n x a‖ + ‖cocycle A T n x b‖ := norm_add_le _ _
      _ ≤ C₁ * Real.exp (n * (t + ε)) + C₂ * Real.exp (n * (t + ε)) := add_le_add (h₁ n) (h₂ n)
      _ = (C₁ + C₂) * Real.exp (n * (t + ε)) := by ring
  smul_mem' := by
    intro c v hv ε hε
    obtain ⟨C, h⟩ := hv ε hε
    refine ⟨‖c‖ * C, fun n ↦ ?_⟩
    calc ‖cocycle A T n x (c • v)‖ = ‖c‖ * ‖cocycle A T n x v‖ := by
          rw [map_smul, norm_smul]
      _ ≤ ‖c‖ * (C * Real.exp (n * (t + ε))) := mul_le_mul_of_nonneg_left (h n) (norm_nonneg c)
      _ = ‖c‖ * C * Real.exp (n * (t + ε)) := by ring

/-- 5.1: the cocycle carries the slow subspace at `x` onto the slow subspace at `T x`, at every
point where `A x` is invertible. -/
theorem map_slowSubspace (A : Ω → E →L[ℝ] E) (T : Ω → Ω) {x : Ω} (hx : IsUnit (A x)) (t : ℝ) :
    (slowSubspace A T x t).map (A x : E →ₗ[ℝ] E) = slowSubspace A T (T x) t := by
  sorry

/-- 5.2: **Oseledets' multiplicative ergodic theorem, one-sided form.** Almost everywhere, every
nonzero vector has an exact exponential growth rate, which is one of the Lyapunov exponents, and
the slow subspace `V_t(x)` has dimension the number of exponents at most `t`. -/
theorem oseledets [IsProbabilityMeasure μ] {T : Ω → Ω} (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ,
      (∀ v : E, v ≠ 0 → ∃ i < finrank ℝ E,
        Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log ‖cocycle A T n x v‖) atTop
          (𝓝 (lyapunovExponent A T i x))) ∧
      ∀ t : ℝ, finrank ℝ (slowSubspace A T x t) =
        ((Finset.range (finrank ℝ E)).filter fun i ↦ lyapunovExponent A T i x ≤ t).card := by
  sorry

/-- 5.2: the exponents are the growth rates of the singular values of `A_n(x)`. -/
theorem tendsto_log_singularValues_cocycle [IsProbabilityMeasure μ] {T : Ω → Ω}
    (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ, ∀ i < finrank ℝ E,
      Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ *
        Real.log ((cocycle A T n x : E →ₗ[ℝ] E).singularValues i)) atTop
        (𝓝 (lyapunovExponent A T i x)) := by
  sorry

/-- 5.3: the generator of the backward cocycle over `T⁻¹`, `y ↦ A(T⁻¹ y)⁻¹`, whose `n`-th
iterate at `x` is `A_{-n}(x)`. -/
def backwardGenerator (A : Ω → E →L[ℝ] E) (T : Ω ≃ᵐ Ω) (y : Ω) : E →L[ℝ] E :=
  Ring.inverse (A (T.symm y))

/-- 5.3: the Oseledets space `E_t(x)`: vectors of forward growth rate at most `t` and backward
growth rate at most `−t`. -/
def oseledetsSpace (A : Ω → E →L[ℝ] E) (T : Ω ≃ᵐ Ω) (x : Ω) (t : ℝ) : Submodule ℝ E :=
  slowSubspace A T x t ⊓ slowSubspace (backwardGenerator A T) T.symm x (-t)

/-- 5.3: **Oseledets' theorem, two-sided form.** For invertible `T`, almost everywhere `E` is the
direct sum of the Oseledets spaces over the distinct exponents; the cocycle carries each onto
the corresponding space at `T x`; a nonzero vector of `E_t(x)` grows at rate `t` forward and at
rate `−t` under the backward cocycle; and `E_t(x)` has dimension the multiplicity of `t`. -/
theorem oseledets_twoSided [IsProbabilityMeasure μ] {T : Ω ≃ᵐ Ω} (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ,
      DirectSum.IsInternal (fun t : ((Finset.range (finrank ℝ E)).image
        fun i ↦ lyapunovExponent A T i x) ↦ oseledetsSpace A T x t) ∧
      (∀ t : ℝ, (oseledetsSpace A T x t).map (A x : E →ₗ[ℝ] E) = oseledetsSpace A T (T x) t) ∧
      (∀ t : ℝ, ∀ v ∈ oseledetsSpace A T x t, v ≠ 0 →
        Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * Real.log ‖cocycle A T n x v‖) atTop (𝓝 t) ∧
        Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ *
          Real.log ‖cocycle (backwardGenerator A T) T.symm n x v‖) atTop (𝓝 (-t))) ∧
      ∀ t : ℝ, finrank ℝ (oseledetsSpace A T x t) =
        ((Finset.range (finrank ℝ E)).filter fun i ↦ lyapunovExponent A T i x = t).card := by
  sorry

/-- 5.3: the exponents of the backward cocycle are the negatives of those of `A`, in reverse
order. -/
theorem lyapunovExponent_backwardGenerator [IsProbabilityMeasure μ] {T : Ω ≃ᵐ Ω}
    (hT : MeasurePreserving T μ μ)
    {A : Ω → E →L[ℝ] E} (hA : AEStronglyMeasurable A μ) (hinv : ∀ᵐ x ∂μ, IsUnit (A x))
    (hA₁ : Integrable (fun x ↦ Real.posLog ‖A x‖) μ)
    (hA₂ : Integrable (fun x ↦ Real.posLog ‖Ring.inverse (A x)‖) μ) :
    ∀ᵐ x ∂μ, ∀ i < finrank ℝ E,
      lyapunovExponent (backwardGenerator A T) T.symm i x =
        -lyapunovExponent A T (finrank ℝ E - 1 - i) x := by
  sorry

end Oseledets

/-! ## Layer 6: products of independent random matrices -/

section IID

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  [MeasurableSpace (E →L[ℝ] E)] [BorelSpace (E →L[ℝ] E)]

open TauCeti.Probability

/-- 6.1: for an i.i.d. sequence of invertible random operators with law `ν`, the exponents are
almost surely constant, and the top one is the growth rate of the expected logarithm of the norm
of the product. -/
theorem lyapunovExponent_iid (ν : Measure (E →L[ℝ] E)) [IsProbabilityMeasure ν]
    (hinv : ∀ᵐ g ∂ν, IsUnit g)
    (hν : Integrable (fun g ↦ Real.posLog ‖g‖ + Real.posLog ‖Ring.inverse g‖) ν) :
    ∃ c : ℕ → ℝ,
      (∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ ν), ∀ i,
        lyapunovExponent (fun ω : ℕ → E →L[ℝ] E ↦ ω 0) (shift _) i ω = c i) ∧
      Tendsto (fun n : ℕ ↦ (n : ℝ)⁻¹ * ∫ ω, Real.log
        ‖cocycle (fun ω : ℕ → E →L[ℝ] E ↦ ω 0) (shift _) n ω‖ ∂(Measure.infinitePi fun _ ↦ ν))
        atTop (𝓝 (c 0)) := by
  sorry

/-- 6.2: a set of operators is strongly irreducible if no nonempty finite family of proper nonzero
subspaces is permuted by all of its invertible elements. Noninvertible elements are ignored: they
are not in the group the theorems of 6.3 concern. -/
def IsStronglyIrreducible (S : Set (E →L[ℝ] E)) : Prop :=
  ∀ 𝓕 : Finset (Submodule ℝ E), 𝓕.Nonempty → (∀ W ∈ 𝓕, W ≠ ⊥ ∧ W ≠ ⊤) →
    ∃ g ∈ S, IsUnit g ∧ ∃ W ∈ 𝓕, W.map (g : E →ₗ[ℝ] E) ∉ 𝓕

/-- 6.3: **Furstenberg's positivity theorem.** If the support of `ν` is strongly irreducible and the
semigroup it generates is unbounded modulo scalars, the top exponent exceeds the mean exponent
`(1/d) ∫ log |det g| dν`; for laws on `SL(E)` it is positive. -/
theorem lyapunovExponent_zero_gt_iid (ν : Measure (E →L[ℝ] E)) [IsProbabilityMeasure ν]
    (hd : 2 ≤ finrank ℝ E) (hinv : ∀ᵐ g ∂ν, IsUnit g)
    (hν : Integrable (fun g ↦ Real.posLog ‖g‖ + Real.posLog ‖Ring.inverse g‖) ν)
    (hirr : IsStronglyIrreducible ν.support)
    (hunb : ¬ Bornology.IsBounded ((fun g : E →L[ℝ] E ↦
      (|LinearMap.det (g : E →ₗ[ℝ] E)| ^ (-(finrank ℝ E : ℝ)⁻¹)) • g) ''
        (Subsemigroup.closure ν.support : Set (E →L[ℝ] E)))) :
    ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ ν),
      (finrank ℝ E : ℝ)⁻¹ * ∫ g, Real.log |LinearMap.det (g : E →ₗ[ℝ] E)| ∂ν <
        lyapunovExponent (fun ω : ℕ → E →L[ℝ] E ↦ ω 0) (shift _) 0 ω := by
  sorry

end IID

/-! ## Layer 7: subadditive limits in probability and combinatorics -/

section Range

variable {G : Type*} [AddCommGroup G] [MeasurableSpace G] [MeasurableSingletonClass G]
  [Countable G]

open TauCeti.Probability

/-- 7.1: the number of distinct sites `S_1, …, S_n` visited by the walk with increments `ω`,
where `S_k = ω 0 + ⋯ + ω (k - 1)`. -/
def rangeCard (ω : ℕ → G) (n : ℕ) : ℕ :=
  ((Finset.Icc 1 n).image fun k ↦ ∑ i ∈ Finset.range k, ω i).card

/-- 7.1: the event that the walk never returns to its starting point. -/
def noReturn (G : Type*) [AddCommGroup G] : Set (ℕ → G) :=
  {ω | ∀ k, 1 ≤ k → ∑ i ∈ Finset.range k, ω i ≠ 0}

/-- 7.1: the range is a subadditive process over the shift. -/
theorem isSubadditiveProcess_rangeCard (m : Measure (ℕ → G))
    (hm : MeasurePreserving (shift G) m m) :
    IsSubadditiveProcess m (shift G) (fun n ω ↦ (rangeCard ω n : ℝ)) := by
  sorry

/-- 7.1: **Kesten–Spitzer–Whitman, stationary form.** For stationary increments, `R_n / n`
converges almost surely to the invariant conditional probability of never returning. -/
theorem tendsto_rangeCard_div (m : Measure (ℕ → G)) [IsProbabilityMeasure m]
    (hm : MeasurePreserving (shift G) m m) :
    ∀ᵐ ω ∂m, Tendsto (fun n : ℕ ↦ (rangeCard ω n : ℝ) / n) atTop
      (𝓝 ((m[(noReturn G).indicator (fun _ ↦ (1 : ℝ)) |
        MeasurableSpace.invariants (shift G)]) ω)) := by
  sorry

/-- 7.1: **Kesten–Spitzer–Whitman.** For i.i.d. increments, `R_n / n` converges almost surely to
the probability of never returning. -/
theorem tendsto_rangeCard_div_iid (ν : Measure G) [IsProbabilityMeasure ν] :
    ∀ᵐ ω ∂(Measure.infinitePi fun _ : ℕ ↦ ν), Tendsto (fun n : ℕ ↦ (rangeCard ω n : ℝ) / n)
      atTop (𝓝 ((Measure.infinitePi fun _ : ℕ ↦ ν) (noReturn G)).toReal) := by
  sorry

end Range

section Passage

variable {d : ℕ} [NeZero d]

/-- 7.2: the unit step in direction `i`, forward for `b = true` and backward for `b = false`. -/
def stepVec (i : Fin d) (b : Bool) : Fin d → ℤ :=
  if b then Pi.single i 1 else -Pi.single i 1

/-- 7.2: the endpoint of the lattice path from `x` with the given steps. -/
def pathEnd (x : Fin d → ℤ) (p : List (Fin d × Bool)) : Fin d → ℤ :=
  x + (p.map fun s ↦ stepVec s.1 s.2).sum

/-- 7.2: the travel time of the lattice path from `x` with the given steps, for edge weights
`τ`. The edge `(i, z)` joins `z` and `z + eᵢ`. -/
def pathWeight (τ : Fin d × (Fin d → ℤ) → ℝ≥0) : (Fin d → ℤ) → List (Fin d × Bool) → ℝ≥0
  | _, [] => 0
  | x, s :: p => τ (s.1, if s.2 then x else x - Pi.single s.1 1) +
      pathWeight τ (x + stepVec s.1 s.2) p

/-- 7.2: the first-passage time from `x` to `y`, the infimum of travel times of lattice paths. -/
def passageTime (τ : Fin d × (Fin d → ℤ) → ℝ≥0) (x y : Fin d → ℤ) : ℝ≥0 :=
  ⨅ p : {p : List (Fin d × Bool) // pathEnd x p = y}, pathWeight τ x p.1

/-- 7.2: the passage time is a pseudometric: it satisfies the triangle inequality. -/
theorem passageTime_le_add (τ : Fin d × (Fin d → ℤ) → ℝ≥0) (x y z : Fin d → ℤ) :
    passageTime τ x z ≤ passageTime τ x y + passageTime τ y z := by
  sorry

/-- 7.2: translating the weights translates the passage times. -/
theorem passageTime_translate (τ : Fin d × (Fin d → ℤ) → ℝ≥0) (z x y : Fin d → ℤ) :
    passageTime (fun e ↦ τ (e.1, e.2 + z)) x y = passageTime τ (x + z) (y + z) := by
  sorry

/-- 7.2: the time constant along the first axis for i.i.d. edge weights of law `ν`,
`inf_{n ≥ 1} E T(0, n e₀) / n`, in `ℝ≥0∞`. -/
def timeConstant (ν : Measure ℝ≥0) : ℝ≥0∞ :=
  ⨅ (n : ℕ) (_ : 0 < n), (∫⁻ τ, (passageTime τ 0 (n • Pi.single 0 1) : ℝ≥0∞)
    ∂(Measure.infinitePi fun _ : Fin d × (Fin d → ℤ) ↦ ν)) / n

/-- 7.2: **the time constant of first-passage percolation.** If the passage time to the
neighbouring site has finite mean, `T(0, n e₀) / n` converges almost surely to the time constant,
which is finite. -/
theorem tendsto_passageTime_div (ν : Measure ℝ≥0) [IsProbabilityMeasure ν]
    (hν : ∫⁻ τ, (passageTime τ 0 (Pi.single (0 : Fin d) 1) : ℝ≥0∞)
      ∂(Measure.infinitePi fun _ : Fin d × (Fin d → ℤ) ↦ ν) < ∞) :
    timeConstant (d := d) ν < ∞ ∧
    ∀ᵐ τ ∂(Measure.infinitePi fun _ : Fin d × (Fin d → ℤ) ↦ ν),
      Tendsto (fun n : ℕ ↦ (passageTime τ 0 (n • Pi.single 0 1) : ℝ≥0∞) / n) atTop
        (𝓝 (timeConstant (d := d) ν)) := by
  sorry

end Passage

section LCS

variable {α : Type*} [DecidableEq α]

open TauCeti.Probability

/-- 7.3: the length of a longest common subsequence of two lists. -/
def lcsLength (u v : List α) : ℕ :=
  ((u.sublists.filter fun w ↦ decide (w.Sublist v)).map List.length).foldr max 0

/-- 7.3: the longest common subsequence of the first `n` letters of the two coordinate words of
`ω`. -/
def lcsPrefix (ω : ℕ → α × α) (n : ℕ) : ℕ :=
  lcsLength ((List.range n).map fun i ↦ (ω i).1) ((List.range n).map fun i ↦ (ω i).2)

/-- 7.3: superadditivity of the longest common subsequence along the shift. -/
theorem lcsPrefix_add_le (ω : ℕ → α × α) (m n : ℕ) :
    lcsPrefix ω m + lcsPrefix ((shift (α × α))^[m] ω) n ≤ lcsPrefix ω (m + n) := by
  sorry

variable [MeasurableSpace α] [MeasurableSingletonClass α] [Finite α]

/-- 7.3: **the Chvátal–Sankoff constant.** For a stationary ergodic sequence of letter pairs,
`L_n / n` converges almost surely to `sup_{n ≥ 1} E L_n / n`. -/
theorem tendsto_lcsPrefix_div (m : Measure (ℕ → α × α)) [IsProbabilityMeasure m]
    (hm : Ergodic (shift (α × α)) m) :
    ∀ᵐ ω ∂m, Tendsto (fun n : ℕ ↦ (lcsPrefix ω n : ℝ) / n) atTop
      (𝓝 (⨆ (n : ℕ) (_ : 0 < n), (∫ ω, (lcsPrefix ω n : ℝ) ∂m) / n)) := by
  sorry

/-- 7.3: for two independent i.i.d. words with letter law `ν`, the limit `γ` satisfies
`ν {a} ≤ γ ≤ 1` for every letter `a`. -/
theorem lcs_constant_bounds (ν : Measure α) [IsProbabilityMeasure ν] (a : α) :
    (ν {a}).toReal ≤ ⨆ (n : ℕ) (_ : 0 < n),
        (∫ ω, (lcsPrefix ω n : ℝ) ∂(Measure.infinitePi fun _ : ℕ ↦ ν.prod ν)) / n ∧
      ⨆ (n : ℕ) (_ : 0 < n),
        (∫ ω, (lcsPrefix ω n : ℝ) ∂(Measure.infinitePi fun _ : ℕ ↦ ν.prod ν)) / n ≤ 1 := by
  sorry

end LCS

