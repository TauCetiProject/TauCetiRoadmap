import Mathlib

/-!
# Modal logic completeness: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib, each with `sorry`, together with the few definitions
they need; every definition has a real body. Every headline theorem of the README is statable at
the pins and is stated here. The README's remaining targets, API lists and Checks are not restated.

Formulas are built from propositional variables of an arbitrary type `α`, falsity, implication and
the box; negation and the diamond are defined. Derivability is a Hilbert-style system whose axioms
are the tautological instances, the distribution schema and the schemas of the system, closed under
modus ponens and necessitation; derivation from a set of hypotheses uses finitely many hypotheses
and applies necessitation only to theorems. Kripke frames are relations `R : W → W → Prop` on a
type of worlds, possibly empty, and consequence is local: truth at a world of every hypothesis
forces truth of the conclusion at that world.
-/

universe u v

namespace TauCetiRoadmap.ModalLogicCompleteness

/-! ## Layer 1: formulas and normal modal systems -/

/-- 1.1 Formulas of the basic modal language over a type `α` of propositional variables:
variables, falsity, implication and the box. -/
inductive Formula (α : Type u) : Type u
  | var : α → Formula α
  | bot : Formula α
  | imp : Formula α → Formula α → Formula α
  | box : Formula α → Formula α
  deriving DecidableEq

namespace Formula

variable {α : Type u}

/-- 1.1 Negation, `¬φ := φ → ⊥`. -/
def neg (φ : Formula α) : Formula α :=
  imp φ bot

/-- 1.1 The diamond, `◇φ := ¬□¬φ`. -/
def dia (φ : Formula α) : Formula α :=
  neg (box (neg φ))

/-- 1.1 The finite set of subformulas of `φ`, `φ` itself included. -/
def subformulas [DecidableEq α] : Formula α → Finset (Formula α)
  | var p => {var p}
  | bot => {bot}
  | imp φ ψ => insert (imp φ ψ) (subformulas φ ∪ subformulas ψ)
  | box φ => insert (box φ) (subformulas φ)

end Formula

open Formula

variable {α : Type u}

/-- 1.2 Classical evaluation of a formula under a truth assignment `v` to its variables and to its
formulas of the form `□ψ`, which are treated as unanalysed atoms. -/
def boolEval (v : Formula α → Prop) : Formula α → Prop
  | var p => v (var p)
  | bot => False
  | imp φ ψ => boolEval v φ → boolEval v ψ
  | box φ => v (box φ)

/-- 1.2 A tautological instance: a formula true under every such assignment. When `α` is
infinite these are exactly the substitution instances of propositional tautologies. -/
def IsTautology (φ : Formula α) : Prop :=
  ∀ v : Formula α → Prop, boolEval v φ

/-- 1.2 The theorems of the normal modal system with extra axioms `Ax`: tautological instances,
the distribution schema `□(φ → ψ) → (□φ → □ψ)` and the members of `Ax`, closed under modus ponens
and necessitation. -/
inductive Proves (Ax : Set (Formula α)) : Formula α → Prop
  | taut {φ : Formula α} : IsTautology φ → Proves Ax φ
  | distrib (φ ψ : Formula α) : Proves Ax (imp (box (imp φ ψ)) (imp (box φ) (box ψ)))
  | ax {φ : Formula α} : φ ∈ Ax → Proves Ax φ
  | mp {φ ψ : Formula α} : Proves Ax (imp φ ψ) → Proves Ax φ → Proves Ax ψ
  | nec {φ : Formula α} : Proves Ax φ → Proves Ax (box φ)

/-- 1.2 Derivability of `φ` from the hypotheses `Γ` in the system with extra axioms `Ax`: for some
finite list `ψ₁, …, ψₙ` of members of `Γ`, the formula `ψ₁ → (ψ₂ → ⋯ (ψₙ → φ))` is a theorem. -/
def Derives (Ax Γ : Set (Formula α)) (φ : Formula α) : Prop :=
  ∃ l : List (Formula α), (∀ ψ ∈ l, ψ ∈ Γ) ∧ Proves Ax (l.foldr imp φ)

/-- 1.3 The schema `T`: all formulas `□φ → φ`. -/
def axT : Set (Formula α) :=
  Set.range fun φ => imp (box φ) φ

/-- 1.3 The schema `4`: all formulas `□φ → □□φ`. -/
def ax4 : Set (Formula α) :=
  Set.range fun φ => imp (box φ) (box (box φ))

/-- 1.3 The schema `B`: all formulas `φ → □◇φ`. -/
def axB : Set (Formula α) :=
  Set.range fun φ => imp φ (box (dia φ))

/-- 1.3 The schema `5`: all formulas `◇φ → □◇φ`. -/
def ax5 : Set (Formula α) :=
  Set.range fun φ => imp (dia φ) (box (dia φ))

/-- 1.3 The Geach formula `◇ʰ□ⁱφ → □ʲ◇ᵏφ`. -/
def geachFormula (h i j k : ℕ) (φ : Formula α) : Formula α :=
  imp (dia^[h] (box^[i] φ)) (box^[j] (dia^[k] φ))

/-- 1.3 The Geach schema with parameters `(h, i, j, k)`: all Geach formulas `◇ʰ□ⁱφ → □ʲ◇ᵏφ`. -/
def geachAxioms (h i j k : ℕ) : Set (Formula α) :=
  Set.range (geachFormula h i j k)

/-- 1.3 The axioms of the system generated by the Geach schemas whose parameters lie in `S`. -/
def geachSystemAxioms (S : Set (ℕ × ℕ × ℕ × ℕ)) : Set (Formula α) :=
  ⋃ t ∈ S, geachAxioms t.1 t.2.1 t.2.2.1 t.2.2.2

/-- 1.3 The six classical normal systems: `K`, `T`, `K4`, `S4`, the Brouwerian system `KTB` and
`S5`. -/
inductive ModalSystem
  | K
  | T
  | K4
  | S4
  | KTB
  | S5

/-- 1.3 The extra axioms of each system: none for `K`, `T` for `T`, `4` for `K4`, `T` and `4` for
`S4`, `T` and `B` for `KTB`, and `T` and `5` for `S5`. -/
def ModalSystem.axioms : ModalSystem → Set (Formula α)
  | .K => ∅
  | .T => axT
  | .K4 => ax4
  | .S4 => axT ∪ ax4
  | .KTB => axT ∪ axB
  | .S5 => axT ∪ ax5

/-- 1.4 `S5` is also axiomatized by `T`, `B` and `4`: the systems `KT5` and `KTB4` have the same
theorems. -/
theorem proves_axT_union_ax5_iff (φ : Formula α) :
    Proves (axT ∪ ax5) φ ↔ Proves (axT ∪ axB ∪ ax4) φ := by
  sorry

/-! ## Layer 2: Kripke semantics, correspondence and soundness -/

/-- 2.1 Truth of a formula at a world `w` of the Kripke model with accessibility relation `R` and
valuation `V`. -/
def Sat {W : Type v} (R : W → W → Prop) (V : α → Set W) : W → Formula α → Prop
  | w, var p => w ∈ V p
  | _, bot => False
  | w, imp φ ψ => Sat R V w φ → Sat R V w ψ
  | w, box φ => ∀ w', R w w' → Sat R V w' φ

/-- 2.1 Validity of a formula on the frame `R`: truth at every world under every valuation. -/
def FrameValid {W : Type v} (R : W → W → Prop) (φ : Formula α) : Prop :=
  ∀ (V : α → Set W) (w : W), Sat R V w φ

/-- 2.1 Local consequence over a class `C` of frames: at every world of every model on a frame of
`C`, if every member of `Γ` is true then `φ` is true. -/
def Entails (C : (W : Type u) → (W → W → Prop) → Prop) (Γ : Set (Formula α))
    (φ : Formula α) : Prop :=
  ∀ (W : Type u) (R : W → W → Prop), C W R → ∀ (V : α → Set W) (w : W),
    (∀ ψ ∈ Γ, Sat R V w ψ) → Sat R V w φ

/-- 2.2 The `n`-fold relational power of `R`: `relPow R 0` is equality and
`relPow R (n + 1) x z` holds when `R x y` and `relPow R n y z` for some `y`. -/
def relPow {W : Type v} (R : W → W → Prop) : ℕ → W → W → Prop
  | 0 => Eq
  | n + 1 => Relation.Comp R (relPow R n)

/-- 2.2 `(h, i, j, k)`-convergence: if `x Rʰ y` and `x Rʲ z` then `y Rⁱ u` and `z Rᵏ u` for some
`u`. -/
def Convergent {W : Type v} (h i j k : ℕ) (R : W → W → Prop) : Prop :=
  ∀ x y z, relPow R h x y → relPow R j x z → ∃ u, relPow R i y u ∧ relPow R k z u

/-- 2.2 The frame correspondence of Lemmon and Scott, for the characteristic formula: the Geach
formula `◇ʰ□ⁱp → □ʲ◇ᵏp` of a variable `p` is valid on a frame if and only if the frame is
`(h, i, j, k)`-convergent. -/
theorem frameValid_geachFormula_var_iff {W : Type v} (R : W → W → Prop) (h i j k : ℕ) (p : α) :
    FrameValid R (geachFormula h i j k (var p)) ↔ Convergent h i j k R := by
  sorry

/-- 2.2 The frame correspondence for the schema: when there is at least one variable, every
instance of the Geach schema is valid on a frame if and only if the frame is
`(h, i, j, k)`-convergent. -/
theorem forall_frameValid_geachAxioms_iff [Nonempty α] {W : Type v} (R : W → W → Prop)
    (h i j k : ℕ) :
    (∀ φ ∈ (geachAxioms h i j k : Set (Formula α)), FrameValid R φ) ↔ Convergent h i j k R := by
  sorry

/-- 2.3 Local consequence over equivalence relations coincides with local consequence over
universal relations. -/
theorem entails_equivalence_iff_universal (Γ : Set (Formula α)) (φ : Formula α) :
    Entails (fun _ R => Equivalence R) Γ φ ↔ Entails (fun _ R => ∀ x y, R x y) Γ φ := by
  sorry

/-- 2.3 Universality is not modally definable: no formula is valid on exactly the frames whose
relation is universal. -/
theorem not_exists_frameValid_iff_universal :
    ¬ ∃ φ : Formula α, ∀ (W : Type u) (R : W → W → Prop), FrameValid R φ ↔ ∀ x y, R x y := by
  sorry

/-- 2.4 Strong soundness: if every extra axiom is valid on every frame of the class `C`, then
every formula derivable from `Γ` is a local consequence of `Γ` over `C`. -/
theorem entails_of_derives {C : (W : Type u) → (W → W → Prop) → Prop} {Ax : Set (Formula α)}
    (hAx : ∀ (W : Type u) (R : W → W → Prop), C W R → ∀ φ ∈ Ax, FrameValid R φ)
    {Γ : Set (Formula α)} {φ : Formula α} (h : Derives Ax Γ φ) : Entails C Γ φ := by
  sorry

/-- 2.4 The frame class of each system: all frames for `K`, reflexive frames for `T`, transitive
frames for `K4`, reflexive transitive frames for `S4`, reflexive symmetric frames for `KTB`, and
equivalence relations for `S5`. -/
def ModalSystem.frameClass : ModalSystem → (W : Type v) → (W → W → Prop) → Prop
  | .K, _, _ => True
  | .T, _, R => ∀ x, R x x
  | .K4, _, R => ∀ x y z, R x y → R y z → R x z
  | .S4, _, R => (∀ x, R x x) ∧ ∀ x y z, R x y → R y z → R x z
  | .KTB, _, R => (∀ x, R x x) ∧ ∀ x y, R x y → R y x
  | .S5, _, R => Equivalence R

/-! ## Layer 3: canonical models and strong completeness -/

/-- 3.1 A set of formulas is consistent in the system with extra axioms `Ax` when `⊥` is not
derivable from it. -/
def Consistent (Ax Γ : Set (Formula α)) : Prop :=
  ¬ Derives Ax Γ bot

/-- 3.1 A maximal consistent set: consistent, and containing `φ` or `¬φ` for every formula `φ`. -/
def IsMaxConsistent (Ax Γ : Set (Formula α)) : Prop :=
  Consistent Ax Γ ∧ ∀ φ, φ ∈ Γ ∨ neg φ ∈ Γ

/-- 3.1 Lindenbaum's lemma, for an arbitrary type of variables: every consistent set extends to a
maximal consistent set. -/
theorem exists_isMaxConsistent_of_consistent {Ax Γ : Set (Formula α)} (hΓ : Consistent Ax Γ) :
    ∃ Δ, Γ ⊆ Δ ∧ IsMaxConsistent Ax Δ := by
  sorry

/-- 3.2 The worlds of the canonical model: the maximal consistent sets. -/
def CanonicalWorld (Ax : Set (Formula α)) : Type u :=
  {Γ : Set (Formula α) // IsMaxConsistent Ax Γ}

/-- 3.2 The canonical relation: `Γ` sees `Δ` when `φ ∈ Δ` for every `□φ ∈ Γ`. -/
def canonicalRel (Ax : Set (Formula α)) (Γ Δ : CanonicalWorld Ax) : Prop :=
  ∀ φ, box φ ∈ Γ.1 → φ ∈ Δ.1

/-- 3.2 The canonical valuation: a variable is true exactly at the worlds containing it. -/
def canonicalVal (Ax : Set (Formula α)) (p : α) : Set (CanonicalWorld Ax) :=
  {Γ | var p ∈ Γ.1}

/-- 3.2 The truth lemma: in the canonical model a formula is true at a world exactly when it
belongs to it. -/
theorem sat_canonical_iff (Ax : Set (Formula α)) (Γ : CanonicalWorld Ax) (φ : Formula α) :
    Sat (canonicalRel Ax) (canonicalVal Ax) Γ φ ↔ φ ∈ Γ.1 := by
  sorry

/-- 3.3 Canonicity of the Geach schemas (Lemmon and Scott): if every instance of the Geach schema
`(h, i, j, k)` is a theorem, the canonical relation is `(h, i, j, k)`-convergent. -/
theorem convergent_canonicalRel {Ax : Set (Formula α)} {h i j k : ℕ}
    (hG : geachAxioms h i j k ⊆ {φ | Proves Ax φ}) : Convergent h i j k (canonicalRel Ax) := by
  sorry

/-- 3.4 Strong soundness and completeness of every system generated by Geach schemas, with respect
to the frames that are convergent for each of its parameter tuples. -/
theorem derives_geachSystemAxioms_iff (S : Set (ℕ × ℕ × ℕ × ℕ)) (Γ : Set (Formula α))
    (φ : Formula α) :
    Derives (geachSystemAxioms S) Γ φ ↔
      Entails (fun _ R => ∀ t ∈ S, Convergent t.1 t.2.1 t.2.2.1 t.2.2.2 R) Γ φ := by
  sorry

/-- 3.4 Strong soundness and completeness of `K`, `T`, `K4`, `S4`, `KTB` and `S5` with respect to
their frame classes. -/
theorem ModalSystem.derives_iff_entails (L : ModalSystem) (Γ : Set (Formula α)) (φ : Formula α) :
    Derives L.axioms Γ φ ↔ Entails L.frameClass Γ φ := by
  sorry

/-! ## Layer 4: filtrations and the finite model property -/

/-- 4.1 A set of formulas is closed under subformulas. -/
def IsSubformulaClosed (Φ : Set (Formula α)) : Prop :=
  (∀ φ ψ, imp φ ψ ∈ Φ → φ ∈ Φ ∧ ψ ∈ Φ) ∧ ∀ φ, box φ ∈ Φ → φ ∈ Φ

/-- 4.1 Two worlds of a model are equivalent through `Φ` when they agree on every member of `Φ`. -/
def agreeSetoid {W : Type v} (R : W → W → Prop) (V : α → Set W) (Φ : Set (Formula α)) :
    Setoid W where
  r x y := ∀ φ ∈ Φ, (Sat R V x φ ↔ Sat R V y φ)
  iseqv :=
    ⟨fun _ _ _ => Iff.rfl, fun hxy φ hφ => (hxy φ hφ).symm,
      fun hxy hyz φ hφ => (hxy φ hφ).trans (hyz φ hφ)⟩

/-- 4.1 The valuation of a filtration: a variable is true at a class when it is true at some
member of the class. -/
def filtrationVal {W : Type v} (R : W → W → Prop) (V : α → Set W) (Φ : Set (Formula α))
    (p : α) : Set (Quotient (agreeSetoid R V Φ)) :=
  Quotient.mk _ '' V p

/-- 4.1 A relation `R'` on the classes is a filtration of `R` through `Φ` when it contains the
image of `R`, and `R' [x] [y]` with `□φ ∈ Φ` true at `x` forces `φ` true at `y`. -/
def IsFiltration {W : Type v} (R : W → W → Prop) (V : α → Set W) (Φ : Set (Formula α))
    (R' : Quotient (agreeSetoid R V Φ) → Quotient (agreeSetoid R V Φ) → Prop) : Prop :=
  (∀ x y, R x y → R' (Quotient.mk _ x) (Quotient.mk _ y)) ∧
    ∀ x y, R' (Quotient.mk _ x) (Quotient.mk _ y) →
      ∀ φ, box φ ∈ Φ → Sat R V x (box φ) → Sat R V y φ

/-- 4.1 The filtration theorem: through a set closed under subformulas, every filtration keeps
the truth value of every member of the set at every world. -/
theorem sat_filtration_iff {W : Type v} {R : W → W → Prop} {V : α → Set W}
    {Φ : Set (Formula α)} (hΦ : IsSubformulaClosed Φ)
    {R' : Quotient (agreeSetoid R V Φ) → Quotient (agreeSetoid R V Φ) → Prop}
    (hR' : IsFiltration R V Φ R') {φ : Formula α} (hφ : φ ∈ Φ) (x : W) :
    Sat R' (filtrationVal R V Φ) (Quotient.mk _ x) φ ↔ Sat R V x φ := by
  sorry

/-- 4.1 Through a finite set `Φ` there are finitely many classes, at most `2 ^ |Φ|`. -/
theorem card_quotient_agreeSetoid_le {W : Type v} (R : W → W → Prop) (V : α → Set W)
    {Φ : Set (Formula α)} (hΦ : Φ.Finite) :
    Finite (Quotient (agreeSetoid R V Φ)) ∧
      Nat.card (Quotient (agreeSetoid R V Φ)) ≤ 2 ^ Φ.ncard := by
  sorry

/-- 4.3 The finite model property with a size bound: a formula is a theorem of `K`, `T`, `K4`,
`S4`, `KTB` or `S5` if and only if it is valid on every frame of the system's class with at most
`2 ^ s` worlds, where `s` is the number of subformulas of the formula. -/
theorem ModalSystem.proves_iff_forall_fin [DecidableEq α] (L : ModalSystem) (φ : Formula α) :
    Proves L.axioms φ ↔
      ∀ n ≤ 2 ^ (subformulas φ).card, ∀ R : Fin n → Fin n → Prop,
        L.frameClass (Fin n) R → FrameValid R φ := by
  sorry

/-- 4.3 `S5` is the logic of finite universal frames: a formula is a theorem of `S5` if and only
if it is valid on the universal frame with `n` worlds for every `n ≤ 2 ^ s`, where `s` is the
number of subformulas of the formula. -/
theorem proves_S5_iff_forall_fin_universal [DecidableEq α] (φ : Formula α) :
    Proves (ModalSystem.S5.axioms) φ ↔
      ∀ n ≤ 2 ^ (subformulas φ).card, FrameValid (fun _ _ : Fin n => True) φ := by
  sorry

end TauCetiRoadmap.ModalLogicCompleteness
