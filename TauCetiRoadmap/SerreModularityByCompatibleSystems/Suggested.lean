import Mathlib
import TauCeti.NumberTheory.ModularForms.Newforms.Newform

/-!
# Serre's modularity conjecture by compatible systems: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is
`README.md`. This file states the roadmap's headline theorems against the pinned APIs;
discharging them finishes neither a layer nor the roadmap.

The statements are qualitative Serre modularity, the level-one case in some weight at least two,
the finiteness of level-one representations, and odd Artin weight-one modularity. The definitions
are the arithmetic interfaces of ClassicalSerreModularity: `GQ`, `IntBar`, `IsFrobAt` and
`IsUnramifiedAt` repeat its declarations unchanged, and the residual and newform interfaces, which
it specifies in words, are declared here. Attachment is expressed on Tau Ceti's
`HeckeRing.GL2.Newform` by its Fourier coefficients, nebentypus and arithmetic Frobenius, over
Mathlib's actual absolute Galois group, algebraic integers, inertia, complex conjugations and
matrix representations.

The exact Serre-weight, conductor and character refinements of the strong form in S6, among them
the weight `k(ρ̄)` of the level-one case, require the residual Artin conductor and Serre's local
weight recipe, neither supplied at the pins. The
finite-flat weight-two case additionally requires the coefficient-independent finite-flat residual
predicate and its group-scheme model. The lifting theorems, the compatible systems and the steps
of the chain require compatible-system carriers, local period conditions and deformation problems.
The Katz weight-one step, geometric reduction theorem and descent require geometric modular forms,
their integral spaces and Hecke actions. These results are specified in the README, without
compiled signatures here. The exact-conductor Artin refinement also requires the Artin conductor;
the weight-one statement here identifies the representation by all good-prime traces and
determinants, without naming a characteristic-zero attachment absent at the pins.
-/

noncomputable section

namespace TauCetiRoadmap.SerreModularityByCompatibleSystems

open NumberField
open HeckeRing.GL2 (Newform)

/-! ## Arithmetic carriers and conventions -/

/-- The absolute Galois group `G_ℚ = Gal(ℚ̄/ℚ)`, with Mathlib's Krull topology. As in
EllipticCurveModularity, the body of `Field.absoluteGaloisGroup ℚ` is unfolded so that Tau Ceti's
actions on algebraic integers and elliptic torsion apply directly. -/
abbrev GQ : Type := AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ

/-- The ring `ℤ̄` of algebraic integers, on which `G_ℚ` acts. -/
abbrev IntBar : Type := 𝓞 (AlgebraicClosure ℚ)

/-- `𝔽̄_p`, the coefficient field of residual representations. -/
abbrev FpBar (p : ℕ) [Fact p.Prime] : Type := AlgebraicClosure (ZMod p)

/-- `σ` is an arithmetic Frobenius element at some prime of `ℤ̄` containing `r`: `σ x ≡ x ^ r`
modulo that prime for every algebraic integer `x`. For a prime number `r` these are the elements
`Frob_r` of the sources, for all choices of a prime above `r`. -/
def IsFrobAt (σ : GQ) (r : ℕ) : Prop :=
  ∃ Q : Ideal IntBar, Q.IsPrime ∧ (r : IntBar) ∈ Q ∧ IsArithFrobAt ℤ σ Q

/-- `ρ` is unramified at `r`: trivial on the inertia group of every prime of `ℤ̄` containing `r`. -/
def IsUnramifiedAt {H : Type*} [Group H] (ρ : GQ →* H) (r : ℕ) : Prop :=
  ∀ Q : Ideal IntBar, Q.IsPrime → (r : IntBar) ∈ Q → Q.inertia GQ ≤ ρ.ker

/-- `ρ` is odd: `det ρ(c) = −1` for every complex conjugation `c`, that is every `c` which some
embedding `φ : ℚ̄ → ℂ` carries to complex conjugation. All such `c` are conjugate in `G_ℚ`. -/
def IsOdd {k : Type*} [CommRing k] (ρ : GQ →* GL (Fin 2) k) : Prop :=
  ∀ (φ : AlgebraicClosure ℚ →+* ℂ) (c : GQ), ComplexEmbedding.IsConj φ c →
    Matrix.det (ρ c : Matrix (Fin 2) (Fin 2) k) = -1

/-- Absolute irreducibility in Burnside's form: the matrices `ρ(g)` span `M₂(k)`. This is
equivalent to irreducibility over every extension field of `k`. -/
def IsAbsIrreducible {G k : Type*} [Group G] [Field k] (ρ : G →* GL (Fin 2) k) : Prop :=
  Submodule.span k (Set.range fun g : G => (ρ g : Matrix (Fin 2) (Fin 2) k)) = ⊤

/-- A residual representation of S-type: continuous (open kernel), odd and absolutely
irreducible. -/
def IsSType {k : Type*} [Field k] (ρ : GQ →* GL (Fin 2) k) : Prop :=
  IsOpen (ρ.ker : Set GQ) ∧ IsOdd ρ ∧ IsAbsIrreducible ρ

/-- The Fourier coefficient at infinity of a bundled newform. -/
def coeff {N : ℕ} [NeZero N] {k : ℤ} (f : Newform N k) (n : ℕ) : ℂ :=
  (UpperHalfPlane.qExpansion 1 f.toCuspForm).coeff n

/-- The subring generated by all Fourier coefficients and nebentypus values. -/
def coefficientRing {N : ℕ} [NeZero N] {k : ℤ} (f : Newform N k) : Subring ℂ :=
  Subring.closure (Set.range (coeff f) ∪ Set.range (fun n : ℕ => f.dirichletLift n))

/-- Coefficient-defined residual attachment: one coefficient reduction (a ring map into a field
of characteristic `p`, so it kills `p`) gives arithmetic Frobenius traces, determinants and
unramifiedness away from the level and characteristic, as specified by
AlgebraicModularFormsAndSerreWeights §7.5. -/
def ArisesFrom {p N : ℕ} [Fact p.Prime] [NeZero N] {k : ℤ}
    (ρ : GQ →* GL (Fin 2) (FpBar p)) (f : Newform N k) : Prop :=
  ∃ φ : coefficientRing f →+* FpBar p,
    ∀ ℓ : ℕ, ℓ.Prime → ¬ ℓ ∣ p * N → IsUnramifiedAt ρ ℓ ∧
      ∀ σ : GQ, IsFrobAt σ ℓ →
        Matrix.trace (ρ σ : Matrix (Fin 2) (Fin 2) (FpBar p)) =
          φ ⟨coeff f ℓ, Subring.subset_closure (Or.inl ⟨ℓ, rfl⟩)⟩ ∧
        Matrix.det (ρ σ : Matrix (Fin 2) (Fin 2) (FpBar p)) =
          φ ⟨f.dirichletLift ℓ, Subring.subset_closure (Or.inr ⟨ℓ, rfl⟩)⟩ *
            (ℓ : FpBar p) ^ (k.toNat - 1)

/-- The matrix action on the existing two-dimensional module. -/
def toRepresentation {G R : Type*} [Group G] [CommRing R]
    (ρ : G →* GL (Fin 2) R) : Representation R G (Fin 2 → R) :=
  (Units.coeHom _).comp (Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp ρ)

/-! ## Layer S5: Qualitative Serre modularity -/

/-- `S5/qualitative-serre-theorem`:
every continuous, odd, absolutely irreducible residual representation is attached to a
classical newform of weight at least two. -/
theorem serre_conjecture_weak {p : ℕ} [Fact p.Prime]
    (ρ : GQ →* GL (Fin 2) (FpBar p)) (hρ : IsSType ρ) :
    ∃ (N : ℕ) (_ : NeZero N) (k : ℤ) (f : Newform N k), 2 ≤ k ∧ ArisesFrom ρ f := by
  sorry

/-! ## Layer S6: The level-one case -/

/-- `S6/level-one-case`: a representation unramified
outside its characteristic is attached to a level-one newform of weight at least two. -/
theorem khare_level_one {p : ℕ} [Fact p.Prime]
    (ρ : GQ →* GL (Fin 2) (FpBar p)) (hρ : IsSType ρ)
    (hunram : ∀ ℓ : ℕ, ℓ.Prime → ℓ ≠ p → IsUnramifiedAt ρ ℓ) :
    ∃ (k : ℤ) (f : Newform 1 k),
      2 ≤ k ∧ ArisesFrom ρ f := by
  sorry

/-- `S6/finiteness-of-level-one-representations`: finitely many isomorphism classes of continuous,
semisimple, odd representations unramified outside the coefficient characteristic. -/
theorem finite_level_one_semisimple (p : ℕ) [Fact p.Prime] :
    ∃ S : Set (GQ →* GL (Fin 2) (FpBar p)), S.Finite ∧
      ∀ ρ : GQ →* GL (Fin 2) (FpBar p), IsOpen (ρ.ker : Set GQ) → IsOdd ρ →
        Representation.IsSemisimpleRepresentation (toRepresentation ρ) →
        (∀ r, r.Prime → r ≠ p → IsUnramifiedAt ρ r) →
        ∃ τ ∈ S, ∃ B : GL (Fin 2) (FpBar p), ∀ g, τ g = B * ρ g * B⁻¹ := by
  sorry

/-! ## Layer S7: Artin weight-one modularity -/

/-- `S7/odd-artin-weight-one-modularity`: every odd irreducible Artin representation
is attached to a weight-one newform, including its determinant character and all good-prime
traces. Open kernel expresses finite-image continuity on the Krull Galois group. -/
theorem weight_one_artin_modularity (ρ : GQ →* GL (Fin 2) ℂ)
    (hcont : IsOpen (ρ.ker : Set GQ)) (hodd : IsOdd ρ) (hirr : IsAbsIrreducible ρ) :
    ∃ (N : ℕ) (_ : NeZero N) (f : Newform N 1),
      ∀ ℓ : ℕ, ℓ.Prime → ¬ ℓ ∣ N → IsUnramifiedAt ρ ℓ ∧
        ∀ σ : GQ, IsFrobAt σ ℓ →
          coeff f ℓ = Matrix.trace (ρ σ : Matrix (Fin 2) (Fin 2) ℂ) ∧
          f.dirichletLift ℓ = Matrix.det (ρ σ : Matrix (Fin 2) (Fin 2) ℂ) := by
  sorry

end TauCetiRoadmap.SerreModularityByCompatibleSystems

end
