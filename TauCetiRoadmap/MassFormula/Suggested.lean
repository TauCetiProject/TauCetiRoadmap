/-!
# Totally ramified extensions of a local field: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is
`README.md`. The statements here suggest Lean forms for particular milestones, so that
contributors and reviewers converge on names and signatures; discharging all of them
finishes neither a layer nor the roadmap.

Every target of the roadmap is a theorem of the pinned Tau Ceti (README, *Exact supplier
contracts*, *From Tau Ceti*). This file states the headline targets of Layers 0–4 on Tau Ceti's
objects — `TauCeti.totallyRamifiedOfDegree`, `IntermediateField.IsTotallyRamified`,
`IntermediateField.discriminantExponent`, `IntermediateField.wildExponent`,
`TauCeti.IsRepresentativeSet`, `TauCeti.eisensteinSet`, `TauCeti.integerBox`,
`TauCeti.Polynomial.monicOfCoeff` and `IntermediateField.rootCount` — and closes each by the
library's theorem, so that the file certifies, at the pin, that Tau Ceti realizes the roadmap. It
defines nothing of its own and admits nothing.

The definitions are junk-tolerant: for `L` infinite over `K`, or for `n = 0`, they take junk
values, which is why the statements carry `0 < n` and membership in
`totallyRamifiedOfDegree K n`.
-/

@[expose] public section

open ValuativeRel MeasureTheory
open scoped ENNReal IntermediateField

namespace TauCetiRoadmap.MassFormula

open TauCeti TauCeti.Polynomial

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K]
  [IsNonarchimedeanLocalField K]

/-! ## Layer 0: the counting invariants -/

/-- **0.1** Every member of `σ_K(n)` is generated by a root of a monic Eisenstein polynomial of
degree `n`. -/
theorem exists_eisenstein_generator {n : ℕ} {L : IntermediateField K (SeparableClosure K)}
    (hL : L ∈ totallyRamifiedOfDegree K n) :
    ∃ (f : Polynomial 𝒪[K]) (x : SeparableClosure K), f.Monic ∧ f.IsEisensteinAt 𝓂[K] ∧
      f.natDegree = n ∧ Polynomial.aeval x (f.map (algebraMap 𝒪[K] K)) = 0 ∧ K⟮x⟯ = L :=
  exists_eisenstein_generator_of_mem_totallyRamifiedOfDegree hL

/-- **0.2** Conversely, a root of a degree-`n` Eisenstein polynomial generates a member of
`σ_K(n)`. -/
theorem adjoin_mem_totallyRamifiedOfDegree {n : ℕ} {f : Polynomial 𝒪[K]}
    (hf : f.IsEisensteinAt 𝓂[K]) (hdeg : f.natDegree = n) {x : SeparableClosure K}
    (hx : Polynomial.aeval x (f.map (algebraMap 𝒪[K] K)) = 0) :
    K⟮x⟯ ∈ totallyRamifiedOfDegree K n :=
  adjoin_mem_totallyRamifiedOfDegree_of_eisenstein hf hdeg hx

/-- **0.3** Membership in `σ_K(n)` is invariant under `K`-isomorphism. -/
theorem mem_totallyRamifiedOfDegree_of_algEquiv {n : ℕ}
    {L M : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n)
    (e : L ≃ₐ[K] M) : M ∈ totallyRamifiedOfDegree K n :=
  TauCeti.mem_totallyRamifiedOfDegree_of_algEquiv hL e

/-- **0.4** `n − 1 ≤ d(L)` on `σ_K(n)`, which makes `c(L) = d(L) + 1 − n` faithful. -/
theorem sub_one_le_discriminantExponent {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    n - 1 ≤ L.discriminantExponent :=
  IntermediateField.sub_one_le_discriminantExponent hL

/-- **0.5** The tame criterion: `c(L) = 0` exactly when `n` is prime to the residue
characteristic. -/
theorem wildExponent_eq_zero_iff {n : ℕ} {L : IntermediateField K (SeparableClosure K)}
    (hL : L ∈ totallyRamifiedOfDegree K n) :
    L.wildExponent = 0 ↔ ¬ ringChar 𝓀[K] ∣ n :=
  IntermediateField.wildExponent_eq_zero_iff hL

/-- **0.6** `c` is an invariant of the `K`-isomorphism class, junk case included. -/
theorem wildExponent_eq_of_algEquiv {L M : IntermediateField K (SeparableClosure K)}
    (e : L ≃ₐ[K] M) : L.wildExponent = M.wildExponent :=
  IntermediateField.wildExponent_eq_of_algEquiv e

/-- **0.7** The box corollary of the power-basis orthogonality: at an Eisenstein generator `ξ`,
the ball `addVal ≥ r` is, in power-basis coordinates, the box with `i`-th factor
`𝓂[K] ^ ((r − i) ⌈/⌉ n)`. -/
theorem le_addVal_sum_eisenstein_powerBasis_iff {L : Type*} [Field L] [ValuativeRel L]
    [TopologicalSpace L] [IsNonarchimedeanLocalField L] [Algebra K L] [ValuativeExtension K L]
    (f : Polynomial 𝒪[K]) (hf : f.IsEisensteinAt 𝓂[K]) (ξ : 𝒪[L])
    (hroot : (f.map (algebraMap 𝒪[K] 𝒪[L])).IsRoot ξ) (hgen : K⟮(ξ : L)⟯ = ⊤)
    (c : Fin f.natDegree → 𝒪[K]) (r : ℕ) :
    (r : ℕ∞) ≤ IsDiscreteValuationRing.addVal 𝒪[L]
        (∑ i, algebraMap 𝒪[K] 𝒪[L] (c i) * ξ ^ (i : ℕ)) ↔
      ∀ i : Fin f.natDegree, c i ∈ 𝓂[K] ^ ((r - (i : ℕ)) ⌈/⌉ f.natDegree) :=
  Polynomial.le_addVal_sum_eisenstein_powerBasis_iff f hf ξ hroot hgen c r

/-! ## Layer 1: quantitative Newton lifting over a discrete valuation ring -/

/-- **1.1** Newton iteration with an estimate, over a Henselian discrete valuation ring. -/
theorem exists_isRoot {A : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] (F : Polynomial A) (y₀ : A)
    (hlt : IsDiscreteValuationRing.addVal A (F.derivative.eval y₀) +
        IsDiscreteValuationRing.addVal A (F.derivative.eval y₀) <
      IsDiscreteValuationRing.addVal A (F.eval y₀)) :
    ∃ z : A, F.IsRoot z ∧
      IsDiscreteValuationRing.addVal A (F.eval y₀) =
        IsDiscreteValuationRing.addVal A (F.derivative.eval y₀) +
          IsDiscreteValuationRing.addVal A (z - y₀) :=
  Polynomial.exists_isRoot_addVal_eval_eq F y₀ hlt

/-- **1.2** Separation of roots: a root closer to a root `z` than the order of `F'(z)` is `z`.
No completeness is used. -/
theorem eq_of_isRoot_of_addVal_lt {A : Type*} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] (F : Polynomial A) {z z' : A} (hz : F.IsRoot z)
    (hz' : F.IsRoot z')
    (hlt : IsDiscreteValuationRing.addVal A (F.derivative.eval z) <
      IsDiscreteValuationRing.addVal A (z' - z)) :
    z' = z :=
  Polynomial.eq_of_isRoot_of_addVal_lt F hz hz' hlt

/-- **1.3** Local constancy of the root count, uniformly over the finite subextensions of
`SeparableClosure K`, in particular over `σ_K(n)`. -/
theorem card_aroots_eq {f : Polynomial 𝒪[K]} (hf : f.Monic)
    (hfsep : (f.map (algebraMap 𝒪[K] K)).Separable) :
    ∃ T : ℕ, 0 < T ∧ ∀ (M : IntermediateField K (SeparableClosure K)) [Module.Finite K M]
      (g : Polynomial 𝒪[K]), g.Monic → (∀ i, g.coeff i - f.coeff i ∈ 𝓂[K] ^ T) →
      ((g.map (algebraMap 𝒪[K] K)).aroots M).card =
        ((f.map (algebraMap 𝒪[K] K)).aroots M).card :=
  exists_card_aroots_eq (SeparableClosure K) hf hfsep

/-! ## Layer 2: the lattice index and the Haar scaling law -/

/-- **2.1** The index of an image lattice over a discrete valuation ring with determinant
associated to `ϖ ^ k` is `q ^ k`. -/
theorem card_quotient_range {R ι : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Fintype ι] [DecidableEq ι] {A : Matrix ι ι R} {ϖ : R} (hϖ : Irreducible ϖ) {k : ℕ}
    (hk : Associated A.det (ϖ ^ k)) :
    Nat.card ((ι → R) ⧸ LinearMap.range A.mulVecLin) =
      Nat.card (IsLocalRing.ResidueField R) ^ k :=
  Matrix.card_quotient_range_mulVecLin_eq_pow hϖ hk

/-- **2.2** The Haar scaling law over a local field: `μ (A '' s) = q ^ (−k) · μ s`. -/
theorem addHaar_image_mulVec {ι : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace (ι → K)]
    [BorelSpace (ι → K)] (μ : Measure (ι → K)) [μ.IsAddHaarMeasure] [μ.Regular]
    {A : Matrix ι ι 𝒪[K]} {ϖ : 𝒪[K]} (hϖ : Irreducible ϖ) {k : ℕ}
    (hk : Associated A.det (ϖ ^ k)) (s : Set (ι → K)) :
    μ ((A.map (algebraMap 𝒪[K] K)).mulVec '' s) = 1 / (Nat.card 𝓀[K] : ℝ≥0∞) ^ k * μ s :=
  Measure.addHaar_image_mulVec μ hϖ hk s

/-! ## Layer 3: the Eisenstein region and the root count -/

/-- **3.1** The Eisenstein region is the set of Eisenstein polynomials. -/
theorem mem_eisensteinSet_iff {n : ℕ} {a : Fin n → K} :
    a ∈ eisensteinSet K n ↔
      ∃ f : Polynomial 𝒪[K], f.map (algebraMap 𝒪[K] K) = monicOfCoeff a ∧
        f.IsEisensteinAt 𝓂[K] :=
  mem_eisensteinSet_iff_exists_isEisensteinAt

/-- **3.2** The measure of the Eisenstein region is `q ^ (−n) · (1 − q ^ (−1))`. -/
theorem measure_eisensteinSet {n : ℕ} (hn : 0 < n) [MeasurableSpace (Fin n → K)]
    [BorelSpace (Fin n → K)] (μ : Measure (Fin n → K)) [μ.IsAddLeftInvariant]
    (hμ : μ (integerBox K (Fin n)) = 1) :
    μ (eisensteinSet K n) =
      1 / (Nat.card 𝓀[K] : ℝ≥0∞) ^ n * (1 - 1 / (Nat.card 𝓀[K] : ℝ≥0∞)) :=
  TauCeti.measure_eisensteinSet hn μ hμ

/-- **3.3** Almost every Eisenstein polynomial is separable. -/
theorem ae_separable {n : ℕ} (hn : 0 < n) [MeasurableSpace (Fin n → K)]
    [BorelSpace (Fin n → K)] (μ : Measure (Fin n → K)) [μ.IsAddHaarMeasure] :
    ∀ᵐ a ∂μ.restrict (eisensteinSet K n), (monicOfCoeff a).Separable :=
  ae_separable_monicOfCoeff_restrict_eisensteinSet hn μ

/-- **3.4** Almost everywhere on the Eisenstein region, the root counts over `σ_K(n)` sum to `n`.
No normalization of the Haar measure is needed. -/
theorem tsum_rootCount {n : ℕ} (hn : 0 < n) [MeasurableSpace (Fin n → K)]
    [BorelSpace (Fin n → K)] (μ : Measure (Fin n → K)) [μ.IsAddHaarMeasure] :
    ∀ᵐ a ∂μ.restrict (eisensteinSet K n),
      ∑' L : totallyRamifiedOfDegree K n, (L.1.rootCount a : ℝ≥0∞) = n :=
  ae_tsum_rootCount_eq hn μ

/-- **3.5** Almost-everywhere measurability of the root count on the Eisenstein region. -/
theorem aemeasurable_rootCount {n : ℕ} [MeasurableSpace (Fin n → K)]
    [OpensMeasurableSpace (Fin n → K)] (μ : Measure (Fin n → K))
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    AEMeasurable (fun a ↦ (L.rootCount a : ℝ≥0∞)) (μ.restrict (eisensteinSet K n)) :=
  aemeasurable_rootCount_restrict_eisensteinSet μ hL

/-- **3.6** `σ_K(n)` is countable, proved without the mass formula. -/
theorem countable_totallyRamifiedOfDegree {n : ℕ} (hn : 0 < n) :
    (totallyRamifiedOfDegree K n).Countable :=
  TauCeti.countable_totallyRamifiedOfDegree hn

/-- **3.7** The local fibre count ([Serre 1978, Lemma 1]): for `r > d(L)`, a monic degree-`n`
`g` has exactly one root within `r` of a uniformizer `ξ` of `L` if and only if
`addVal (g ξ) ≥ r + d(L)`. -/
theorem existsUnique_isRoot_le_addVal_iff {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    letI := (mem_totallyRamifiedOfDegree_iff.1 hL).2.finite
    letI := finiteIntermediateFieldValuativeRel K (SeparableClosure K) L
    letI := finiteIntermediateFieldTopology K (SeparableClosure K) L
    haveI := finiteIntermediateField_isNonarchimedeanLocalField K (SeparableClosure K) L
    haveI := finiteIntermediateField_valuativeExtension K (SeparableClosure K) L
    ∀ {ξ : 𝒪[L]}, Irreducible ξ → ∀ {g : Polynomial 𝒪[K]}, g.Monic → g.natDegree = n →
      ∀ {r : ℕ}, L.discriminantExponent < r →
        ((∃! z : 𝒪[L], Polynomial.aeval z g = 0 ∧
            (r : ℕ∞) ≤ IsDiscreteValuationRing.addVal 𝒪[L] (z - ξ)) ↔
          ((r + L.discriminantExponent : ℕ) : ℕ∞) ≤
            IsDiscreteValuationRing.addVal 𝒪[L] (Polynomial.aeval ξ g)) :=
  IntermediateField.existsUnique_isRoot_le_addVal_iff hL

/-- **3.8** The integral of the root count ([Serre 1978, Lemmas 2 and 3]). -/
theorem lintegral_rootCount {n : ℕ} {L : IntermediateField K (SeparableClosure K)}
    (hL : L ∈ totallyRamifiedOfDegree K n) [MeasurableSpace (Fin n → K)]
    [BorelSpace (Fin n → K)] (μ : Measure (Fin n → K)) [μ.IsAddLeftInvariant]
    (hμ : μ (integerBox K (Fin n)) = 1) :
    ∫⁻ a in eisensteinSet K n, (L.rootCount a : ℝ≥0∞) ∂μ =
      1 / (Nat.card 𝓀[K] : ℝ≥0∞) ^ (L.discriminantExponent + 1) *
        (1 - 1 / (Nat.card 𝓀[K] : ℝ≥0∞)) :=
  IntermediateField.lintegral_rootCount hL μ hμ

/-! ## Layer 4: the mass formulas -/

/-- **4.1 Theorem 1, the first mass formula** ([Serre 1978, Thm. 1]). -/
theorem tsum_one_div_natCard_residueField_pow_wildExponent (n : ℕ) :
    ∑' L : totallyRamifiedOfDegree K n, 1 / (Nat.card 𝓀[K] : ℝ≥0∞) ^ L.1.wildExponent = n :=
  TauCeti.tsum_one_div_natCard_residueField_pow_wildExponent

/-- **4.2 The finiteness dichotomy** ([Serre 1978, Rmk. 1°]). -/
theorem totallyRamifiedOfDegree_infinite_iff {n : ℕ} (hn : 0 < n) :
    (totallyRamifiedOfDegree K n).Infinite ↔
      ringChar K = ringChar 𝓀[K] ∧ ringChar 𝓀[K] ∣ n :=
  infinite_totallyRamifiedOfDegree_iff hn

/-- **4.3 Convergence** ([Serre 1978, Rmk. 1°]): the real series has sum `n`. -/
theorem hasSum_one_div_natCard_residueField_pow_wildExponent (n : ℕ) :
    HasSum (fun L : totallyRamifiedOfDegree K n ↦
      1 / (Nat.card 𝓀[K] : ℝ) ^ L.1.wildExponent) n :=
  TauCeti.hasSum_one_div_natCard_residueField_pow_wildExponent

/-- **4.4 The orbit count** ([Serre 1978, Rmk. 3°]). -/
theorem ncard_isomorphic_mul_natCard_algEquiv {n : ℕ}
    {L : IntermediateField K (SeparableClosure K)} (hL : L ∈ totallyRamifiedOfDegree K n) :
    {M ∈ totallyRamifiedOfDegree K n | Nonempty (L ≃ₐ[K] M)}.ncard * Nat.card (L ≃ₐ[K] L) =
      n :=
  TauCeti.ncard_isomorphic_mul_natCard_algEquiv hL

/-- **4.5 Theorem 2, the mass formula proper** ([Serre 1978, Thm. 2]). -/
theorem tsum_one_div_natCard_algEquiv_mul_natCard_residueField_pow_wildExponent {n : ℕ}
    (hn : 0 < n) {R : Set (IntermediateField K (SeparableClosure K))}
    (hR : IsRepresentativeSet n R) :
    ∑' M : R, 1 / ((Nat.card (M ≃ₐ[K] M) : ℝ≥0∞) *
      (Nat.card 𝓀[K] : ℝ≥0∞) ^ M.1.wildExponent) = 1 :=
  hR.tsum_one_div_natCard_algEquiv_mul_natCard_residueField_pow_wildExponent hn

/-- **4.6 The tame count**: away from the residue characteristic, `σ_K(n)` has exactly `n`
members. -/
theorem encard_totallyRamifiedOfDegree_of_not_dvd {n : ℕ} (hp : ¬ ringChar 𝓀[K] ∣ n) :
    (totallyRamifiedOfDegree K n).encard = n :=
  TauCeti.encard_totallyRamifiedOfDegree_of_not_dvd hp

end TauCetiRoadmap.MassFormula
