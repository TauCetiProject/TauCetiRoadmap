import Mathlib
import TauCeti.Analysis.InnerProductSpace.ProjValMeasure.Integral
import TauCeti.Analysis.Semigroups.Group.Stone.Basic
import TauCeti.Topology.Algebra.Module.LinearPMap.Resolvent.Basic

/-!
# Self-adjoint spectral theory: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems against the pinned Mathlib and Tau Ceti, on the pinned carriers: Tau Ceti's
projection-valued measures `TauCeti.ProjValMeasure` with their integral on
`TauCeti.BoundedBorelFunction`, the resolvent `LinearPMap.resolvent` of a partial operator with
the convention `R(z) = (z • 1 - A)⁻¹`, and the strongly continuous groups
`TauCeti.Semigroups.StronglyContinuousGroup` with the complex generator of a unitary group.

The headline theorems, in README order:

* Layer 1: uniqueness of the regular spectral measure of a representation of `C(K)`;
* Layer 2: a Hilbert basis of eigenvectors for a compact normal operator;
* Layer 3: existence and uniqueness of the spectral measure of a self-adjoint operator,
  characterised by the resolvent formula, and the spectral criterion for a lower bound;
* Layer 4: the spectral representation of the unitary group generated by a self-adjoint
  operator, and its Yosida approximation by bounded exponentials.

Every headline theorem is statable at the pins. The two definitions below, the resolvent
characterisation `IsSpectralMeasure` and the symmetrised Yosida approximant `yosidaApproximant`,
are the ones these statements need.

The pinned spectrum of a partial operator, `LinearPMap.spectrum`, is also exported under the
name `TauCeti.LinearPMap.spectrum`, which the target file of SpectralSubspacePerturbation uses.
-/

namespace TauCeti.LinearPMap

export _root_.LinearPMap (spectrum)

end TauCeti.LinearPMap

namespace TauCetiRoadmap.SelfAdjointSpectralTheory

open scoped InnerProductSpace Topology
open MeasureTheory Filter

/-! ## Layer 1: Spectral measures of representations of `C(K)` -/

/-- **Uniqueness of the regular spectral measure.** On a compact Hausdorff space `K` with its
Borel σ-algebra, two projection-valued measures whose diagonal measures are regular and whose
integrals agree on every continuous function are equal. Applied to a unital representation `π`
of `C(K)`, the projection-valued measure whose integral extends `π` is unique among those with
regular diagonal measures (Conway, *A Course in Functional Analysis*, Theorem IX.1.14). -/
theorem projValMeasure_eq_of_regular_of_integral_eq
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {K : Type*} [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [MeasurableSpace K] [BorelSpace K]
    {P Q : TauCeti.ProjValMeasure K H}
    (hP : ∀ ξ : H, (P.diag ξ).Regular) (hQ : ∀ ξ : H, (Q.diag ξ).Regular)
    (h : ∀ f : C(K, ℂ), P.integral (TauCeti.BoundedBorelFunction.ofContinuousMap f) =
      Q.integral (TauCeti.BoundedBorelFunction.ofContinuousMap f)) :
    P = Q := by
  sorry

/-! ## Layer 2: Compact normal operators -/

/-- **Spectral theorem for compact normal operators.** A compact normal operator on a complex
Hilbert space has a Hilbert basis consisting of eigenvectors. For a compact self-adjoint operator
this is Teschl, *Mathematical Methods in Quantum Mechanics*, Theorem 6.6; the normal case
diagonalises the commuting real and imaginary parts simultaneously. -/
theorem exists_hilbertBasis_forall_hasEigenvector_of_isStarNormal
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {T : H →L[ℂ] H} (hT : IsCompactOperator T) [IsStarNormal T] :
    ∃ (s : Set H) (b : HilbertBasis s ℂ H) (ν : s → ℂ), ⇑b = ((↑) : s → H) ∧
      ∀ x : s, Module.End.HasEigenvector (T : Module.End ℂ H) (ν x) (x : H) := by
  sorry

/-! ## Layer 3: The spectral measure of an unbounded self-adjoint operator -/

/-- `IsSpectralMeasure A P` says that the projection-valued measure `P` on `ℝ` represents the
resolvent of the partial operator `A`: for every nonreal `z` and every vector `ξ`,
`⟪ξ, R(z) ξ⟫ = ∫ (z - s)⁻¹ dμ_ξ(s)`, where `R(z) = (z • 1 - A)⁻¹` and `μ_ξ = P.diag ξ`. This is the
Borel transform of `μ_ξ` (Teschl, *Mathematical Methods in Quantum Mechanics*, (3.40)), up to
the sign coming from the resolvent convention. -/
def IsSpectralMeasure
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    (A : H →ₗ.[ℂ] H) (P : TauCeti.ProjValMeasure ℝ H) : Prop :=
  ∀ z : ℂ, z.im ≠ 0 → ∀ ξ : H,
    ⟪ξ, LinearPMap.resolvent A z ξ⟫_ℂ = ∫ s : ℝ, (z - (s : ℂ))⁻¹ ∂(P.diag ξ)

/-- **Spectral theorem, resolvent form.** A self-adjoint operator on a complex Hilbert space has
exactly one projection-valued measure on `ℝ` representing its resolvent (Teschl, *Mathematical
Methods in Quantum Mechanics*, Theorem 3.7, with uniqueness by the Stieltjes inversion formula,
Theorem 3.21). -/
theorem existsUnique_isSpectralMeasure
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {A : H →ₗ.[ℂ] H} (hA : IsSelfAdjoint A) :
    ∃! P : TauCeti.ProjValMeasure ℝ H, IsSpectralMeasure A P := by
  sorry

/-- **Spectral criterion for a lower bound.** For a self-adjoint operator `A` with spectral
measure `P` and a real `c`, the quadratic form of `A` is bounded below by `c` on the domain of
`A` exactly when `P` vanishes on the half-line `(-∞, c)` (Teschl, *Mathematical Methods in
Quantum Mechanics*, Theorem 3.8). -/
theorem forall_le_re_inner_iff_proj_Iio_eq_zero
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {A : H →ₗ.[ℂ] H} (hA : IsSelfAdjoint A)
    {P : TauCeti.ProjValMeasure ℝ H} (hP : IsSpectralMeasure A P) (c : ℝ) :
    (∀ x : A.domain, c * ‖(x : H)‖ ^ 2 ≤ (⟪(x : H), A x⟫_ℂ).re) ↔
      P.proj (Set.Iio c) measurableSet_Iio = 0 := by
  sorry

/-! ## Layer 4: The unitary group of a self-adjoint operator -/

/-- **Spectral representation of the Stone group.** If the unitary group `U` has complex
generator `i • A` and `P` is the spectral measure of `A`, then
`⟪ξ, U(t) ξ⟫ = ∫ exp(i t s) dμ_ξ(s)` for every time `t` and vector `ξ`; that is, `U(t) = exp(i t A)`
in the Borel calculus of `P` (Teschl, *Mathematical Methods in Quantum Mechanics*, Theorems
5.1 and 5.2, written there for `exp(-i t A)`). -/
theorem inner_apply_eq_integral_exp
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {A : H →ₗ.[ℂ] H} {P : TauCeti.ProjValMeasure ℝ H} (hP : IsSpectralMeasure A P)
    {U : TauCeti.Semigroups.StronglyContinuousGroup H} (hU : U.IsUnitary)
    (hUA : U.complexGenerator hU = Complex.I • A) (t : ℝ) (ξ : H) :
    ⟪ξ, U t ξ⟫_ℂ = ∫ s : ℝ, Complex.exp (Complex.I * ((t : ℂ) * (s : ℂ))) ∂(P.diag ξ) := by
  sorry

/-- The symmetrised Yosida approximant `S_n = -(n² / 2) (R(i n) + R(-i n))` of a partial operator
`A`, the average of the two imaginary-shift approximants `-n² R(i n) - i n` and
`-n² R(-i n) + i n`. For self-adjoint `A` it is a bounded self-adjoint operator, equal to
`n² A (n² + A²)⁻¹` in the Borel calculus; at `n = 0` it is `0`. -/
noncomputable def yosidaApproximant
    {H : Type*} [NormedAddCommGroup H] [NormedSpace ℂ H]
    (A : H →ₗ.[ℂ] H) (n : ℕ) : H →L[ℂ] H :=
  (-((n : ℂ) ^ 2 / 2)) •
    (LinearPMap.resolvent A (Complex.I * n) + LinearPMap.resolvent A (-(Complex.I * n)))

/-- **Yosida approximation of the Stone group.** If the unitary group `U` has complex generator
`i • A`, then the bounded unitary groups `exp(i t S_n)` generated by the symmetrised Yosida
approximants converge strongly to `U(t)` for every time `t` (the approximants converge to `A` in
the strong resolvent sense, Teschl, *Mathematical Methods in Quantum Mechanics*, Lemma 6.36, and
Theorem 6.31 applies to `s ↦ exp(i t s)`). -/
theorem tendsto_ofBoundedExp_yosidaApproximant
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
    {A : H →ₗ.[ℂ] H}
    {U : TauCeti.Semigroups.StronglyContinuousGroup H} (hU : U.IsUnitary)
    (hUA : U.complexGenerator hU = Complex.I • A) (t : ℝ) (ψ : H) :
    Tendsto (fun n : ℕ =>
        TauCeti.Semigroups.StronglyContinuousGroup.ofBoundedExp (yosidaApproximant A n) t ψ)
      atTop (𝓝 (U t ψ)) := by
  sorry

end TauCetiRoadmap.SelfAdjointSpectralTheory
