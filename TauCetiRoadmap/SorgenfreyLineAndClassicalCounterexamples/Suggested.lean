import Mathlib

/-!
# The Sorgenfrey line, the Niemytzki plane and the closure–complement theorem: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
results against the pinned Mathlib, with the four definitions they need, every theorem with
`sorry` and every definition with a real body. Every headline theorem of the README is statable
at the pins and is stated here.

`Sorgenfrey` is a new type equal to `ℝ`, carrying only the lower limit topology. `NiemytzkiPlane`
is a new type equal to the closed upper half-plane `{p : ℝ × ℝ // 0 ≤ p.2}`, carrying only the
tangent-disc topology. Closure–complement orbits are written with `Relation.ReflTransGen` and
counted with `Set.encard`.
-/

open Set Topology TopologicalSpace

noncomputable section

namespace TauCetiRoadmap.SorgenfreyLineAndClassicalCounterexamples

/-! ## Layer 1: the Sorgenfrey line and the Sorgenfrey plane -/

/-- 1.1 The Sorgenfrey line: a copy of `ℝ` that carries the lower limit topology. -/
def Sorgenfrey : Type := ℝ

/-- 1.1 The lower limit topology, generated by the half-open intervals `[a, b)`. -/
instance : TopologicalSpace Sorgenfrey :=
  generateFrom {s | ∃ a b : ℝ, s = Ico a b}

/-- 1.2 The Sorgenfrey line is hereditarily Lindelöf. -/
theorem hereditarilyLindelofSpace_sorgenfrey : HereditarilyLindelofSpace Sorgenfrey := by
  sorry

/-- 1.3 The Sorgenfrey line is perfectly normal and T₀. -/
theorem t6Space_sorgenfrey : T6Space Sorgenfrey := by
  sorry

/-- 1.4 The Sorgenfrey line is paracompact. -/
theorem paracompactSpace_sorgenfrey : ParacompactSpace Sorgenfrey := by
  sorry

/-- 1.5 Every compact subset of the Sorgenfrey line is countable. -/
theorem countable_of_isCompact_sorgenfrey {K : Set Sorgenfrey} (hK : IsCompact K) :
    K.Countable := by
  sorry

/-- 1.6 The Sorgenfrey plane is neither Lindelöf nor paracompact. -/
theorem not_lindelofSpace_and_not_paracompactSpace_sorgenfrey_prod :
    ¬ LindelofSpace (Sorgenfrey × Sorgenfrey) ∧ ¬ ParacompactSpace (Sorgenfrey × Sorgenfrey) := by
  sorry

/-! ## Layer 2: the Niemytzki plane -/

/-- 2.1 The Niemytzki plane: the closed upper half-plane, as a new type. -/
def NiemytzkiPlane : Type := {p : ℝ × ℝ // 0 ≤ p.2}

/-- 2.1 The tangent-disc topology, generated by the open discs intersected with the open
half-plane and by the sets `{(t, 0)} ∪ D(t, r)` with `r > 0`, where `D(t, r)` is the open disc
of radius `r` centred at `(t, r)`. -/
instance : TopologicalSpace NiemytzkiPlane :=
  generateFrom
    ({s | ∃ (c : ℝ × ℝ) (r : ℝ), s = {q : NiemytzkiPlane | 0 < (Subtype.val q).2 ∧
        ((Subtype.val q).1 - c.1) ^ 2 + ((Subtype.val q).2 - c.2) ^ 2 < r ^ 2}} ∪
     {s | ∃ t r : ℝ, 0 < r ∧ s = {q : NiemytzkiPlane | Subtype.val q = (t, 0) ∨
        ((Subtype.val q).1 - t) ^ 2 + ((Subtype.val q).2 - r) ^ 2 < r ^ 2}})

/-- 2.2 The Niemytzki plane is T₀ and completely regular. -/
theorem t35Space_niemytzkiPlane : T35Space NiemytzkiPlane := by
  sorry

/-- 2.3 The Niemytzki plane is separable and not normal. -/
theorem separableSpace_and_not_normalSpace_niemytzkiPlane :
    SeparableSpace NiemytzkiPlane ∧ ¬ NormalSpace NiemytzkiPlane := by
  sorry

/-! ## Layer 3: closure, interior and complement -/

/-- 3.1 For every closure operator on a Boolean algebra, the closure–complement orbit of an
element has at most fourteen elements. -/
theorem encard_closureComplement_le_fourteen {α : Type*} [BooleanAlgebra α]
    (c : ClosureOperator α) (a : α) :
    {b | Relation.ReflTransGen (fun x y => y = c x ∨ y = xᶜ) a b}.encard ≤ 14 := by
  sorry

/-- 3.2 For every closure operator on a Boolean algebra, the orbit of an element under closure
and the interior `x ↦ (c xᶜ)ᶜ` has at most seven elements. -/
theorem encard_closureInterior_le_seven {α : Type*} [BooleanAlgebra α]
    (c : ClosureOperator α) (a : α) :
    {b | Relation.ReflTransGen (fun x y => y = c x ∨ y = (c xᶜ)ᶜ) a b}.encard ≤ 7 := by
  sorry

/-- 3.3 In an extremally disconnected space every closure–complement orbit has at most ten
elements. -/
theorem encard_closureComplement_le_ten {X : Type*} [TopologicalSpace X]
    [ExtremallyDisconnected X] (s : Set X) :
    {t | Relation.ReflTransGen (fun u v => v = closure u ∨ v = uᶜ) s t}.encard ≤ 10 := by
  sorry

end TauCetiRoadmap.SorgenfreyLineAndClassicalCounterexamples
