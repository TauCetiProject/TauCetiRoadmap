module

public import Mathlib

/-!
# Hypercompleteness, sheaves of spectra and coherent ∞-topoi: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline theorems
against the pinned Mathlib and Tau Ceti, with the few definitions their statements need. What is
stated here is classical and lives on Mathlib carriers:

* Stone duality for bounded distributive lattices and Boolean algebras (README Layer 7, §7.3 and
  §7.4), with the spectrum `LatticeSpectrum` built from Mathlib's order ideals and prime ideals;
* the Kan condition and Kan fibrations of semisimplicial sets, their comparison with Mathlib's Kan
  fibrations of simplicial sets, the lifting of semisimplicial Kan fibrations and the
  Rourke–Sanderson theorem (README §11.2 and §11.3).

Not statable at the pins. Every other headline is a statement about ∞-topoi, and Mathlib and Tau
Ceti have no ∞-topos: no presheaf ∞-category with its Yoneda embedding, no accessible left exact
localization, no effective epimorphisms, homotopy sheaves or ∞-connective morphisms in an
∞-category, no Grothendieck topology on an ∞-category and no sheaf ∞-category. These carriers are
targets of earlier Parts of this family, whose files a roadmap's `Suggested.lean` may not import.
In particular:
* the hypercompletion, its universal property and the factorization of left exact localizations
  (Layer 1), hyperdescent (Layer 2), homotopy dimension, the convergence of Postnikov towers and the
  hypercompleteness of ∞-topoi locally of finite homotopy dimension (Layer 3) need ∞-topoi and
  ∞-connective morphisms;
* sheaves of spectra, their t-structure and their hypercompleteness (Layers 4–6) need, in addition,
  the ∞-category of spectra, spectrum objects and t-structures on stable ∞-categories;
* coherent ∞-topoi, the presentation of locally coherent hypercomplete ∞-topoi as hypercomplete
  sheaves on finitary sites (§9.5), Deligne completeness and Postnikov complete ∞-topoi
  (Layers 8–10 and 12) need ∞-topoi, their points and the ∞-category of ∞-topoi;
* the finitary topology generated by a class of covering morphisms and the Čech sheaf criterion
  (§9.3, §9.4) need Grothendieck topologies on an ∞-category and the sheaves for them;
* local ∞-pretopoi (§11.1), Kan fibrations of semisimplicial objects of an ∞-topos (§11.2) and the
  realization of trivial Kan fibrations of semisimplicial spaces and of semisimplicial objects of an
  ∞-topos (§11.3, §11.4) need geometric realizations and effective epimorphisms in an ∞-category;
* the hypercomplete sheaf criterion (§11.5) needs, in addition, Grothendieck topologies on an
  ∞-category, their sheaf ∞-categories and the hypercomplete objects of these.
-/

public section

namespace TauCetiRoadmap.InfinityCategoryTheory.HypercompletenessAndCoherence

open CategoryTheory Topology TopologicalSpace

open scoped Simplicial

universe u

/-! ## Layer 7: Stone duality -/

/-- README §7.3.2. The spectrum of a bounded distributive lattice `Λ`: the set of prime ideals of `Λ`, with
Mathlib's order ideals and prime ideals (SAG, Construction A.1.2.3, p. 1740). -/
structure LatticeSpectrum (Λ : Type u) [DistribLattice Λ] [BoundedOrder Λ] : Type u where
  /-- The underlying order ideal. -/
  asIdeal : Order.Ideal Λ
  /-- The ideal is prime. -/
  isPrime : asIdeal.IsPrime

namespace LatticeSpectrum

variable {Λ : Type u} [DistribLattice Λ] [BoundedOrder Λ]

/-- README §7.3.2. The basic open set `Spec(Λ)_x` of the spectrum attached to `x`: the prime ideals not
containing `x` (SAG, Notation A.1.2.4, p. 1740). -/
def basicOpen (x : Λ) : Set (LatticeSpectrum Λ) :=
  {p | x ∉ p.asIdeal}

/-- README §7.3.2. The topology on the spectrum generated by the basic open sets (SAG, Prop. A.1.2.5 (1),
(3), p. 1740). -/
instance : TopologicalSpace (LatticeSpectrum Λ) :=
  TopologicalSpace.generateFrom (Set.range basicOpen)

/-- README §7.3.2. Sending an ideal `I` to the set `Spec(Λ)_I` of primes not containing `I` is an order
isomorphism from the ideals of `Λ` onto the open subsets of the spectrum (SAG, Prop. A.1.2.5 (1),
(2), p. 1740). -/
theorem exists_orderIso_opens :
    ∃ e : Order.Ideal Λ ≃o Opens (LatticeSpectrum Λ),
      ∀ I : Order.Ideal Λ, (e I : Set (LatticeSpectrum Λ)) = {p | ¬ I ≤ p.asIdeal} := by
  sorry

/-- README §7.4.1, Level 2. The spectrum of a bounded distributive lattice is a coherent (spectral) space
(SAG, Prop. A.1.2.5 (5), (6), p. 1741, and Prop. A.1.5.2, p. 1747). -/
theorem spectralSpace : SpectralSpace (LatticeSpectrum Λ) := by
  sorry

/-- README §7.4.1, Level 2. The compact open subsets of the spectrum are exactly the basic open sets (SAG,
Prop. A.1.2.5 (3), (5), pp. 1740–1741). -/
theorem isOpen_and_isCompact_iff (s : Set (LatticeSpectrum Λ)) :
    IsOpen s ∧ IsCompact s ↔ ∃ x : Λ, basicOpen x = s := by
  sorry

/-- README §7.4.1, Level 2. The basic open sets determine the order of `Λ`; this is the prime ideal
theorem in the form used for Stone duality (SAG, Prop. A.1.2.5 (5), p. 1741, and Lemma A.1.2.6,
p. 1741). -/
theorem basicOpen_subset_basicOpen_iff {x y : Λ} : basicOpen x ⊆ basicOpen y ↔ x ≤ y := by
  sorry

/-- README §7.4.1, Level 2. A map between spectra of bounded distributive lattices is spectral if and only
if it is induced, by taking inverse images of prime ideals, by a unique bounded lattice
homomorphism in the opposite direction (SAG, Prop. A.1.5.10 (2), p. 1749). -/
theorem isSpectralMap_iff_existsUnique_boundedLatticeHom {Λ' : Type u} [DistribLattice Λ']
    [BoundedOrder Λ'] (f : LatticeSpectrum Λ → LatticeSpectrum Λ') :
    IsSpectralMap f ↔
      ∃! g : BoundedLatticeHom Λ' Λ,
        ∀ (p : LatticeSpectrum Λ) (y : Λ'), y ∈ (f p).asIdeal ↔ g y ∈ p.asIdeal := by
  sorry

/-- README §7.4.1, Level 2. Every coherent (spectral) space is homeomorphic to the spectrum of a bounded
distributive lattice (SAG, Prop. A.1.5.10 (1), p. 1749). -/
theorem exists_homeomorph (X : Type u) [TopologicalSpace X] [SpectralSpace X] :
    ∃ (Λ : Type u) (_ : DistribLattice Λ) (_ : BoundedOrder Λ),
      Nonempty (X ≃ₜ LatticeSpectrum Λ) := by
  sorry

/-- README §7.3.3. A bounded distributive lattice is complemented if and only if its spectrum is
Hausdorff. The spectrum of a bounded distributive lattice is always compact, so this is SAG,
Prop. A.1.6.5, p. 1750, for bounded distributive lattices (with Remark A.1.6.10, p. 1751). -/
theorem t2Space_iff_complementedLattice :
    T2Space (LatticeSpectrum Λ) ↔ ComplementedLattice Λ := by
  sorry

end LatticeSpectrum

/-- README §7.4.1, Level 3. Stone duality, essential image: every Stone space (compact, Hausdorff, with a
basis of clopen sets) is homeomorphic to the spectrum of a Boolean algebra (SAG, Thm. A.1.6.11,
p. 1751). -/
theorem exists_homeomorph_latticeSpectrum_of_isTopologicalBasis_isClopen (X : Type u)
    [TopologicalSpace X] [CompactSpace X] [T2Space X]
    (hX : IsTopologicalBasis (Set.ofPred IsClopen : Set (Set X))) :
    ∃ (Λ : Type u) (_ : BooleanAlgebra Λ), Nonempty (X ≃ₜ LatticeSpectrum Λ) := by
  sorry

/-- README §7.4.1, Level 3. Stone duality, full faithfulness: every continuous map between spectra of
Boolean algebras is induced by a unique Boolean algebra homomorphism in the opposite direction
(SAG, Thm. A.1.6.11, p. 1751, with Cor. A.1.6.6, p. 1750). -/
theorem continuous_iff_existsUnique_boundedLatticeHom {Λ Λ' : Type u} [BooleanAlgebra Λ]
    [BooleanAlgebra Λ'] (f : LatticeSpectrum Λ → LatticeSpectrum Λ') :
    Continuous f ↔
      ∃! g : BoundedLatticeHom Λ' Λ,
        ∀ (p : LatticeSpectrum Λ) (y : Λ'), y ∈ (f p).asIdeal ↔ g y ∈ p.asIdeal := by
  sorry

/-! ## Layer 11: Semisimplicial Kan complexes -/

/-- README §11.2.3 and §11.3.2. A semisimplicial set `X` (a functor out of the opposite of Mathlib's
`SemiSimplexCategory`) satisfies the Kan condition if every horn `Λ[n+1, i]` in `X` has a filler.
A horn is given by compatible simplices indexed by the injective maps `⦋m⦌ₛ ⟶ ⦋n+1⦌ₛ` whose image
misses some vertex `j ≠ i`, that is, by the nondegenerate simplices of the horn (SAG,
Def. A.5.2.3 and Remark A.5.2.4, p. 1788, in the ∞-topos of spaces; Example A.5.2.2, p. 1788). -/
def SemisimplicialKan (X : SemiSimplexCategoryᵒᵖ ⥤ Type u) : Prop :=
  ∀ (n : ℕ) (i : Fin (n + 2))
    (x : ∀ (m : ℕ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ),
      (∃ j : Fin (n + 2), j ≠ i ∧ j ∉ Set.range (SemiSimplexCategory.homEquiv f)) →
        X.obj (Opposite.op ⦋m⦌ₛ)),
    (∀ (m m' : ℕ) (g : ⦋m'⦌ₛ ⟶ ⦋m⦌ₛ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ) hf hgf,
      X.map g.op (x m f hf) = x m' (g ≫ f) hgf) →
    ∃ y : X.obj (Opposite.op ⦋n + 1⦌ₛ),
      ∀ (m : ℕ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ) hf, X.map f.op y = x m f hf

/-- README §11.2.2 and §11.3.1. A map `p : X ⟶ Y` of semisimplicial sets is a Kan fibration if every horn
`Λ[n+1, i]` in `X`, together with an `(n+1)`-simplex of `Y` restricting to its image under `p`, has
a filler in `X` lying over that simplex. Horns are given as in `SemisimplicialKan` (SAG,
Def. A.5.2.1, p. 1788, in the ∞-topos of spaces, and Example A.5.2.2, p. 1788). -/
def SemisimplicialKanFibration {X Y : SemiSimplexCategoryᵒᵖ ⥤ Type u} (p : X ⟶ Y) : Prop :=
  ∀ (n : ℕ) (i : Fin (n + 2))
    (x : ∀ (m : ℕ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ),
      (∃ j : Fin (n + 2), j ≠ i ∧ j ∉ Set.range (SemiSimplexCategory.homEquiv f)) →
        X.obj (Opposite.op ⦋m⦌ₛ))
    (z : Y.obj (Opposite.op ⦋n + 1⦌ₛ)),
    (∀ (m m' : ℕ) (g : ⦋m'⦌ₛ ⟶ ⦋m⦌ₛ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ) hf hgf,
      X.map g.op (x m f hf) = x m' (g ≫ f) hgf) →
    (∀ (m : ℕ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ) hf, p.app (Opposite.op ⦋m⦌ₛ) (x m f hf) = Y.map f.op z) →
    ∃ y : X.obj (Opposite.op ⦋n + 1⦌ₛ), p.app (Opposite.op ⦋n + 1⦌ₛ) y = z ∧
      ∀ (m : ℕ) (f : ⦋m⦌ₛ ⟶ ⦋n + 1⦌ₛ) hf, X.map f.op y = x m f hf

open HomotopicalAlgebra SSet.modelCategoryQuillen in
/-- README §11.2.2. A map of simplicial sets is a Kan fibration exactly when its underlying map of
semisimplicial sets is one: the case of levelwise discrete simplicial objects of the ∞-topos of
spaces in SAG, Example A.5.2.2, p. 1788, as used in §11.3. -/
theorem fibration_iff_semisimplicialKanFibration {X Y : SSet.{u}} (p : X ⟶ Y) :
    Fibration p ↔
      SemisimplicialKanFibration (Functor.whiskerLeft SemiSimplexCategory.toSimplexCategory.op p) := by
  sorry

open HomotopicalAlgebra SSet.modelCategoryQuillen in
/-- README §11.3.1. A Kan fibration of semisimplicial sets whose target underlies a simplicial set `Y` lifts
to a Kan fibration of simplicial sets over `Y` (SAG, Prop. A.5.3.4, p. 1791). -/
theorem exists_fibration_of_semisimplicialKanFibration (Y : SSet.{u})
    {X : SemiSimplexCategoryᵒᵖ ⥤ Type u} (p : X ⟶ SemiSimplexCategory.toSimplexCategory.op ⋙ Y)
    (hp : SemisimplicialKanFibration p) :
    ∃ (X' : SSet.{u}) (q : X' ⟶ Y) (e : SemiSimplexCategory.toSimplexCategory.op ⋙ X' ≅ X),
      Fibration q ∧ e.hom ≫ p = Functor.whiskerLeft SemiSimplexCategory.toSimplexCategory.op q := by
  sorry

/-- README §11.3.2. Rourke–Sanderson: a semisimplicial set satisfying the Kan condition is the underlying
semisimplicial set of a simplicial set (SAG, Cor. A.5.3.5, p. 1792). -/
theorem exists_sSet_of_semisimplicialKan (X : SemiSimplexCategoryᵒᵖ ⥤ Type u)
    (hX : SemisimplicialKan X) :
    ∃ Y : SSet.{u}, Nonempty (SemiSimplexCategory.toSimplexCategory.op ⋙ Y ≅ X) := by
  sorry

end TauCetiRoadmap.InfinityCategoryTheory.HypercompletenessAndCoherence
