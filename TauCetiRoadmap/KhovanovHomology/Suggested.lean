namespace TauCeti.Khovanov

/-- The native half-edge relation generated by following either an arc or the chosen smoothing. -/
def circleStep {n : ℕ} (D : PDCode n) (s : Fin n → Bool)
    (x y : Fin (4 * n)) : Prop :=
  y = D.edgePair.val x ∨
    y = D.smoothingTurn (D.smoothingChoice s) x

/-- A crossing-bearing resolved circle is one component of the alternating two-matching graph.
This quotient uses native `Relation.EqvGen.setoid` and records connectivity without a separate
graph encoding, including the alternating two-edge case. -/
def CrossingCircle {n : ℕ} (D : PDCode n) (s : Fin n → Bool) :=
  Quotient (Relation.EqvGen.setoid (circleStep D s))

/-- Every crossing-bearing circle type is finite because it is a quotient of `Fin (4*n)`. -/
noncomputable instance crossingCircleFintype {n : ℕ} (D : PDCode n) (s : Fin n → Bool) :
    Fintype (CrossingCircle D s) := by
  classical
  unfold CrossingCircle
  infer_instance

/-- The complete resolved-circle carrier, with abstract finite labels for crossing-free circles.
The PD-code stores only their number, not identities for these circles. -/
def ResolvedCircle {n : ℕ} (D : PDCode n) (s : Fin n → Bool) :=
  CrossingCircle D s ⊕ Fin D.crossinglessComponentCount

/-- The complete carrier is finite after adjoining the crossing-free summand. -/
noncomputable instance resolvedCircleFintype {n : ℕ} (D : PDCode n) (s : Fin n → Bool) :
    Fintype (ResolvedCircle D s) := by
  unfold ResolvedCircle
  infer_instance

/-- The circle carrier has the native state-loop count. The proof identifies each undirected
component with the pair of opposite directed `SameCycle statePerm` classes, using both fixed-point-free
perfect matchings to rule out a reversal-fixed directed orbit. -/
theorem card_resolvedCircle {n : ℕ} (D : PDCode n) (s : Fin n → Bool) :
    Fintype.card (ResolvedCircle D s) = D.stateLoopCount s := by
  sorry

/-- Transport of resolved circles under half-edge and crossing relabelling. -/
def relabelResolvedCircle {n m : ℕ} (D : PDCode n) (s : Fin m → Bool)
    (half : Fin (4 * n) ≃ Fin (4 * m)) (cross : Fin n ≃ Fin m) :
    ResolvedCircle D (s ∘ cross) ≃ ResolvedCircle (D.relabel half cross) s := by
  sorry

/-- Native PD-code relabelling preserves the number of crossing-free circles. -/
theorem relabelResolvedCircle_crossingless {n m : ℕ} (D : PDCode n)
    (half : Fin (4 * n) ≃ Fin (4 * m)) (cross : Fin n ≃ Fin m) :
    (D.relabel half cross).crossinglessComponentCount = D.crossinglessComponentCount := by
  rfl

/-- The declared circle equivalence is required to fix the abstract crossing-free labels.
This specifies its actual action, rather than merely the equality of the two circle counts. -/
theorem relabelResolvedCircle_inr {n m : ℕ} (D : PDCode n) (s : Fin m → Bool)
    (half : Fin (4 * n) ≃ Fin (4 * m)) (cross : Fin n ≃ Fin m)
    (k : Fin D.crossinglessComponentCount) :
    relabelResolvedCircle D s half cross (.inr k) = .inr k := by
  sorry

/-- A directed cube edge changes one crossing from its native A smoothing (`true`) to its
native B smoothing (`false`) and agrees at every other crossing. -/
structure CubeEdge {n : ℕ} (s t : Fin n → Bool) where
  crossing : Fin n
  fromA : s crossing = true
  toB : t crossing = false
  agreeAway : ∀ j, j ≠ crossing → s j = t j

/-! ## Rank-two Frobenius algebra -/

/-- The ordinary Khovanov coefficient algebra is the native trivial square-zero extension. -/
abbrev DualNumbers (R : Type u) := TrivSqZeroExt R R

/-- The element X in the native square-zero extension. -/
def khX (R : Type u) [CommRing R] : DualNumbers R := TrivSqZeroExt.inr 1

/-- The specified Khovanov counit, ε(1)=0 and ε(X)=1. -/
def khCounit (R : Type u) [CommRing R] : DualNumbers R →ₗ[R] R :=
  TrivSqZeroExt.sndHom R R

/-- The specified Khovanov comultiplication, Δ(1)=1⊗X+X⊗1 and Δ(X)=X⊗X. -/
def khComul (R : Type u) [CommRing R] :
    DualNumbers R →ₗ[R] DualNumbers R ⊗[R] DualNumbers R :=
  (TrivSqZeroExt.fstHom R R R).toLinearMap.smulRight
      ((1 : DualNumbers R) ⊗ₜ[R] khX R + khX R ⊗ₜ[R] (1 : DualNumbers R)) +
    (TrivSqZeroExt.sndHom R R).smulRight (khX R ⊗ₜ[R] khX R)

/-- The actual counit sends the unit label to zero. -/
@[simp] theorem khCounit_one (R : Type u) [CommRing R] :
    khCounit R (1 : DualNumbers R) = 0 := by
  rfl

/-- The actual counit sends the X label to one. -/
@[simp] theorem khCounit_X (R : Type u) [CommRing R] :
    khCounit R (khX R) = 1 := by
  rfl

/-- The merge coefficient on two X labels is zero in the actual algebra. -/
@[simp] theorem khX_mul_khX (R : Type u) [CommRing R] :
    khX R * khX R = 0 := by
  simp [khX]

/-- The actual split map on the unit label has its two specified enhanced-label terms. -/
@[simp] theorem khComul_one (R : Type u) [CommRing R] :
    khComul R (1 : DualNumbers R) =
      (1 : DualNumbers R) ⊗ₜ[R] khX R + khX R ⊗ₜ[R] (1 : DualNumbers R) := by
  simp [khComul, khX]

/-- The actual split map on an X label has the single X/X term. -/
@[simp] theorem khComul_X (R : Type u) [CommRing R] :
    khComul R (khX R) = khX R ⊗ₜ[R] khX R := by
  simp [khComul, khX]

/-- The chosen coalgebra structure used by Khovanov theory. Its data fields are the explicit
maps above; the three laws are substantive proof obligations. -/
@[instance_reducible]
noncomputable def khCoalgebra (R : Type u) [CommRing R] : Coalgebra R (DualNumbers R) where
  comul := khComul R
  counit := khCounit R
  coassoc := by sorry
  rTensor_counit_comp_comul := by sorry
  lTensor_counit_comp_comul := by sorry

section ChosenCoalgebra
variable (R : Type u) [CommRing R]
local instance chosenCoalgebra : Coalgebra R (DualNumbers R) := khCoalgebra R

-- Bind the native componentwise scalar action to multiplication in the square-zero extension.
local instance dualNumbersSMulCommClass : SMulCommClass R (DualNumbers R) (DualNumbers R) where
  smul_comm r a b := by
    change r • (a * b) = a * (r • b)
    ext <;> simp [TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_mul,
      smul_eq_mul, mul_add, mul_assoc, mul_comm, mul_left_comm]

local instance dualNumbersScalarTower : IsScalarTower R (DualNumbers R) (DualNumbers R) where
  smul_assoc r a b := by
    change (r • a) * b = r • (a * b)
    ext <;> simp [TrivSqZeroExt.fst_mul, TrivSqZeroExt.snd_mul,
      smul_eq_mul, mul_add, mul_assoc, mul_comm, mul_left_comm, add_comm]

/-- The actual native Frobenius equation for the chosen Khovanov coalgebra. -/
theorem khIsFrobenius : Coalgebra.IsFrobenius R (DualNumbers R) := by
  constructor
  sorry

end ChosenCoalgebra

/-! ## Bigraded free terms and the cochain complex -/

/-- A basis state uses `true` for the A smoothing; the subset S of B smoothings is therefore the
set where the state is false. -/
def bSmoothingSet {n : ℕ} (s : Fin n → Bool) : Finset (Fin n) :=
  Finset.univ.filter (fun i => s i = false)

/-- The integral cube incidence sign for adding crossing `crossing` to the B-smoothing subset. -/
def cubeIncidenceSign {n : ℕ} (s : Fin n → Bool) (crossing : Fin n) : ℤ :=
  (-1 : ℤ) ^ ((bSmoothingSet s).filter (fun k => k < crossing)).card

/-- The enhanced-state basis consists of a smoothing state and a 1/X label on each resolved
circle: `false` denotes 1 and `true` denotes X. -/
def EnhancedState {n : ℕ} (D : OrientedPDCode n) :=
  Σ s : Fin n → Bool, ResolvedCircle D.toPDCode s → Bool

noncomputable instance enhancedStateFintype {n : ℕ} (D : OrientedPDCode n) :
    Fintype (EnhancedState D) := by
  classical
  unfold EnhancedState
  infer_instance

/-- Number of positive crossings in the native oriented PD-code. -/
def positiveCrossingCount {n : ℕ} (D : OrientedPDCode n) : ℕ :=
  (Finset.univ.filter (fun i => D.crossingSign i = 1)).card

/-- Number of negative crossings in the native oriented PD-code. -/
def negativeCrossingCount {n : ℕ} (D : OrientedPDCode n) : ℕ :=
  (Finset.univ.filter (fun i => D.crossingSign i = -1)).card

/-- The normalized cochain degree `|S|-n₋`. -/
def enhancedCochainDegree {n : ℕ} (D : OrientedPDCode n) (e : EnhancedState D) : ℤ :=
  ((bSmoothingSet e.1).card : ℤ) - (negativeCrossingCount D : ℤ)

/-- The native quantum degree `|S|+n₊-2n₋` plus one degree for each 1 label and minus one for
each X label. -/
def enhancedQuantumDegree {n : ℕ} (D : OrientedPDCode n) (e : EnhancedState D) : ℤ := by
  classical
  exact ((bSmoothingSet e.1).card : ℤ) + (positiveCrossingCount D : ℤ) -
    2 * (negativeCrossingCount D : ℤ) +
      Finset.univ.sum (fun c : ResolvedCircle D.toPDCode e.1 => if e.2 c then -1 else 1)

/-- The concrete free module on enhanced states in bidegree `(i,j)`. -/
def BigradedTerm {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i j : ℤ) : ModuleCat.{u} R :=
  ModuleCat.of R <| Finsupp
    {e : EnhancedState D // enhancedCochainDegree D e = i ∧ enhancedQuantumDegree D e = j} R

/-- The finite-free basis indexed by the actual enhanced states in bidegree `(i,j)`. -/
noncomputable def bigradedBasis {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i j : ℤ) :
    Module.Basis {e : EnhancedState D // enhancedCochainDegree D e = i ∧
      enhancedQuantumDegree D e = j} R
      (Finsupp {e : EnhancedState D // enhancedCochainDegree D e = i ∧
        enhancedQuantumDegree D e = j} R) :=
  Finsupp.basisSingleOne

/-- One cochain term with the quantum-graded summands retained as object data. -/
def CochainTerm {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i : ℤ) : GradedObject ℤ (ModuleCat.{u} R) :=
  fun j => BigradedTerm D R i j

/-- The underlying cochain module in degree `i`, on the actual finite enhanced-state basis. -/
def CochainModule {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i : ℤ) : ModuleCat.{u} R :=
  ModuleCat.of R <| Finsupp {e : EnhancedState D // enhancedCochainDegree D e = i} R

/-- The cochain module is the direct sum of its finite quantum-degree modules. -/
def cochainModule_quantumDecomposition {n : ℕ} (D : OrientedPDCode n)
    (R : Type u) [CommRing R] (i : ℤ) :
    CochainModule D R i ≅
      (GradedObject.total ℤ (ModuleCat.{u} R)).obj (CochainTerm D R i) := by
  sorry

/-- Enhanced labels on a fixed resolution and fixed quantum degree. -/
def ResolutionBasis {n : ℕ} (D : OrientedPDCode n) (s : Fin n → Bool) (j : ℤ) :=
  {e : EnhancedState D // e.1 = s ∧ enhancedQuantumDegree D e = j}

/-- The local saddle contribution has actual finite-free source and target modules. It is only
available after supplying the planar presentation and a directed A-to-B cube edge. -/
def saddleContribution {n : ℕ} (D : OrientedPDCode n) (hD : D.toPDCode.IsPlanar)
    (R : Type u) [CommRing R] {s t : Fin n → Bool} (edge : CubeEdge s t) (j : ℤ) :
    Finsupp (ResolutionBasis D s j) R →ₗ[R] Finsupp (ResolutionBasis D t j) R := by
  sorry

/-- A single crossing's signed cube contribution, extended over all enhanced source states. Its
basis formula uses the local saddle above multiplied by `cubeIncidenceSign` for the source
resolution. -/
def signedEdgeContribution {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i : ℤ) (crossing : Fin n) :
    CochainModule D R i ⟶ CochainModule D R (i + 1) := by
  sorry

/-- The total cube differential is explicitly the finite sum of signed single-crossing maps. -/
noncomputable def cubeDifferential {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i : ℤ) :
    CochainModule D R i ⟶ CochainModule D R (i + 1) := by
  classical
  exact ∑ crossing : Fin n, signedEdgeContribution D hD R i crossing

/-- The ordinary module-valued cochain complex has exactly the declared `CochainModule` objects
and the displayed signed cube differential. `shape` and `d_comp_d'` are proved from the cochain
shape and two-face cancellation, respectively. -/
noncomputable def khovanovComplex {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] :
    HomologicalComplex (ModuleCat.{u} R) (ComplexShape.up ℤ) where
  X := CochainModule D R
  d := fun i j => if h : i + 1 = j then
    cubeDifferential D hD R i ≫ eqToHom (congrArg (CochainModule D R) h)
    else 0
  shape := by
    intro i j hshape
    by_cases h : i + 1 = j
    · exact (hshape h).elim
    · simp [h]
  d_comp_d' := by
    intro i j k hij hjk
    -- The only composable nonzero terms are adjacent cube edges; opposite face signs cancel.
    sorry

/-- The differential in the complex is the declared sum map for each adjacent cochain degree. -/
theorem khovanovComplex_d_succ {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i : ℤ) :
    (khovanovComplex D hD R).d i (i + 1) = cubeDifferential D hD R i := by
  simp [khovanovComplex]

/-- The signed differential preserves the enhanced-state quantum degree on basis coefficients. -/
def DifferentialQuantumHomogeneous {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] : Prop :=
  ∀ i (e : EnhancedState D) (he : enhancedCochainDegree D e = i)
    (e' : EnhancedState D) (he' : enhancedCochainDegree D e' = i + 1),
      Finsupp.toFun ((cubeDifferential D hD R i).hom (Finsupp.single ⟨e, he⟩ (1 : R)) :
        Finsupp {e : EnhancedState D // enhancedCochainDegree D e = i + 1} R) ⟨e', he'⟩ ≠ 0 →
        enhancedQuantumDegree D e' = enhancedQuantumDegree D e

theorem differential_preserves_quantumDegree {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] :
    DifferentialQuantumHomogeneous D hD R := by
  sorry

/-! ## Quantum-degree complexes -/

/-- Forget the quantum-degree equation in the actual enhanced-state index subtype. -/
def bigradedStateEmbedding {n : ℕ} (D : OrientedPDCode n) (i j : ℤ) :
    {e : EnhancedState D // enhancedCochainDegree D e = i ∧ enhancedQuantumDegree D e = j} ↪
      {e : EnhancedState D // enhancedCochainDegree D e = i} where
  toFun e := ⟨e.1, e.2.1⟩
  inj' a b h := Subtype.ext
    (congrArg (fun e : {e : EnhancedState D // enhancedCochainDegree D e = i} => e.1) h)

/-- The inclusion of a quantum summand is the actual basis-index inclusion. -/
def quantumInclusion {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i j : ℤ) : BigradedTerm D R i j ⟶ CochainModule D R i :=
  ModuleCat.ofHom (Finsupp.lmapDomain R R (bigradedStateEmbedding D i j))

/-- Projection onto a quantum summand restricts coefficients along the same basis embedding. -/
def quantumProjection {n : ℕ} (D : OrientedPDCode n) (R : Type u) [CommRing R]
    (i j : ℤ) : CochainModule D R i ⟶ BigradedTerm D R i j :=
  ModuleCat.ofHom (Finsupp.lcomapDomain (R := R) (M := R)
    (bigradedStateEmbedding D i j) (bigradedStateEmbedding D i j).injective)

/-- The quantum differential is projection of the existing ordinary differential after inclusion.
The preservation theorem above is what makes this restriction a subcomplex differential. -/
def quantumDifferential {n : ℕ} (D : OrientedPDCode n) (hD : D.toPDCode.IsPlanar)
    (R : Type u) [CommRing R] (i j : ℤ) :
    BigradedTerm D R i j ⟶ BigradedTerm D R (i + 1) j :=
  quantumInclusion D R i j ≫ cubeDifferential D hD R i ≫ quantumProjection D R (i + 1) j

/-- Quantum preservation identifies the restricted differential with the ordinary one on the
actual summand; prove this from `differential_preserves_quantumDegree` on the finite basis. -/
theorem quantumDifferential_inclusion {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i j : ℤ) :
    quantumDifferential D hD R i j ≫ quantumInclusion D R (i + 1) j =
      quantumInclusion D R i j ≫ cubeDifferential D hD R i := by
  sorry

/-- The cochain complex at fixed quantum degree, on exactly the declared `BigradedTerm` objects.
Its square-zero proof uses quantum inclusion compatibility and the ordinary complex identity. -/
def khovanovQuantumComplex {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (j : ℤ) :
    HomologicalComplex (ModuleCat.{u} R) (ComplexShape.up ℤ) where
  X := fun i => BigradedTerm D R i j
  d := fun i k => if h : i + 1 = k then
    quantumDifferential D hD R i j ≫ eqToHom (congrArg (fun i => BigradedTerm D R i j) h)
    else 0
  shape := by
    intro i k hshape
    by_cases h : i + 1 = k
    · exact (hshape h).elim
    · simp [h]
  d_comp_d' := by
    intro i k l hik hkl
    sorry

/-- Each quantum complex maps to the ordinary complex by the specified degreewise inclusions. -/
def quantumComplexInclusion {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (j : ℤ) :
    khovanovQuantumComplex D hD R j ⟶ khovanovComplex D hD R where
  f i := quantumInclusion D R i j
  comm' := by
    intro i k h
    sorry

/-- The ordinary complex is the actual coproduct of its quantum subcomplexes. -/
def quantumComplexDirectSumIso {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] :
    khovanovComplex D hD R ≅
      (GradedObject.total ℤ
        (HomologicalComplex (ModuleCat.{u} R) (ComplexShape.up ℤ))).obj
          (fun j => khovanovQuantumComplex D hD R j) := by
  sorry

/-- The direct-sum comparison is pinned by the actual enhanced-state inclusions. -/
theorem quantumComplexDirectSumIso_ι {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (j : ℤ) :
    Limits.Sigma.ι (fun j => khovanovQuantumComplex D hD R j) j ≫
        (quantumComplexDirectSumIso D hD R).inv = quantumComplexInclusion D hD R j := by
  sorry

/-- Khovanov homology in the actual bidegree `(i,j)`. -/
def khovanovBigradedHomology {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i j : ℤ) : ModuleCat.{u} R :=
  (khovanovQuantumComplex D hD R j).homology i

/-- The cohomology module in cochain degree `i` of the actual ordinary module complex. -/
noncomputable def khovanovHomology {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i : ℤ) : ModuleCat.{u} R :=
  (khovanovComplex D hD R).homology i

/-- Cohomology of the ordinary complex decomposes into the actual bigraded homology modules. -/
def khovanovHomology_quantumDirectSumIso {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i : ℤ) :
    khovanovHomology D hD R i ≅
      (GradedObject.total ℤ (ModuleCat.{u} R)).obj
        (fun j => khovanovBigradedHomology D hD R i j) := by
  sorry

/-- The homology decomposition agrees with the maps induced by quantum-complex inclusions. -/
theorem khovanovHomology_quantumDirectSumIso_ι {n : ℕ} (D : OrientedPDCode n)
    (hD : D.toPDCode.IsPlanar) (R : Type u) [CommRing R] (i j : ℤ) :
    Limits.Sigma.ι (fun j => khovanovBigradedHomology D hD R i j) j ≫
        (khovanovHomology_quantumDirectSumIso D hD R i).inv =
      HomologicalComplex.homologyMap (quantumComplexInclusion D hD R j) i := by
  sorry

/-- The finite quantum Euler characteristic is the explicit sum over all enhanced states. The
sign exponent uses `|S|+n₋`, which has the same parity as `|S|-n₋`. -/
noncomputable def quantumEulerCharacteristic {n : ℕ} (D : OrientedPDCode n) :
    ℤ[T;T⁻¹] := by
  classical
  exact Finset.univ.sum (fun e : EnhancedState D =>
    LaurentPolynomial.C ((-1 : ℤ) ^ ((bSmoothingSet e.1).card + negativeCrossingCount D)) *
      LaurentPolynomial.T (enhancedQuantumDegree D e))

/-- The canonical Laurent unit at which the native Jones variable is replaced by `-q`. -/
noncomputable def negLaurentGenerator : (ℤ[T;T⁻¹])ˣ :=
  -(LaurentPolynomial.isUnit_T (R := ℤ) 1).unit

theorem negLaurentGenerator_coe :
    (negLaurentGenerator : ℤ[T;T⁻¹]) = -LaurentPolynomial.T (1 : ℤ) := by
  simp [negLaurentGenerator]

/-- Exact Euler/Jones comparison target. The multiplication by the loop factor changes the Jones
state-sum exponent `k-1` to the enhanced-state rank exponent `k`. -/
theorem quantumEulerCharacteristic_eq_loopFactor_mul_nativeJones
    {n : ℕ} (D : OrientedPDCode n) (hcomponents : 0 < D.toPDCode.componentCount) :
    quantumEulerCharacteristic D =
      (LaurentPolynomial.T (1 : ℤ) + LaurentPolynomial.T (-1 : ℤ)) *
        LaurentPolynomial.eval₂ (Int.castRingHom ℤ[T;T⁻¹]) negLaurentGenerator D.jonesPolynomial := by
  sorry

/-- The empty diagram is the exceptional branch: its single enhanced state gives Euler
characteristic `1`, matching the native empty Jones polynomial without multiplication by the loop
factor. -/
theorem quantumEulerCharacteristic_empty {D : OrientedPDCode 0}
    (hzero : D.toPDCode.crossinglessComponentCount = 0) :
    quantumEulerCharacteristic D = 1 := by
  sorry

end TauCeti.Khovanov
