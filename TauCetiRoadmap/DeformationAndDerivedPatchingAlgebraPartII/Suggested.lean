import Mathlib
import TauCeti.RingTheory.Ideal.AffineBlowup

/-!
# DeformationAndDerivedPatchingAlgebraPartII: representative target signatures

The roadmap is `README.md` in this directory: Kawasaki's Cohen–Macaulay blowing-ups of finite
modules over Noetherian local rings, following Česnavičius, *Macaulayfication of Noetherian
schemes*, §3 (numbering of arXiv:1810.04493v2). This file records the definitions and theorem
signatures that can be stated against the pinned Mathlib and Tau Ceti, together with the unit
tests of the definitions as `example`s. These are suggested forms, not an exhaustive checklist;
the README is definitive where the two differ.

Design choices made explicit here:

* Sequences are ordered `List`s, and every prefix quotient is the actual quotient
  `M ⧸ (Ideal.ofList (rs.take i) • ⊤)`. Nothing is asserted to be invariant under permutation.
* Support dimension is Mathlib's `Module.supportDim`, valued in `WithBot ℕ∞`; the zero module has
  dimension `⊥`. The annihilator product takes an explicit natural cutoff, so no infinite or
  bottom dimension is ever converted to a natural number.
* Local cohomology is Mathlib's `localCohomology J j`. The terminal Cohen–Macaulay condition of a
  CM-secant sequence is written as the vanishing of `H^j_𝔪` below the support dimension
  (`LowLocalCohomologyVanishes`). For a finite module over a Noetherian local ring this is the
  Cohen–Macaulay property of SchemeAndStackFoundations (depth is the first nonvanishing local
  cohomology degree); it is vacuous for the zero module, which is Cohen–Macaulay.
* The affine blow-up algebra `R[I/a]` is supplied by the pinned Tau Ceti as
  `Ideal.affineBlowup I a (Localization.Away a)`, with the open immersions
  `TauCeti.AlgebraicGeometry.affineBlowupι` into `Proj (reesAlgebra.grade I)`.
  `ChartRing` is a type synonym for this supplied algebra's carrier.
* The module blowing-up is the sheaf on `Proj` of the graded Rees module `⊕ Iⁿ M`. Its value on
  the chart of `a ∈ I` is `chartModule I a M`, the `R[I/a]`-span of the image of `M` in `M[1/a]`:
  the image, not the tensor product `R[I/a] ⊗ M`. Cohen–Macaulayness of the blowing-up is stated
  chartwise, at every prime of every chart (`IsCMBlowupChartwise`), which is equivalent because
  the charts of all `a ∈ I` cover the blow-up and the condition is local.

The sheaf construction of the module blowing-up, dualizing complexes and spectral sequences
are README targets only; the closing comment identifies these and the remaining API targets.
-/

namespace TauCetiRoadmap.DeformationAndDerivedPatchingAlgebraPartII

noncomputable section

open scoped Pointwise

universe u

/-! ## Layer K0: annihilator products, secant and CM-secant sequences -/

section Layer0

variable {R : Type u} [CommRing R]

/-- Principal local cohomology of a torsion module: multiplication by `2` gives zero transition
maps on `ℤ/2`, so its degree-one local cohomology supported on `(2)` is zero. -/
example : Subsingleton ((localCohomology (Ideal.span {(2 : ℤ)}) 1).obj
    (ModuleCat.of ℤ (ZMod 2))) := by
  sorry

/-- The quotient of `M` by the submodule generated by the entries of the list `rs`:
`M/(r₁, …, rₛ)M`. -/
abbrev prefixQuotient (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) : Type u :=
  M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))

/-- The quotient by `[2]` is nonzero (`ℤ/2`), not the submodule `2ℤ`. -/
example : Nontrivial (prefixQuotient ℤ ([2] : List ℤ)) := by
  sorry

/-- The quotient by `[2, 3]` is zero, whereas quotienting by their product gives `ℤ/6`. -/
example : Subsingleton (prefixQuotient ℤ ([2, 3] : List ℤ)) := by
  sorry

/-- The local-cohomology annihilator product `a_J(M, d) = ∏_{0 ≤ j < d} Ann_R H^j_J(M)`: a finite
product of ideals (not an intersection), with an explicit natural cutoff `d`. Česnavičius's
`a(M)` is `annihilatorProduct 𝔪 M d` with `d = dim Supp M` for `M ≠ 0` (Definition 3.1(ii),
Remark 3.3, Lemma 3.6). -/
def annihilatorProduct (J : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] (d : ℕ) :
    Ideal R :=
  ∏ j ∈ Finset.range d, Module.annihilator R ((localCohomology J j).obj (ModuleCat.of R M))

/-- Empty product: cutoff zero gives the unit ideal, for every module including `0`. -/
example (J : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] :
    annihilatorProduct J M 0 = ⊤ := by
  simp [annihilatorProduct]

/-- Cutoff two is the product, not the intersection, of the first two annihilators. -/
example (J : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] :
    annihilatorProduct J M 2 =
      Module.annihilator R ((localCohomology J 0).obj (ModuleCat.of R M)) *
        Module.annihilator R ((localCohomology J 1).obj (ModuleCat.of R M)) := by
  sorry

/-- The product lies in each factor below the cutoff. -/
theorem annihilatorProduct_le_annihilator (J : Ideal R) (M : Type u) [AddCommGroup M]
    [Module R M] {j d : ℕ} (h : j < d) :
    annihilatorProduct J M d ≤
      Module.annihilator R ((localCohomology J j).obj (ModuleCat.of R M)) := by
  sorry

variable [IsLocalRing R]

/-- Secant sequences (Česnavičius, Definition 3.1(i)): every entry lies in `𝔪` and every step
strictly lowers the dimension of the support of the prefix quotient. Only the empty list is
secant for the zero module. -/
def IsSecant (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  (∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) ∧
    ∀ i : Fin rs.length,
      Module.supportDim R (prefixQuotient M (rs.take (i.val + 1))) <
        Module.supportDim R (prefixQuotient M (rs.take i.val))

/-- Every secant list for a nonzero finite module extends to a secant system of parameters
with zero-dimensional terminal quotient (Česnavičius, Remark 3.2; Stacks, tag 00KQ). -/
theorem isSecant_exists_append [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] [Nontrivial M] (rs : List R) (h : IsSecant M rs) :
    ∃ qs : List R, IsSecant M (rs ++ qs) ∧
      Module.supportDim R (prefixQuotient M (rs ++ qs)) = 0 := by
  sorry

/-- Local cohomology at `𝔪` vanishes in every degree below the dimension of the support. For a
finite module over a Noetherian local ring this is the Cohen–Macaulay condition
(`Module.IsCohenMacaulay` of SchemeAndStackFoundations); the zero module satisfies it. -/
def LowLocalCohomologyVanishes (R : Type u) [CommRing R] [IsLocalRing R] (M : Type u) [AddCommGroup M] [Module R M] : Prop :=
  ∀ j : ℕ, (j : WithBot ℕ∞) < Module.supportDim R M →
    Subsingleton ((localCohomology (IsLocalRing.maximalIdeal R) j).obj (ModuleCat.of R M))

/-- The power-series DVR has no local cohomology below its dimension one. -/
example : LowLocalCohomologyVanishes (PowerSeries ℚ) (PowerSeries ℚ) := by
  sorry

/-- In `ℚ⟦x⟧⟦y⟧/(x², xy)`, the nonzero class of `x` is maximal-ideal torsion while the
support has dimension one; the low-cohomology predicate therefore fails. -/
example : ¬ LowLocalCohomologyVanishes (PowerSeries (PowerSeries ℚ))
    (PowerSeries (PowerSeries ℚ) ⧸ Ideal.span
      {(PowerSeries.C (PowerSeries.X : PowerSeries ℚ)) ^ 2,
       PowerSeries.C (PowerSeries.X : PowerSeries ℚ) *
         (PowerSeries.X : PowerSeries (PowerSeries ℚ))}) := by
  sorry

/-- CM-secant sequences (Česnavičius, Definition 3.1(ii)): a secant sequence whose terminal
quotient is Cohen–Macaulay and whose `i`-th entry lies in the annihilator product of the
preceding prefix quotient, with the cutoff equal to that quotient's support dimension. Terminal
Cohen–Macaulayness is required only of the final quotient. -/
def IsCMSecant (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  IsSecant M rs ∧ LowLocalCohomologyVanishes R (prefixQuotient M rs) ∧
    ∀ i : Fin rs.length, ∃ d : ℕ,
      Module.supportDim R (prefixQuotient M (rs.take i.val)) = (d : WithBot ℕ∞) ∧
        rs[i] ∈ annihilatorProduct (IsLocalRing.maximalIdeal R) (prefixQuotient M (rs.take i.val)) d

/-- Over the field `ℚ`, the one-dimensional space with the empty list is CM-secant. -/
example : IsCMSecant ℚ ([] : List ℚ) := by sorry

/-- `[0]` is not secant on `ℚ`: the support dimension does not drop. -/
example : ¬ IsSecant ℚ ([0] : List ℚ) := by sorry

/-- On the zero module only the empty list is secant, so only `[]` is CM-secant. -/
example (M : Type u) [AddCommGroup M] [Module R M] [Subsingleton M] (r : R) (rs : List R) :
    IsCMSecant M ([] : List R) ∧ ¬ IsCMSecant M (r :: rs) := by sorry

/-- The regular-terminal reduction needs a nonzero module: zero acts injectively on `0`, but
`[0]` is not secant for `0`. -/
example (M : Type u) [AddCommGroup M] [Module R M] [Subsingleton M] :
    IsSMulRegular M (0 : R) ∧ ¬ IsSecant M ([0] : List R) := by
  sorry

/-- `[X]` is CM-secant for `ℚ⟦X⟧`: the dimension drops from one to zero and `H⁰_𝔪 = 0`. -/
example : IsCMSecant (PowerSeries ℚ) ([PowerSeries.X] : List (PowerSeries ℚ)) := by sorry

/-- `[X²]` is also CM-secant for `ℚ⟦X⟧`: secancy does not single out a uniformizer. -/
example : IsCMSecant (PowerSeries ℚ) ([PowerSeries.X ^ 2] : List (PowerSeries ℚ)) := by
  sorry

/-- The empty list is CM-secant exactly when the module is Cohen–Macaulay. -/
theorem isCMSecant_nil_iff (M : Type u) [AddCommGroup M] [Module R M] :
    IsCMSecant M ([] : List R) ↔ LowLocalCohomologyVanishes R M := by
  sorry

/-- Schenzel's bound (Česnavičius, Remark 3.3; Schenzel 1982, 2.4.2), in its positive-power form:
for a nonempty secant sequence, `a(M)` kills every element of `M/(r₁, …, r_{s-1})M` killed by a
positive power of `rₛ`. No Cohen–Macaulay hypothesis is made. -/
theorem schenzel_torsion_bound [IsNoetherianRing R] (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] (rs : List R) (h : IsSecant M rs) (hne : rs ≠ []) (d : ℕ)
    (hd : Module.supportDim R M = (d : WithBot ℕ∞)) (x : prefixQuotient M rs.dropLast)
    (n : ℕ) (hn : 0 < n) (hx : (rs.getLast hne) ^ n • x = 0) :
    ∀ a ∈ annihilatorProduct (IsLocalRing.maximalIdeal R) M d, a • x = 0 := by
  sorry

/-- A parameter element of a nonzero finite Cohen–Macaulay module is regular: Schenzel's
bound for `[x]` has the unit annihilator product (Česnavičius, Remark 3.3). -/
theorem isSMulRegular_of_isCohenMacaulay [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] [Nontrivial M] (hcm : LowLocalCohomologyVanishes R M)
    (x : R) (hx : x ∈ IsLocalRing.maximalIdeal R)
    (hd : Module.supportDim R (prefixQuotient M [x]) + 1 = Module.supportDim R M) :
    IsSMulRegular M x := by
  sorry

/-- Every secant list on a finite Cohen–Macaulay module is CM-secant, by parameter regularity
and the Cohen–Macaulay regular-quotient criterion (Česnavičius, Remarks 3.3–3.4). -/
theorem IsCMSecant.of_isCohenMacaulay [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] (hcm : LowLocalCohomologyVanishes R M)
    (rs : List R) (hsec : IsSecant M rs) : IsCMSecant M rs := by
  sorry

/-- Every CM-secant sequence of a nonzero finite module extends to a CM-secant system of
parameters (Česnavičius, Remark 3.4). -/
theorem isCMSecant_exists_append [IsNoetherianRing R] (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Nontrivial M] (rs : List R) (h : IsCMSecant M rs) :
    ∃ qs : List R, IsCMSecant M (rs ++ qs) ∧
      Module.supportDim R (prefixQuotient M (rs ++ qs)) = 0 := by
  sorry

/-- For a secant system of parameters, CM-secancy is the `p`-standard condition of type `s - 1`
read on the reversed list (Česnavičius, Remark 3.4; Kawasaki 1996, Definition 2.5): every entry
of the reversed list lies in the annihilator product of the quotient by the entries after it. -/
theorem isCMSecant_iff_pStandard_reverse [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] (rs : List R) (hsec : IsSecant M rs)
    (hpar : Module.supportDim R (prefixQuotient M rs) = 0) :
    IsCMSecant M rs ↔ ∀ i : Fin rs.reverse.length, ∃ d : ℕ,
      Module.supportDim R (prefixQuotient M (rs.reverse.drop (i.val + 1))) =
          (d : WithBot ℕ∞) ∧
        rs.reverse[i] ∈ annihilatorProduct (IsLocalRing.maximalIdeal R)
          (prefixQuotient M (rs.reverse.drop (i.val + 1))) d := by
  sorry

/-- Matlis: if `E` is injective and the residue field embeds in `E`, then
`Hom_R(-, E)` preserves annihilators of finite modules
(Česnavičius, proof of Lemma 3.6(a)). -/
theorem annihilator_eq_annihilator_linearMap_injectiveHull [IsNoetherianRing R]
    (N : Type u) [AddCommGroup N] [Module R N] [Module.Finite R N]
    (E : ModuleCat.{u} R) [CategoryTheory.Injective E]
    (e : (R ⧸ IsLocalRing.maximalIdeal R) →ₗ[R] E) (he : Function.Injective e) :
    Module.annihilator R N = Module.annihilator R (N →ₗ[R] E) := by
  sorry

end Layer0

/-! ## Layer K1: Huneke d-sequences and the Goto–Yamagishi identities -/

section Layer1

variable {R : Type u} [CommRing R]

/-- Huneke's d-sequences (Česnavičius, Definition 3.8): for every `i`, multiplication by `rᵢ` is
injective on the submodule `(r₁, …, rₛ)·(M/(r₁, …, r_{i-1})M)` of the actual prefix quotient. No
properness, finiteness or locality is assumed. -/
def IsDSequence (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  ∀ i : Fin rs.length,
    IsSMulRegular
      ↥(Ideal.ofList rs • (⊤ : Submodule R (prefixQuotient M (rs.take i.val))))
      rs[i]

/-- Every module admits the empty d-sequence. -/
example (M : Type u) [AddCommGroup M] [Module R M] : IsDSequence M ([] : List R) := by
  intro i; exact i.elim0

/-- `[0]` is a d-sequence on `ℚ` although it is not weakly regular. -/
example : IsDSequence ℚ ([0] : List ℚ) ∧ ¬ RingTheory.Sequence.IsWeaklyRegular ℚ ([0] : List ℚ) := by
  sorry

/-- `[1]` is a d-sequence on `ℚ` although it is not regular (its final quotient is zero). -/
example : IsDSequence ℚ ([1] : List ℚ) ∧ ¬ RingTheory.Sequence.IsRegular ℚ ([1] : List ℚ) := by
  sorry

/-- Order matters: `[2, 0]` is a d-sequence on `ℤ`, `[0, 2]` is not. -/
example : IsDSequence ℤ ([2, 0] : List ℤ) ∧ ¬ IsDSequence ℤ ([0, 2] : List ℤ) := by
  sorry

/-- Weakly regular sequences are d-sequences. -/
theorem isDSequence_of_isWeaklyRegular (M : Type u) [AddCommGroup M] [Module R M]
    {rs : List R} (h : RingTheory.Sequence.IsWeaklyRegular M rs) : IsDSequence M rs := by
  sorry

/-- The torsion characterization (Česnavičius, Remark 3.9, with the later index): `rs` is a
d-sequence iff for all `i ≤ j` the `rⱼ`-torsion and the `rᵢrⱼ`-torsion of `M/(r₁, …, r_{i-1})M`
agree. -/
theorem isDSequence_iff_torsion (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) :
    IsDSequence M rs ↔
      ∀ (i j : Fin rs.length), i ≤ j → ∀ x : prefixQuotient M (rs.take i.val),
        (rs[i] * rs[j]) • x = 0 ↔ rs[j] • x = 0 := by
  sorry

/-- Goto–Yamagishi, first equality of (3.10.1): `(Qᵢ :_M rᵢ) ∩ JⁿM = Qᵢ ∩ JⁿM` for `n ≥ 1`, where
`Qᵢ = (r₁, …, r_{i-1})M` and `J = (r₁, …, rₛ)`. -/
theorem goto_yamagishi_colon (M : Type u) [AddCommGroup M] [Module R M] {rs : List R}
    (h : IsDSequence M rs) (i : Fin rs.length) (n : ℕ) (hn : 1 ≤ n) :
    Submodule.comap (rs[i] • (LinearMap.id : M →ₗ[R] M))
        (Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) ⊓
        (Ideal.ofList rs ^ n • (⊤ : Submodule R M)) =
      (Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) ⊓
        (Ideal.ofList rs ^ n • (⊤ : Submodule R M)) := by
  sorry

/-- Goto–Yamagishi, second equality of (3.10.1): `Qᵢ ∩ JⁿM = (r₁, …, r_{i-1})J^{n-1}M` for
`n ≥ 1`. -/
theorem goto_yamagishi_intersection (M : Type u) [AddCommGroup M] [Module R M] {rs : List R}
    (h : IsDSequence M rs) (i : Fin rs.length) (n : ℕ) (hn : 1 ≤ n) :
    (Ideal.ofList (rs.take i.val) • (⊤ : Submodule R M)) ⊓
        (Ideal.ofList rs ^ n • (⊤ : Submodule R M)) =
      ((Ideal.ofList (rs.take i.val) * Ideal.ofList rs ^ (n - 1)) • (⊤ : Submodule R M)) := by
  sorry

end Layer1

/-! ## Layer K2: products of prefix ideals and Kawasaki's conditions -/

section Layer2

variable {R : Type u} [CommRing R]

/-- Kawasaki's ideal `I_s = ∏_{i=1}^{s} (r₁, …, rᵢ)`, the product of the successive prefix ideals
(Česnavičius, Proposition 3.11 and the proof of Theorem 3.14, with the `i`-th factor the `i`-th
prefix). `I₀ = R`; `I_s` is not the `s`-th power of `(r₁, …, rₛ)`. -/
def prefixProduct (rs : List R) (s : ℕ) : Ideal R :=
  ∏ i ∈ Finset.range s, Ideal.ofList (rs.take (i + 1))

/-- `I₀` is the unit ideal. -/
example (rs : List R) : prefixProduct rs 0 = ⊤ := by
  simp [prefixProduct]

/-- `I₂` for `[a, b]` is `(a)(a, b)`. -/
example (a b : R) : prefixProduct [a, b] 2 = Ideal.ofList [a] * Ideal.ofList [a, b] := by
  sorry

/-- For `[2, 3]` over `ℤ`, `I₂ = (2)` while `(2, 3)² = ℤ`. -/
example : prefixProduct ([2, 3] : List ℤ) 2 ≠ Ideal.ofList ([2, 3] : List ℤ) ^ 2 := by
  sorry

/-- A zero first entry kills every positive prefix product. -/
example (b : R) : prefixProduct [0, b] 2 = ⊥ := by
  sorry

/-- The recurrence `I_{s+1} = I_s·(r₁, …, r_{s+1})` used for iterated blowing-ups. -/
theorem prefixProduct_succ (rs : List R) (s : ℕ) :
    prefixProduct rs (s + 1) = prefixProduct rs s * Ideal.ofList (rs.take (s + 1)) := by
  sorry

variable [IsLocalRing R]

/-- Kawasaki's three conditions on a list `rs = (r₁, …, rₛ)` relative to `M` (Česnavičius,
Proposition 3.11 (i)–(iii)), quantified over every auxiliary list `as` secant for
`M/(r₁, …, rₛ)M`: (i) the reversed list is a d-sequence on `M/(as)M`; (ii) for `s ≥ 2` and
`m, n > 0` the `rₛᵐ`-torsion and the `(r₁, …, rₛ)`-torsion of `M'/I_{s-1}ⁿM'` agree, with
`M' = M/(as)M`; (iii) for nonempty `as` with last entry `a` and `M' = M/(as without a)M`, if `a`
is regular on `M'/(r₁, …, rₛ)M'` then it is regular on `M'` and on every `M'/I_sⁿM'`, `n > 0`. -/
def KawasakiConditions (M : Type u) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  (∀ as : List R, IsSecant (prefixQuotient M rs) as →
      IsDSequence (prefixQuotient M as) rs.reverse) ∧
    (∀ hlen : 2 ≤ rs.length, ∀ as : List R, IsSecant (prefixQuotient M rs) as →
      ∀ m n : ℕ, 0 < m → 0 < n →
        ∀ x : prefixQuotient M as ⧸
            (prefixProduct rs (rs.length - 1) ^ n • (⊤ : Submodule R (prefixQuotient M as))),
          (rs[rs.length - 1]'(by omega)) ^ m • x = 0 ↔ ∀ a ∈ Ideal.ofList rs, a • x = 0) ∧
    (∀ as : List R, IsSecant (prefixQuotient M rs) as → ∀ hne : as ≠ [],
      IsSMulRegular (prefixQuotient (prefixQuotient M as.dropLast) rs) (as.getLast hne) →
        IsSMulRegular (prefixQuotient M as.dropLast) (as.getLast hne) ∧
          ∀ n : ℕ, 0 < n →
            IsSMulRegular
              (prefixQuotient M as.dropLast ⧸
                (prefixProduct rs rs.length ^ n • (⊤ : Submodule R (prefixQuotient M as.dropLast))))
              (as.getLast hne))

/-- The empty list satisfies Kawasaki's conditions on every module. -/
example (M : Type u) [AddCommGroup M] [Module R M] : KawasakiConditions M ([] : List R) := by
  sorry

/-- Every list satisfies Kawasaki's conditions on the zero module. -/
example (M : Type u) [AddCommGroup M] [Module R M] [Subsingleton M] (rs : List R) :
    KawasakiConditions M rs := by
  sorry

/-- Non-example: on `ℚ⟦X⟧/(X²)` the list `[X]` fails condition (i) with the empty auxiliary
list, since `X` kills `X·(ℚ⟦X⟧/(X²)) ≠ 0`. -/
example : ¬ KawasakiConditions (PowerSeries ℚ ⧸ Ideal.span {(PowerSeries.X : PowerSeries ℚ) ^ 2})
    ([PowerSeries.X] : List (PowerSeries ℚ)) := by
  sorry

/-- Kawasaki (Česnavičius, Proposition 3.11): every initial segment of a CM-secant sequence
satisfies Kawasaki's conditions. -/
theorem kawasakiConditions_take_of_isCMSecant [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] {rs : List R} (h : IsCMSecant M rs) {s : ℕ}
    (hs : s ≤ rs.length) : KawasakiConditions M (rs.take s) := by
  sorry

/-- Robustness (Česnavičius, Remark 3.12): Kawasaki's conditions for `rs` persist after dividing
`M` by any auxiliary list secant for `M/(rs)M`. -/
theorem KawasakiConditions.prefixQuotient [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] {rs as : List R} (h : KawasakiConditions M rs)
    (has : IsSecant (prefixQuotient M rs) as) :
    KawasakiConditions (prefixQuotient M as) rs := by
  sorry

end Layer2

/-! ## Layer K3: Rees modules, blow-up charts and module blowing-ups -/

section Layer3

variable {R : Type u} [CommRing R]

/-- The graded Rees module `⊕ₙ IⁿM` as a `reesAlgebra I`-submodule of `PolynomialModule R M`: the
coefficient of degree `n` lies in `IⁿM` (Česnavičius, §3.13). In degree `n` it is `IⁿM`, not
`M ⊗ Iⁿ`. -/
def reesModule (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] :
    Submodule (reesAlgebra I) (PolynomialModule R M) where
  carrier := {p | ∀ n, p.coeff n ∈ (I ^ n • (⊤ : Submodule R M))}
  zero_mem' := by intro n; simp
  add_mem' := by
    intro p q hp hq n
    simpa using (I ^ n • (⊤ : Submodule R M)).add_mem (hp n) (hq n)
  smul_mem' := by
    intro f p hp n
    change ((f : Polynomial R) • p).coeff n ∈ (I ^ n • (⊤ : Submodule R M))
    rw [PolynomialModule.smul_apply]
    apply Submodule.sum_mem
    intro ij hij
    rw [← Finset.HasAntidiagonal.mem_antidiagonal.mp hij, pow_add, Submodule.mul_smul]
    exact Submodule.smul_mem_smul (f.property ij.1) (hp ij.2)

/-- Membership is coefficientwise membership in `IⁿM`. -/
theorem mem_reesModule_iff (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M]
    (p : PolynomialModule R M) :
    p ∈ reesModule I M ↔ ∀ n, p.coeff n ∈ (I ^ n • (⊤ : Submodule R M)) :=
  Iff.rfl

/-- Degree zero is unrestricted, even for the zero ideal. -/
example (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] (m : M) :
    PolynomialModule.single R 0 m ∈ reesModule I M := by
  sorry

/-- For `I = 0` over `ℤ`, the degree-one element `1·t` is not in the Rees module. -/
example : PolynomialModule.single ℤ 1 (1 : ℤ) ∉ reesModule (⊥ : Ideal ℤ) ℤ := by
  sorry

/-- For `I = (2)` and `M = ℤ/2`, the degree-one element `1·t` is excluded (`2·(ℤ/2) = 0`), although
`ℤ/2 ⊗ Rees(I)` has a nonzero degree-one part. -/
example : PolynomialModule.single ℤ 1 (1 : ZMod 2) ∉ reesModule (Ideal.span {(2 : ℤ)}) (ZMod 2) := by
  sorry

/-- For the unit ideal the Rees module is the whole polynomial module. -/
example (M : Type u) [AddCommGroup M] [Module R M] : reesModule (⊤ : Ideal R) M = ⊤ := by
  sorry

/-- The chart ring `R[I/a]` as a commutative ring with a single ring structure, so that its
localizations and modules carry no competing instances. Its carrier is Tau Ceti's
`Ideal.affineBlowup I a (Localization.Away a)`. -/
def ChartRing (I : Ideal R) (a : R) : Type u := I.affineBlowup a (Localization.Away a)

instance (I : Ideal R) (a : R) : CommRing (ChartRing I a) :=
  (I.affineBlowup a (Localization.Away a)).toCommRing

instance (I : Ideal R) (a : R) : Algebra R (ChartRing I a) :=
  (I.affineBlowup a (Localization.Away a)).algebra

/-- The inclusion `R[I/a] → R[1/a]`. -/
def ChartRing.toLocalization (I : Ideal R) (a : R) : ChartRing I a →+* Localization.Away a :=
  (I.affineBlowup a (Localization.Away a)).val.toRingHom

/-- `R[I/a]` acts on `M[1/a]` through `R[1/a]`. -/
instance ChartRing.moduleLocalizedModule (I : Ideal R) (a : R) (M : Type u) [AddCommGroup M]
    [Module R M] : Module (ChartRing I a) (LocalizedModule (Submonoid.powers a) M) :=
  letI : Module (Localization.Away a) (LocalizedModule (Submonoid.powers a) M) :=
    LocalizedModule.moduleOfIsLocalization
  Module.compHom _ (ChartRing.toLocalization I a)

/-- The chart module `M_(a)`: the `R[I/a]`-submodule of `M[1/a]` spanned by the image of `M`
(Česnavičius, §3.13). For `a ∈ I`, it is the value of the module blowing-up on `D₊(a t)`;
it is the image of `R[I/a] ⊗_R M`, not that tensor product. -/
def chartModule (I : Ideal R) (a : R) (M : Type u) [AddCommGroup M] [Module R M] :
    Submodule (ChartRing I a) (LocalizedModule (Submonoid.powers a) M) :=
  Submodule.span (ChartRing I a) (Set.range (LocalizedModule.mkLinearMap (Submonoid.powers a) M))

/-- `ℤ/2` blown up along `(2)`: the chart module at `2` is zero, while `ℤ[(2)/2] ⊗ ℤ/2 = ℤ/2`. -/
example : Subsingleton (chartModule (Ideal.span {(2 : ℤ)}) 2 (ZMod 2)) := by
  sorry

/-- Unit ideal, unit chart: the chart module is everything. -/
example (M : Type u) [AddCommGroup M] [Module R M] : chartModule (⊤ : Ideal R) 1 M = ⊤ := by
  sorry

/-- The chart element `a` is regular on `M_(a)`. For `a ∈ I`, the module blowing-up has no
nonzero sections supported on the exceptional divisor (Česnavičius, §3.13). -/
theorem chartModule_isSMulRegular (I : Ideal R) (a : R) (M : Type u) [AddCommGroup M]
    [Module R M] : IsSMulRegular (chartModule I a M) (algebraMap R (ChartRing I a) a) := by
  sorry

/-- A chart scalar kills `M_(a)` exactly when it kills the image of `M` in `M[1/a]`; this is the
chart form of the support of the module blowing-up when `a ∈ I`. -/
theorem mem_annihilator_chartModule_iff (I : Ideal R) (a : R) (M : Type u) [AddCommGroup M]
    [Module R M] (x : ChartRing I a) :
    x ∈ Module.annihilator (ChartRing I a) (chartModule I a M) ↔
      ∀ m : M, x • LocalizedModule.mkLinearMap (Submonoid.powers a) M m = 0 := by
  sorry

/-- In an injective finite-type extension of Noetherian domains, prime height plus residue
transcendence degree is bounded by the base height plus generic transcendence degree
(Stacks, Lemma 10.113.1, tag 02IJ). -/
theorem finiteType_height_le (A B : Type u) [CommRing A] [CommRing B] [IsDomain A]
    [IsDomain B] [IsNoetherianRing A] [Algebra A B] [Algebra.FiniteType A B]
    (hinj : Function.Injective (algebraMap A B)) (p : Ideal A) [p.IsPrime]
    (q : Ideal B) [q.IsPrime] (hover : p = q.comap (algebraMap A B)) :
    letI : Algebra p.ResidueField q.ResidueField :=
      (Ideal.ResidueField.map p q (algebraMap A B) hover).toAlgebra
    q.height + ((Algebra.trdeg p.ResidueField q.ResidueField).toNat : ℕ∞) ≤
      p.height + ((Algebra.trdeg A B).toNat : ℕ∞) := by
  sorry

/-- The Rees algebra of an ideal of a Noetherian ring has dimension at most `dim R + 1`
(using `finiteType_height_le` on each minimal-prime quotient). -/
theorem ringKrullDim_reesAlgebra_le [IsNoetherianRing R] (I : Ideal R) :
    ringKrullDim (reesAlgebra I) ≤ ringKrullDim R + 1 := by
  sorry

/-- Chart form of the dimension bound: the support of the module blowing-up on any chart has
dimension at most `dim Supp M`. -/
theorem supportDim_chartModule_le [IsNoetherianRing R] (I : Ideal R) (a : R) (ha : a ∈ I)
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    Module.supportDim (ChartRing I a) (chartModule I a M) ≤ Module.supportDim R M := by
  sorry

end Layer3

/-! ## Layer K4: Cohen–Macaulay blowing-ups -/

section Layer4

variable {R : Type u} [CommRing R]

/-- The module blowing-up `Bl_I(M)` is Cohen–Macaulay, tested on the chart of every `a ∈ I` at every
prime: the localized chart module has vanishing local cohomology below its support dimension. -/
def IsCMBlowupChartwise (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] : Prop :=
  ∀ a ∈ I, ∀ p : PrimeSpectrum (ChartRing I a),
    LowLocalCohomologyVanishes (Localization.AtPrime p.asIdeal)
      (LocalizedModule p.asIdeal.primeCompl (chartModule I a M))

/-- The zero module has Cohen–Macaulay blowing-ups along every ideal. -/
example (I : Ideal R) (M : Type u) [AddCommGroup M] [Module R M] [Subsingleton M] :
    IsCMBlowupChartwise I M := by
  sorry

/-- The zero ideal has empty blow-up, so chartwise Cohen–Macaulayness holds for every module. -/
example (M : Type u) [AddCommGroup M] [Module R M] :
    IsCMBlowupChartwise (⊥ : Ideal R) M := by
  sorry

/-- Over a field, blowing up the unit ideal gives the field itself, which is Cohen–Macaulay. -/
example : IsCMBlowupChartwise (⊤ : Ideal ℚ) ℚ := by
  sorry

/-- The corrected chart relation (Česnavičius, (3.14.10)): if `a` and `b` kill `H¹_{(a,b)}(M)`,
then `b T - a` kills `H¹_{(a,b)}(M[T])` over `R[T]`. The Noetherian hypothesis gives the flat base
change `H¹_{(a,b)}(M[T]) ≅ H¹_{(a,b)}(M) ⊗_R R[T]`. -/
theorem chart_relation_mem_annihilator [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] (a b : R)
    (ha : a ∈ Module.annihilator R
      ((localCohomology (Ideal.ofList [a, b]) 1).obj (ModuleCat.of R M)))
    (hb : b ∈ Module.annihilator R
      ((localCohomology (Ideal.ofList [a, b]) 1).obj (ModuleCat.of R M))) :
    Polynomial.C b * Polynomial.X - Polynomial.C a ∈
      Module.annihilator (Polynomial R)
        ((localCohomology (Ideal.ofList [Polynomial.C a, Polynomial.C b]) 1).obj
          (ModuleCat.of (Polynomial R) (PolynomialModule R M))) := by
  sorry

variable [IsLocalRing R]

/-- Kawasaki's depth induction (Česnavičius, proof of Theorem 3.14): if `r₁, …, rₛ` is secant for
`M` and every initial segment satisfies Kawasaki's conditions, then the chart modules of
`Bl_{I_s}(M)` have depth at least `s` at every closed point over `𝔪`. -/
theorem depth_ge_of_kawasakiConditions [IsNoetherianRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] (rs : List R) (hsec : IsSecant M rs)
    (hp : ∀ j ≤ rs.length, KawasakiConditions M (rs.take j)) (a : R)
    (ha : a ∈ prefixProduct rs rs.length)
    (p : PrimeSpectrum (ChartRing (prefixProduct rs rs.length) a)) (hclosed : p.asIdeal.IsMaximal)
    (hover : p.asIdeal.comap (algebraMap R (ChartRing (prefixProduct rs rs.length) a)) =
      IsLocalRing.maximalIdeal R)
    (j : ℕ) (hj : j < rs.length) :
    Subsingleton ((localCohomology (IsLocalRing.maximalIdeal (Localization.AtPrime p.asIdeal)) j).obj
      (ModuleCat.of (Localization.AtPrime p.asIdeal)
        (LocalizedModule p.asIdeal.primeCompl
          (chartModule (prefixProduct rs rs.length) a M)))) := by
  sorry

/-- Kawasaki's theorem under weaker hypotheses (Česnavičius, proof of Theorem 3.14): a list secant
for `M` whose initial segments satisfy Kawasaki's conditions and whose terminal quotient is
Cohen–Macaulay. -/
theorem isCMBlowupChartwise_of_kawasakiConditions [IsNoetherianRing R] (M : Type u)
    [AddCommGroup M] [Module R M] [Module.Finite R M] (rs : List R) (hsec : IsSecant M rs)
    (hterm : LowLocalCohomologyVanishes R (prefixQuotient M rs))
    (hp : ∀ j ≤ rs.length, KawasakiConditions M (rs.take j)) :
    IsCMBlowupChartwise (prefixProduct rs rs.length) M := by
  sorry

/-- **Kawasaki's theorem** (Česnavičius, Theorem 3.14): for a CM-secant sequence `r₁, …, rₜ` of a
finite module `M` over a Noetherian local ring, the blowing-up of `M` along
`I = ∏_{i=1}^{t} (r₁, …, rᵢ)` is Cohen–Macaulay. -/
theorem isCMBlowupChartwise_prefixProduct_of_isCMSecant [IsNoetherianRing R] (M : Type u)
    [AddCommGroup M] [Module R M] [Module.Finite R M] (rs : List R) (h : IsCMSecant M rs) :
    IsCMBlowupChartwise (prefixProduct rs rs.length) M := by
  sorry

end Layer4

/-- A Cohen–Macaulay local ring whose blowing-up at the maximal ideal is not Cohen–Macaulay
(Huckaba's example, recorded in Heinzer–Johnston–Lantz–Shah, Example 3.6): `k[x³, x⁵y³, x¹⁵y², y⁷]` localized at its maximal
ideal of positive-degree elements; on the chart of `x³` the local ring at the origin has depth
one and dimension two. -/
theorem exists_isCohenMacaulay_not_isCMBlowupChartwise_maximalIdeal :
    ∃ (A : Type u) (_ : CommRing A) (_ : IsNoetherianRing A) (_ : IsLocalRing A),
      LowLocalCohomologyVanishes A A ∧ ¬ IsCMBlowupChartwise (IsLocalRing.maximalIdeal A) A := by
  sorry

/-! ## Concrete boundary Checks

The power-series notation below represents the concrete rings in the README Checks. -/

section BoundaryChecks

local notation "S₁" => PowerSeries ℚ
local notation "S₂" => PowerSeries (PowerSeries ℚ)
local notation "S₃" => PowerSeries (PowerSeries (PowerSeries ℚ))
local notation "x₁" => (PowerSeries.X : S₁)
local notation "x₂" => (PowerSeries.C x₁ : S₂)
local notation "y₂" => (PowerSeries.X : S₂)
local notation "x₃" => (PowerSeries.C x₂ : S₃)
local notation "y₃" => (PowerSeries.C y₂ : S₃)
local notation "z₃" => (PowerSeries.X : S₃)
local notation "N₂" => (S₂ ⧸ Ideal.span {x₂ ^ 2, x₂ * y₂})
local notation "N₃" => (S₃ ⧸ Ideal.span {x₃ ^ 2, x₃ * y₃})
local notation "C₂" => (S₂ ⧸ Ideal.span {x₂ * y₂})
local notation "S₄" => PowerSeries (PowerSeries (PowerSeries (PowerSeries ℚ)))
local notation "x₄" => (PowerSeries.C x₃ : S₄)
local notation "y₄" => (PowerSeries.C y₃ : S₄)
local notation "z₄" => (PowerSeries.C z₃ : S₄)
local notation "w₄" => (PowerSeries.X : S₄)

/-- The empty prefix quotient of `ℤ` retains its nonzero elements. -/
example : Nontrivial (prefixQuotient ℤ ([] : List ℤ)) := by sorry

/-- The principal DVR computation puts nonvanishing in degree one. -/
example : Subsingleton ((localCohomology (Ideal.span {x₁}) 0).obj (ModuleCat.of S₁ S₁)) ∧
    Nontrivial ((localCohomology (Ideal.span {x₁}) 1).obj (ModuleCat.of S₁ S₁)) := by sorry

/-- A residue module is entirely degree-zero torsion and has no degree-one cohomology. -/
example : Nontrivial ((localCohomology (Ideal.span {x₁}) 0).obj
      (ModuleCat.of S₁ (S₁ ⧸ Ideal.span {x₁}))) ∧
    Subsingleton ((localCohomology (Ideal.span {x₁}) 1).obj
      (ModuleCat.of S₁ (S₁ ⧸ Ideal.span {x₁}))) := by sorry

/-- The two-dimensional regular local ring has its first nonzero local cohomology in degree two. -/
example : Subsingleton ((localCohomology (Ideal.ofList [x₂,y₂]) 0).obj (ModuleCat.of S₂ S₂)) ∧
    Subsingleton ((localCohomology (Ideal.ofList [x₂,y₂]) 1).obj (ModuleCat.of S₂ S₂)) ∧
    Nontrivial ((localCohomology (Ideal.ofList [x₂,y₂]) 2).obj (ModuleCat.of S₂ S₂)) := by sorry

/-- Cutoff one retains `(X²)`, rather than its radical `(X)`. -/
example : annihilatorProduct (IsLocalRing.maximalIdeal S₁) (S₁ ⧸ Ideal.span {x₁ ^ 2}) 1 =
      Ideal.span {x₁ ^ 2} ∧
    annihilatorProduct (IsLocalRing.maximalIdeal S₁) (S₁ ⧸ Ideal.span {x₁ ^ 2}) 1 ≠
      Ideal.span {x₁} := by sorry

/-- Every cutoff gives the unit annihilator product on a zero module. -/
example {R : Type u} [CommRing R] (J : Ideal R) (M : Type u) [AddCommGroup M] [Module R M]
    [Subsingleton M] (d : ℕ) : annihilatorProduct J M d = ⊤ := by sorry

/-- The summands `k` and `R/(y)` give product `(xy,y²)` and intersection `(y)`. -/
example : let M := (S₂ ⧸ Ideal.ofList [x₂,y₂]) × (S₂ ⧸ Ideal.span {y₂})
    annihilatorProduct (IsLocalRing.maximalIdeal S₂) M 2 = Ideal.span {x₂*y₂, y₂^2} ∧
    (Module.annihilator S₂ ((localCohomology (IsLocalRing.maximalIdeal S₂) 0).obj
        (ModuleCat.of S₂ M)) ⊓
      Module.annihilator S₂ ((localCohomology (IsLocalRing.maximalIdeal S₂) 1).obj
        (ModuleCat.of S₂ M))) = Ideal.span {y₂} ∧
    y₂ ∉ annihilatorProduct (IsLocalRing.maximalIdeal S₂) M 2 := by sorry

/-- Repeating `X` fails the second dimension drop. -/
example : ¬ IsSecant S₁ [x₁,x₁] := by sorry

/-- A unit entry cannot belong to the maximal ideal. -/
example {R : Type u} [CommRing R] [IsLocalRing R] (M : Type u) [AddCommGroup M] [Module R M] :
    ¬ IsSecant M ([1] : List R) := by sorry

/-- The zero module satisfies the low-cohomology condition vacuously. -/
example {R : Type u} [CommRing R] [IsLocalRing R] (M : Type u) [AddCommGroup M] [Module R M]
    [Subsingleton M] : LowLocalCohomologyVanishes R M := by sorry

/-- The embedded-point module is CM-secant along `y` although `y` is a zero divisor. -/
example : IsCMSecant N₂ [y₂] ∧ ¬ IsSMulRegular N₂ y₂ ∧
    ¬ LowLocalCohomologyVanishes S₂ N₂ := by sorry

/-- Its nonzero `x`-class is killed by `y` and by the annihilator product `𝔪`. -/
example : let x := Ideal.Quotient.mk (Ideal.span {x₂^2, x₂*y₂}) x₂
    x ≠ 0 ∧ y₂ • x = 0 ∧
      annihilatorProduct (IsLocalRing.maximalIdeal S₂) N₂ 1 = IsLocalRing.maximalIdeal S₂ ∧
      ∀ a ∈ IsLocalRing.maximalIdeal S₂, a • x = 0 := by sorry

/-- Both the empty and the one-entry partial parameter lists complete in dimensions zero and one. -/
example : IsSecant (S₁ ⧸ Ideal.span {x₁}) ([] : List S₁) ∧
    Module.supportDim S₁ (prefixQuotient (S₁ ⧸ Ideal.span {x₁}) ([] : List S₁)) = 0 ∧
    IsSecant S₂ [x₂,y₂] ∧ Module.supportDim S₂ (prefixQuotient S₂ [x₂,y₂]) = 0 := by sorry

/-- The regular parameter list `[x,y]` is CM-secant, with the reversed annihilator memberships. -/
example : IsCMSecant S₂ [x₂,y₂] ∧
    y₂ ∈ annihilatorProduct (IsLocalRing.maximalIdeal S₂) (prefixQuotient S₂ [x₂]) 1 ∧
    x₂ ∈ annihilatorProduct (IsLocalRing.maximalIdeal S₂) S₂ 2 := by sorry

/-- The alternative parameter `x+y` is CM-secant on the embedded-point module. -/
example : IsCMSecant N₂ [x₂+y₂] ∧
    Module.supportDim S₂ (prefixQuotient N₂ [x₂+y₂]) = 0 := by sorry

/-- A nonessential residue-field embedding into an injective vector space still preserves
annihilators. -/
example : Module.annihilator ℚ (ℚ →ₗ[ℚ] (ℚ × ℚ)) = ⊥ := by sorry

/-- The residue module and its Matlis dual have maximal-ideal annihilator. -/
example : let E := ((localCohomology (IsLocalRing.maximalIdeal S₁) 1).obj (ModuleCat.of S₁ S₁))
    Module.annihilator S₁ (S₁ ⧸ Ideal.span {x₁}) = IsLocalRing.maximalIdeal S₁ ∧
    Module.annihilator S₁ ((S₁ ⧸ Ideal.span {x₁}) →ₗ[S₁] E) = IsLocalRing.maximalIdeal S₁ := by sorry

/-- The dual of a zero module is zero, so its annihilator is the unit ideal. -/
example {R : Type u} [CommRing R] (M E : Type u) [AddCommGroup M] [Module R M]
    [Subsingleton M] [AddCommGroup E] [Module R E] :
    Module.annihilator R M = ⊤ ∧ Module.annihilator R (M →ₗ[R] E) = ⊤ := by sorry

/-- The DVR injective hull `H¹_𝔪(R)` is faithful, as is `Hom_R(R,E)`. -/
example : let E := ((localCohomology (IsLocalRing.maximalIdeal S₁) 1).obj (ModuleCat.of S₁ S₁))
    Module.annihilator S₁ E = ⊥ ∧ Module.annihilator S₁ (S₁ →ₗ[S₁] E) = ⊥ := by sorry

/-- The later torsion index detects `R/(u) × R`; the `t`-torsion is zero. -/
example : let M := (S₂ ⧸ Ideal.span {y₂}) × S₂
    IsDSequence M [x₂,y₂] ∧ IsSMulRegular M x₂ ∧
    (∀ z : M, (x₂*y₂) • z = 0 ↔ y₂ • z = 0) ∧
    ∃ z : M, z ≠ 0 ∧ y₂ • z = 0 ∧ x₂ • z ≠ 0 := by sorry

/-- At exponent zero the colon identity for `[0]` on `ℚ` fails. -/
example : Submodule.comap ((0 : ℚ) • (LinearMap.id : ℚ →ₗ[ℚ] ℚ))
    (⊥ : Submodule ℚ ℚ) ≠ (⊥ : Submodule ℚ ℚ) := by sorry

/-- The regular two-variable intersection is `(x²,xy)`. -/
example : (Ideal.span {x₂} ⊓ Ideal.ofList [x₂,y₂] ^ 2) = Ideal.span {x₂^2,x₂*y₂} := by sorry

/-- The one-dimensional regular parameter satisfies Kawasaki's three conditions. -/
example : KawasakiConditions S₁ [x₁] := by sorry

/-- Auxiliary division by `y` preserves the conditions of `[x]`. -/
example : IsSecant (prefixQuotient S₂ [x₂]) [y₂] ∧
    KawasakiConditions (prefixQuotient S₂ [y₂]) [x₂] := by sorry

/-- Reversal is essential for the CM-secant list `[y,z]` on the embedded-line module. -/
example : IsCMSecant N₃ [y₃,z₃] ∧ IsDSequence N₃ [z₃,y₃] ∧ ¬ IsDSequence N₃ [y₃,z₃] ∧
    (Ideal.Quotient.mk (Ideal.span {x₃^2,x₃*y₃}) (x₃*z₃)) ≠ 0 := by sorry

/-- On `R/(x)`, positive powers of `y` are regular while `x` kills the entire quotient. -/
example (m : ℕ) (hm : 0 < m) : IsSMulRegular (S₂ ⧸ Ideal.span {x₂}) (y₂^m) ∧
    (∀ z : S₂ ⧸ Ideal.span {x₂},
      (∀ a ∈ Ideal.ofList [x₂,y₂], a • z = 0) ↔ z = 0) ∧
    (∀ z : S₂ ⧸ Ideal.span {x₂}, x₂ • z = 0) ∧ Nontrivial (S₂ ⧸ Ideal.span {x₂}) := by sorry

/-- At exponent two, `(x)`-torsion is nonzero but `y` remains regular. -/
example : IsSMulRegular (S₂ ⧸ Ideal.span {x₂^2}) y₂ ∧
    ∃ z : S₂ ⧸ Ideal.span {x₂^2}, z ≠ 0 ∧ x₂ • z = 0 := by sorry

/-- The auxiliary parameter `z` remains regular modulo every positive prefix-product power. -/
example (n : ℕ) (hn : 0 < n) : IsSMulRegular (prefixQuotient S₃ [x₃,y₃]) z₃ ∧
    IsSMulRegular S₃ z₃ ∧
    IsSMulRegular (S₃ ⧸ prefixProduct [x₃,y₃] 2 ^ n) z₃ := by sorry

/-- The principal zero-divisor chart kills the nonzero `y`-class. -/
example : let x := Ideal.Quotient.mk (Ideal.span {x₂*y₂}) x₂
    let y := Ideal.Quotient.mk (Ideal.span {x₂*y₂}) y₂
    y ≠ 0 ∧ LocalizedModule.mkLinearMap (Submonoid.powers x) C₂ y = 0 ∧
      Nontrivial (chartModule (Ideal.span {x}) x C₂) := by sorry

/-- The self-module chart is the chart ring as a module. -/
example {R : Type u} [CommRing R] (I : Ideal R) (a : R) :
    Nonempty (chartModule I a R ≃ₗ[ChartRing I a] ChartRing I a) := by sorry

/-- The unit centre retains the embedded point and fails chartwise Cohen–Macaulayness. -/
example : ¬ IsCMBlowupChartwise (⊤ : Ideal N₂) N₂ := by sorry

/-- The zero and unit Rees algebras over a DVR have dimensions one and two. -/
example : ringKrullDim (reesAlgebra (⊥ : Ideal S₁)) = 1 ∧
    ringKrullDim (reesAlgebra (⊤ : Ideal S₁)) = 2 := by sorry

/-- Without quotient regularity the degree-one map has a nonzero source and zero image. -/
example : let P : Submodule S₁ S₁ := Ideal.span {x₁} • (⊤ : Submodule S₁ S₁)
    Nontrivial (↥P ⧸ (x₁ • (⊤ : Submodule S₁ ↥P))) ∧
    Ideal.span {x₁} • (⊤ : Submodule S₁ (S₁ ⧸ Ideal.span {x₁})) = ⊥ := by sorry

/-- The torsion-supported module has empty chart support, strictly below its base support dimension. -/
example : Module.supportDim (ChartRing (Ideal.span {(2 : ℤ)}) 2)
      (chartModule (Ideal.span {(2 : ℤ)}) 2 (ZMod 2)) = ⊥ ∧
    Module.supportDim ℤ (ZMod 2) = 0 := by sorry

/-- The chart relation fails to annihilate local cohomology when its coefficient hypotheses fail. -/
example : Polynomial.C y₂ * Polynomial.X - Polynomial.C x₂ ∉
    Module.annihilator (Polynomial S₂)
      ((localCohomology (Ideal.ofList [Polynomial.C x₂, Polynomial.C y₂]) 1).obj
        (ModuleCat.of (Polynomial S₂) (PolynomialModule S₂ C₂))) := by sorry

/-- Unit support has zero cohomology; zero support retains the module only in degree zero. -/
example : (∀ j, Subsingleton ((localCohomology (⊤ : Ideal ℤ) j).obj (ModuleCat.of ℤ ℤ))) ∧
    Nontrivial ((localCohomology (⊥ : Ideal ℤ) 0).obj (ModuleCat.of ℤ ℤ)) ∧
    (∀ j, 0 < j → Subsingleton ((localCohomology (⊥ : Ideal ℤ) j).obj
      (ModuleCat.of ℤ ℤ))) := by sorry

/-- Two successive principal supports recover nonzero degree-two cohomology. -/
example : Nontrivial ((localCohomology (Ideal.span {y₂}) 1).obj
    ((localCohomology (Ideal.span {x₂}) 1).obj (ModuleCat.of S₂ S₂))) := by sorry

/-- The DVR cohomology is torsion of unbounded exponent, with no higher supported cohomology. -/
example : let T := ((localCohomology (Ideal.span {x₁}) 1).obj (ModuleCat.of S₁ S₁))
    Nontrivial ((localCohomology (Ideal.span {x₁}) 0).obj T) ∧
    (∀ j, 0 < j → Subsingleton ((localCohomology (Ideal.span {x₁}) j).obj T)) ∧
    (∀ n : ℕ, ∃ z : T, x₁^(n+1) • z = 0 ∧ x₁^n • z ≠ 0) := by sorry

/-- A polynomial variable gives a nonzero outer-degree-one contribution. -/
example : Nontrivial ((localCohomology (Ideal.span {(Polynomial.X : Polynomial S₁)}) 1).obj
    ((localCohomology (Ideal.span {Polynomial.C x₁}) 1).obj
      (ModuleCat.of (Polynomial S₁) (Polynomial S₁)))) := by sorry

/-- Quotient change of rings retains degree-one cohomology killed by the quotient relation. -/
example : let H := ((localCohomology (Ideal.ofList [x₂,y₂]) 1).obj
      (ModuleCat.of S₂ (S₂ ⧸ Ideal.span {y₂})))
    Nontrivial H ∧ y₂ ∈ Module.annihilator S₂ H := by sorry

/-- Inverting the support generator removes all supported cohomology. -/
example : ∀ j, Subsingleton ((localCohomology (Ideal.span {x₁}) j).obj
    (ModuleCat.of S₁ (Localization.Away x₁))) := by sorry

/-- The canonical colimit map of a constant filtered diagram preserves DVR cohomology. -/
example : let H := ((localCohomology (Ideal.span {x₁}) 1).obj (ModuleCat.of S₁ S₁))
    Function.Bijective (CategoryTheory.Limits.colimit.ι
      ((CategoryTheory.Functor.const ℕ).obj H) 0) := by sorry

/-- Both parameters are regular, and their square quotient is zero-dimensional with no low cohomology. -/
example : IsSMulRegular S₁ x₁ ∧ IsSMulRegular S₁ (x₁^2) ∧
    Module.supportDim S₁ (S₁ ⧸ Ideal.span {x₁^2}) = 0 ∧
    LowLocalCohomologyVanishes S₁ (S₁ ⧸ Ideal.span {x₁^2}) := by sorry

/-- Field biduality uses the evaluation map on the two-dimensional vector space. -/
example : Function.Bijective (Module.Dual.eval ℚ (ℚ × ℚ)) := by sorry

/-- Multiplying the correct residue-module annihilator by itself gives the wrong ideal. -/
example : let E := ((localCohomology (IsLocalRing.maximalIdeal S₁) 1).obj (ModuleCat.of S₁ S₁))
    Module.annihilator S₁ ((S₁ ⧸ Ideal.span {x₁}) →ₗ[S₁] E) ≠
      Ideal.span {x₁^2} := by sorry

/-- A zero ring attains the zero-ideal Rees bound, with both dimensions bottom. -/
example : ringKrullDim (reesAlgebra (⊥ : Ideal (ZMod 1))) = ⊥ ∧
    ringKrullDim (reesAlgebra (⊥ : Ideal (ZMod 1))) = ringKrullDim (ZMod 1) + 1 := by sorry

/-- The maximal ideal has nonzero degree-one cohomology annihilated by both parameters. -/
example : let M := ↥(IsLocalRing.maximalIdeal S₂)
    let H := ((localCohomology (Ideal.ofList [x₂,y₂]) 1).obj (ModuleCat.of S₂ M))
    IsCMSecant M [x₂,y₂] ∧ Nontrivial H ∧
    x₂ ∈ Module.annihilator S₂ H ∧ y₂ ∈ Module.annihilator S₂ H ∧
    (1 : S₂) ∉ Module.annihilator S₂ H := by sorry

/-- Both chart relations kill the nonzero polynomial extension of that cohomology. -/
example : let M := ↥(IsLocalRing.maximalIdeal S₂)
    let H := ((localCohomology (Ideal.ofList [Polynomial.C x₂, Polynomial.C y₂]) 1).obj
      (ModuleCat.of (Polynomial S₂) (PolynomialModule S₂ M)))
    Nontrivial H ∧
    Polynomial.C y₂ * Polynomial.X - Polynomial.C x₂ ∈ Module.annihilator (Polynomial S₂) H ∧
    Polynomial.C x₂ * Polynomial.X - Polynomial.C y₂ ∈ Module.annihilator (Polynomial S₂) H ∧
    (1 : Polynomial S₂) ∉ Module.annihilator (Polynomial S₂) H := by sorry

/-- The residue summand supplies nonzero torsion in both versions of the torsion identity. -/
example (m : ℕ) (hm : 0 < m) :
    let M := (S₂ ⧸ Ideal.ofList [x₂,y₂]) × S₂
    let Q := prefixQuotient M [x₂]
    IsCMSecant M [x₂,y₂] ∧
    (∀ z : Q, y₂^m • z = 0 ↔ ∀ a ∈ Ideal.ofList [x₂,y₂], a • z = 0) ∧
    (∃ z : Q, z ≠ 0 ∧ y₂^m • z = 0) := by sorry

/-- The first chart is nonzero while its second principal chart and the product chart vanish. -/
example : let I := Ideal.ofList [x₂,y₂]
    let J := Ideal.span {x₂}
    let M := S₂ ⧸ J
    let B := ChartRing I y₂
    let c := algebraMap S₂ B x₂
    Nontrivial (chartModule I y₂ M) ∧
    Subsingleton (chartModule (J.map (algebraMap S₂ B)) c (chartModule I y₂ M)) ∧
    Subsingleton (chartModule (I*J) (y₂*x₂) M) := by sorry

/-- The regular principal and two-parameter centres give Cohen–Macaulay charts. -/
example : IsCMBlowupChartwise (Ideal.span {x₁}) S₁ ∧
    IsCMBlowupChartwise (prefixProduct [x₂,y₂] 2) S₂ := by sorry

/-- The principal centre removes the embedded point of the non-Cohen–Macaulay base. -/
example : let y := Ideal.Quotient.mk (Ideal.span {x₂^2,x₂*y₂}) y₂
    IsCMBlowupChartwise (Ideal.span {y}) N₂ := by sorry

/-- The auxiliary colon evaluates identically for the product and the last parameter. -/
example : Submodule.comap ((x₂*x₂) • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂}) = Ideal.span {y₂} ∧ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂}) = Ideal.span {y₂} := by sorry

/-- The auxiliary colon evaluates identically for the product and the last parameter. -/
example : Submodule.comap ((x₂*x₂) • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (⊥) = ⊥ ∧ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (⊥) = ⊥ := by sorry

/-- The auxiliary colon evaluates identically for the product and the last parameter. -/
example : Submodule.comap ((y₃*y₃) • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) = Ideal.span {x₃, z₃} ∧ Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) = Ideal.span {x₃, z₃} := by sorry

/-- Estimate A evaluates the colon intersection at the stated positive exponent. -/
example : (Submodule.comap (x₁ • (LinearMap.id : S₁ →ₗ[S₁] S₁)) (⊥) ⊓ Ideal.span {x₁}) = ⊥ := by sorry

/-- Estimate A evaluates the colon intersection at the stated positive exponent. -/
example : (Submodule.comap (y₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {x₂}) ⊓ Ideal.span {x₂, y₂}) = Ideal.span {x₂} := by sorry

/-- Estimate A evaluates the colon intersection at the stated positive exponent. -/
example : (Submodule.comap (y₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {x₂}) ⊓ Ideal.span {x₂, y₂} ^ 2) = Ideal.span {x₂^2, x₂*y₂} := by sorry

/-- Estimate B retains multiplication by the tail parameter. -/
example : Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) = Ideal.span {y₂^2} ∧ (y₂ • Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^1}) ⊔ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (⊥)) = Ideal.span {y₂^2} := by sorry

/-- Estimate B retains multiplication by the tail parameter. -/
example : Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^3}) = Ideal.span {y₂^3} ∧ (y₂ • Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) ⊔ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (⊥)) = Ideal.span {y₂^3} := by sorry

/-- Estimate B retains the nonzero auxiliary-prefix contribution. -/
example : Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃^2}) = Ideal.span {x₃, z₃^2} ∧ (z₃ • Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) ⊔ Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃})) = Ideal.span {x₃, z₃^2} := by sorry

/-- Estimate C evaluates the colon and its bounding submodule. -/
example : Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂}) = Ideal.span {y₂} ∧ (Ideal.span {y₂} : Submodule S₂ S₂) ≤ ⊤ := by sorry

/-- Estimate C evaluates the colon and its bounding submodule. -/
example : Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) = Ideal.span {y₂^2} ∧ (Ideal.span {y₂^2} : Submodule S₂ S₂) ≤ Ideal.span {y₂} := by sorry

/-- Estimate C evaluates the colon and its bounding submodule. -/
example : Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃^2}) = Ideal.span {x₃, z₃^2} ∧ (Ideal.span {x₃, z₃^2} : Submodule S₃ S₃) ≤ Ideal.span {x₃, z₃} := by sorry

/-- Estimate D evaluates both sides of the inclusion. -/
example : (Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^1}) ⊓ Ideal.span {y₂}) = Ideal.span {y₂^1} ∧ (y₂ • Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (⊤)) = Ideal.span {y₂^1} := by sorry

/-- Estimate D evaluates both sides of the inclusion. -/
example : (Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) ⊓ Ideal.span {y₂}) = Ideal.span {y₂^2} ∧ (y₂ • Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂})) = Ideal.span {y₂^2} := by sorry

/-- Estimate D distinguishes its smaller left side from the auxiliary-prefix right side. -/
example : (Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃^2}) ⊓ Ideal.span {z₃}) = Ideal.span {x₃*z₃, z₃^2} ∧ (z₃ • Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) ⊔ Ideal.span {x₃}) = Ideal.span {x₃, z₃^2} ∧ (Ideal.span {x₃*z₃, z₃^2} : Submodule S₃ S₃) ≤ Ideal.span {x₃, z₃^2} := by sorry

/-- Estimate E evaluates both colons without losing the auxiliary prefix. -/
example : Submodule.comap ((x₂*x₂) • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂}) = Ideal.span {y₂} ∧ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂}) = Ideal.span {y₂} := by sorry

/-- Estimate E evaluates both colons without losing the auxiliary prefix. -/
example : Submodule.comap ((x₂*x₂) • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) = Ideal.span {y₂^2} ∧ Submodule.comap (x₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {y₂^2}) = Ideal.span {y₂^2} := by sorry

/-- Estimate E evaluates both colons without losing the auxiliary prefix. -/
example : Submodule.comap ((y₃*y₃) • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) = Ideal.span {x₃, z₃} ∧ Submodule.comap (y₃ • (LinearMap.id : S₃ →ₗ[S₃] S₃)) (Ideal.span {x₃, z₃}) = Ideal.span {x₃, z₃} := by sorry

/-- The positive-exponent Goto–Yamagishi colon intersection has the evaluated value. -/
example : (Submodule.comap ((0 : ℚ) • (LinearMap.id : ℚ →ₗ[ℚ] ℚ)) (⊥) ⊓ (⊥ : Submodule ℚ ℚ)) = (⊥ : Submodule ℚ ℚ) := by sorry

/-- The positive-exponent Goto–Yamagishi colon intersection has the evaluated value. -/
example : (Submodule.comap (y₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {x₂}) ⊓ (Ideal.span {x₂, y₂} : Submodule S₂ S₂)) = (Ideal.span {x₂} : Submodule S₂ S₂) := by sorry

/-- The positive-exponent Goto–Yamagishi colon intersection has the evaluated value. -/
example : (Submodule.comap (y₂ • (LinearMap.id : S₂ →ₗ[S₂] S₂)) (Ideal.span {x₂}) ⊓ (Ideal.span {x₂, y₂} ^ 2 : Submodule S₂ S₂)) = (Ideal.span {x₂^2, x₂*y₂} : Submodule S₂ S₂) := by sorry

/-- The degree-one intersection retains the first parameter ideal. -/
example : (Ideal.span {x₂} ⊓ Ideal.span {x₂, y₂}) = Ideal.span {x₂} := by sorry

/-- Both regular two-generator polynomial presentations have a regular denominator. -/
example : let Ky : Ideal (Polynomial S₂) := Ideal.span {Polynomial.C y₂ * Polynomial.X - Polynomial.C x₂}
    let Kx : Ideal (Polynomial S₂) := Ideal.span {Polynomial.C x₂ * Polynomial.X - Polynomial.C y₂}
    let Qy := Polynomial S₂ ⧸ Ky
    let Qx := Polynomial S₂ ⧸ Kx
    IsSMulRegular Qy (Ideal.Quotient.mk Ky (Polynomial.C y₂)) ∧
    IsSMulRegular Qx (Ideal.Quotient.mk Kx (Polynomial.C x₂)) := by sorry

/-- The reducible-base presentation has nonzero denominator torsion removed by localization. -/
example : letI : CommRing C₂ := inferInstance
    let x : C₂ := Ideal.Quotient.mk (Ideal.span {x₂*y₂}) x₂
    let y : C₂ := Ideal.Quotient.mk (Ideal.span {x₂*y₂}) y₂
    let K : Ideal (Polynomial C₂) := Ideal.span {Polynomial.C x * Polynomial.X - Polynomial.C y}
    letI : K.IsTwoSided := by infer_instance
    let Q := Polynomial C₂ ⧸ K
    letI : CommRing Q := Ideal.Quotient.commRing K
    let t := Ideal.Quotient.mk K Polynomial.X
    let a := Ideal.Quotient.mk K (Polynomial.C x)
    let b := Ideal.Quotient.mk K (Polynomial.C y)
    t ≠ 0 ∧ a^2 * t = 0 ∧
    algebraMap Q (Localization.Away a) t = 0 ∧
    algebraMap Q (Localization.Away a) b = 0 := by sorry

/-- At the regular two-parameter chart origin, depth is exactly two. -/
example : let K : Ideal (Polynomial S₂) := Ideal.span {Polynomial.C x₂ * Polynomial.X - Polynomial.C y₂}
    let Q := Polynomial S₂ ⧸ K
    letI : CommRing Q := inferInstanceAs (CommRing (Polynomial S₂ ⧸ K))
    let a := Ideal.Quotient.mk K (Polynomial.C x₂)
    let b := Ideal.Quotient.mk K (Polynomial.C y₂)
    let t := Ideal.Quotient.mk K Polynomial.X
    let n := Ideal.ofList [a,b,t]
    letI : n.IsPrime := by sorry
    let L := Localization.AtPrime n
    let m := n.map (algebraMap Q L)
    Subsingleton ((localCohomology m 0).obj (ModuleCat.of L L)) ∧
    Subsingleton ((localCohomology m 1).obj (ModuleCat.of L L)) ∧
    Nontrivial ((localCohomology m 2).obj (ModuleCat.of L L)) := by sorry

/-- The intermediate regular chart has zero degree-one cohomology and no maximal-ideal torsion
in its degree-two cohomology. -/
example : let K : Ideal (Polynomial S₃) := Ideal.span {Polynomial.C x₃ * Polynomial.X - Polynomial.C y₃}
    let Q := Polynomial S₃ ⧸ K
    letI : CommRing Q := inferInstanceAs (CommRing (Polynomial S₃ ⧸ K))
    let a := Ideal.Quotient.mk K (Polynomial.C x₃)
    let b := Ideal.Quotient.mk K (Polynomial.C y₃)
    let c := Ideal.Quotient.mk K (Polynomial.C z₃)
    let t := Ideal.Quotient.mk K Polynomial.X
    let n := Ideal.ofList [a,b,c,t]
    letI : n.IsPrime := by sorry
    let L := Localization.AtPrime n
    let J := (Ideal.ofList [a,c]).map (algebraMap Q L)
    let m := n.map (algebraMap Q L)
    let H := ((localCohomology J 2).obj (ModuleCat.of L L))
    Subsingleton ((localCohomology J 1).obj (ModuleCat.of L L)) ∧
    Subsingleton ((localCohomology m 0).obj H) := by sorry

/-- The intermediate regular chart has zero degree-one cohomology and no maximal-ideal torsion
in its degree-two cohomology. -/
example : let K : Ideal (Polynomial S₄) := Ideal.span {Polynomial.C x₄ * Polynomial.X - Polynomial.C y₄}
    let Q := Polynomial S₄ ⧸ K
    letI : CommRing Q := inferInstanceAs (CommRing (Polynomial S₄ ⧸ K))
    let a := Ideal.Quotient.mk K (Polynomial.C x₄)
    let b := Ideal.Quotient.mk K (Polynomial.C y₄)
    let c := Ideal.Quotient.mk K (Polynomial.C z₄)
    let t := Ideal.Quotient.mk K Polynomial.X
    let n := Ideal.ofList [a,b,c,t,Ideal.Quotient.mk K (Polynomial.C w₄)]
    letI : n.IsPrime := by sorry
    let L := Localization.AtPrime n
    let J := (Ideal.ofList [a,c]).map (algebraMap Q L)
    let m := n.map (algebraMap Q L)
    let H := ((localCohomology J 2).obj (ModuleCat.of L L))
    Subsingleton ((localCohomology J 1).obj (ModuleCat.of L L)) ∧
    Subsingleton ((localCohomology m 0).obj H) := by sorry

/-- Removing the embedded plane gives a three-dimensional chart whose next outer degree is
nonzero. The smooth coordinates `x₃,y₃,z₃` represent `y,z,w` after removing the original `x`. -/
example : let M := S₄ ⧸ Ideal.span {x₄^2,x₄*y₄}
    let K : Ideal (Polynomial S₃) := Ideal.span {Polynomial.C x₃ * Polynomial.X - Polynomial.C y₃}
    let Q := Polynomial S₃ ⧸ K
    letI : CommRing Q := inferInstanceAs (CommRing (Polynomial S₃ ⧸ K))
    let a := Ideal.Quotient.mk K (Polynomial.C x₃)
    let b := Ideal.Quotient.mk K (Polynomial.C y₃)
    let c := Ideal.Quotient.mk K (Polynomial.C z₃)
    let t := Ideal.Quotient.mk K Polynomial.X
    let n := Ideal.ofList [a,b,c,t]
    letI : n.IsPrime := by sorry
    let L := Localization.AtPrime n
    let J := (Ideal.ofList [a,c]).map (algebraMap Q L)
    let m := n.map (algebraMap Q L)
    let H := ((localCohomology J 2).obj (ModuleCat.of L L))
    IsCMSecant M [y₄,z₄,w₄] ∧
    Subsingleton ((localCohomology J 1).obj (ModuleCat.of L L)) ∧
    IsSMulRegular H (algebraMap Q L t) ∧
    Subsingleton ((localCohomology m 0).obj H) ∧
    Nontrivial ((localCohomology m 1).obj H) := by sorry

/-- The original monomials satisfy the two equations giving the finite free presentation. -/
example : let x := (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let y := (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let u := x^3
    let v := x^5*y^3
    let w := x^15*y^2
    let z := y^7
    v^3 = w*z ∧ w^7 = u^35*z^2 := by sorry

/-- The chart monomials satisfy both integrality equations and the zero-divisor equation. -/
example : let x := (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let y := (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let a := x^3
    let b := x^5*y^3
    let c := x^14*y^2
    let d := x^4*y^7
    b^21 = a^23*d^9 ∧ c^21 = a^90*d^6 ∧ d*c^2 = a*b^3*c := by sorry

/-- The exponent lattice is full, and the parameter lattice has relative index twenty-one. -/
example : let H := AddSubgroup.closure ({(3,0),(5,3),(15,2),(0,7)} : Set (ℤ × ℤ))
    let P := AddSubgroup.closure ({(3,0),(0,7)} : Set (ℤ × ℤ))
    H = ⊤ ∧ H.index = 1 ∧ P.relIndex H = 21 := by sorry

/-- The good parameter-product centre on the concrete localized monomial algebra is
Cohen–Macaulay. -/
example : let x := (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let y := (MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) ℚ)
    let G := ({x^3,x^5*y^3,x^15*y^2,y^7} : Set (MvPolynomial (Fin 2) ℚ))
    let A₀ := Algebra.adjoin ℚ G
    let u : A₀ := ⟨x^3, by apply Algebra.subset_adjoin; simp [G]⟩
    let v : A₀ := ⟨x^5*y^3, by apply Algebra.subset_adjoin; simp [G]⟩
    let w : A₀ := ⟨x^15*y^2, by apply Algebra.subset_adjoin; simp [G]⟩
    let z : A₀ := ⟨y^7, by apply Algebra.subset_adjoin; simp [G]⟩
    let n := Ideal.ofList [u,v,w,z]
    letI : n.IsPrime := by sorry
    let A := Localization.AtPrime n
    let u' := algebraMap A₀ A u
    let z' := algebraMap A₀ A z
    IsCMBlowupChartwise (prefixProduct [u',z'] 2) A := by sorry

/-- Over a field, the closed and generic primes of the polynomial line have heights one and zero. -/
example : (Ideal.span {(Polynomial.X : Polynomial ℚ)}).height = 1 ∧
    (⊥ : Ideal (Polynomial ℚ)).height = 0 ∧ Algebra.trdeg ℚ (Polynomial ℚ) = 1 := by sorry

/-- The origin of the affine plane has height two over its height-one contraction. -/
example : (Ideal.span {(Polynomial.X : Polynomial (Polynomial ℚ)),
      Polynomial.C (Polynomial.X : Polynomial ℚ)}).height = 2 ∧
    (Ideal.span {(Polynomial.X : Polynomial ℚ)}).height = 1 ∧
    Algebra.trdeg (Polynomial ℚ) (Polynomial (Polynomial ℚ)) = 1 := by sorry

/-- At the generic point of the polynomial line, the residue-field term is one. -/
example : let q : Ideal (Polynomial ℚ) := ⊥
    letI : q.IsPrime := by infer_instance
    q.height = 0 ∧ Algebra.trdeg ℚ q.ResidueField = 1 := by sorry

end BoundaryChecks

