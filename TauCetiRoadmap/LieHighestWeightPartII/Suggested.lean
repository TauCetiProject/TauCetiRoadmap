module

public import Mathlib
public import TauCeti.Algebra.Lie.AdjointAction.InnerAutomorphismGroup
public import TauCeti.RepresentationTheory.Spin.Polarization.TypeD.Representation
public import TauCeti.Algebra.AlgebraicGroup.Representation.PointsAction.Basic
public import TauCeti.Algebra.AlgebraicGroup.Representation.SemisimplePoint.Basic
public import TauCeti.Algebra.AlgebraicGroup.Reductive.Basic
public import TauCeti.Algebra.Lie.HighestWeight.Basic

/-!
# Highest weight theory, Part II: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems against the pinned Mathlib and Tau Ceti, each with `sorry`, together with the simple
definitions they need: zero-inclusive `sl₂`-triples, the increasing weight filtration of a triple
on a module, and, for Layer 5, the weight pattern of an endomorphism, `q`-geometric points and
positive real parts of points of a complex affine algebraic group, taken as a finite-type
commutative Hopf `ℂ`-algebra.

In Layers 0–4, `K` is an algebraically closed field of characteristic zero (the half-integrality
test of Layer 5 needs only characteristic zero and a splitting Cartan subalgebra) and conjugacy
of triples means conjugacy under the group `Int(L)` of inner automorphisms, Tau Ceti's
`TauCeti.intLieAlgebra K L`, the subgroup of `LinearMap.GeneralLinearGroup K L` generated by the
exponentials `exp (ad x)` of the elements `x` with nilpotent adjoint action. Its exponential series
is read through a `ℚ`-Lie algebra structure on `L`, carried as an instance argument
`[LieAlgebra ℚ L]` as in Tau Ceti; such a structure exists (`TauCeti.ratLieAlgebra`) and is unique,
an additive group carrying at most one `ℚ`-module structure. The type-`D` recognition theorem is
stated on Mathlib's split carrier `LieAlgebra.Orthogonal.typeD`, on which Tau Ceti's half-spin
module `S⁺` lives.

Headline theorems that are not statable at the pins:

* **The finite test family of README Layer 4** (standard modules of the classical factors, one
  half-spin module per factor of type `D`, adjoint modules of the exceptional factors): the pins
  decompose a finite-dimensional Killing Lie algebra into its simple ideals
  (`LieAlgebra.IsSemisimple`) and give an irreducible root system its Dynkin type
  (`TauCeti.existsUnique_dynkinType`), but attach to a simple ideal of classical type no standard
  module and to one of type `D` no half-spin module, and the statement quantifies over these
  modules. The recognition theorem over all finite-dimensional modules is stated.
* **The half-integrality test for algebraic groups** (README §5.2, second statement): the pins have
  split maximal tori, Borel subgroups and pinnings of reductive Hopf algebras and the weight spaces
  of a comodule at group-like elements, but no highest weight of an irreducible comodule relative
  to a Borel subgroup (the rational highest-weight theory of ReductiveGroups Layer 10B), over which
  that statement quantifies. The Lie-algebra form of the test is stated.
-/

@[expose] public section

universe u v

namespace TauCetiRoadmap.LieHighestWeightPartII

open LieModule Module

/-! ## Layer 0: zero-inclusive triples and inner conjugacy -/

/-- A zero-inclusive `sl₂`-triple: the three bracket relations of an `sl₂`-triple `(h, e, f)`,
without Mathlib's condition `h ≠ 0` of `IsSl2Triple`. Over a field of characteristic zero the
only additional solution is `(0, 0, 0)`; it is the triple attached to the zero nilpotent element
(Ciubotaru–Harris, §2.1, relations (2.1)). -/
structure IsSl2TripleOrZero {L : Type*} [LieRing L] (h e f : L) : Prop where
  lie_e_f : ⁅e, f⁆ = h
  lie_h_e_nsmul : ⁅h, e⁆ = 2 • e
  lie_h_f_nsmul : ⁅h, f⁆ = -(2 • f)

/-! ## Layer 1: representation filtrations -/

/-- The increasing weight filtration of a neutral element `h` on a Lie module `M`: its `i`-th
step is the sum of the eigenspaces of the action of `h` at the integers `j ≤ i`
(Ciubotaru–Harris, §2.2, Definition 2.2). For the neutral element of a zero-inclusive triple on a
finite-dimensional module over an algebraically closed field of characteristic zero the steps are
zero for `i` small and all of `M` for `i` large, and `e` raises the index by two. -/
noncomputable def weightFiltration (K : Type*) {L : Type*} [Field K] [LieRing L]
    [LieAlgebra K L] (h : L) (M : Type*) [AddCommGroup M] [Module K M] [LieRingModule L M]
    [LieModule K L M] (i : ℤ) : Submodule K M :=
  ⨆ (j : ℤ) (_ : j ≤ i), (toEnd K L M h).eigenspace (j : K)

/-- **The filtration determines the restricted `sl₂`-module.** For zero-inclusive triples
`(h, e, f)` in `L` and `(h', e', f')` in `L'`, and finite-dimensional modules `M`, `M'`, the
weight filtrations have the same dimension in every degree if and only if some linear
isomorphism `M ≃ M'` intertwines the actions of `h, e, f` with those of `h', e', f'`
(README Layer 1; Ciubotaru–Harris, proof of Lemma 10.9). -/
theorem finrank_weightFiltration_eq_iff_exists_intertwiner
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {L L' : Type*} [LieRing L] [LieAlgebra K L] [LieRing L'] [LieAlgebra K L']
    {M M' : Type*} [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
    [FiniteDimensional K M] [AddCommGroup M'] [Module K M'] [LieRingModule L' M']
    [LieModule K L' M'] [FiniteDimensional K M']
    {h e f : L} {h' e' f' : L'}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f') :
    (∀ i : ℤ, finrank K (weightFiltration K h M i) = finrank K (weightFiltration K h' M' i)) ↔
      ∃ φ : M ≃ₗ[K] M', ∀ m : M,
        φ ⁅h, m⁆ = ⁅h', φ m⁆ ∧ φ ⁅e, m⁆ = ⁅e', φ m⁆ ∧ φ ⁅f, m⁆ = ⁅f', φ m⁆ := sorry

/-! ## Layer 2: classical types -/

/-- **Type `A`: the standard module recognises triples.** In `sl(n, K)`, two zero-inclusive
triples whose weight filtrations on the standard module `Kⁿ` have the same dimensions are
conjugate under `Int(sl(n, K))` (README Layer 2; Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_sl
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {n : Type*} [Fintype n] [DecidableEq n] [LieAlgebra ℚ (LieAlgebra.SpecialLinear.sl n K)]
    {h e f h' e' f' : LieAlgebra.SpecialLinear.sl n K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (n → K) i) =
      finrank K (weightFiltration K h' (n → K) i)) :
    ∃ φ ∈ TauCeti.intLieAlgebra K (LieAlgebra.SpecialLinear.sl n K),
      φ • h = h' ∧ φ • e = e' ∧ φ • f = f' := sorry

/-- **Type `C`: the standard module recognises triples.** In the symplectic Lie algebra
`sp(2l, K)` acting on `K^(l ⊕ l)`, two zero-inclusive triples whose weight filtrations on the
standard module have the same dimensions are conjugate under `Int(sp(2l, K))` (README Layer 2;
Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_sp
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {l : Type*} [Fintype l] [DecidableEq l] [LieAlgebra ℚ (LieAlgebra.Symplectic.sp l K)]
    {h e f h' e' f' : LieAlgebra.Symplectic.sp l K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (l ⊕ l → K) i) =
      finrank K (weightFiltration K h' (l ⊕ l → K) i)) :
    ∃ φ ∈ TauCeti.intLieAlgebra K (LieAlgebra.Symplectic.sp l K),
      φ • h = h' ∧ φ • e = e' ∧ φ • f = f' := sorry

/-- **Types `B` and `D` away from very even partitions.** In `so(n, K)` acting on `Kⁿ`, two
zero-inclusive triples whose weight filtrations on the standard module have the same dimensions
are conjugate under `Int(so(n, K))`, provided the neutral element `h` has a nonzero kernel on
`Kⁿ`. That proviso says that the Jordan type of `e` has a part of odd size; it holds whenever `n`
is odd and fails for `n = 0`. For very even Jordan types in positive dimension the conclusion
fails, and README Layer 2 separates the two classes by a half-spin module: see
`exists_innerAut_of_finrank_weightFiltration_typeD` (Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_so
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K]
    {n : Type*} [Fintype n] [DecidableEq n] [LieAlgebra ℚ (LieAlgebra.Orthogonal.so n K)]
    {h e f h' e' f' : LieAlgebra.Orthogonal.so n K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hker : (toEnd K (LieAlgebra.Orthogonal.so n K) (n → K) h).eigenspace 0 ≠ ⊥)
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (n → K) i) =
      finrank K (weightFiltration K h' (n → K) i)) :
    ∃ φ ∈ TauCeti.intLieAlgebra K (LieAlgebra.Orthogonal.so n K),
      φ • h = h' ∧ φ • e = e' ∧ φ • f = f' := sorry

/-- **Type `D`: the standard module and one half-spin module recognise triples.** On Mathlib's
split even orthogonal algebra `typeD ι K` (isomorphic to `so(2r, K)`, `r = |ι|`, README §2.0),
let `P` be a polarisation of a quadratic space with no remainder line and `b` a basis of its
isotropic summand `W` indexed by `ι`, so that the even half-spin module `S⁺ = ⋀^even W`
(`TauCeti.spinPlus Q P`, of dimension `2^(r−1)` for `r ≥ 1`) carries the action
`ρ = TauCeti.SpinPolarizationData.typeDSpinPlusLieRep` of `typeD ι K`, `2` being invertible in
`K`. The weight filtration of a neutral element `h` on `S⁺` is the sum of the eigenspaces of
`ρ(h)` at the integers `j ≤ i`. Two zero-inclusive triples whose weight filtrations on the standard
module `K^(ι ⊕ ι)` and on `S⁺` both have the same dimensions in every degree are conjugate under
`Int(typeD ι K)`, with no restriction on the Jordan type: away from very even partitions the
standard module decides, and for very even partitions `S⁺` separates the two classes
(README §§2.3–2.4; Ciubotaru–Harris, Lemma 10.9). -/
theorem exists_innerAut_of_finrank_weightFiltration_typeD
    {K : Type*} [Field K] [IsAlgClosed K] [CharZero K] [Invertible (2 : K)]
    {V : Type*} [AddCommGroup V] [Module K V] {Q : QuadraticForm K V}
    (P : TauCeti.SpinPolarizationData Q) {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : Module.Basis ι K P.W) (hline : P.line = ⊥)
    [LieAlgebra ℚ (LieAlgebra.Orthogonal.typeD ι K)]
    {h e f h' e' f' : LieAlgebra.Orthogonal.typeD ι K}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h (ι ⊕ ι → K) i) =
      finrank K (weightFiltration K h' (ι ⊕ ι → K) i))
    (hspin : ∀ i : ℤ,
      finrank K (⨆ (j : ℤ) (_ : j ≤ i), (P.typeDSpinPlusLieRep b hline h).eigenspace (j : K) :
          Submodule K (TauCeti.spinPlus Q P)) =
        finrank K (⨆ (j : ℤ) (_ : j ≤ i), (P.typeDSpinPlusLieRep b hline h').eigenspace (j : K) :
          Submodule K (TauCeti.spinPlus Q P))) :
    ∃ φ ∈ TauCeti.intLieAlgebra K (LieAlgebra.Orthogonal.typeD ι K),
      φ • h = h' ∧ φ • e = e' ∧ φ • f = f' := sorry

/-! ## Layer 3: exceptional types -/

/-- **The adjoint module recognises triples in exceptional types.** If `L` is isomorphic to the
split Lie algebra of type `G₂`, `F₄`, `E₆`, `E₇` or `E₈`, two zero-inclusive triples whose weight
filtrations on the adjoint module `L` have the same dimensions are conjugate under `Int(L)`. The
types `E₆` and `E₇` are included and are proved in their own root systems (README Layer 3;
Ciubotaru–Harris, Lemma 10.9 and Tables 2–4). The finite-dimensionality and Killing hypotheses
hold for these algebras by LieHighestWeight Layer 8, on which the proof depends; they are carried
explicitly and are harmless. -/
theorem exists_innerAut_of_finrank_weightFiltration_adjoint_exceptional
    {K L : Type*} [Field K] [IsAlgClosed K] [CharZero K] [LieRing L] [LieAlgebra K L]
    [LieAlgebra ℚ L] [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
    (hL : Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.g₂ K) ∨ Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.f₄ K) ∨
      Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₆ K) ∨ Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₇ K) ∨
      Nonempty (L ≃ₗ⁅K⁆ LieAlgebra.e₈ K))
    {h e f h' e' f' : L}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f')
    (hdim : ∀ i : ℤ, finrank K (weightFiltration K h L i) =
      finrank K (weightFiltration K h' L i)) :
    ∃ φ ∈ TauCeti.intLieAlgebra K L, φ • h = h' ∧ φ • e = e' ∧ φ • f = f' := sorry

/-! ## Layer 4: semisimple recognition -/

/-- **Filtration recognition.** In a finite-dimensional semisimple Lie algebra `L` over an
algebraically closed field of characteristic zero, two zero-inclusive triples are conjugate under
`Int(L)` if and only if their weight filtrations have the same dimension in every degree on every
finite-dimensional `L`-module (README Layer 4; Ciubotaru–Harris, Lemma 2.4 and Lemma 10.9). The
modules range over a universe containing `K` and `L`, so that the adjoint module and the modules
`Kⁿ` occur. -/
theorem exists_innerAut_iff_finrank_weightFiltration
    {K : Type u} {L : Type v} [Field K] [IsAlgClosed K] [CharZero K] [LieRing L]
    [LieAlgebra K L] [LieAlgebra ℚ L] [FiniteDimensional K L] [LieAlgebra.IsKilling K L]
    {h e f h' e' f' : L}
    (t : IsSl2TripleOrZero h e f) (t' : IsSl2TripleOrZero h' e' f') :
    (∃ φ ∈ TauCeti.intLieAlgebra K L, φ • h = h' ∧ φ • e = e' ∧ φ • f = f') ↔
      ∀ (M : Type (max u v)) [AddCommGroup M] [Module K M] [LieRingModule L M]
        [LieModule K L M] [FiniteDimensional K M] (i : ℤ),
        finrank K (weightFiltration K h M i) = finrank K (weightFiltration K h' M i) := sorry

/-! ## Layer 5: highest weights and weight patterns -/

/-- **The highest-weight half-integrality test.** Let `L` be a finite-dimensional Lie algebra
with nondegenerate Killing form over a field `K` of characteristic zero, `H` a splitting Cartan
subalgebra, `b` a base of its root system, and `ν : H^* → ℝ` additive with `2ν(α) ∈ ℤ` for every
simple root `α` of `b`. If an irreducible `L`-module `M` has a highest weight vector of weight `λ`
for `b`, then `2ν(μ) ∈ ℤ` for every weight `μ` of `M` if and only if `2ν(λ) ∈ ℤ`. Neither
dominance of `ν` nor finite-dimensionality of `M` is assumed (Ciubotaru–Harris, Lemma 6.30;
README §5.2). -/
theorem forall_weight_halfIntegral_iff_highestWeight
    {K L M : Type*} [Field K] [CharZero K]
    [LieRing L] [LieAlgebra K L] [LieAlgebra.IsKilling K L] [FiniteDimensional K L]
    {H : LieSubalgebra K L} [H.IsCartanSubalgebra] [IsTriangularizable K H L]
    (b : (LieAlgebra.IsKilling.rootSystem H).Base)
    [AddCommGroup M] [Module K M] [LieRingModule L M] [LieModule K L M]
    [LieModule.IsIrreducible K L M]
    {lam : Dual K H} {v : M} (hv : TauCeti.IsHighestWeightVector b lam v)
    (ν : Dual K H →+ ℝ)
    (hν : ∀ i ∈ b.support, ∃ z : ℤ,
      2 * ν ((LieAlgebra.IsKilling.rootSystem H).root i) = z) :
    (∀ μ : Dual K H, genWeightSpace M (μ : H → K) ≠ ⊥ → ∃ z : ℤ, 2 * ν μ = z) ↔
      ∃ z : ℤ, 2 * ν lam = z := sorry

/-- The weight pattern of a complex endomorphism `A` at `i ∈ ℤ`, for a fixed real `q`: the
dimension of the sum of the eigenspaces of `A` at the eigenvalues of absolute value `q^(i/2)`.
For a semisimple `A` whose eigenvalues all have absolute value in `q^(ℤ/2)` this is the sum of
the multiplicities of the eigenvalues of absolute value `q^(i/2)` (Ciubotaru–Harris, §10.1;
README §5.3). -/
noncomputable def weightPattern (q : ℝ) {V : Type*} [AddCommGroup V] [Module ℂ V]
    (A : Module.End ℂ V) (i : ℤ) : ℕ :=
  finrank ℂ (⨆ (μ : ℂ) (_ : ‖μ‖ = Real.sqrt q ^ i), A.eigenspace μ : Submodule ℂ V)

/-- A `q`-geometric point of a complex affine algebraic group, given as a finite-type
commutative Hopf `ℂ`-algebra `H` with its convolution group of `ℂ`-points: on every
finite-dimensional `H`-comodule every eigenvalue of the action of `s` has absolute value
`q^(i/2)` for some integer `i` (the complex form of Ciubotaru–Harris, Definition 2.5;
README Conventions and §5.3). -/
def IsGeometricPoint (q : ℝ) {H : TauCeti.FiniteTypeCommHopfAlgCat.{0, 0} ℂ}
    (s : WithConv (H →ₐ[ℂ] ℂ)) : Prop :=
  ∀ (M : TauCeti.FGComoduleCat.{0, 0, 0} ℂ H) (μ : ℂ),
    (TauCeti.Comodule.basePointsRepresentation (H := H) M s).HasEigenvalue μ →
      ∃ i : ℤ, ‖μ‖ = Real.sqrt q ^ i

/-- `r` is a positive real part of the point `s`: on every finite-dimensional `H`-comodule, `r`
acts on the `μ`-eigenspace of `s` by the scalar `|μ|`. For a semisimple `s` this is satisfied by
the positive real part `r(s)` of Ciubotaru–Harris, §10.1, and determines `r` (README §5.4). -/
def IsPositiveRealPart {H : TauCeti.FiniteTypeCommHopfAlgCat.{0, 0} ℂ}
    (s r : WithConv (H →ₐ[ℂ] ℂ)) : Prop :=
  ∀ (M : TauCeti.FGComoduleCat.{0, 0, 0} ℂ H) (μ : ℂ) (v : M),
    v ∈ (TauCeti.Comodule.basePointsRepresentation (H := H) M s).eigenspace μ →
      TauCeti.Comodule.basePointsRepresentation (H := H) M r v = ((‖μ‖ : ℝ) : ℂ) • v

/-- **Recognition of the positive real part.** Let `H` be the coordinate algebra of a connected
complex reductive group (`TauCeti.reductiveCommHopfAlgProperty`), `q > 1`, and `s, s'`
semisimple `q`-geometric points with equal weight patterns on every finite-dimensional
`H`-comodule in every degree. Then positive real parts `r` of `s` and `r'` of `s'` are conjugate
by a point of `H` (Ciubotaru–Harris, Proposition 10.2; README §5.5). Existence of a positive real
part of a semisimple point is README §5.4. -/
theorem exists_conj_positiveRealPart_of_weightPattern_eq
    {q : ℝ} (hq : 1 < q) {H : TauCeti.FiniteTypeCommHopfAlgCat.{0, 0} ℂ}
    (hH : TauCeti.reductiveCommHopfAlgProperty ℂ H)
    {s s' r r' : WithConv (H →ₐ[ℂ] ℂ)}
    (hs : TauCeti.HopfAlgebra.IsSemisimplePoint s)
    (hs' : TauCeti.HopfAlgebra.IsSemisimplePoint s')
    (hgs : IsGeometricPoint q s) (hgs' : IsGeometricPoint q s')
    (hpat : ∀ (M : TauCeti.FGComoduleCat.{0, 0, 0} ℂ H) (i : ℤ),
      weightPattern q (TauCeti.Comodule.basePointsRepresentation (H := H) M s) i =
        weightPattern q (TauCeti.Comodule.basePointsRepresentation (H := H) M s') i)
    (hr : IsPositiveRealPart s r) (hr' : IsPositiveRealPart s' r') :
    ∃ g : WithConv (H →ₐ[ℂ] ℂ), g * r * g⁻¹ = r' := sorry

end TauCetiRoadmap.LieHighestWeightPartII
