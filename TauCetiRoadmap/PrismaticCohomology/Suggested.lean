import Mathlib

/-!
# PrismaticCohomology: representative target signatures

The roadmap is README.md. These are suggested forms, not an exhaustive checklist.
This file records light definitions and representative theorem signatures statable against
the pinned APIs. The correction polynomial
has integral coefficients before evaluation, Frobenius congruences contain no chosen division,
and quotient stability retains the specified delta operation. The elementary polynomial
prefix makes sense over any commutative ring; the prismatic geometric targets
in the README retain their p-local and completeness hypotheses.
-/

namespace TauCetiRoadmap.PrismaticCohomology

open scoped BigOperators

namespace Delta

variable {R S : Type*} [CommRing R] [CommRing S]

/-- The integral addition correction. Division takes place in `ℕ`, before casting to `R`.
For prime `p`, every coefficient in the indicated range is an exact quotient.
The symmetry and zero API is `Delta.addCorrection_symm`, `Delta.addCorrection_zero`. -/
def addCorrection (p : ℕ) (x y : R) : R :=
  -∑ i ∈ Finset.Ico 1 p, ((p.choose i / p : ℕ) : R) * x ^ i * y ^ (p - i)

/-- A delta structure for `p`. The ring carrier and its operations are already fixed.
The prime assumption is imposed on theorems using this polynomial structure.
The scalar API includes `Delta.Structure.delta_neg` and `Delta.Structure.delta_two`. -/
structure Structure (p : ℕ) (R : Type*) [CommRing R] where
  delta : R → R
  delta_zero : delta 0 = 0
  delta_one : delta 1 = 0
  delta_add : ∀ x y, delta (x + y) = delta x + delta y + addCorrection p x y
  delta_mul : ∀ x y,
    delta (x * y) = x ^ p * delta y + y ^ p * delta x + (p : R) * delta x * delta y

/-- An ordinary Frobenius lift is an endomorphism congruent to the p-th power modulo p.
It records neither choices of quotients nor a homotopy on a derived reduction.
Reduction and the witness criterion are `Delta.FrobeniusLift.mod_p` and
`Delta.FrobeniusLift.congruence_iff`. -/
structure FrobeniusLift (p : ℕ) (R : Type*) [CommRing R] where
  hom : R →+* R
  congruence : ∀ x, ∃ y, hom x = x ^ p + (p : R) * y

/-- The function underlying the associated Frobenius; its ring laws are a target theorem.
The bundled map has evaluation `Delta.toFrobenius_apply`, rank-one evaluation
`Delta.toFrobenius_rank_one`, and delta-map naturality `Delta.toFrobenius_map`. -/
def associatedFrobenius {p : ℕ} (d : Structure p R) (x : R) : R :=
  x ^ p + (p : R) * d.delta x

/-- The canonical integer operation uses integer division, not division in the target ring.
Its bundled structure has `Delta.intDelta_apply`, `Delta.intDelta_frobenius` and
`Delta.intDelta_prime` as evaluation, Frobenius and scalar-p laws. -/
def integerDelta (p : ℕ) (a : ℤ) : ℤ := (a - a ^ p) / (p : ℤ)

/-- Delta morphisms are unital ring maps commuting with the specified delta operations. -/
def IsDeltaMap {p : ℕ} (d : Structure p R) (e : Structure p S) (f : R →+* S) : Prop :=
  ∀ x, f (d.delta x) = e.delta (f x)

/-- Stability of an ordinary ideal under delta; Frobenius stability alone is insufficient. -/
def IsStable {p : ℕ} (d : Structure p R) (I : Ideal R) : Prop :=
  ∀ x ∈ I, d.delta x ∈ I

/-- The ideal generated by iterates of delta on elements of `I`, including the zeroth iterate.
This is an ordinary ideal span; it is not an iteration of Frobenius or of Witt coordinates.
Its API is `Delta.idealClosure_eq_span`, `Delta.le_idealClosure`,
`Delta.idealClosure_stable`, `Delta.idealClosure_le` for stable targets,
`Delta.idealClosure_idem` and `Delta.idealClosure_mono`. -/
def idealClosure {p : ℕ} (d : Structure p R) (I : Ideal R) : Ideal R :=
  Ideal.span {y | ∃ n : ℕ, ∃ x ∈ I, y = d.delta^[n] x}

/-- Distinguished means that delta of the element is a unit. -/
def IsDistinguished {p : ℕ} (d : Structure p R) (x : R) : Prop := IsUnit (d.delta x)

/-- Rank one means delta vanishes; the reverse implication from a Frobenius equality
requires injectivity of multiplication by p. -/
def IsRankOne {p : ℕ} (d : Structure p R) (x : R) : Prop := d.delta x = 0

/-- The denominator-cleared identity is valid in rings with p-torsion. -/
theorem correction_identity (p : ℕ) (hp : p.Prime) (x y : R) :
    (p : R) * addCorrection p x y = x ^ p + y ^ p - (x + y) ^ p := by
  sorry

/-- The sign of the correction in the dyadic case. -/
theorem correction_two (x y : R) : addCorrection 2 x y = -(x * y) := by
  sorry

/-- Ring maps commute with evaluation of the integral correction polynomial. -/
theorem addCorrection_map (p : ℕ) (f : R →+* S) (x y : R) :
    f (addCorrection p x y) = addCorrection p (f x) (f y) := by
  sorry

/-- The associated function is the underlying map of a Frobenius lift. -/
theorem associatedFrobenius_isLift (p : ℕ) (hp : p.Prime) (d : Structure p R) :
    ∃ f : FrobeniusLift p R, ∀ x, f.hom x = associatedFrobenius d x := by
  sorry

/-- With no p-torsion, each ordinary lift has a unique delta reconstruction.
`CharZero` alone does not imply the required injectivity.
The equivalence laws are `Delta.frobeniusEquiv_apply`, `Delta.frobeniusEquiv_symm_spec`
and `Delta.frobeniusEquiv_symm_toFrobenius`. The README checks
`reconstruction_integer_value`, `reconstruction_rejects_characteristic_p` and
`reconstruction_zero_ring` distinguish the integer, torsion and zero-ring cases. -/
theorem reconstruction (p : ℕ) (hp : p.Prime)
    (hinj : Function.Injective (fun x : R => (p : R) * x)) (f : FrobeniusLift p R) :
    ∃! d : Structure p R, ∀ x, associatedFrobenius d x = f.hom x := by
  sorry

/-- The integer formula satisfies the delta axioms without supplying a sorry'd structure. -/
theorem integerDelta_structure (p : ℕ) (hp : p.Prime) :
    ∃ d : Structure p ℤ, d.delta = integerDelta p := by
  sorry

/-- The integer scalar p has a forced delta value in every delta ring. -/
theorem delta_prime (p : ℕ) (hp : p.Prime) (d : Structure p R) :
    d.delta (p : R) = 1 - (p : R) ^ (p - 1) := by
  sorry

/-- In characteristic p, the ordinary Frobenius congruence does not supply delta data. -/
theorem no_delta_structure (p : ℕ) (hp : p.Prime) [CharP R p] [Nontrivial R] :
    IsEmpty (Structure p R) := by
  sorry

/-- Delta descent to a quotient is exactly delta stability of its kernel. -/
theorem quotient_structure_iff (p : ℕ) (hp : p.Prime) (d : Structure p R) (I : Ideal R) :
    (∃ e : Structure p (R ⧸ I), IsDeltaMap d e (Ideal.Quotient.mk I)) ↔ IsStable d I := by
  sorry

/-- The delta closure of the ideal generated by p is the unit ideal. -/
theorem idealClosure_prime (p : ℕ) (hp : p.Prime) (d : Structure p R) :
    idealClosure d (Ideal.span {(p : R)}) = ⊤ := by
  sorry

/-- Distinguished elements provide the prism relation p in the ideal (x, phi(x)).
This is the integral form of the README's `Prismatic.IsDistinguished.p_mem_span`. -/
theorem distinguished_prime_mem (p : ℕ) (d : Structure p R) (x : R)
    (hx : IsDistinguished d x) :
    (p : R) ∈ Ideal.span {x, associatedFrobenius d x} := by
  sorry

/-- Functoriality tests the actual integral coefficients, including the zero argument. -/
example (x : R) : addCorrection 2 x 0 = 0 := by
  simp [addCorrection]

/-- The wrong positive sign fails at (1,1). -/
example : addCorrection 2 (1 : ℤ) 1 = -1 := by
  norm_num [addCorrection, Finset.sum_Ico_succ_top]

/-- The cubic coefficient includes both cross terms. -/
example : addCorrection 3 (1 : ℤ) 2 = -6 := by
  norm_num [addCorrection, Finset.sum_Ico_succ_top]

/-- Integer delta is neither the zero operation nor the p-th power map. -/
example : integerDelta 2 2 = -1 ∧ integerDelta 2 4 = -6 := by
  norm_num [integerDelta]

/-- Odd p has a different scalar correction. -/
example : integerDelta 3 2 = -2 := by
  norm_num [integerDelta]

/-- The identity endomorphism is an ordinary lift on the integers. -/
example (p : ℕ) (hp : p.Prime) :
    ∃ f : FrobeniusLift p ℤ, f.hom = RingHom.id ℤ := by
  sorry

/-- A characteristic-p ordinary lift exists although a delta structure does not. -/
example : ∃ f : FrobeniusLift 2 (ZMod 2), f.hom = RingHom.id (ZMod 2) := by
  sorry

/-- The zero ring is allowed, including in the torsion-free reconstruction. -/
example : Nonempty (Structure 2 (ZMod 1)) := by
  sorry

/-- Delta morphisms include the identity; this checks the direction of the compatibility. -/
example (p : ℕ) (d : Structure p R) : IsDeltaMap d d (RingHom.id R) := by
  intro x
  rfl

/-- The bottom ideal is stable. -/
example (p : ℕ) (d : Structure p R) : IsStable d (⊥ : Ideal R) := by
  simp [IsStable, d.delta_zero]

/-- The prime ideal is not delta-stable in the integer example. -/
example (d : Structure 2 ℤ) : ¬ IsStable d (Ideal.span {(2 : ℤ)}) := by
  sorry

/-- The closure really changes the integer prime ideal. -/
example (d : Structure 2 ℤ) : idealClosure d (Ideal.span {(2 : ℤ)}) = ⊤ := by
  sorry

/-- A zero input generates no additional delta iterates. -/
example (p : ℕ) (d : Structure p R) : idealClosure d (⊥ : Ideal R) = ⊥ := by
  sorry

/-- Containment of a delta closure does not force stability of its target ideal. -/
example (d : Structure 2 ℤ) :
    idealClosure d (⊥ : Ideal ℤ) ≤ Ideal.span {(2 : ℤ)} ∧
      ¬ IsStable d (Ideal.span {(2 : ℤ)}) := by
  sorry

/-- For p=2, delta(2)=-1 is a unit even over the integers. -/
example (d : Structure 2 ℤ) : IsDistinguished d 2 := by
  sorry

/-- Squaring p destroys distinguishedness in the integer dyadic example. -/
example (d : Structure 2 ℤ) : ¬ IsDistinguished d 4 := by
  sorry

/-- Zero is rank one for every delta structure. -/
example (p : ℕ) (d : Structure p R) : IsRankOne d 0 := d.delta_zero

/-- The integer 2 is not rank one in a dyadic delta ring on Z. -/
example (d : Structure 2 ℤ) : ¬ IsRankOne d 2 := by
  sorry

/-- The associated Frobenius evaluates the given delta data; p need not be cancellable. -/
example (p : ℕ) (hp : p.Prime) (d : Structure p R) : associatedFrobenius d 0 = 0 := by
  simp [associatedFrobenius, hp.ne_zero, d.delta_zero]

/-- The dyadic correction is the negative cross term over every commutative ring. -/
example (x y : R) : addCorrection 2 x y = -(x * y) := correction_two x y

/-- The cubic correction contains both mixed monomials. -/
example (x y : R) : addCorrection 3 x y = -(x * y * (x + y)) := by
  sorry

/-- The integral correction vanishes on a zero argument for every natural index. -/
example (p : ℕ) (x : R) : addCorrection p x 0 = 0 := by
  sorry

/-- Delta axioms force the nonzero dyadic scalar value. -/
example (d : Structure 2 ℤ) : d.delta 2 = -1 := by
  sorry

/-- A zero operation cannot satisfy the integer delta axioms. -/
example (d : Structure 2 ℤ) : ¬ (∀ x, d.delta x = 0) := by
  sorry

/-- The scalar product tests the final term in the delta product rule. -/
example (d : Structure 2 ℤ) : d.delta 4 = -6 := by
  sorry

/-- Squaring fails to be a unital ring endomorphism of the integers. -/
example : ¬ ∃ f : FrobeniusLift 2 ℤ, ∀ x, f.hom x = x ^ 2 := by
  sorry

/-- Rank-one evaluation does not require cancellation of p. -/
example (p : ℕ) (d : Structure p R) (x : R) (h : IsRankOne d x) :
    associatedFrobenius d x = x ^ p := by
  simp [associatedFrobenius, IsRankOne] at h ⊢
  rw [h]
  simp

/-- Associated Frobenius fixes the integer 2. -/
example (d : Structure 2 ℤ) : associatedFrobenius d 2 = 2 := by
  sorry

/-- Every two operations give the same Frobenius on the zero ring. -/
example (p : ℕ) (d e : Structure p (ZMod 1)) :
    ∀ x, associatedFrobenius d x = associatedFrobenius e x := by
  sorry

/-- Integer division has the stated sign on negative input. -/
example : integerDelta 2 (-1) = -1 := by
  norm_num [integerDelta]

/-- The integer operation vanishes at zero. -/
example (p : ℕ) : integerDelta p 0 = 0 := by
  cases p <;> simp [integerDelta]

/-- Cancellation of p fails on the nonzero characteristic-p ring. -/
example : ¬ Function.Injective (fun x : ZMod 2 => (2 : ZMod 2) * x) := by
  sorry

/-- Cancellation remains valid on the zero ring. -/
example (p : ℕ) : Function.Injective (fun x : ZMod 1 => (p : ZMod 1) * x) := by
  sorry

/-- Delta stabilization fixes stable ideals. -/
example (p : ℕ) (hp : p.Prime) (d : Structure p R) (I : Ideal R)
    (h : IsStable d I) : idealClosure d I = I := by
  sorry

/-- All elements of the zero ring are distinguished. -/
example (p : ℕ) (d : Structure p (ZMod 1)) (x : ZMod 1) :
    IsDistinguished d x := by
  sorry

/-- The unit is rank one. -/
example (p : ℕ) (d : Structure p R) : IsRankOne d 1 := d.delta_one

/-- Invertibility of the zeroth Witt coordinate alone is insufficient over the integers. -/
example : ¬ IsUnit (TruncatedWittVector.mk 2 ![(1 : ℤ), 1]) := by
  sorry

/-- Witt addition retains its mixed coordinate in characteristic two. -/
example : (TruncatedWittVector.mk 2 ![(1 : ZMod 2), 0] +
    TruncatedWittVector.mk 2 ![(1 : ZMod 2), 0]).coeff 1 = 1 := by
  sorry

/-- The integer Witt section has the negative second coordinate and the identity ghost. -/
example :
    ∃ s : ℤ →+* TruncatedWittVector 2 2 ℤ,
      (∀ x, (s x).coeff 0 = x) ∧
      (s 2).coeff 1 = -1 ∧
      (s 2).coeff 0 ^ 2 + 2 * (s 2).coeff 1 = 2 := by
  sorry

/-- A nonzero characteristic-two ring admits no first-coordinate Witt section. -/
example :
    ¬ ∃ s : ZMod 2 →+* TruncatedWittVector 2 2 (ZMod 2),
      ∀ x, (s x).coeff 0 = x := by
  sorry

/-- The unique length-two Witt vector over the zero ring is a unit. -/
example : IsUnit (0 : TruncatedWittVector 2 2 (ZMod 1)) := by
  sorry

/-- The first dyadic shifted quotient sends the class of two to one. -/
example : (integerDelta 2 2 : ZMod 2) = 1 := by
  decide

/-- The first triadic shifted quotient sends the class of three to one. -/
example : (integerDelta 3 3 : ZMod 3) = 1 := by
  decide

/-- The second dyadic shifted quotient retains a nonzero even residue. -/
example : (integerDelta 2 4 : ZMod 4) = 2 := by
  decide

/-- The rational localization has the forced delta value on one third. -/
example (d : Structure 2 ℚ) : d.delta (1 / 3) = 1 / 9 := by
  sorry

section SquareZero

local instance squareZeroRightModule : Module ℤᵐᵒᵖ (ZMod 2) :=
  Module.compHom _ ((RingHom.id ℤ).fromOpposite mul_comm)

local instance squareZeroCentral : IsCentralScalar ℤ (ZMod 2) := ⟨fun _ _ => rfl⟩

local instance squareZeroCommRing : CommRing (TrivSqZeroExt ℤ (ZMod 2)) :=
  @TrivSqZeroExt.commRing ℤ (ZMod 2) _ _ _ squareZeroRightModule squareZeroCentral


/-- The dyadic square-zero family retains the torsion parameter in its delta operation. -/
theorem squareZeroFamily_exists :
    ∃ family : ZMod 2 → Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
      ∀ (c : ZMod 2) (x : TrivSqZeroExt ℤ (ZMod 2)), (family c).delta x =
        (integerDelta 2 x.fst, (c - (x.fst : ZMod 2)) * x.snd) := by
  sorry

/-- Every parameter occurs as the delta of the square-zero generator. -/
example (c : ZMod 2) :
    ∃ d : Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
      d.delta (TrivSqZeroExt.inr 1) = TrivSqZeroExt.inr c := by
  sorry

/-- The sum of the unit and the square-zero generator detects the addition correction. -/
example (c : ZMod 2) :
    ∃ d : Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
      d.delta (TrivSqZeroExt.inr 1) = TrivSqZeroExt.inr c ∧
      d.delta (1 + TrivSqZeroExt.inr 1) = TrivSqZeroExt.inr (c - 1) := by
  sorry

/-- The square-zero family restricts to the canonical integer delta operation. -/
example (c : ZMod 2) :
    ∃ d : Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
      d.delta (TrivSqZeroExt.inr 1) = TrivSqZeroExt.inr c ∧
      ∀ a : ℤ, d.delta (TrivSqZeroExt.inl a) =
        TrivSqZeroExt.inl (integerDelta 2 a) := by
  sorry

/-- Frobenius equality does not detect rank one on the square-zero torsion generator. -/
example :
    ∃ d : Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
      associatedFrobenius d (TrivSqZeroExt.inr 1) =
        (TrivSqZeroExt.inr 1) ^ 2 ∧
      ¬ IsRankOne d (TrivSqZeroExt.inr 1) := by
  sorry

/-- The square-zero correction has both mixed terms with negative signs. -/
example (x y : TrivSqZeroExt ℤ (ZMod 2)) :
    (addCorrection 2 x y).snd =
      -(x.fst : ZMod 2) * y.snd - (y.fst : ZMod 2) * x.snd := by
  sorry

/-- Delta compatibility is preserved by composition of ring maps. -/
example {T : Type*} [CommRing T] (p : ℕ)
    (d : Structure p R) (e : Structure p S) (t : Structure p T)
    (f : R →+* S) (g : S →+* T) (hf : IsDeltaMap d e f) (hg : IsDeltaMap e t g) :
    IsDeltaMap d t (g.comp f) := by
  intro x
  change g (f (d.delta x)) = t.delta (g (f x))
  rw [hf x, hg (f x)]

/-- Equal Frobenius maps can forget a nonzero change of delta on torsion. -/
example : ∃ d e : Structure 2 (TrivSqZeroExt ℤ (ZMod 2)),
    d.delta (TrivSqZeroExt.inr 1) = 0 ∧
    e.delta (TrivSqZeroExt.inr 1) = TrivSqZeroExt.inr 1 ∧
    (∀ x, associatedFrobenius d x = associatedFrobenius e x) ∧
    ¬ IsDeltaMap d e (RingHom.id _) := by
  sorry

end SquareZero

end Delta

/-- The completion counterexample uses a right shift: the first coordinate becomes zero,
and the next coordinate is multiplied by the distinguished parameter. -/
example {R : Type*} [CommRing R] (d : R) :
    (fun n : ℕ => match n with
      | 0 => 0
      | k + 1 => d * ((Pi.single 0 (1 : R) : ℕ → R) k)) =
      (Pi.single 1 d : ℕ → R) := by
  funext n
  cases n with
  | zero => simp
  | succ k =>
    cases k <;> simp

/-- The shifted torsion class survives one step: X is not divisible by X squared.
These are the first two F₂[d]/dⁿ components of the completed-localisation control. -/
example : ¬ (Polynomial.X : Polynomial (ZMod 2)) ^ 2 ∣ Polynomial.X := by
  sorry

/-- In the next torsion component, the second power is killed, not the first. -/
example :
    let I : Ideal (Polynomial (ZMod 2)) := Ideal.span {Polynomial.X ^ 2}
    let x : Polynomial (ZMod 2) ⧸ I := Ideal.Quotient.mk I Polynomial.X
    x ≠ 0 ∧ x * x = 0 := by
  sorry

