/-!
# Totally distributive topoi: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is `README.md`.
This file states the roadmap's headline theorems against the pinned Mathlib and Tau Ceti, each
with `sorry`, together with the definitions their statements need, all with real bodies on native
carriers. The API around each target, the special cases and the Checks stay in the README.

Headlines stated here (README target, Lean name):

* 1.1, `IsCompletelyDistributive`.
* 1.2, `isCompletelyDistributive_iff_le_sSup_iInter`.
* 1.3, `isLocallyConnected_iff` (on `IsConnectedElem` and `IsLocallyConnected`).
* 1.4, `nonempty_orderIso_lowerSet_iff` (on `IsCompletelySupPrime`) and
  `not_isCompletelySupPrime`.
* 2.1, `ProductsPreserveEpis`, `ProductsDistribOverCoproducts`, `IsTotallyDistributive`,
  `IsPresheafTopos`.
* 2.2, `productsDistribOverCoproducts_sheaf_iff`.
* 2.3, `isRightAdjoint_presheafToSheaf_iff`.
* 2.4, `productsPreserveEpis_and_distrib_iff` and
  `productsPreserveEpis_and_distrib_iff_exists_essential`.
* 2.5, `isTotallyDistributive_sheaf_iff`.
* 3.1, `Sh`, `productsPreserveEpis_and_distrib_sh_iff`.
* 3.2, `productsDistribOverCoproducts_sh_iff`.
* 3.3, `isPresheafTopos_sh_iff`.
* 3.5, `LowerIco`, `productsPreserveEpis_and_distrib_sh_lowerIco`,
  `not_isPresheafTopos_sh_lowerIco`, `nonempty_isInitial_of_projective_sh_lowerIco`.
* 3.6, `productsPreserveEpis_sh_cantor`, `not_productsDistribOverCoproducts_sh_cantor`,
  `not_productsPreserveEpis_sh_real`.
* 4.1, `isPresheafTopos_sheaf_iff`.
* 4.2, `enoughProjectives_sh_cantor`.

Not statable at the pins, with the carrier each lacks:

* 3.4, the localic forms for a frame `L` (`Sh(L)` satisfies (A) and (B) exactly when `L` is
  completely distributive, (B) alone exactly when `L` is locally connected, `Sh(L)` is a presheaf
  topos exactly when `L` is join-generated by completely join-prime elements): they lack
  GrothendieckTopoi's `Frame.grothendieckTopology` (GrothendieckTopoi 7.1); the spatial forms
  (3.1–3.3) are stated, on Mathlib's `Opens.grothendieckTopology`.
* 3.6, the topos of continuous `ℤ_p`-sets satisfies (B) and not (A): it lacks products in
  Mathlib's `DiscreteContAction`, which has no limit instance at the pins.

`Sh(ℝ)` satisfying (B) is not stated: it is target 3.2 applied to Mathlib's instance
`LocallyConnectedSpace ℝ`, and the README keeps it. A completely distributive frame is locally
connected (1.3) by the same one-line reduction, and is kept in the README too.
-/

@[expose] public section

universe v u

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace TauCetiRoadmap.TotallyDistributiveTopoi

/-! ## Layer 1: completely distributive and locally connected frames -/

section Order

variable {L : Type u}

variable (L) in
/-- **1.1.** A complete lattice is *completely distributive* when every meet of joins is the join
of the meets along choice functions, for families indexed in the universe of `L`. Mathlib's class
`CompletelyDistribLattice` gives it through `iInf_iSup_eq`. -/
def IsCompletelyDistributive [CompleteLattice L] : Prop :=
  ∀ (ι : Type u) (κ : ι → Type u) (f : ∀ i, κ i → L),
    ⨅ i, ⨆ j, f i j = ⨆ g : (∀ i, κ i), ⨅ i, f i (g i)

/-- **1.2.** Complete distributivity is the stability of covers under arbitrary intersections:
if `a` lies below the join of each of a family of lower sets, it lies below the join of their
intersection. This is the order-theoretic form of target 2.3 on the canonical site of `L`. -/
theorem isCompletelyDistributive_iff_le_sSup_iInter [CompleteLattice L] :
    IsCompletelyDistributive L ↔
      ∀ (a : L) (ι : Type u) (S : ι → Set L), (∀ i, IsLowerSet (S i)) →
        (∀ i, a ≤ sSup (S i)) → a ≤ sSup (⋂ i, S i) :=
  sorry

/-- **1.3.** An element of a frame is *connected* when it is not `⊥` and is not the join of two
disjoint elements other than `⊥`. -/
def IsConnectedElem [Order.Frame L] (a : L) : Prop :=
  a ≠ ⊥ ∧ ∀ b c : L, Disjoint b c → b ⊔ c = a → b = ⊥ ∨ c = ⊥

variable (L) in
/-- **1.3.** A frame is *locally connected* when every element is the join of the connected
elements below it. -/
def IsLocallyConnected [Order.Frame L] : Prop :=
  ∀ a : L, sSup {b | b ≤ a ∧ IsConnectedElem b} = a

/-- **1.3.** A frame is locally connected exactly when it is completely distributive for families
of pairwise disjoint elements. -/
theorem isLocallyConnected_iff [Order.Frame L] :
    IsLocallyConnected L ↔
      ∀ (ι : Type u) (κ : ι → Type u) (f : ∀ i, κ i → L),
        (∀ i, Pairwise fun j j' => Disjoint (f i j) (f i j')) →
          ⨅ i, ⨆ j, f i j = ⨆ g : (∀ i, κ i), ⨅ i, f i (g i) :=
  sorry

/-- **1.4.** An element `a` is *completely join-prime* when `a ≤ sSup s` forces `a ≤ b` for some
`b ∈ s`. Taking `s = ∅` shows that `⊥` is never completely join-prime. -/
def IsCompletelySupPrime [CompleteLattice L] (a : L) : Prop :=
  ∀ s : Set L, a ≤ sSup s → ∃ b ∈ s, a ≤ b

/-- **1.4.** A complete lattice is isomorphic to the lattice of lower sets of a partial order
exactly when every element is the join of the completely join-prime elements below it (compare
Raney 1952, Theorem 2). -/
theorem nonempty_orderIso_lowerSet_iff [CompleteLattice L] :
    (∃ (P : Type u) (_ : PartialOrder P), Nonempty (L ≃o LowerSet P)) ↔
      ∀ a : L, sSup {p | p ≤ a ∧ IsCompletelySupPrime p} = a :=
  sorry

/-- **1.4.** A densely ordered complete chain has no completely join-prime element: each `a` is
the join of `Set.Iio a`. -/
theorem not_isCompletelySupPrime [CompleteLinearOrder L] [DenselyOrdered L] (a : L) :
    ¬ IsCompletelySupPrime a :=
  sorry

end Order

/-! ## Layer 2: the two exactness conditions on a topos -/

section Exactness

variable (E : Type v) [Category.{u} E]

/-- **2.1, condition (A).** A `u`-small product of epimorphisms is an epimorphism. -/
def ProductsPreserveEpis [HasProducts.{u} E] : Prop :=
  ∀ ⦃ι : Type u⦄ ⦃X Y : ι → E⦄ (f : ∀ i, X i ⟶ Y i), (∀ i, Epi (f i)) → Epi (Limits.Pi.map f)

/-- **2.1, condition (B).** `u`-small products distribute over `u`-small coproducts: the
canonical map `∐_{k : ∀ i, K i} ∏ᵢ X i (k i) ⟶ ∏ᵢ ∐_{j : K i} X i j` is an isomorphism. -/
def ProductsDistribOverCoproducts [HasProducts.{u} E] [HasCoproducts.{u} E] : Prop :=
  ∀ ⦃ι : Type u⦄ ⦃K : ι → Type u⦄ (X : ∀ i, K i → E),
    IsIso (Sigma.desc fun k : (∀ i, K i) => Limits.Pi.map fun i => Sigma.ι (X i) (k i))

/-- **2.1.** `E` is *totally distributive* (Rosebrugh–Wood): the Yoneda embedding has a left
adjoint `c`, and `c` has a further left adjoint. -/
def IsTotallyDistributive : Prop :=
  ∃ (c : (Eᵒᵖ ⥤ Type u) ⥤ E) (_ : c ⊣ yoneda), c.IsRightAdjoint

/-- **2.1.** `E` is equivalent to the category of presheaves on a `u`-small category. -/
def IsPresheafTopos : Prop :=
  ∃ (D : Type u) (_ : SmallCategory D), Nonempty (E ≌ (Dᵒᵖ ⥤ Type u))

end Exactness

section Site

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)

/-- **2.2.** Products distribute over coproducts in `Sheaf J (Type u)` exactly when the topos is
locally connected: the constant sheaf functor has a left adjoint `π₀`. -/
theorem productsDistribOverCoproducts_sheaf_iff :
    ProductsDistribOverCoproducts (Sheaf J (Type u)) ↔
      (constantSheaf J (Type u)).IsRightAdjoint :=
  sorry

/-- **2.3.** Sheafification has a left adjoint (the sheaves form an essential subtopos of the
presheaves) exactly when the covering sieves of every object are closed under `u`-small
intersections. -/
theorem isRightAdjoint_presheafToSheaf_iff :
    (presheafToSheaf J (Type u)).IsRightAdjoint ↔
      ∀ (c : C) (ι : Type u) (S : ι → Sieve c), (∀ i, S i ∈ J c) → ⨅ i, S i ∈ J c :=
  sorry

/-- **2.4.** On a subcanonical site, `Sheaf J (Type u)` satisfies (A) and (B) exactly when the
covering sieves of every object are closed under `u`-small intersections. -/
theorem productsPreserveEpis_and_distrib_iff [J.Subcanonical] :
    ProductsPreserveEpis (Sheaf J (Type u)) ∧ ProductsDistribOverCoproducts (Sheaf J (Type u)) ↔
      ∀ (c : C) (ι : Type u) (S : ι → Sieve c), (∀ i, S i ∈ J c) → ⨅ i, S i ∈ J c :=
  sorry

/-- **2.4.** `Sheaf J (Type u)` satisfies (A) and (B) exactly when it is an essential subtopos of
a presheaf topos: a fully faithful functor into presheaves on a small category whose left adjoint
preserves finite limits and has a further left adjoint. -/
theorem productsPreserveEpis_and_distrib_iff_exists_essential :
    ProductsPreserveEpis (Sheaf J (Type u)) ∧ ProductsDistribOverCoproducts (Sheaf J (Type u)) ↔
      ∃ (D : Type u) (_ : SmallCategory D) (i : Sheaf J (Type u) ⥤ (Dᵒᵖ ⥤ Type u))
        (r : (Dᵒᵖ ⥤ Type u) ⥤ Sheaf J (Type u)) (_ : r ⊣ i),
        i.Full ∧ i.Faithful ∧ PreservesFiniteLimits r ∧ r.IsRightAdjoint :=
  sorry

/-- **2.5.** `Sheaf J (Type u)` is totally distributive exactly when it satisfies (A) and (B)
(through Lucyshyn-Wright 2012, Theorem 1.5.5). -/
theorem isTotallyDistributive_sheaf_iff :
    IsTotallyDistributive (Sheaf J (Type u)) ↔
      ProductsPreserveEpis (Sheaf J (Type u)) ∧ ProductsDistribOverCoproducts (Sheaf J (Type u)) :=
  sorry

end Site

/-! ## Layer 3: spaces, the counterexample and independence -/

/-- **3.1.** The topos of sheaves of sets on a space `X`, on Mathlib's site of open sets. -/
abbrev Sh (X : Type u) [TopologicalSpace X] : Type (u + 1) :=
  Sheaf (Opens.grothendieckTopology X) (Type u)

section Space

variable (X : Type u) [TopologicalSpace X]

/-- **3.1.** `Sh(X)` satisfies (A) and (B) exactly when the frame `Opens X` is completely
distributive. -/
theorem productsPreserveEpis_and_distrib_sh_iff :
    ProductsPreserveEpis (Sh X) ∧ ProductsDistribOverCoproducts (Sh X) ↔
      IsCompletelyDistributive (Opens X) :=
  sorry

/-- **3.2.** `Sh(X)` satisfies (B) exactly when `X` is locally connected. -/
theorem productsDistribOverCoproducts_sh_iff :
    ProductsDistribOverCoproducts (Sh X) ↔ LocallyConnectedSpace X :=
  sorry

/-- **3.3.** `Sh(X)` is a presheaf topos exactly when every open set is the union of the
completely join-prime open sets it contains. -/
theorem isPresheafTopos_sh_iff :
    IsPresheafTopos (Sh X) ↔ ∀ U : Opens X, sSup {V | V ≤ U ∧ IsCompletelySupPrime V} = U :=
  sorry

end Space

/-- **3.5.** The interval `[0, 1)` with the lower topology: its open sets are the `[0, a)`,
`0 ≤ a ≤ 1`, and its frame of open sets is the complete chain `[0, 1]`. -/
abbrev LowerIco : Type := Topology.WithLower (Set.Ico (0 : ℝ) 1)

/-- **3.5.** Sheaves on `[0, 1)` with the lower topology satisfy (A) and (B). -/
theorem productsPreserveEpis_and_distrib_sh_lowerIco :
    ProductsPreserveEpis (Sh LowerIco) ∧ ProductsDistribOverCoproducts (Sh LowerIco) :=
  sorry

/-- **3.5.** Sheaves on `[0, 1)` with the lower topology do not form a presheaf topos. -/
theorem not_isPresheafTopos_sh_lowerIco : ¬ IsPresheafTopos (Sh LowerIco) :=
  sorry

/-- **3.5.** Every projective sheaf on `[0, 1)` with the lower topology is initial. -/
theorem nonempty_isInitial_of_projective_sh_lowerIco (P : Sh LowerIco) [Projective P] :
    Nonempty (IsInitial P) :=
  sorry

/-- **3.6.** Sheaves on the Cantor space satisfy (A). -/
theorem productsPreserveEpis_sh_cantor : ProductsPreserveEpis (Sh (ℕ → Bool)) :=
  sorry

/-- **3.6.** Sheaves on the Cantor space do not satisfy (B). -/
theorem not_productsDistribOverCoproducts_sh_cantor :
    ¬ ProductsDistribOverCoproducts (Sh (ℕ → Bool)) :=
  sorry

/-- **3.6.** Sheaves on the real line do not satisfy (A). -/
theorem not_productsPreserveEpis_sh_real : ¬ ProductsPreserveEpis (Sh ℝ) :=
  sorry

/-! ## Layer 4: projective objects -/

section Projectives

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)

/-- **4.1.** `Sheaf J (Type u)` is a presheaf topos exactly when it satisfies (B) and has enough
projectives. -/
theorem isPresheafTopos_sheaf_iff :
    IsPresheafTopos (Sheaf J (Type u)) ↔
      ProductsDistribOverCoproducts (Sheaf J (Type u)) ∧ EnoughProjectives (Sheaf J (Type u)) :=
  sorry

end Projectives

/-- **4.2.** Sheaves on the Cantor space have enough projectives, so (B) cannot be dropped from
target 4.1. -/
theorem enoughProjectives_sh_cantor : EnoughProjectives (Sh (ℕ → Bool)) :=
  sorry

end TauCetiRoadmap.TotallyDistributiveTopoi
