/-!
# Local analysis of finite groups: suggested interfaces

**This file is not the roadmap and is not exhaustive.** `README.md` is definitive. The
declarations below are suggested forms for the main definitions and the named milestones of
each layer; they do not list the basic API that the README asks for around each definition.
Every `sorry` is an honest target, not an assumption.

`pCore` is copied in the shape of mathlib4#39771 (`Subgroup.pCore`), so that the eventual
replacement by Mathlib's declaration is a deletion plus an import.
-/

namespace TauCetiRoadmap.LocalFiniteGroupTheory

open Subgroup
open scoped Pointwise commutatorElement

universe u v

variable {G : Type u} [Group G]

/-! ## L1: cores, Hall subgroups and the Baer–Suzuki theorem -/

/-- The `p`-core `O_p(H)` of a subgroup `H`, as a subgroup of `G`, in the shape of
mathlib4#39771: the intersection of the Sylow `p`-subgroups of `H`. -/
def pCore (p : ℕ) (H : Subgroup G) : Subgroup G :=
  (⨅ P : Sylow p H, (P : Subgroup H)).map H.subtype

/-- `K` is a `π`-subgroup: every prime dividing its order lies in `π`. -/
def IsPiSubgroup (π : Set ℕ) (K : Subgroup G) : Prop :=
  ∀ q : ℕ, q.Prime → q ∣ Nat.card K → q ∈ π

/-- The `π`-core `O_π(H)`: the subgroup generated by the normal `π`-subgroups of `H`. -/
def piCore (π : Set ℕ) (H : Subgroup G) : Subgroup G :=
  sSup {N : Subgroup G | N ≤ H ∧ (N.subgroupOf H).Normal ∧ IsPiSubgroup π N}

/-- The `p′`-core `O_{p′}(H)`. -/
def pPrimeCore (p : ℕ) (H : Subgroup G) : Subgroup G :=
  piCore {q | q ≠ p} H

theorem isPiSubgroup_piCore [Finite G] (π : Set ℕ) (H : Subgroup G) :
    IsPiSubgroup π (piCore π H) := sorry

theorem piCore_singleton [Finite G] (p : ℕ) [Fact p.Prime] (H : Subgroup G) :
    piCore {p} H = pCore p H := sorry

/-- A Hall `π`-subgroup: a `π`-subgroup whose index involves no prime of `π`. -/
def IsHallSubgroup (π : Set ℕ) (K : Subgroup G) : Prop :=
  IsPiSubgroup π K ∧ ∀ q : ℕ, q.Prime → q ∣ K.index → q ∉ π

/-- **Hall's theorem**, existence. -/
theorem exists_isHallSubgroup [Finite G] (hG : Group.IsSolvable G) (π : Set ℕ) :
    ∃ K : Subgroup G, IsHallSubgroup π K := sorry

/-- **Hall's theorem**, conjugacy. -/
theorem exists_conj_eq_of_isHallSubgroup [Finite G] (hG : Group.IsSolvable G) {π : Set ℕ}
    {K L : Subgroup G} (hK : IsHallSubgroup π K) (hL : IsHallSubgroup π L) :
    ∃ g : G, MulAut.conj g • K = L := sorry

/-- **Schur–Zassenhaus**, conjugacy (Mathlib has existence). -/
theorem exists_conj_eq_of_isComplement' [Finite G] {N : Subgroup G} [N.Normal]
    (hN : Nat.Coprime (Nat.card N) N.index) (hsolv : Group.IsSolvable N ∨ Group.IsSolvable (G ⧸ N))
    {H K : Subgroup G} (hH : IsComplement' N H) (hK : IsComplement' N K) :
    ∃ g : G, MulAut.conj g • H = K := sorry

/-- **The Baer–Suzuki theorem.** -/
theorem mem_pCore_of_forall_isPGroup_closure [Finite G] {p : ℕ} [Fact p.Prime] {x : G}
    (hx : IsPGroup p (zpowers x))
    (h : ∀ g : G, IsPGroup p (closure ({x, g * x * g⁻¹} : Set G))) :
    x ∈ pCore p ⊤ := sorry

/-! ## L2: the Fitting subgroup, components and `F*(G)` -/

/-- The Fitting subgroup `F(H)`: the subgroup generated by the normal nilpotent subgroups
of `H`. -/
def fitting (H : Subgroup G) : Subgroup G :=
  sSup {N : Subgroup G | N ≤ H ∧ (N.subgroupOf H).Normal ∧ Group.IsNilpotent N}

theorem isNilpotent_fitting [Finite G] (H : Subgroup G) : Group.IsNilpotent (fitting H) :=
  sorry

theorem fitting_eq_iSup_pCore [Finite G] (H : Subgroup G) :
    fitting H = ⨆ p : Nat.Primes, pCore p H := sorry

theorem centralizer_fitting_le [Finite G] (hG : Group.IsSolvable G) :
    centralizer ((fitting ⊤ : Subgroup G) : Set G) ≤ fitting ⊤ := sorry

/-- A group is **quasisimple** if it is perfect and simple modulo its centre. -/
class IsQuasisimple (K : Type*) [Group K] : Prop where
  isPerfect : Group.IsPerfect K
  isSimpleGroup_quotient_center : IsSimpleGroup (K ⧸ center K)

/-- `K` is a **component** of `H`: a quasisimple subnormal subgroup of `H`. -/
def IsComponentOf (K H : Subgroup G) : Prop :=
  K ≤ H ∧ (K.subgroupOf H).IsSubnormal ∧ IsQuasisimple K

/-- The layer `E(H)`: the subgroup generated by the components of `H`. -/
def layer (H : Subgroup G) : Subgroup G :=
  sSup {K : Subgroup G | IsComponentOf K H}

/-- The generalized Fitting subgroup `F*(H) = F(H) E(H)`. -/
def generalizedFitting (H : Subgroup G) : Subgroup G :=
  fitting H ⊔ layer H

theorem commutator_eq_bot_of_isComponentOf [Finite G] {K L H : Subgroup G}
    (hK : IsComponentOf K H) (hL : IsComponentOf L H) (hKL : K ≠ L) : ⁅K, L⁆ = ⊥ := sorry

theorem commutator_fitting_layer [Finite G] (H : Subgroup G) :
    ⁅fitting H, layer H⁆ = ⊥ := sorry

/-- **Bender's theorem**: `F*(G)` is self-centralizing. -/
theorem centralizer_generalizedFitting_le [Finite G] :
    centralizer ((generalizedFitting ⊤ : Subgroup G) : Set G) ≤ generalizedFitting ⊤ := sorry

/-! ## L3: coprime action -/

section CoprimeAction

variable (A : Type v) [Group A] [MulDistribMulAction A G]

/-- The subgroup `C_G(a)` of points fixed by one element `a` of the acting group. -/
def fixedBy (a : A) : Subgroup G where
  carrier := {g | a • g = g}
  mul_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq] at hx hy ⊢
    rw [smul_mul', hx, hy]
  one_mem' := smul_one a
  inv_mem' {x} hx := by
    simp only [Set.mem_ofPred_eq] at hx ⊢
    rw [smul_inv', hx]

/-- The commutator `[K, A]` of an `A`-invariant subgroup `K` with the acting group. -/
def commutatorAct (K : Subgroup G) : Subgroup G :=
  closure {y | ∃ x ∈ K, ∃ a : A, y = x⁻¹ * (a • x)}

variable {A}

theorem exists_sylow_smul_eq [Finite G] [Finite A]
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G))
    (hsolv : Group.IsSolvable A ∨ Group.IsSolvable G)
    (p : ℕ) [Fact p.Prime] :
    ∃ P : Sylow p G, ∀ a : A, a • (P : Subgroup G) = P := sorry

theorem exists_mem_fixedPoints_conj_eq [Finite G] [Finite A]
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G))
    (hsolv : Group.IsSolvable A ∨ Group.IsSolvable G)
    {p : ℕ} [Fact p.Prime] {P Q : Sylow p G}
    (hP : ∀ a : A, a • (P : Subgroup G) = P) (hQ : ∀ a : A, a • (Q : Subgroup G) = Q) :
    ∃ c ∈ FixedPoints.subgroup A G, MulAut.conj c • (P : Subgroup G) = Q := sorry

/-- Fixed points lift through an invariant normal subgroup. -/
theorem exists_mem_fixedPoints_mul_of_forall_mem [Finite G] [Finite A]
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G))
    (hsolv : Group.IsSolvable A ∨ Group.IsSolvable G)
    {N : Subgroup G} [N.Normal] (hN : ∀ a : A, a • N = N) {g : G}
    (hg : ∀ a : A, g⁻¹ * (a • g) ∈ N) :
    ∃ c ∈ FixedPoints.subgroup A G, ∃ n ∈ N, g = c * n := sorry

theorem fixedPoints_sup_commutatorAct [Finite G] [Finite A]
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G))
    (hsolv : Group.IsSolvable A ∨ Group.IsSolvable G) :
    FixedPoints.subgroup A G ⊔ commutatorAct A ⊤ = ⊤ := sorry

theorem commutatorAct_commutatorAct [Finite G] [Finite A]
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G))
    (hsolv : Group.IsSolvable A ∨ Group.IsSolvable G) :
    commutatorAct A (commutatorAct A ⊤) = commutatorAct A (⊤ : Subgroup G) := sorry

/-- A noncyclic elementary abelian group acting coprimely is generated by the centralizers of
its nonidentity elements. -/
theorem iSup_fixedBy_eq_top [Finite G] [Finite A] [IsMulCommutative A] {p : ℕ} [Fact p.Prime]
    (hexp : ∀ a : A, a ^ p = 1) (hnc : ¬ IsCyclic A)
    (hcop : Nat.Coprime (Nat.card A) (Nat.card G)) :
    ⨆ (a : A) (_ : a ≠ 1), fixedBy A a = (⊤ : Subgroup G) := sorry

/-- **Thompson's `A × B` lemma.** -/
theorem eq_of_fixedPoints_le_of_isPGroup [Finite G] {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G)
    {B : Type v} [Group B] [Finite A] [Finite B] [MulDistribMulAction B G] [SMulCommClass A B G]
    (hA : Nat.Coprime (Nat.card A) p) (hB : IsPGroup p B)
    (htriv : ∀ a : A, ∀ g ∈ FixedPoints.subgroup B G, a • g = g) :
    ∀ a : A, ∀ g : G, a • g = g := sorry

end CoprimeAction

/-! ## L4: `p`-groups for local analysis -/

/-- An elementary abelian `p`-group. -/
def IsElementaryAbelian (p : ℕ) (E : Type*) [Group E] : Prop :=
  IsMulCommutative E ∧ ∀ e : E, e ^ p = 1

/-- The `p`-rank `m_p(G)`: the largest `k` with an elementary abelian subgroup of order `p ^ k`.
-/
noncomputable def pRank (p : ℕ) (G : Type*) [Group G] : ℕ :=
  sSup {k | ∃ E : Subgroup G, IsElementaryAbelian p E ∧ Nat.card E = p ^ k}

/-- An extraspecial `p`-group: its centre has order `p` and equals both its derived subgroup and
its Frattini subgroup. -/
def IsExtraspecial (p : ℕ) (P : Type*) [Group P] : Prop :=
  IsPGroup p P ∧ Nat.card (center P) = p ∧ commutator P = center P ∧ frattini P = center P

theorem exists_card_eq_of_isExtraspecial {p : ℕ} [Fact p.Prime] {P : Type*} [Group P]
    [Finite P] (hP : IsExtraspecial p P) : ∃ n, 1 ≤ n ∧ Nat.card P = p ^ (2 * n + 1) := sorry

/-- `𝒜(P)`: the abelian subgroups of `P` of maximal order. -/
def maxOrderAbelianSubgroups (P : Subgroup G) : Set (Subgroup G) :=
  {A | A ≤ P ∧ IsMulCommutative A ∧
    ∀ B : Subgroup G, B ≤ P → IsMulCommutative B → Nat.card B ≤ Nat.card A}

/-- The Thompson subgroup `J(P)`, generated by `𝒜(P)`. -/
def thompsonSubgroup (P : Subgroup G) : Subgroup G :=
  sSup (maxOrderAbelianSubgroups P)

/-- **Thompson's replacement theorem**, in its base form. -/
theorem sup_mem_maxOrderAbelianSubgroups [Finite G] {P A : Subgroup G}
    (hA : A ∈ maxOrderAbelianSubgroups P) {x : G} (hx : x ∈ P)
    (hM : IsMulCommutative (closure {g | ∃ u ∈ A, ⁅x, u⁆ = g})) :
    closure {g | ∃ u ∈ A, ⁅x, u⁆ = g} ⊔
        (A ⊓ centralizer (closure {g | ∃ u ∈ A, ⁅x, u⁆ = g} : Set G)) ∈
      maxOrderAbelianSubgroups P := sorry

/-! ## L5: normal `p`-complements and the `ZJ` theorem -/

/-- `G` has a **normal `p`-complement**: a normal subgroup complementing every Sylow `p`-subgroup.
-/
def HasNormalPComplement (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ N : Subgroup G, N.Normal ∧ ∀ P : Sylow p G, IsComplement' N P

/-- **Frobenius's normal `p`-complement theorem.** -/
theorem hasNormalPComplement_of_forall_isPGroup [Finite G] {p : ℕ} [Fact p.Prime]
    (h : ∀ Q : Subgroup G, IsPGroup p Q → Q ≠ ⊥ →
      HasNormalPComplement p (normalizer (Q : Set G))) :
    HasNormalPComplement p G := sorry

/-- `p`-stability (for odd `p`): an element normalizing a `p`-subgroup `P`, with
`O_{p′}(G) P ⊴ G`, and acting quadratically on `P`, induces an automorphism in
`O_p(N_G(P) / C_G(P))`. The last condition is stated without the quotient: the normal closure of
`x` in `N_G(P)`, modulo `C_G(P)`, is a `p`-group. -/
def IsPStable (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∀ P : Subgroup G, IsPGroup p P → (pPrimeCore p ⊤ ⊔ P).Normal →
    ∀ x ∈ normalizer (P : Set G), ⁅⁅P, zpowers x⁆, zpowers x⁆ = ⊥ →
      ∃ K : Subgroup G, x ∈ K ∧ K ≤ normalizer (P : Set G) ∧
        (K.subgroupOf (normalizer (P : Set G))).Normal ∧
        ∀ k ∈ K, ∃ n : ℕ, k ^ (p ^ n) ∈ centralizer (P : Set G)

/-- **Glauberman's `ZJ` theorem.** -/
theorem normal_center_thompsonSubgroup [Finite G] {p : ℕ} [Fact p.Prime] (hp : Odd p)
    (hst : IsPStable p G)
    (hc : centralizer ((pCore p ⊤ : Subgroup G) : Set G) ≤ pCore p ⊤) (S : Sylow p G) :
    (centralizer (thompsonSubgroup (S : Subgroup G) : Set G) ⊓
      thompsonSubgroup (S : Subgroup G)).Normal := sorry

/-- **The Glauberman–Thompson normal `p`-complement theorem.** -/
theorem hasNormalPComplement_of_normalizer_center_thompsonSubgroup [Finite G] {p : ℕ}
    [Fact p.Prime] (hp : Odd p) (S : Sylow p G)
    (h : HasNormalPComplement p (normalizer ((centralizer
      (thompsonSubgroup (S : Subgroup G) : Set G) ⊓ thompsonSubgroup (S : Subgroup G) :
        Subgroup G) : Set G))) :
    HasNormalPComplement p G := sorry

/-! ## L6: Thompson's theorem on fixed-point-free automorphisms -/

/-- **Thompson's theorem.** A finite group with a fixed-point-free automorphism of prime order is
nilpotent. -/
theorem isNilpotent_of_fixedPointFree [Finite G] (φ : MulAut G) (hφ : (orderOf φ).Prime)
    (hfix : MonoidHom.FixedPointFree ⇑φ) : Group.IsNilpotent G := sorry

/-- The Frobenius kernel is nilpotent, stated against Tau Ceti's `frobeniusKernel` set, so that
it does not depend on Frobenius's theorem that the kernel is a subgroup. -/
theorem isNilpotent_of_coe_eq_frobeniusKernel [Finite G] {H N : Subgroup G}
    (hH : TauCeti.IsTISubgroup H) (hbot : H ≠ ⊥) (htop : H ≠ ⊤)
    (hN : (N : Set G) = TauCeti.frobeniusKernel H) : Group.IsNilpotent N := sorry

/-! ## L7: solvable signalizer functors -/

/-- An `A`-signalizer functor on the nonidentity elements of `A`. -/
structure IsSignalizerFunctor (p : ℕ) (A : Subgroup G) (θ : G → Subgroup G) : Prop where
  le_centralizer : ∀ a ∈ A, a ≠ 1 → θ a ≤ centralizer {a}
  coprime : ∀ a ∈ A, a ≠ 1 → Nat.Coprime p (Nat.card (θ a))
  le_normalizer : ∀ a ∈ A, a ≠ 1 → A ≤ normalizer (θ a : Set G)
  balanced : ∀ a ∈ A, a ≠ 1 → ∀ b ∈ A, b ≠ 1 → θ a ⊓ centralizer {b} ≤ θ b

/-- The subgroup generated by the values of `θ`. -/
def signalizerCompletion (A : Subgroup G) (θ : G → Subgroup G) : Subgroup G :=
  ⨆ (a : G) (_ : a ∈ A) (_ : a ≠ 1), θ a

/-- **Glauberman's solvable signalizer functor theorem.** -/
theorem signalizerCompletion_complete [Finite G] {p : ℕ} [Fact p.Prime] {A : Subgroup G}
    (hA : IsElementaryAbelian p A) (hrank : p ^ 3 ≤ Nat.card A) {θ : G → Subgroup G}
    (hθ : IsSignalizerFunctor p A θ) (hsolv : ∀ a ∈ A, a ≠ 1 → Group.IsSolvable (θ a)) :
    Nat.Coprime p (Nat.card (signalizerCompletion A θ)) ∧
      Group.IsSolvable (signalizerCompletion A θ) ∧
      ∀ a ∈ A, a ≠ 1 → signalizerCompletion A θ ⊓ centralizer {a} = θ a := sorry

end TauCetiRoadmap.LocalFiniteGroupTheory
