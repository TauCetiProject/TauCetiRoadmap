/-- O2: the presentation of `M11` maps onto its model. -/
theorem exists_surjective_M11 :
    ∃ f : SporadicName.M11.Group →* M11, Function.Surjective f := sorry

/-- O2: the presented group of `M11` is nontrivial. -/
theorem nontrivial_M11 : Nontrivial SporadicName.M11.Group := sorry

