import Mathlib
import TauCeti.GroupTheory.SpecificGroups.CFSG.Sporadic.Presentation

/-!
# Orders of the sporadic groups from permutation representations: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib and Tau Ceti, each with `sorry`.

The headline theorems are stated for `M24`, the representative name of the README's O1 table.
Every other name of that table has the same three theorems, with its own ATLAS generators, degree,
order and `TauCeti.SporadicName` constructor; nothing is missing at the pins to state them.

The model is the subgroup of `Equiv.Perm (Fin 24)` generated by the two permutations of the ATLAS
files `M24G1-p24B0.m1` and `M24G1-p24B0.m2`, shifted to the points `0, …, 23` and written here in
Mathlib's cycle notation. In Tau Ceti the same permutations are written with `permOfImages` from
the `hex-perm-group-mathlib` dependency of O0.
-/

namespace TauCetiRoadmap.SporadicOrders

open TauCeti

/-- The permutation model of `M24` on 24 points: the subgroup generated by the involution of the
ATLAS file `M24G1-p24B0.m1` and the element of order three of `M24G1-p24B0.m2`, with the point `i`
of the files sent to `i - 1`. -/
def M24 : Subgroup (Equiv.Perm (Fin 24)) :=
  Subgroup.closure
    {c[0, 3] * c[1, 6] * c[2, 16] * c[4, 12] * c[5, 8] * c[7, 14] * c[9, 18] * c[10, 17] *
        c[11, 20] * c[13, 15] * c[19, 23] * c[21, 22],
      c[0, 3, 5] * c[1, 20, 13] * c[2, 8, 14] * c[4, 17, 9] * c[12, 16, 15] * c[18, 23, 22]}

/-- O1: the permutation model of `M24` has order `244823040 = 2¹⁰ · 3³ · 5 · 7 · 11 · 23`. -/
theorem card_M24 : Nat.card M24 = 244823040 := sorry

/-- O2: the group presented by CFSGStatement's presentation of `M24` maps onto the permutation
model. -/
theorem exists_surjective_M24 :
    ∃ f : SporadicName.M24.Group →* M24, Function.Surjective f := sorry

/-- O2: the group presented by CFSGStatement's presentation of `M24` is nontrivial. -/
theorem nontrivial_M24 : Nontrivial SporadicName.M24.Group := sorry

end TauCetiRoadmap.SporadicOrders
