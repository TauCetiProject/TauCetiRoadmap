import Mathlib

/-!
# Quantum enveloping algebras: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib, each with `sorry`, together with the few definitions
needed to state them: the full-lattice Cartan datum, the symmetric quantum integers and the
Laurent Gaussian binomials, the Drinfeld–Jimbo presentation of Layer 1 as a `RingQuot` of a
`FreeAlgebra` over an arbitrary field `K` with parameter `q`, its coproduct and counit as algebra
maps, and the generator values of the braid operators of Layer 2.

Stated here: the quantum Lucas theorem for signed upper arguments at every root of unity
(Layer 0); the Hopf structure (coalgebra laws, then the antipode with its generator values), the
triangular decomposition and the linear independence of the full-`Y` torus (Layer 1); the
existence of the braid automorphisms with their generator formulas and the braid relations
(Layer 2).

Not statable at the pins:

* the comparison with the rank-one algebra of QuantumGroups Q8 (Layer 1), whose carrier is a
  roadmap target, not a library declaration;
* the braided halves `U⁺ ⊗_χ U⁺`, the nilpotent and Borel pairings and the Drinfeld double
  (Layer 1): the bicharacter-twisted tensor product algebra is not at the pins;
* the root vectors and the PBW basis (Layers 2–3): their ordering needs a reduced expression of
  the longest element of the Weyl group of the datum, and the identification of the group
  generated by the reflections `sᵢ` with a Mathlib `CoxeterSystem` is KacMoody Layer 2 §2.1;
* the integral form `U_A` and every statement about it or its specializations (Layers 3–8): the
  pins have no `ℤ[v, v⁻¹]`-algebra structure on `RatFunc ℚ`, and the specialized algebras
  `R ⊗_A U_A` are constructions;
* the comparison of `U_A` at `v = 1` with the Kostant form (Layer 3), the integral highest-weight
  comparison (Layer 4), the Frobenius maps (Layer 5) and the contraction comparisons (Layer 7):
  Tau Ceti's `TauCeti.UniversalEnvelopingAlgebra.kostantForm` takes root and Cartan families in a
  rational Lie algebra as input, and the rational pinned reductive Lie algebra of a root datum
  `(X, Y)` with its Chevalley families is ReductiveGroups Layer 9 §9A, absent from the pins;
* the modified algebra `dot U`, its integral form and the modified Frobenius map (Layer 5): its
  weight idempotents are projections on a category of weight modules not available at the pins;
* the half-algebra Frobenius sequences at small orders (Layer 5): Nichols algebras and Hopf
  algebras in categories of Yetter–Drinfeld modules are not at the pins;
* the root-of-unity module theorems (Layer 6) and the quantum-plane comparisons (Layer 8), which
  are statements about modules over the specialized integral form.
-/

noncomputable section

open scoped TensorProduct

namespace TauCetiRoadmap.QuantumEnvelopingAlgebras

universe u v w

/-! ## Layer 0: the datum, quantum integers and Gaussian binomials -/

/-- A full-lattice finite-rank symmetrizable Cartan realization (Layer 0): free lattices `X`, `Y`
with a perfect pairing, linearly independent simple roots and coroots, the generalized Cartan
matrix `aᵢⱼ = ⟨αⱼ, hᵢ⟩`, and a positive symmetrizer `dᵢ aᵢⱼ = dⱼ aⱼᵢ`. -/
structure CartanDatum (ι : Type u) (X : Type v) (Y : Type w)
    [Fintype ι] [DecidableEq ι] [AddCommGroup X] [AddCommGroup Y]
    [Module.Free ℤ X] [Module.Free ℤ Y] [Module.Finite ℤ X] [Module.Finite ℤ Y] where
  /-- The perfect pairing `X ≃ Hom(Y, ℤ)`. -/
  pairing : X ≃ₗ[ℤ] (Y →ₗ[ℤ] ℤ)
  /-- The simple roots `αᵢ ∈ X`. -/
  root : ι → X
  /-- The simple coroots `hᵢ ∈ Y`. -/
  coroot : ι → Y
  root_independent : LinearIndependent ℤ root
  coroot_independent : LinearIndependent ℤ coroot
  /-- The generalized Cartan matrix. -/
  cartan : ι → ι → ℤ
  cartan_eq : ∀ i j, cartan i j = pairing (root j) (coroot i)
  diagonal : ∀ i, cartan i i = 2
  offDiagonal : ∀ i j, i ≠ j → cartan i j ≤ 0
  zeroSymmetry : ∀ i j, cartan i j = 0 ↔ cartan j i = 0
  /-- The symmetrizer `dᵢ`. -/
  symmetrizer : ι → ℕ
  symmetrizer_pos : ∀ i, 0 < symmetrizer i
  symmetrizes : ∀ i j,
    (symmetrizer i : ℤ) * cartan i j = (symmetrizer j : ℤ) * cartan j i

namespace CartanDatum

variable {ι : Type u} {X : Type v} {Y : Type w}
  [Fintype ι] [DecidableEq ι] [AddCommGroup X] [AddCommGroup Y]
  [Module.Free ℤ X] [Module.Free ℤ Y] [Module.Finite ℤ X] [Module.Finite ℤ Y]
  (D : CartanDatum ι X Y)

/-- The pairing value `⟨αᵢ, y⟩`. -/
def pairingValue (i : ι) (y : Y) : ℤ := D.pairing (D.root i) y

/-- The toral direction `dᵢ hᵢ`, so that `Kᵢ = K_(dᵢ hᵢ)`. -/
def simpleTorus (i : ι) : Y := D.symmetrizer i • D.coroot i

/-- The simple reflection `sᵢ y = y − ⟨αᵢ, y⟩ hᵢ` of the cocharacter lattice `Y`. -/
def reflect (i : ι) (y : Y) : Y := y - D.pairingValue i y • D.coroot i

/-- The order `mᵢⱼ` of `sᵢ sⱼ` for `i ≠ j` when `aᵢⱼ aⱼᵢ ≤ 3`: `2, 3, 4, 6` for
`aᵢⱼ aⱼᵢ = 0, 1, 2, 3`. -/
def braidLength (i j : ι) : ℕ :=
  if D.cartan i j * D.cartan j i = 0 then 2
  else if D.cartan i j * D.cartan j i = 1 then 3
  else if D.cartan i j * D.cartan j i = 2 then 4
  else 6

end CartanDatum

/-- The symmetric quantum integer `[r]_q = (q^r − q^(−r))/(q − q⁻¹)` in a field. At `q = ±1` the
denominator vanishes and the value is `0`; the theorems below assume that `q` is not a root of
unity, where it is the honest quotient. -/
def qInt {K : Type*} [Field K] (q : K) (r : ℕ) : K :=
  (q ^ r - (q ^ r)⁻¹) / (q - q⁻¹)

/-- The quantum factorial `[r]_q! = [1]_q ⋯ [r]_q`. -/
def qFactorial {K : Type*} [Field K] (q : K) (r : ℕ) : K :=
  ∏ j ∈ Finset.range r, qInt q (j + 1)

open LaurentPolynomial in
/-- The symmetric Gaussian binomial `[n choose r]_v ∈ ℤ[v, v⁻¹]`, by the denominator-free Pascal
recurrence `[n+1 choose r+1] = v^(−(r+1)) [n choose r+1] + v^(n−r) [n choose r]`; it is `0` for
`r > n`. -/
def gaussian : ℕ → ℕ → LaurentPolynomial ℤ
  | _, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, r + 1 => T (-(r + 1 : ℤ)) * gaussian n (r + 1) + T ((n : ℤ) - r) * gaussian n r

/-- The Gaussian binomial with signed upper argument: the Laurent polynomial extending
`∏_(j=1)^r [m−j+1]_v / [j]_v` to `m ∈ ℤ`, so that `[−a choose r]_v = (−1)^r [a+r−1 choose r]_v`
for `a > 0`. -/
def signedGaussian : ℤ → ℕ → LaurentPolynomial ℤ
  | (n : ℕ), r => gaussian n r
  | Int.negSucc a, r => (-1) ^ r * gaussian (a + r) r

/-- Specialization `ℤ[v, v⁻¹] → K`, `v ↦ ζ`, at a unit `ζ`. -/
def specialize {K : Type*} [CommRing K] (ζ : Kˣ) : LaurentPolynomial ℤ →+* K :=
  LaurentPolynomial.eval₂ (Int.castRingHom K) ζ

/-- **Quantum Lucas theorem**, for every root of unity and every signed upper argument
(McGerty2006 Lemma 2.7, after Lusztig1993 Chapter 34). Let `ζ²` be a primitive `l`-th root of
unity, `m = m₁ l + m₀` and `r = r₁ l + r₀` the Euclidean decompositions with `0 ≤ m₀, r₀ < l`. Then
`[m choose r]_ζ = ζ^(l(r₁m₀ − m₁r₀) + (m₁+1) r₁ l²) [m₀ choose r₀]_ζ · binom(m₁, r₁)`, with the
integer-valued binomial `Ring.choose`; for odd order of `ζ` the power of `ζ` is `1`. -/
theorem quantumLucas {K : Type*} [Field K] (ζ : Kˣ) (l : ℕ) (hl : 0 < l)
    (hζ : IsPrimitiveRoot ((ζ : K) ^ 2) l) (m : ℤ) (r : ℕ) :
    specialize ζ (signedGaussian m r) =
      ((ζ ^ ((l : ℤ) * (((r / l : ℕ) : ℤ) * (m % l) - (m / l) * ((r % l : ℕ) : ℤ)) +
          (m / l + 1) * ((r / l : ℕ) : ℤ) * (l : ℤ) ^ 2) : Kˣ) : K) *
        specialize ζ (gaussian (m % l).toNat (r % l)) *
        ((Ring.choose (m / l) (r / l) : ℤ) : K) := by
  sorry

/-! ## Layer 1: the Drinfeld–Jimbo algebra and its Hopf structure -/

/-- Generators of the free algebra: `Eᵢ`, `Fᵢ` and a toral symbol `K_y` for every `y ∈ Y`, so
that central and isogeny directions of `Y` are retained. -/
inductive Generator (ι : Type u) (Y : Type v)
  | E (i : ι)
  | F (i : ι)
  | K (y : Y)

section Presentation

variable {ι : Type u} {X : Type v} {Y : Type w} {K : Type*}
  [AddCommGroup X] [AddCommGroup Y] [Field K]
  [Module.Free ℤ X] [Module.Free ℤ Y] [Module.Finite ℤ X] [Module.Finite ℤ Y]
  [Fintype ι] [DecidableEq ι]
  (D : CartanDatum ι X Y) (q : K)

local notation "Free" => FreeAlgebra K (Generator ι Y)

/-- The divided power `x^(r) = x^r / [r]_q!`. -/
def dividedPower (q : K) (x : Free) (r : ℕ) : Free :=
  (qFactorial q r)⁻¹ • x ^ r

/-- The generator `Eᵢ` of the free algebra. -/
def genE (i : ι) : Free := FreeAlgebra.ι K (.E i)
/-- The generator `Fᵢ` of the free algebra. -/
def genF (i : ι) : Free := FreeAlgebra.ι K (.F i)
/-- The toral generator `K_y` of the free algebra. -/
def genK (y : Y) : Free := FreeAlgebra.ι K (.K y)

/-- The toral generator `Kᵢ = K_(dᵢ hᵢ)` of the free algebra. -/
def simpleK (i : ι) : Free := genK (D.simpleTorus i)

/-- The Serre length `1 − aᵢⱼ`. -/
def serreLength (i j : ι) : ℕ := (1 - D.cartan i j).toNat

/-- The positive quantum Serre element `Σ_(r+s=1−aᵢⱼ) (−1)^r Eᵢ^(r) Eⱼ Eᵢ^(s)`, with divided
powers at `qᵢ = q^dᵢ`. -/
def serreE (i j : ι) : Free :=
  ∑ r ∈ Finset.range (serreLength D i j + 1),
    ((-1 : K) ^ r) •
      (dividedPower (q ^ D.symmetrizer i) (genE i) r *
        genE j *
        dividedPower (q ^ D.symmetrizer i) (genE i)
          (serreLength D i j - r))

/-- The negative quantum Serre element `Σ_(r+s=1−aᵢⱼ) (−1)^r Fᵢ^(r) Fⱼ Fᵢ^(s)`. -/
def serreF (i j : ι) : Free :=
  ∑ r ∈ Finset.range (serreLength D i j + 1),
    ((-1 : K) ^ r) •
      (dividedPower (q ^ D.symmetrizer i) (genF i) r *
        genF j *
        dividedPower (q ^ D.symmetrizer i) (genF i)
          (serreLength D i j - r))

/-- The defining relations of Layer 1: the torus is the group algebra of `Y`, `K_y` conjugates
`Eᵢ` and `Fᵢ` by `q^(±⟨αᵢ, y⟩)`, `EᵢFⱼ − FⱼEᵢ = δᵢⱼ (Kᵢ − Kᵢ⁻¹)/(qᵢ − qᵢ⁻¹)`, and the quantum
Serre relations. -/
inductive Relation : Free → Free → Prop
  | torusUnit : Relation (genK 0) 1
  | torusMul (y z : Y) :
      Relation (genK y * genK z) (genK (y + z))
  | conjugateE (y : Y) (i : ι) :
      Relation
        (genK y * genE i * genK (-y))
        ((q ^ D.pairingValue i y) • genE i)
  | conjugateF (y : Y) (i : ι) :
      Relation
        (genK y * genF i * genK (-y))
        ((q ^ (-(D.pairingValue i y))) • genF i)
  | commutator (i j : ι) :
      Relation
        (genE i * genF j - genF j * genE i)
        (if i = j then
          (q ^ D.symmetrizer i - (q ^ D.symmetrizer i)⁻¹)⁻¹ •
            (simpleK D i - genK (-(D.simpleTorus i)))
        else 0)
  | serrePositive (i j : ι) (hij : i ≠ j) :
      Relation (serreE D q i j) 0
  | serreNegative (i j : ι) (hij : i ≠ j) :
      Relation (serreF D q i j) 0

/-- The quantized enveloping algebra `U_q(A, X, Y)` of Layer 1, as a `RingQuot` of the free
algebra. -/
abbrev U := RingQuot (Relation D q)

/-- The image in `U` of a generator of the free algebra. -/
def generator (g : Generator ι Y) : U D q :=
  RingQuot.mkAlgHom K (Relation D q) (FreeAlgebra.ι K g)

/-- The generator `Eᵢ` of `U`. -/
def E (i : ι) : U D q := generator D q (.E i)
/-- The generator `Fᵢ` of `U`. -/
def F (i : ι) : U D q := generator D q (.F i)
/-- The toral generator `K_y` of `U`. -/
def Ktorus (y : Y) : U D q := generator D q (.K y)
/-- `Kᵢ = K_(dᵢ hᵢ)`. -/
def Ki (i : ι) : U D q := Ktorus D q (D.simpleTorus i)
/-- `Kᵢ⁻¹ = K_(−dᵢ hᵢ)`. -/
def KiInv (i : ι) : U D q := Ktorus D q (-(D.simpleTorus i))

/-- The algebra map out of `U` determined by images of the generators satisfying the
relations (the universal property of the presentation). -/
def lift {B : Type*} [Ring B] [Algebra K B]
    (f : Generator ι Y → B)
    (hrel : ∀ a b, Relation D q a b →
      (FreeAlgebra.lift K f) a = (FreeAlgebra.lift K f) b) :
    U D q →ₐ[K] B :=
  RingQuot.liftAlgHom K ⟨FreeAlgebra.lift K f, fun {_ _} h => hrel _ _ h⟩

/-- The coproduct on generators, in the convention of QuantumGroups Q8:
`Δ(Eᵢ) = Eᵢ ⊗ 1 + Kᵢ ⊗ Eᵢ`, `Δ(Fᵢ) = Fᵢ ⊗ Kᵢ⁻¹ + 1 ⊗ Fᵢ`, `Δ(K_y) = K_y ⊗ K_y`. -/
def comulGenerator : Generator ι Y → U D q ⊗[K] U D q
  | .E i => E D q i ⊗ₜ[K] (1 : U D q) + Ki D q i ⊗ₜ[K] E D q i
  | .F i => F D q i ⊗ₜ[K] KiInv D q i + (1 : U D q) ⊗ₜ[K] F D q i
  | .K y => Ktorus D q y ⊗ₜ[K] Ktorus D q y

/-- The coproduct images satisfy every defining relation, for `q` not a root of unity. -/
theorem comul_relations (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0)
    (a b : Free) (h : Relation D q a b) :
    (FreeAlgebra.lift K (comulGenerator D q)) a =
      (FreeAlgebra.lift K (comulGenerator D q)) b := by
  sorry

/-- The coproduct `Δ : U → U ⊗ U` as an algebra map. -/
def comulAlgHom (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    U D q →ₐ[K] U D q ⊗[K] U D q :=
  lift D q (comulGenerator D q) (comul_relations D q hq hfac)

/-- The counit on generators: `ε(Eᵢ) = ε(Fᵢ) = 0`, `ε(K_y) = 1`. -/
def counitGenerator : Generator ι Y → K
  | .E _ => 0
  | .F _ => 0
  | .K _ => 1

/-- The counit values satisfy every defining relation. -/
theorem counit_relations (a b : Free) (h : Relation D q a b) :
    (FreeAlgebra.lift K (counitGenerator (K := K) (ι := ι) (Y := Y))) a =
      (FreeAlgebra.lift K (counitGenerator (K := K) (ι := ι) (Y := Y))) b := by
  sorry

/-- The counit `ε : U → K` as an algebra map. -/
def counitAlgHom : U D q →ₐ[K] K :=
  lift D q counitGenerator (counit_relations D q)

/-- Coassociativity of the Layer 1 coproduct. -/
theorem comul_coassoc (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.assoc K K K (U D q) (U D q) (U D q)).toAlgHom.comp
        ((Algebra.TensorProduct.map (comulAlgHom D q hq hfac) (.id K (U D q))).comp
          (comulAlgHom D q hq hfac)) =
      (Algebra.TensorProduct.map (.id K (U D q)) (comulAlgHom D q hq hfac)).comp
        (comulAlgHom D q hq hfac) := by
  sorry

/-- The left counit law `(ε ⊗ id) ∘ Δ = id` (Layer 1). -/
theorem counit_comul_left (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.map (counitAlgHom D q) (.id K (U D q))).comp
        (comulAlgHom D q hq hfac) =
      ((Algebra.TensorProduct.lid K (U D q)).symm : U D q →ₐ[K] K ⊗[K] U D q) := by
  sorry

/-- The right counit law `(id ⊗ ε) ∘ Δ = id` (Layer 1). -/
theorem counit_comul_right (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.map (.id K (U D q)) (counitAlgHom D q)).comp
        (comulAlgHom D q hq hfac) =
      ((Algebra.TensorProduct.rid K K (U D q)).symm : U D q →ₐ[K] U D q ⊗[K] K) := by
  sorry

/-- The native Mathlib bialgebra structure on `U` with the Layer 1 coproduct and counit. -/
abbrev bialgebra (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    Bialgebra K (U D q) :=
  Bialgebra.ofAlgHom (comulAlgHom D q hq hfac) (counitAlgHom D q)
    (comul_coassoc D q hq hfac) (counit_comul_left D q hq hfac)
    (counit_comul_right D q hq hfac)

/-- The bialgebra `U` has an antipode, i.e. it is a Hopf algebra (Layer 1): a linear map `S` that
is a convolution inverse of the identity on both sides, is bijective, and takes the values
`S(Eᵢ) = −Kᵢ⁻¹Eᵢ`, `S(Fᵢ) = −FᵢKᵢ`, `S(K_y) = K_(−y)`. -/
theorem exists_antipode (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    letI := bialgebra D q hq hfac
    ∃ S : U D q →ₗ[K] U D q,
      LinearMap.mul' K (U D q) ∘ₗ S.rTensor (U D q) ∘ₗ Coalgebra.comul =
          Algebra.linearMap K (U D q) ∘ₗ Coalgebra.counit ∧
        LinearMap.mul' K (U D q) ∘ₗ S.lTensor (U D q) ∘ₗ Coalgebra.comul =
          Algebra.linearMap K (U D q) ∘ₗ Coalgebra.counit ∧
        Function.Bijective S ∧
        (∀ i, S (E D q i) = -(KiInv D q i * E D q i)) ∧
        (∀ i, S (F D q i) = -(F D q i * Ki D q i)) ∧
        ∀ y, S (Ktorus D q y) = Ktorus D q (-y) := by
  sorry

/-- Triangular decomposition (Layer 1): multiplication `U⁻ ⊗ U⁰ ⊗ U⁺ → U` is a linear
isomorphism, where `U⁻`, `U⁰`, `U⁺` are the subalgebras generated by the `Fᵢ`, by the `K_y`, and
by the `Eᵢ`. -/
theorem triangular_bijective (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    Function.Bijective
      (LinearMap.mul' K (U D q) ∘ₗ
        TensorProduct.map (Algebra.adjoin K (Set.range (F D q))).val.toLinearMap
          (LinearMap.mul' K (U D q) ∘ₗ
            TensorProduct.map (Algebra.adjoin K (Set.range (Ktorus D q))).val.toLinearMap
              (Algebra.adjoin K (Set.range (E D q))).val.toLinearMap)) := by
  sorry

/-- The full-`Y` torus is the group algebra of `Y` (Layer 1): the `K_y`, `y ∈ Y`, are linearly
independent in `U`; no central direction of `Y` is collapsed. -/
theorem Ktorus_linearIndependent (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    LinearIndependent K (Ktorus D q) := by
  sorry

/-! ## Layer 2: braid operators -/

/-- The images of the generators under the braid operator `Tᵢ`, as elements of the free algebra,
with `qᵢ = q^dᵢ` and `n = −aᵢⱼ`: `Tᵢ(Eᵢ) = −FᵢKᵢ`, `Tᵢ(Fᵢ) = −Kᵢ⁻¹Eᵢ`, `Tᵢ(K_y) = K_(sᵢ y)`, and
for `j ≠ i`
`Tᵢ(Eⱼ) = Σ_(r=0)^n (−1)^(r+n) qᵢ^(−r) Eᵢ^(n−r) Eⱼ Eᵢ^(r)`,
`Tᵢ(Fⱼ) = Σ_(r=0)^n (−1)^(r+n) qᵢ^r Fᵢ^(r) Fⱼ Fᵢ^(n−r)`. -/
def braidImageFree (i : ι) : Generator ι Y → Free
  | .E j =>
      if j = i then -(genF i * simpleK D i) else
        ∑ r ∈ Finset.range ((-D.cartan i j).toNat + 1),
          ((-1 : K) ^ (r + (-D.cartan i j).toNat) * ((q ^ D.symmetrizer i) ^ r)⁻¹) •
            (dividedPower (q ^ D.symmetrizer i) (genE i) ((-D.cartan i j).toNat - r) *
              genE j * dividedPower (q ^ D.symmetrizer i) (genE i) r)
  | .F j =>
      if j = i then -(genK (-(D.simpleTorus i)) * genE i) else
        ∑ r ∈ Finset.range ((-D.cartan i j).toNat + 1),
          ((-1 : K) ^ (r + (-D.cartan i j).toNat) * (q ^ D.symmetrizer i) ^ r) •
            (dividedPower (q ^ D.symmetrizer i) (genF i) r * genF j *
              dividedPower (q ^ D.symmetrizer i) (genF i) ((-D.cartan i j).toNat - r))
  | .K y => genK (D.reflect i y)

/-- The braid-operator images of the generators in `U`. -/
def braidImage (i : ι) (g : Generator ι Y) : U D q :=
  RingQuot.mkAlgHom K (Relation D q) (braidImageFree D q i g)

/-- **Braid automorphisms** (Layer 2; Lusztig1993 Chapter 37; in finite type Lentner2014
Definition 3.4): for every `i` there is a `K`-algebra automorphism `Tᵢ` of `U` with the generator
values of `braidImage`. Generators determine it, so it is unique. -/
theorem exists_braidOperator (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) (i : ι) :
    ∃ T : U D q ≃ₐ[K] U D q, ∀ g, T (generator D q g) = braidImage D q i g := by
  sorry

/-- The alternating composite `Tᵢ ∘ Tⱼ ∘ Tᵢ ∘ ⋯` with `n` factors. -/
def braidWord (T : ι → U D q ≃ₐ[K] U D q) : ι → ι → ℕ → (U D q ≃ₐ[K] U D q)
  | _, _, 0 => AlgEquiv.refl
  | i, j, n + 1 => (braidWord T j i n).trans (T i)

/-- **Braid relations** (Layer 2; Lusztig1993 Chapter 39): for `i ≠ j` with `aᵢⱼ aⱼᵢ ≤ 3`, the braid
operators satisfy `Tᵢ Tⱼ Tᵢ ⋯ = Tⱼ Tᵢ Tⱼ ⋯` with `mᵢⱼ` factors on each side. -/
theorem braid_relation (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0)
    (T : ι → U D q ≃ₐ[K] U D q)
    (hT : ∀ i g, T i (generator D q g) = braidImage D q i g)
    (i j : ι) (hij : i ≠ j) (hm : D.cartan i j * D.cartan j i ≤ 3) :
    braidWord D q T i j (D.braidLength i j) = braidWord D q T j i (D.braidLength i j) := by
  sorry

end Presentation

