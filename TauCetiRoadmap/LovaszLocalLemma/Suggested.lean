import Mathlib

/-!
# The Lovász local lemma: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib, each with `sorry`, together with the definitions
they need; every definition has a real body. Every headline theorem of the README is statable at
the pins and is stated here. The README's Checks are not restated.

Events are measurable sets of a probability space `(Ω, μ)`, indexed by a finite type `ι`, and
probabilities are taken with `MeasureTheory.Measure.real`. A dependency digraph is a map
`Γ : ι → Finset ι` such that each event is independent, in Mathlib's sense
`ProbabilityTheory.Indep`, of the σ-algebra generated by the events outside `Γ i ∪ {i}`.

Because a roadmap's module cannot be imported, the definitions of clauses and satisfiability
are copied verbatim from PropositionalSatisfiability 1.1, and the Ramsey property and the
Ramsey number from RamseyNumbers 1.1, in this file's namespace.
-/

noncomputable section

open MeasureTheory ProbabilityTheory MeasurableSpace
open Std.Sat (Literal)

namespace TauCetiRoadmap.LovaszLocalLemma

/-! ## Layer 1: the local lemma -/

/-- 1.2 `Γ` is a dependency digraph for the events `A`: for every `i`, the event `A i` is
independent of the σ-algebra generated by the events `A j` with `j ≠ i` and `j ∉ Γ i`. -/
def IsDependencyDigraph {Ω ι : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (A : ι → Set Ω)
    (Γ : ι → Finset ι) : Prop :=
  ∀ i, Indep (generateFrom {A i}) (generateFrom (A '' {j | j ≠ i ∧ j ∉ Γ i})) μ

/-- 1.1 The lopsided local lemma (Erdős–Spencer), in the product form its proof uses: if
`x i ≤ 1` for every `i` and, for every `i` and every finite set `S` of indices that avoids `i`
and `Γ i`, `μ (A i ∩ ⋂ j ∈ S, (A j)ᶜ) ≤ x i * (∏ j ∈ Γ i, (1 - x j)) * μ (⋂ j ∈ S, (A j)ᶜ)`, then
the probability that no event occurs is at least `∏ i, (1 - x i)`. -/
theorem prod_one_sub_le_measureReal_iInter_compl_of_lopsided {Ω ι : Type*} [MeasurableSpace Ω]
    [Fintype ι] [DecidableEq ι] (μ : Measure Ω) [IsProbabilityMeasure μ] (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet (A i)) (Γ : ι → Finset ι) (x : ι → ℝ) (hx : ∀ i, x i ≤ 1)
    (h : ∀ i (S : Finset ι), i ∉ S → Disjoint S (Γ i) →
      μ.real (A i ∩ ⋂ j ∈ S, (A j)ᶜ) ≤
        x i * (∏ j ∈ Γ i, (1 - x j)) * μ.real (⋂ j ∈ S, (A j)ᶜ)) :
    ∏ i, (1 - x i) ≤ μ.real (⋂ i, (A i)ᶜ) := by
  sorry

/-- 1.2 The Lovász local lemma, general (asymmetric) form (Erdős–Lovász): if `Γ` is a dependency
digraph, `x i ≤ 1` and `μ (A i) ≤ x i * ∏ j ∈ Γ i, (1 - x j)` for every `i`, then the
probability that no event occurs is at least `∏ i, (1 - x i)`. -/
theorem prod_one_sub_le_measureReal_iInter_compl {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι]
    [DecidableEq ι] (μ : Measure Ω) [IsProbabilityMeasure μ] (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet (A i)) (Γ : ι → Finset ι) (hΓ : IsDependencyDigraph μ A Γ)
    (x : ι → ℝ) (hx : ∀ i, x i ≤ 1) (h : ∀ i, μ.real (A i) ≤ x i * ∏ j ∈ Γ i, (1 - x j)) :
    ∏ i, (1 - x i) ≤ μ.real (⋂ i, (A i)ᶜ) := by
  sorry

/-- 1.3 The Lovász local lemma, symmetric form, stated lopsided: if the sets `Γ i` have at most
`d` elements, `μ (A i ∩ ⋂ j ∈ S, (A j)ᶜ) ≤ p * μ (⋂ j ∈ S, (A j)ᶜ)` for every `i` and every
finite set `S` of indices that avoids `i` and `Γ i`, and `e · p · (d + 1) ≤ 1`, then with
positive probability no event occurs. For a dependency digraph the hypothesis on `S` follows from
`μ (A i) ≤ p`. -/
theorem measure_iInter_compl_pos {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι] [DecidableEq ι]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (A : ι → Set Ω) (hA : ∀ i, MeasurableSet (A i))
    (Γ : ι → Finset ι) (p : ℝ) (d : ℕ) (hd : ∀ i, (Γ i).card ≤ d)
    (hp : ∀ i (S : Finset ι), i ∉ S → Disjoint S (Γ i) →
      μ.real (A i ∩ ⋂ j ∈ S, (A j)ᶜ) ≤ p * μ.real (⋂ j ∈ S, (A j)ᶜ))
    (h : Real.exp 1 * p * (d + 1) ≤ 1) :
    0 < μ (⋂ i, (A i)ᶜ) := by
  sorry

/-! ## Layer 2: the variable model -/

/-- 2.1 The dependency neighbourhood of `i` for events determined by the variables `vbl i`: the
indices `j ≠ i` whose variable set meets `vbl i`. -/
def dependencyNbhd {ι V : Type*} [Fintype ι] [DecidableEq ι] [DecidableEq V]
    (vbl : ι → Finset V) (i : ι) : Finset ι :=
  Finset.univ.filter fun j => j ≠ i ∧ ¬ Disjoint (vbl i) (vbl j)

/-- 2.1 In the variable model the variable-sharing neighbourhoods form a dependency digraph: if
the random variables `X v` are measurable and mutually independent and each event `A i` is
measurable with respect to the σ-algebra generated by the `X v` with `v ∈ vbl i`, then
`dependencyNbhd vbl` is a dependency digraph for `A`. -/
theorem isDependencyDigraph_dependencyNbhd {Ω ι V : Type*} [MeasurableSpace Ω] [Fintype ι]
    [DecidableEq ι] [DecidableEq V] (μ : Measure Ω) {β : V → Type*}
    [∀ v, MeasurableSpace (β v)] (X : ∀ v, Ω → β v) (hX : ∀ v, Measurable (X v))
    (hind : iIndepFun X μ) (vbl : ι → Finset V) (A : ι → Set Ω)
    (hA : ∀ i, MeasurableSet[⨆ v ∈ vbl i, MeasurableSpace.comap (X v) inferInstance] (A i)) :
    IsDependencyDigraph μ A (dependencyNbhd vbl) := by
  sorry

/-! ## Layer 3: two-colourings of hypergraphs -/

/-- 3.1 Property B under a local condition: if every edge of a finite hypergraph
`H` has at least `k` vertices, meets at most `d` other edges, and `2 e (d + 1) ≤ 2 ^ k`, then
some two-colouring of the vertices leaves no edge monochromatic. -/
theorem exists_two_colouring_of_card_nbhd_le {V : Type*} [DecidableEq V]
    (H : Finset (Finset V)) (k d : ℕ) (hk : ∀ e ∈ H, k ≤ e.card)
    (hd : ∀ e ∈ H, (H.filter fun f => f ≠ e ∧ ¬ Disjoint e f).card ≤ d)
    (h : Real.exp 1 * (d + 1) * 2 ≤ 2 ^ k) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ u ∈ e, ∃ v ∈ e, c u ≠ c v := by
  sorry

/-- 3.2 A hypergraph whose edges have exactly `k ≥ 9` vertices and whose vertices lie in at most
`k` edges each has a two-colouring with no monochromatic edge. -/
theorem exists_two_colouring_of_card_edges_le {V : Type*} [DecidableEq V]
    (H : Finset (Finset V)) (k : ℕ) (hk9 : 9 ≤ k) (hk : ∀ e ∈ H, e.card = k)
    (hdeg : ∀ v, (H.filter fun e => v ∈ e).card ≤ k) :
    ∃ c : V → Bool, ∀ e ∈ H, ∃ u ∈ e, ∃ v ∈ e, c u ≠ c v := by
  sorry

/-! ## Layer 4: satisfiability of formulas with sparse clause overlaps -/

/-- 4.1 A clause is a finite set of literals (copied verbatim from PropositionalSatisfiability
1.1). -/
abbrev Clause (V : Type*) := Finset (Literal V)

/-- 4.1 A formula in conjunctive normal form is a finite set of clauses (copied verbatim from
PropositionalSatisfiability 1.1). -/
abbrev CNF (V : Type*) := Finset (Clause V)

variable {V : Type*}

/-- 4.1 The assignment `τ` satisfies the clause `C`: some literal `(v, b)` of `C` has `τ v = b`
(copied verbatim from PropositionalSatisfiability 1.1). -/
def Satisfies (τ : V → Bool) (C : Clause V) : Prop := ∃ l ∈ C, τ l.1 = l.2

/-- 4.1 The assignment `τ` is a model of the clause set `S` (copied verbatim from
PropositionalSatisfiability 1.1). -/
def Models (τ : V → Bool) (S : Set (Clause V)) : Prop := ∀ C ∈ S, Satisfies τ C

/-- 4.1 The clause set `S` has a model (copied verbatim from PropositionalSatisfiability 1.1). -/
def Satisfiable (S : Set (Clause V)) : Prop := ∃ τ, Models τ S

/-- 4.1 The variables of a clause (copied verbatim from PropositionalSatisfiability 1.1). -/
def Clause.vars [DecidableEq V] (C : Clause V) : Finset V := C.image Prod.fst

/-- 4.1 A formula in conjunctive normal form in which every clause has at least `k` variables
and shares a variable with at most `d` other clauses is satisfiable when `e (d + 1) ≤ 2 ^ k`. -/
theorem satisfiable_of_card_nbhd_le [DecidableEq V] (F : CNF V) (k d : ℕ)
    (hk : ∀ C ∈ F, k ≤ (Clause.vars C).card)
    (hd : ∀ C ∈ F,
      (F.filter fun D => D ≠ C ∧ ¬ Disjoint (Clause.vars C) (Clause.vars D)).card ≤ d)
    (h : Real.exp 1 * (d + 1) ≤ 2 ^ k) :
    Satisfiable (F : Set (Clause V)) := by
  sorry

/-- 4.2 A formula in conjunctive normal form in which every clause has exactly `k ≥ 1` variables
and every variable occurs in at most `t` clauses is satisfiable when `e k t ≤ 2 ^ k`. -/
theorem satisfiable_of_card_occurrences_le [DecidableEq V] (F : CNF V) (k t : ℕ) (hk1 : 1 ≤ k)
    (hk : ∀ C ∈ F, (Clause.vars C).card = k)
    (ht : ∀ v, (F.filter fun C => v ∈ Clause.vars C).card ≤ t)
    (h : Real.exp 1 * k * t ≤ 2 ^ k) :
    Satisfiable (F : Set (Clause V)) := by
  sorry

/-! ## Layer 5: Spencer's lower bound for diagonal Ramsey numbers -/

open SimpleGraph

/-- 5.1 The Ramsey property (copied verbatim from RamseyNumbers 1.1): every colouring of the edges
of the complete graph on `n` vertices with colours in `K` has, for some colour `k`, a set of
`f k` vertices all of whose edges have colour `k`. -/
def RamseyProp {K : Type*} (f : K → ℕ) (n : ℕ) : Prop :=
  ∀ C : TopEdgeLabeling (Fin n) K, ∃ k : K, ∃ s : Finset (Fin n), (C.labelGraph k).IsNClique (f k) s

/-- 5.1 The Ramsey number `R(f)` (copied verbatim from RamseyNumbers 1.1): the infimum in `ℕ` of
the numbers of vertices with the Ramsey property. -/
def ramseyNumber {K : Type*} (f : K → ℕ) : ℕ :=
  sInf {n | RamseyProp f n}

/-- 5.1 Spencer's criterion: if `e · (binom(k, 2) · binom(n, k − 2) + 1) · 2 ≤ 2 ^ binom(k, 2)`,
then `n < R(k, k)`. -/
theorem lt_ramseyNumber_of_exp_mul_le (n k : ℕ)
    (h : Real.exp 1 * ((k.choose 2 * n.choose (k - 2) + 1 : ℕ) : ℝ) * 2 ≤ 2 ^ k.choose 2) :
    n < ramseyNumber ![k, k] := by
  sorry

end TauCetiRoadmap.LovaszLocalLemma
