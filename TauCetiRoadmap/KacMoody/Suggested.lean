import Mathlib

/-!
# Kac–Moody algebras, integrable modules and path crystals: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline theorems
against the pinned Mathlib and Tau Ceti, each with `sorry`, on the carriers the README builds: the
Kac–Moody algebra of a symmetrizable datum presented on a rational realization, its enveloping
algebra, Verma modules, simple highest-weight modules, weight spaces and Weyl group.

Stated here:

* the Weyl–Kac character formula (Kac, Theorem 10.4), as the weight-multiplicity identity
  `dim L(λ)_μ = Σ_w (−1)^ℓ(w) dim M(w(λ+ρ)−ρ)_μ` with finite support of the sum;
* complete reducibility of the integrable part of category `O` (Kac, Theorem 10.7), together with
  the identification of its simple constituents as the `L(λ)` with `λ` dominant integral.

Not statable at the pins, and so not stated:

* Littelmann's endpoint theorem and the path character identity (Layer 6): they need the path
  carrier with its root operators, which the roadmap constructs;
* the Chevalley–Pieri formula (Layer 7): it needs the minimal Kac–Moody group and its Schubert
  schemes;
* the loop-group kernel theorem (Layer 8): it needs the minimal derived affine group.
-/

noncomputable section

open scoped BigOperators

namespace TauCetiRoadmap.KacMoody

/-! ## Layer 0: symmetrizable Cartan data and realizations -/

/-- A symmetrizable generalized Cartan matrix on a finite index set, with the row convention
`cartan i j = α_j(h_i)`, and a symmetrizer: positive integers `d_i` with `d_i a_ij = d_j a_ji`. -/
structure SymmetrizableDatum (I : Type*) [Fintype I] where
  cartan : Matrix I I ℤ
  diagonal : ∀ i, cartan i i = 2
  offDiagonal : ∀ i j, i ≠ j → cartan i j ≤ 0
  zeroSymmetry : ∀ i j, cartan i j = 0 ↔ cartan j i = 0
  symmetrizer : I → ℕ
  symmetrizer_pos : ∀ i, 0 < symmetrizer i
  symmetrizes : ∀ i j,
    (symmetrizer i : ℤ) * cartan i j = (symmetrizer j : ℤ) * cartan j i

/-- A rational realization of the datum on `ℚ^m`: linearly independent simple coroots, linearly
independent simple roots, and the Cartan pairing. `m` need not be minimal, so central enlargements
are included. -/
structure RationalRealization {I : Type*} [Fintype I] (A : SymmetrizableDatum I) (m : ℕ) where
  coroot : I → (Fin m → ℚ)
  root : I → Module.Dual ℚ (Fin m → ℚ)
  coroot_independent : LinearIndependent ℚ coroot
  root_independent : LinearIndependent ℚ root
  pairing : ∀ i j, root j (coroot i) = (A.cartan i j : ℚ)

/-! ## Layer 1: the Kac–Moody algebra on the full realization -/

/-- The free Lie algebra on every Cartan direction together with one positive and one negative
generator per index. -/
abbrev FreePresentation (I : Type*) (m : ℕ) :=
  FreeLieAlgebra ℚ ((Fin m → ℚ) ⊕ (I ⊕ I))

/-- The free generator attached to a Cartan vector `x`. -/
def hGenerator {I : Type*} {m : ℕ} (x : Fin m → ℚ) : FreePresentation I m :=
  FreeLieAlgebra.of ℚ (Sum.inl x)

/-- The free generator `e_i`. -/
def eGenerator {I : Type*} {m : ℕ} (i : I) : FreePresentation I m :=
  FreeLieAlgebra.of ℚ (Sum.inr (Sum.inl i))

/-- The free generator `f_i`. -/
def fGenerator {I : Type*} {m : ℕ} (i : I) : FreePresentation I m :=
  FreeLieAlgebra.of ℚ (Sum.inr (Sum.inr i))

/-- The relators of the Kac–Moody algebra: Cartan linearity, `[H,H] = 0`, the Chevalley relations
`[h,e_i] = α_i(h)e_i`, `[h,f_i] = −α_i(h)f_i`, `[e_i,f_j] = δ_ij h_i`, and the Serre relations
`(ad e_i)^(1−a_ij) e_j = 0`, `(ad f_i)^(1−a_ij) f_j = 0` for `i ≠ j`. -/
def relators {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) : Set (FreePresentation I m) :=
  {z | ∃ (x y : Fin m → ℚ), z = hGenerator (I := I) (x + y) - hGenerator (I := I) x - hGenerator (I := I) y} ∪
  {z | ∃ (q : ℚ) (x : Fin m → ℚ), z = hGenerator (I := I) (q • x) - q • hGenerator (I := I) x} ∪
  {z | ∃ (x y : Fin m → ℚ), z = ⁅hGenerator (I := I) x, hGenerator (I := I) y⁆} ∪
  {z | ∃ (x : Fin m → ℚ) (i : I), z = ⁅hGenerator (I := I) x, eGenerator (m := m) i⁆ - R.root i x • eGenerator (m := m) i} ∪
  {z | ∃ (x : Fin m → ℚ) (i : I), z = ⁅hGenerator (I := I) x, fGenerator (m := m) i⁆ + R.root i x • fGenerator (m := m) i} ∪
  {z | ∃ (i j : I), z = ⁅eGenerator (m := m) i, fGenerator (m := m) j⁆ -
    if i = j then hGenerator (I := I) (R.coroot i) else 0} ∪
  {z | ∃ (i j : I), i ≠ j ∧ z =
    ((LieAlgebra.ad ℚ (FreePresentation I m) (eGenerator (m := m) i)) ^
      (1 - A.cartan i j).toNat) (eGenerator (m := m) j)} ∪
  {z | ∃ (i j : I), i ≠ j ∧ z =
    ((LieAlgebra.ad ℚ (FreePresentation I m) (fGenerator (m := m) i)) ^
      (1 - A.cartan i j).toNat) (fGenerator (m := m) j)}

/-- The Lie ideal generated by the relators. -/
def presentationIdeal {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m) :
    LieIdeal ℚ (FreePresentation I m) :=
  LieSubmodule.lieSpan ℚ _ (relators R)

/-- The Kac–Moody algebra of the realization: the free Lie algebra modulo the relators. -/
abbrev PresentedLieAlgebra {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m) :=
  FreePresentation I m ⧸ presentationIdeal R

/-- The image of the Cartan vector `x` in the Kac–Moody algebra. -/
def cartanElement {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (x : Fin m → ℚ) : PresentedLieAlgebra R :=
  LieSubmodule.Quotient.mk (hGenerator x)

/-- The Chevalley generator `e_i` of the Kac–Moody algebra. -/
def positiveGenerator {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (i : I) : PresentedLieAlgebra R :=
  LieSubmodule.Quotient.mk (eGenerator i)

/-- The Chevalley generator `f_i` of the Kac–Moody algebra. -/
def negativeGenerator {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (i : I) : PresentedLieAlgebra R :=
  LieSubmodule.Quotient.mk (fGenerator i)

/-- The universal enveloping algebra of the Kac–Moody algebra. -/
abbrev Enveloping {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m) :=
  UniversalEnvelopingAlgebra ℚ (PresentedLieAlgebra R)

/-! ## Layer 2: the Weyl group -/

/-- The simple reflection `λ ↦ λ − λ(h_i) α_i` on the dual of the realization, as Mathlib's
`Module.reflection` at `α_i(h_i) = 2`. -/
def simpleReflection {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (i : I) :
    Module.Dual ℚ (Fin m → ℚ) ≃ₗ[ℚ] Module.Dual ℚ (Fin m → ℚ) :=
  Module.reflection (x := R.root i) (f := Module.Dual.eval ℚ (Fin m → ℚ) (R.coroot i))
    (by simpa [R.pairing i i] using congrArg (Int.cast : ℤ → ℚ) (A.diagonal i))

/-- The Weyl group of the realization: the subgroup of `GL(H*)` generated by the simple
reflections. -/
def weylGroup {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) :
    Subgroup (Module.Dual ℚ (Fin m → ℚ) ≃ₗ[ℚ] Module.Dual ℚ (Fin m → ℚ)) :=
  Subgroup.closure (Set.range (simpleReflection R))

/-- The length of a Weyl group element: the least length of a word in the simple reflections
whose product is it. -/
def length {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (w : weylGroup R) : ℕ :=
  sInf {n | ∃ l : List I, l.length = n ∧ (l.map (simpleReflection R)).prod = (w : _ ≃ₗ[ℚ] _)}

/-- The positive root cone `Q_+`: the additive monoid generated by the simple roots in `H*`. -/
def positiveRootCone {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) : AddSubmonoid (Module.Dual ℚ (Fin m → ℚ)) :=
  AddSubmonoid.closure (Set.range R.root)

/-! ## Layer 3: Verma modules, weight spaces and category O -/

/-- The Verma relations for the weight `λ`: `h − λ(h)` for every Cartan vector and every `e_i`. -/
def vermaRelations {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (lam : Module.Dual ℚ (Fin m → ℚ)) : Set (Enveloping R) :=
  Set.range (fun x : Fin m → ℚ =>
    UniversalEnvelopingAlgebra.ι ℚ (cartanElement R x) -
      algebraMap ℚ (Enveloping R) (lam x)) ∪
  Set.range (fun i : I => UniversalEnvelopingAlgebra.ι ℚ (positiveGenerator R i))

/-- The left ideal of the enveloping algebra generated by the Verma relations. -/
def vermaLeftIdeal {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (lam : Module.Dual ℚ (Fin m → ℚ)) : Submodule (Enveloping R) (Enveloping R) :=
  Submodule.span (Enveloping R) (vermaRelations R lam)

/-- The Verma module `M(λ)`: the enveloping algebra modulo the left ideal of the Verma relations. -/
abbrev VermaModule {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (lam : Module.Dual ℚ (Fin m → ℚ)) := Enveloping R ⧸ vermaLeftIdeal R lam

/-- The ℚ-linear action of the Cartan vector `x` on a module over the enveloping algebra. -/
def cartanAction {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (M : Type*) [AddCommGroup M] [Module (Enveloping R) M]
    [Module ℚ M] [IsScalarTower ℚ (Enveloping R) M] (x : Fin m → ℚ) : Module.End ℚ M where
  toFun v := UniversalEnvelopingAlgebra.ι ℚ (cartanElement R x) • v
  map_add' := smul_add _
  map_smul' q v := smul_comm _ q v

/-- The weight space `M_μ`: the vectors on which every Cartan vector `x` acts by the scalar
`μ(x)`. -/
def weightSpace {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (M : Type*) [AddCommGroup M] [Module (Enveloping R) M]
    [Module ℚ M] [IsScalarTower ℚ (Enveloping R) M] (μ : Module.Dual ℚ (Fin m → ℚ)) :
    Submodule ℚ M :=
  ⨅ x : Fin m → ℚ, Module.End.eigenspace (cartanAction R M x) (μ x)

/-- The sum of all proper submodules of the Verma module `M(λ)`; the roadmap proves it is the
unique maximal proper submodule. -/
def maximalSubmodule {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (lam : Module.Dual ℚ (Fin m → ℚ)) :
    Submodule (Enveloping R) (VermaModule R lam) :=
  sSup {N | N ≠ ⊤}

/-- The simple highest-weight module `L(λ)`: the Verma module modulo its maximal proper
submodule. -/
abbrev IrreducibleModule {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (lam : Module.Dual ℚ (Fin m → ℚ)) :=
  VermaModule R lam ⧸ maximalSubmodule R lam

/-- Membership of a module in the integrable part of category `O` (Kac, §9.1 and §3.6): the
weight spaces span, are finite-dimensional and lie in finitely many cones `λ_j − Q_+`, and every
`e_i` and `f_i` acts locally nilpotently. -/
structure IsIntegrableO {I : Type*} [Fintype I] [DecidableEq I] {A : SymmetrizableDatum I} {m : ℕ}
    (R : RationalRealization A m) (M : Type*) [AddCommGroup M] [Module (Enveloping R) M]
    [Module ℚ M] [IsScalarTower ℚ (Enveloping R) M] : Prop where
  weight_sup : ⨆ μ, weightSpace R M μ = ⊤
  finite_weightSpace : ∀ μ, FiniteDimensional ℚ (weightSpace R M μ)
  bounded : ∃ tops : Finset (Module.Dual ℚ (Fin m → ℚ)), ∀ μ, weightSpace R M μ ≠ ⊥ →
    ∃ lam ∈ tops, lam - μ ∈ positiveRootCone R
  locallyNilpotent_pos : ∀ i (v : M), ∃ n : ℕ,
    (UniversalEnvelopingAlgebra.ι ℚ (positiveGenerator R i)) ^ n • v = 0
  locallyNilpotent_neg : ∀ i (v : M), ∃ n : ℕ,
    (UniversalEnvelopingAlgebra.ι ℚ (negativeGenerator R i)) ^ n • v = 0

/-- Complete reducibility of the integrable part of category `O` (Kac, Theorem 10.7): such a
module is semisimple over the enveloping algebra, and each of its simple submodules is isomorphic
to `L(λ)` for a dominant integral `λ`. -/
theorem completeReducibility_integrableO {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m) (M : Type*) [AddCommGroup M]
    [Module (Enveloping R) M] [Module ℚ M] [IsScalarTower ℚ (Enveloping R) M]
    (hM : IsIntegrableO R M) :
    IsSemisimpleModule (Enveloping R) M ∧
    ∀ N : Submodule (Enveloping R) M, IsSimpleModule (Enveloping R) N →
      ∃ lam : Module.Dual ℚ (Fin m → ℚ), (∀ i, ∃ n : ℕ, lam (R.coroot i) = n) ∧
        Nonempty (N ≃ₗ[Enveloping R] IrreducibleModule R lam) := by
  sorry

/-! ## Layer 4: the Weyl–Kac character formula -/

/-- The Weyl–Kac character formula (Kac, Theorem 10.4) as a weight-multiplicity identity: for
`λ` dominant integral, `ρ` with `ρ(h_i) = 1`, and any weight `μ`, the multiplicities
`dim M(w(λ+ρ)−ρ)_μ` vanish for all but finitely many `w`, and
`dim L(λ)_μ = Σ_w (−1)^ℓ(w) dim M(w(λ+ρ)−ρ)_μ`. -/
theorem weylKac_character_formula {I : Type*} [Fintype I] [DecidableEq I]
    {A : SymmetrizableDatum I} {m : ℕ} (R : RationalRealization A m)
    (lam ρ μ : Module.Dual ℚ (Fin m → ℚ))
    (hlam : ∀ i, ∃ n : ℕ, lam (R.coroot i) = n) (hρ : ∀ i, ρ (R.coroot i) = 1) :
    (Function.support (fun w : weylGroup R =>
        Module.finrank ℚ (weightSpace R (VermaModule R ((w : _ ≃ₗ[ℚ] _) (lam + ρ) - ρ)) μ))).Finite ∧
    (Module.finrank ℚ (weightSpace R (IrreducibleModule R lam) μ) : ℤ) =
      ∑ᶠ w : weylGroup R, (-1 : ℤ) ^ length R w *
        Module.finrank ℚ (weightSpace R (VermaModule R ((w : _ ≃ₗ[ℚ] _) (lam + ρ) - ρ)) μ) := by
  sorry

end TauCetiRoadmap.KacMoody
