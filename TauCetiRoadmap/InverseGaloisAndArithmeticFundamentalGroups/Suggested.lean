import Mathlib
import TauCeti.Topology.Algebra.Group.Generation
import TauCeti.Topology.Algebra.Group.Profinite.EmbeddingProblem.Basic
import TauCeti.FieldTheory.FunctionField.Place.Extension.Basic
import TauCeti.FieldTheory.FunctionField.RiemannRoch.Genus

/-!
# Inverse Galois theory and arithmetic fundamental groups: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is `README.md`.
The statements here give the roadmap's headline theorems against the pinned Mathlib and Tau Ceti
APIs; discharging them finishes neither a layer nor the roadmap.

Layer IG.2 is represented by Hilbert irreducibility, including several parameters, full polynomial
Galois groups, disjoint realizations, Weissauer's theorem, the failure of finite generation for
absolute Galois groups of Hilbertian fields and the normal-subgroup theorem.
Layer IG.3 contributes rational rigidity and the stable classification of generating braid orbits.
Layer IG.4 contributes split nilpotent embedding problems, Shafarevich's theorem, supersolvable
and quaternion Grunwald prescriptions and realizations over extensions of collectively coprime
degrees. Layer IG.5's Abhyankar theorem is stated in the equivalent function-field language, using Tau Ceti's genus,
places and ramification indices. Layer IG.6 contributes specialization of regular realizations and
the implication between the named open inverse Galois problems.

The trace formulas of IG.0 require compactly supported constructible étale cohomology with its
coefficient and Frobenius actions; the pinned pro-étale cohomology of the constant integral sheaf
alone does not supply these objects. Integral and rational local-system categories, Noohi
reconstruction, the pro-étale fundamental group and the tame specialization maps of IG.0–IG.1
are not supplied by the pinned sites and finite Galois categories. Those headlines have no
signatures here. Likewise the Hurwitz schemes, admissible covers, component invariants and their
Frobenius actions needed for the comparisons and counts of IG.5 are absent. Brauer–Manin density and
Property E require the homogeneous-space Brauer pairing and the maximal unramified extension with
its operator action, respectively; these structures are not available at the pins. The geometric Hilbert-subset and
thin-set formulations need the cover/residue-fibre interfaces of IG.0–IG.2; the cover form of
rigidity and its moduli obstruction need marked branched covers. Field and cover patching need
the compatible completed patch rings and normalized covers, which are not supplied by the pins.

The definitions below use native polynomials, free and presented groups, conjugacy classes and
Galois extensions. Braid equivalence is the equivalence relation generated by the concrete positive
Hurwitz moves on lists. The universal marked group imposes only the conjugation relations, and its
class degree has a real homomorphism body. Regularity of a field realization uses
`IsIntegrallyClosedIn` on the constant field.
-/

namespace TauCetiRoadmap.InverseGaloisAndArithmeticFundamentalGroups

noncomputable section

open Polynomial

universe u

/-! ## Layer IG.2: Hilbert irreducibility and specialization -/

namespace RationalSpecialization

variable {K : Type*} [Field K]

/-- Coefficientwise specialization `p(T, Y) ↦ p(t, Y)`, total as a function. -/
def specialize (t : K) (p : (RatFunc K)[X]) : K[X] :=
  p.sum fun n c => monomial n (RatFunc.eval (RingHom.id K) t c)

end RationalSpecialization

open RationalSpecialization in
/-- `K` is Hilbertian: every finite family of irreducible separable polynomials of positive degree
in `K(T)[Y]` has a common specialization at some `t ∈ K` with regular coefficients, the same
degrees, and irreducible values (Layer IG.2, *Hilbert subsets and Hilbertian fields*, polynomial
form on the affine line). -/
def IsHilbertian (K : Type*) [Field K] : Prop :=
  ∀ s : Finset (RatFunc K)[X], (∀ p ∈ s, Irreducible p ∧ p.Separable ∧ 0 < p.natDegree) →
    ∃ t : K, ∀ p ∈ s, (∀ n, (p.coeff n).denom.eval t ≠ 0) ∧
      (specialize t p).natDegree = p.natDegree ∧ Irreducible (specialize t p)

/-- A rational function field in one indeterminate over any field is Hilbertian
(Fried–Jarden, Theorem 13.4.2); no Hilbertianity assumption on the constant field is needed. -/
theorem isHilbertian_ratFunc (K : Type*) [Field K] : IsHilbertian (RatFunc K) := sorry

/-- Hilbert's irreducibility theorem over number fields (Serre, *Topics in Galois Theory*,
§3.4). -/
theorem isHilbertian_of_numberField (K : Type*) [Field K] [NumberField K] : IsHilbertian K :=
  sorry

/-- Hilbert irreducibility over a number field in any number of parameters (the case `r = 0` is
trivial). Clearing coefficient denominators gives polynomial families over the multivariate
polynomial ring; the arbitrary nonzero guard expresses Zariski density as well as finite
avoidance. -/
theorem hilbert_irreducibility (K : Type*) [Field K] [NumberField K]
    (r : ℕ) (s : Finset (Polynomial (MvPolynomial (Fin r) K)))
    (hs : ∀ f ∈ s,
      Irreducible (f.map (algebraMap _ (FractionRing (MvPolynomial (Fin r) K)))) ∧
      (f.map (algebraMap _ (FractionRing (MvPolynomial (Fin r) K)))).Separable ∧
      0 < f.natDegree)
    (g : MvPolynomial (Fin r) K) (hg : g ≠ 0) :
    ∃ t : Fin r → K, MvPolynomial.eval t g ≠ 0 ∧ ∀ f ∈ s,
      (f.map (MvPolynomial.eval t)).natDegree = f.natDegree ∧
      Irreducible (f.map (MvPolynomial.eval t)) := by
  sorry

open RationalSpecialization in
/-- Hilbert specialization preserves the full polynomial Galois group at infinitely many
parameters, together with coefficient regularity, degree and separability. -/
theorem IsHilbertian.infinite_full_group {K : Type*} [Field K] [CharZero K]
    (hK : IsHilbertian K) (f : (RatFunc K)[X]) (hf : f.Separable) :
    {t : K | (∀ n, (f.coeff n).denom.eval t ≠ 0) ∧
      (specialize t f).natDegree = f.natDegree ∧ (specialize t f).Separable ∧
      Nonempty ((specialize t f).Gal ≃* f.Gal)}.Infinite := sorry

/-- Weissauer's theorem (Fried–Jarden, Theorem 13.9.1(b)): a proper finite extension of a Galois
extension, possibly infinite, of a Hilbertian field of characteristic zero is Hilbertian. -/
theorem IsHilbertian.of_isGalois_of_one_lt_finrank {K : Type*} [Field K] [CharZero K]
    (hK : IsHilbertian K) (M : IntermediateField K (AlgebraicClosure K)) [IsGalois K M]
    (L : IntermediateField M (AlgebraicClosure K)) [FiniteDimensional M L]
    (hL : 1 < Module.finrank M L) : IsHilbertian L := sorry

/-- The absolute Galois group of a Hilbertian field of characteristic zero is not topologically
finitely generated: it has continuous quotients `C₂^r` for every `r`. -/
theorem IsHilbertian.not_isTopologicallyFinitelyGenerated {F : Type*} [Field F] [CharZero F]
    (hF : IsHilbertian F) :
    ¬ TauCeti.IsTopologicallyFinitelyGenerated (Field.absoluteGaloisGroup F) := sorry

/-- A closed normal subgroup of the absolute Galois group of a Hilbertian field of characteristic
zero is trivial if it is topologically finitely generated; fields finitely generated over `ℚ` are
covered through `isHilbertian_ratFunc`, `isHilbertian_of_numberField` and finite-extension
permanence. -/
theorem normal_subgroup_absoluteGaloisGroup_eq_bot (K : Type*) [Field K] [CharZero K]
    (hK : IsHilbertian K) (N : Subgroup (Field.absoluteGaloisGroup K)) [N.Normal]
    (hclosed : IsClosed (N : Set (Field.absoluteGaloisGroup K)))
    (hfg : TauCeti.IsTopologicallyFinitelyGenerated N) : N = ⊥ := sorry

/-! ## Layer IG.3: branch cycles, rigidity, braid orbits and lifting invariants -/

/-- A branch tuple of length `r` in `G`. -/
abbrev BranchTuple (r : ℕ) (G : Type*) := Fin r → G

namespace BranchTuple

variable {G : Type*} [Group G] {r : ℕ}

/-- The ordered product `t 0 * t 1 * ⋯ * t (r - 1)`. -/
def product (t : BranchTuple r G) : G := (List.ofFn t).prod

/-- The subgroup generated by the entries. -/
def generated (t : BranchTuple r G) : Subgroup G := Subgroup.closure (Set.range t)

end BranchTuple

section Rigidity

variable {G : Type*} [Group G]

/-- A conjugacy class in a finite group is rational if every power prime to `|G|` preserves it. -/
def IsRationalClass [Finite G] (C : ConjClasses G) : Prop :=
  ∀ m : ℕ, Nat.Coprime m (Nat.card G) → ∀ x ∈ C.carrier, x ^ m ∈ C.carrier

/-- A tuple of classes is rigid if the generating product-one tuples with entries in the classes
form exactly one orbit under simultaneous conjugation. -/
def IsRigid {r : ℕ} (C : Fin r → ConjClasses G) : Prop :=
  (∃ t : BranchTuple r G, (∀ i, t i ∈ (C i).carrier) ∧ BranchTuple.product t = 1 ∧
      BranchTuple.generated t = ⊤) ∧
    ∀ t t' : BranchTuple r G,
      (∀ i, t i ∈ (C i).carrier) → BranchTuple.product t = 1 → BranchTuple.generated t = ⊤ →
      (∀ i, t' i ∈ (C i).carrier) → BranchTuple.product t' = 1 →
      BranchTuple.generated t' = ⊤ → ∃ g : G, ∀ i, t' i = g * t i * g⁻¹

end Rigidity

/-- `G` is the Galois group of a regular extension of `K(T)`: a finite Galois extension `L` of
`K(T)` with group `G` in which `K` is algebraically closed. -/
def HasRegularRealization (K : Type u) [Field K] (G : Type*) [Group G] : Prop :=
  ∃ (L : Type u) (_ : Field L) (_ : Algebra (RatFunc K) L) (_ : Algebra K L)
    (_ : IsScalarTower K (RatFunc K) L),
    FiniteDimensional (RatFunc K) L ∧ IsGalois (RatFunc K) L ∧
      Nonempty ((L ≃ₐ[RatFunc K] L) ≃* G) ∧
      IsIntegrallyClosedIn K L

/-- Rational rigidity (Serre, *Topics in Galois Theory*, Theorem 8.1.1): a centreless finite group
with a rigid tuple of rational classes is the Galois group of a regular extension of `K(T)` for
every field `K` of characteristic zero. An identity class only marks an unramified point. -/
theorem hasRegularRealization_of_rigid (K : Type u) [Field K] [CharZero K] (G : Type*) [Group G]
    [Finite G] (hZ : Subgroup.center G = ⊥) {r : ℕ} (C : Fin r → ConjClasses G)
    (hrat : ∀ i, IsRationalClass (C i)) (hrig : IsRigid C) :
    HasRegularRealization K G := sorry

namespace ReducedSchur

variable {G : Type*} [Group G]

/-- The relations `[x][y][x]⁻¹ = [x y x⁻¹]` of the universal marked extension. -/
def universalRelations (c : Set G) (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) :
    Set (FreeGroup c) :=
  {w | ∃ x y : c, w = FreeGroup.of x * FreeGroup.of y * (FreeGroup.of x)⁻¹ *
    (FreeGroup.of ⟨x.1 * y.1 * x.1⁻¹, hc x.1 y.1 y.2⟩)⁻¹}

/-- The group on the marked generators with the conjugation relations; its projection is a
central extension of `G` when `c` generates `G`. -/
abbrev universalMarked (c : Set G) (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) :=
  PresentedGroup (universalRelations c hc)

/-- The conjugacy classes meeting `c`, the index set `D = c/G` of the class degree. -/
def classSet (c : Set G) : Set (ConjClasses G) := ConjClasses.mk '' c

/-- Class degree on the universal marked group, sending a marked generator to its class basis
vector in the free abelian group. -/
def degree (c : Set G)
    (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) :
    universalMarked c hc →* Multiplicative (classSet c →₀ ℤ) :=
  PresentedGroup.toGroup (f := fun x : c => Multiplicative.ofAdd
    (Finsupp.single ⟨ConjClasses.mk x.val, ⟨x.val, x.property, rfl⟩⟩ (1 : ℤ))) (by
    rintro w ⟨x, y, rfl⟩
    have hclass : ConjClasses.mk (x.val * y.val * x.val⁻¹) = ConjClasses.mk y.val :=
      Quotient.sound' (isConj_iff.mpr ⟨x.val⁻¹, by group⟩)
    have hindex : (⟨ConjClasses.mk (x.val * y.val * x.val⁻¹),
        ⟨_, hc x.val y.val y.property, rfl⟩⟩ : classSet c) =
        ⟨ConjClasses.mk y.val, ⟨y.val, y.property, rfl⟩⟩ := Subtype.ext hclass
    simp [hindex])

end ReducedSchur

/-- Braid equivalence: the equivalence relation generated by adjacent positive Hurwitz moves,
with arbitrary initial and final blocks. -/
def HurwitzEquivalent {G : Type*} [Group G] : List G → List G → Prop :=
  Relation.EqvGen fun t t' => ∃ (a b : G) (pre post : List G),
    t = pre ++ a :: b :: post ∧ t' = pre ++ (a * b * a⁻¹) :: a :: post

/-- The lifting invariant of a branch tuple: the ordered product of the marked generators in
`U(G, c)`. -/
def LiftingInvariant.tuple {G : Type*} [Group G] (c : Set G)
    (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) {r : ℕ} (t : Fin r → c) :
    ReducedSchur.universalMarked c hc :=
  (List.ofFn fun i => PresentedGroup.of (t i)).prod

/-- Wood's stable classification: for large multiplicities in every class, equality of the
lift product detects generating braid orbits, and every marked element of that degree occurs. -/
theorem LiftingInvariant.stable_classification {G : Type*} [Group G] [Finite G] (c : Set G)
    (hc : ∀ g : G, ∀ x ∈ c, g * x * g⁻¹ ∈ c) (hgen : Subgroup.closure c = ⊤) :
    ∃ M : ℕ,
      (∀ (r : ℕ) (t t' : Fin r → c),
        BranchTuple.generated (fun i => (t i).val) = ⊤ →
        BranchTuple.generated (fun i => (t' i).val) = ⊤ →
        (∀ d, (M : ℤ) ≤ Multiplicative.toAdd
          (ReducedSchur.degree c hc (LiftingInvariant.tuple c hc t)) d) →
        (LiftingInvariant.tuple c hc t = LiftingInvariant.tuple c hc t' ↔
          HurwitzEquivalent (List.ofFn fun i => (t i).val) (List.ofFn fun i => (t' i).val))) ∧
      (∀ z : ReducedSchur.universalMarked c hc,
        (∀ d, (M : ℤ) ≤ Multiplicative.toAdd (ReducedSchur.degree c hc z) d) →
        ∃ (r : ℕ) (t : Fin r → c),
          BranchTuple.generated (fun i => (t i).val) = ⊤ ∧ LiftingInvariant.tuple c hc t = z) := by
  sorry

/-! ## Layer IG.4: embedding problems, Shafarevich's theorem and unramified Γ-groups -/

/-- Every finite split embedding problem over a number field with nilpotent kernel has a
continuous surjective solution. -/
theorem exists_proper_solution_of_split_nilpotent (K : Type*) [Field K] [NumberField K]
    (P : TauCeti.FiniteEmbeddingProblem (Field.absoluteGaloisGroup K))
    (s : P.Q →* P.E) (hs : P.α.comp s = MonoidHom.id P.Q) [Group.IsNilpotent P.α.ker] :
    ∃ β : Field.absoluteGaloisGroup K →* P.E, P.IsSolution β ∧ Function.Surjective β := sorry

/-- Shafarevich's theorem: every finite solvable group is a Galois group over every number
field. -/
theorem shafarevich (K : Type u) [Field K] [NumberField K] (G : Type*) [Group G] [Finite G]
    [Group.IsSolvable G] :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ IsGalois K L ∧ Nonempty ((L ≃ₐ[K] L) ≃* G) := sorry

/-- `G` is supersolvable: a chain `1 = H₀ ≤ ⋯ ≤ Hₙ = G` of normal subgroups of `G` in which each
step adjoins one element, so that the successive quotients are cyclic. -/
def IsSupersolvable (G : Type*) [Group G] : Prop :=
  ∃ (n : ℕ) (H : Fin (n + 1) → Subgroup G), H 0 = ⊥ ∧ H (Fin.last n) = ⊤ ∧
    (∀ i, (H i).Normal) ∧ ∀ i : Fin n, ∃ g : G, H i.succ = H i.castSucc ⊔ Subgroup.zpowers g

open IsDedekindDomain NumberField in
/-- Grunwald prescriptions for supersolvable groups (Harpaz–Wittenberg, corollary of Théorème B):
away from finite places whose residue characteristic divides `|G|`, local Galois extensions whose
groups embed in `G` are the completions of one global `G`-extension; the tensor product with each
completion is a power of the prescribed local field. -/
theorem exists_galois_with_local_prescriptions_of_supersolvable (K : Type u) [Field K]
    [NumberField K] (G : Type*) [Group G] [Finite G] (hG : IsSupersolvable G)
    (Sf : Finset (HeightOneSpectrum (𝓞 K)))
    (hSf : ∀ v ∈ Sf, (Nat.card G : 𝓞 K) ∉ v.asIdeal) (Si : Finset (InfinitePlace K))
    (Lf : HeightOneSpectrum (𝓞 K) → Type u) [∀ v, Field (Lf v)]
    [∀ v, Algebra (v.adicCompletion K) (Lf v)]
    (hLf : ∀ v ∈ Sf, FiniteDimensional (v.adicCompletion K) (Lf v) ∧
      IsGalois (v.adicCompletion K) (Lf v) ∧
      ∃ φ : (Lf v ≃ₐ[v.adicCompletion K] Lf v) →* G, Function.Injective φ)
    (Li : InfinitePlace K → Type u) [∀ v, Field (Li v)] [∀ v, Algebra v.Completion (Li v)]
    (hLi : ∀ v ∈ Si, FiniteDimensional v.Completion (Li v) ∧ IsGalois v.Completion (Li v) ∧
      ∃ φ : (Li v ≃ₐ[v.Completion] Li v) →* G, Function.Injective φ) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ IsGalois K L ∧ Nonempty ((L ≃ₐ[K] L) ≃* G) ∧
      (∀ v ∈ Sf, ∃ m : ℕ, Nonempty
        (TensorProduct K (v.adicCompletion K) L ≃ₐ[v.adicCompletion K] (Fin m → Lf v))) ∧
      ∀ v ∈ Si, ∃ m : ℕ, Nonempty
        (TensorProduct K v.Completion L ≃ₐ[v.Completion] (Fin m → Li v)) := by
  sorry

open IsDedekindDomain NumberField in
/-- Quaternion Grunwald prescriptions (Harpaz–Wittenberg, discussion after the corollary to
Théorème B, p. 4): for the generalized quaternion group of order `2^(n+3)`, local Galois extensions
whose groups embed in it are induced by one global realization at any finite set of places,
including dyadic and infinite places. Each completed tensor product is a power of the local field. -/
theorem exists_galois_with_local_prescriptions_of_quaternion (K : Type u) [Field K]
    [NumberField K] (n : ℕ)
    (Sf : Finset (HeightOneSpectrum (𝓞 K)))
    (Si : Finset (InfinitePlace K))
    (Lf : HeightOneSpectrum (𝓞 K) → Type u) [∀ v, Field (Lf v)]
    [∀ v, Algebra (v.adicCompletion K) (Lf v)]
    (hLf : ∀ v ∈ Sf, FiniteDimensional (v.adicCompletion K) (Lf v) ∧
      IsGalois (v.adicCompletion K) (Lf v) ∧
      ∃ φ : (Lf v ≃ₐ[v.adicCompletion K] Lf v) →* QuaternionGroup (2 ^ (n + 1)), Function.Injective φ)
    (Li : InfinitePlace K → Type u) [∀ v, Field (Li v)] [∀ v, Algebra v.Completion (Li v)]
    (hLi : ∀ v ∈ Si, FiniteDimensional v.Completion (Li v) ∧ IsGalois v.Completion (Li v) ∧
      ∃ φ : (Li v ≃ₐ[v.Completion] Li v) →* QuaternionGroup (2 ^ (n + 1)), Function.Injective φ) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ IsGalois K L ∧ Nonempty ((L ≃ₐ[K] L) ≃* QuaternionGroup (2 ^ (n + 1))) ∧
      (∀ v ∈ Sf, ∃ m : ℕ, Nonempty
        (TensorProduct K (v.adicCompletion K) L ≃ₐ[v.adicCompletion K] (Fin m → Lf v))) ∧
      ∀ v ∈ Si, ∃ m : ℕ, Nonempty
        (TensorProduct K v.Completion L ≃ₐ[v.Completion] (Fin m → Li v)) := by
  sorry

/-- Every finite group is realizable over finitely many extensions of a number field whose
degrees have greatest common divisor one (Harpaz–Wittenberg, Remark 7.11). -/
theorem exists_realizations_coprime_degrees (K : Type u) [Field K] [NumberField K]
    (G : Type*) [Group G] [Finite G] :
    ∃ (n : ℕ) (E : Fin n → IntermediateField K (AlgebraicClosure K)),
      (Finset.univ.gcd fun i => Module.finrank K (E i)) = 1 ∧
      ∀ i, FiniteDimensional K (E i) ∧
        ∃ (L : Type u) (_ : Field L) (_ : Algebra (E i) L),
          FiniteDimensional (E i) L ∧ IsGalois (E i) L ∧
          Nonempty ((L ≃ₐ[E i] L) ≃* G) := by
  sorry

/-! ## Layer IG.5: configuration spaces and Hurwitz moduli -/

/-- The normal subgroup generated by all elements of prime-power order for the prime `p`. -/
abbrev pGenerated (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.normalClosure {g | ∃ n : ℕ, g ^ (p ^ n) = 1}

/-- Abhyankar's affine-curve theorem, in function-field form: precisely the groups whose
prime-to-`p` quotient needs at most `2g + r - 1` generators occur unramified off the `r` punctures.
The integral-extension witness makes restriction of places explicit. -/
theorem abhyankar_affine_curve (k : Type*) (F : Type u) [Field k] [IsAlgClosed k] [Field F] [Algebra k F]
    (hF : TauCeti.IsFunctionField k F) (p : ℕ) [Fact p.Prime] [CharP k p]
    (D : Finset (TauCeti.Place k F)) (hD : D.Nonempty)
    (G : Type*) [Group G] [Finite G] :
    (∃ (L : Type u) (_ : Field L) (_ : Algebra F L) (_ : Algebra k L)
      (_ : IsScalarTower k F L) (_ : FiniteDimensional F L) (_ : Algebra.IsIntegral F L),
      IsGalois F L ∧ Nonempty ((L ≃ₐ[F] L) ≃* G) ∧
        ∀ P : TauCeti.Place k L, P.restrict k F ∉ D → P.ramificationIdx F = 1) ↔
      Group.rank (G ⧸ pGenerated p G) ≤ 2 * TauCeti.genus k F + D.card - 1 := by
  sorry

/-! ## Layer IG.6: realizations and the inverse Galois problem -/

/-- The inverse Galois problem over `ℚ`, a named open statement. -/
def InverseGaloisProblem : Prop :=
  ∀ (G : Type) [Group G] [Finite G],
    ∃ (L : Type) (_ : Field L) (_ : Algebra ℚ L),
      FiniteDimensional ℚ L ∧ IsGalois ℚ L ∧ Nonempty ((L ≃ₐ[ℚ] L) ≃* G)

/-- The regular inverse Galois problem over `ℚ(T)`, a named open statement. -/
def RegularInverseGaloisProblem : Prop :=
  ∀ (G : Type) [Group G] [Finite G], HasRegularRealization ℚ G

/-- A regular realization over the rational function field of a characteristic-zero Hilbertian
field specializes to a finite Galois realization over that field. -/
theorem HasRegularRealization.exists_realization (K : Type u) [Field K] [CharZero K]
    (hK : IsHilbertian K) (G : Type*) [Group G] [Finite G] (h : HasRegularRealization K G) :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L),
      FiniteDimensional K L ∧ IsGalois K L ∧ Nonempty ((L ≃ₐ[K] L) ≃* G) := sorry

/-- A regular realization over a number field gives a sequence of realizations, each linearly
disjoint from a prescribed finite extension and the compositum of all earlier members. -/
theorem HasRegularRealization.exists_disjoint_realizations (K : Type u) [Field K] [NumberField K]
    (G : Type*) [Group G] [Finite G] (h : HasRegularRealization K G)
    (M : IntermediateField K (AlgebraicClosure K)) [FiniteDimensional K M] :
    ∃ L : ℕ → IntermediateField K (AlgebraicClosure K), ∀ n,
      FiniteDimensional K (L n) ∧ IsGalois K (L n) ∧
      Nonempty (((L n) ≃ₐ[K] (L n)) ≃* G) ∧
      (L n).LinearDisjoint ↥(M ⊔ ⨆ i : Fin n, L i.val) := by
  sorry

/-- The regular inverse Galois problem implies the inverse Galois problem over `ℚ`. -/
theorem inverseGaloisProblem_of_regular :
    RegularInverseGaloisProblem → InverseGaloisProblem := sorry

end

end TauCetiRoadmap.InverseGaloisAndArithmeticFundamentalGroups
