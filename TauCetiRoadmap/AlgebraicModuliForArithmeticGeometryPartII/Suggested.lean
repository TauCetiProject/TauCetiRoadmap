module

import Mathlib
import TauCeti.AlgebraicGeometry.LineBundle.Degree
import TauCeti.AlgebraicGeometry.LineBundle.Pullback

/-!
# Algebraic moduli for arithmetic geometry, Part II: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs.

Murre–Oort representability and finite type of the torsion component lack the fppf Picard sheaf and Picard group scheme.
The affinization Brauer obstruction lacks the scheme units sheaf on the fppf site
and its Leray comparison. The semiample contraction dictionary and numerical
uniqueness lack relative global generation, the section algebra and relative Proj.
Openness of ampleness lacks algebraic spaces and relative ampleness.
Geometric exceptional negativity and Zariski's lemma lack the geometric intersection
pairing, although their matrix inequalities are supplied by Tau Ceti.
Negative-curve descent and intersection-label descent lack that pairing.
The ampleness assertion for complete-DVR lifts lacks relative ampleness.
Cone identification over a discrete valuation ring lacks the real space of curve
classes, its closed cones and the restriction map of numerical groups. Nef-and-big
specialization lacks the relative projective-morphism and positivity interfaces. Semiample numerical descent and
Cascini–Tanaka vertical descent lack those predicates and the relative Cartier
pullback theory. Independence and transformation of AHK rank lack exceptional
prime divisor data and resolution comparison.
These headlines have no substitute declarations here.
-/

namespace TauCetiRoadmap.AlgebraicModuliForArithmeticGeometryPartII

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

/-! ## Layer 0: degrees and relative numerical triviality -/

/-- An invertible sheaf on a proper k-scheme is numerically trivial when its
restriction to every integral closed curve has Euler-characteristic degree zero
over k. Singular integral curves are included. -/
def NumericallyTrivial (k : Type u) [Field k] (X : Scheme.{u})
    (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x]
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf X) : Prop :=
  ∀ (C : Scheme.{u}) (_ : IsIntegral C) (i : C ⟶ X) (_ : IsClosedImmersion i),
    topologicalKrullDim C = 1 →
      letI : C.Over (Spec (CommRingCat.of k)) := ⟨i ≫ x⟩
      (((TauCeti.AlgebraicGeometry.InvertibleSheaf.pullback i).obj L).eulerDegree k) = 0

/-- Relative numerical triviality `L ≡_f 0` for a proper morphism `f : X → S`: for every
point `s` of `S`, the pullback of `L` to the scheme-theoretic fibre `X_s` is numerically
trivial over the residue field `κ(s)`, so degrees are taken over `κ(s)`. -/
def RelNumericallyTrivial {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f]
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf X) : Prop :=
  ∀ s : S,
    haveI : IsProper (f.fiberToSpecResidueField s) :=
      inferInstanceAs (IsProper (pullback.snd _ _))
    NumericallyTrivial (S.residueField s) (f.fiber s) (f.fiberToSpecResidueField s)
      ((TauCeti.AlgebraicGeometry.InvertibleSheaf.pullback (f.fiberι s)).obj L)

/-! ## Layer 1: numerical groups, cones, nefness and bigness -/

/-- The subgroup of the Picard group of a proper `k`-scheme generated by the classes of
numerically trivial invertible sheaves. The quotient by it is the numerical group
`Num(X/k)`. -/
noncomputable def numericallyTrivialClasses (k : Type u) [Field k] (X : Scheme.{u})
    (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x] :
    Subgroup (TauCeti.AlgebraicGeometry.LineBundleClass X) :=
  Subgroup.closure {a | ∃ L, TauCeti.AlgebraicGeometry.LineBundleClass.mk L = a ∧
    NumericallyTrivial k X x L}

/-- The subgroup of the Picard group generated by the classes of relatively numerically
trivial invertible sheaves for a proper morphism `f : X → S`. The quotient by it is the
relative numerical group `Num(X/S)`. -/
noncomputable def relNumericallyTrivialClasses {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f] :
    Subgroup (TauCeti.AlgebraicGeometry.LineBundleClass X) :=
  Subgroup.closure {a | ∃ L, TauCeti.AlgebraicGeometry.LineBundleClass.mk L = a ∧
    RelNumericallyTrivial f L}

/-- Numerical Néron–Severi theorem: for a proper scheme over an arbitrary field, the
numerical group `Num(X/k)` is a free abelian group of finite rank. No reducedness,
connectedness, projectivity or perfection of `k` is assumed.
Kleiman, Remark 6.19; Bhatt et al., Remark 2.22. -/
theorem numericalClassGroup_free_finite (k : Type u) [Field k] (X : Scheme.{u})
    (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x] :
    Module.Free ℤ (Additive (TauCeti.AlgebraicGeometry.LineBundleClass X ⧸
        numericallyTrivialClasses k X x)) ∧
      Module.Finite ℤ (Additive (TauCeti.AlgebraicGeometry.LineBundleClass X ⧸
        numericallyTrivialClasses k X x)) := by
  sorry

/-- Relative finiteness: for a proper morphism `f : X → S` to a Noetherian scheme, the
relative numerical group `Num(X/S)` is a free abelian group of finite rank.
Bhatt et al., Remark 2.22. -/
theorem relNumericalClassGroup_free_finite {X S : Scheme.{u}} (f : X ⟶ S) [IsProper f]
    [IsNoetherian S] :
    Module.Free ℤ (Additive (TauCeti.AlgebraicGeometry.LineBundleClass X ⧸
        relNumericallyTrivialClasses f)) ∧
      Module.Finite ℤ (Additive (TauCeti.AlgebraicGeometry.LineBundleClass X ⧸
        relNumericallyTrivialClasses f)) := by
  sorry

/-! ## Layer 2: proper Picard schemes and the numerical local system -/

/-- The actual base-field automorphisms fix every geometric numerical class.
For each automorphism of the algebraic closure, the two equations specify its
unique induced map on the base change. This is numerical local-system constancy
without choosing a represented Picard sheaf (Schröer, §1, p. 5). -/
def HasTrivialNumericalGaloisAction
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x] : Prop :=
  let b := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let X_K := pullback x b
  let q : TauCeti.AlgebraicGeometry.LineBundleClass X_K →
      TauCeti.AlgebraicGeometry.LineBundleClass X_K ⧸
        numericallyTrivialClasses K X_K (pullback.snd x b) := QuotientGroup.mk
  ∀ (sigma : K ≃ₐ[k] K) (g : X_K ⟶ X_K),
    g ≫ pullback.fst x b = pullback.fst x b →
    g ≫ pullback.snd x b =
      pullback.snd x b ≫ Spec.map (CommRingCat.ofHom sigma.toRingHom) →
    ∀ L : TauCeti.AlgebraicGeometry.InvertibleSheaf X_K,
      q (TauCeti.AlgebraicGeometry.LineBundleClass.mk
        ((TauCeti.AlgebraicGeometry.InvertibleSheaf.pullback g).obj L)) =
      q (TauCeti.AlgebraicGeometry.LineBundleClass.mk L)

/-- Numerical local-system constancy is equivalent to a single positive exponent
making every geometric numerical class the pullback of an actual line bundle on X.
The exponent is uniform in the geometric line bundle; equality is in the numerical
quotient, allowing a numerically trivial twist. No reducedness, connectedness,
projectivity or perfection is assumed (Schröer, Lemma 1.1, pp. 5–6). -/
theorem constantNumericalClasses_iff_positivePowerDescent
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x] :
    let b := Spec.map (CommRingCat.ofHom (algebraMap k K))
    let X_K := pullback x b
    let q : TauCeti.AlgebraicGeometry.LineBundleClass X_K →
        TauCeti.AlgebraicGeometry.LineBundleClass X_K ⧸
          numericallyTrivialClasses K X_K (pullback.snd x b) := QuotientGroup.mk
    HasTrivialNumericalGaloisAction k K X x ↔
      ∃ d : ℕ, 0 < d ∧
        ∀ L : TauCeti.AlgebraicGeometry.InvertibleSheaf X_K,
          ∃ M : TauCeti.AlgebraicGeometry.InvertibleSheaf X,
            q (TauCeti.AlgebraicGeometry.LineBundleClass.mk L ^ d) =
            q (TauCeti.AlgebraicGeometry.LineBundleClass.mk
              ((TauCeti.AlgebraicGeometry.InvertibleSheaf.pullback
                (pullback.fst x b)).obj M)) := by
  sorry

/-- On a proper scheme over an algebraic extension of a finite field, every
numerically trivial invertible sheaf has finite order in the Picard group.
No reducedness, projectivity or geometric integrality is assumed.
Keel, Lemma 2.16, is stated for projective schemes over the algebraic closure of a
finite field; it extends to every algebraic extension of `𝔽_p` by spreading out to a
finite subfield, and to proper schemes by the proper finite-type numerical Picard
component. -/
theorem numericallyTrivial_torsion_of_algebraic_finiteField
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k]
    [Algebra (ZMod p) k] [Algebra.IsAlgebraic (ZMod p) k]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x]
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf X)
    (hL : NumericallyTrivial k X x L) :
    ∃ n : ℕ, 0 < n ∧ TauCeti.AlgebraicGeometry.LineBundleClass.mk L ^ n = 1 := by
  sorry

/-! ## Layer 3: contractions, semiampleness and descent -/

/-- A contraction is proper, and its canonical structure-sheaf map is an
isomorphism: on every open of the target the induced map on sections is an
isomorphism. -/
def IsContraction {X Y : Scheme.{u}} (f : X ⟶ Y) : Prop :=
  IsProper f ∧ ∀ U : Y.Opens, IsIso (f.app U)

/-- Every proper contraction after a purely inseparable field extension descends
to a proper contraction over the original field. The target square is cartesian
and the source square commutes under the prescribed identification of the source
with its base change. No projectivity or numerical constancy is assumed.
Schröer, proof of Theorem 1.3 and the following remark, p. 7. -/
theorem contraction_descends_purelyInseparable
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    [IsPurelyInseparable k K]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x]
    (Y' : Scheme.{u}) (y' : Y' ⟶ Spec (CommRingCat.of K)) [IsProper y']
    (f' : pullback x (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Y')
    (hf' : IsContraction f')
    (hover : f' ≫ y' = pullback.snd x
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :
    ∃ (Y : Scheme.{u}) (y : Y ⟶ Spec (CommRingCat.of k))
      (f : X ⟶ Y) (v : Y' ⟶ Y),
      IsProper y ∧ IsContraction f ∧ f ≫ y = x ∧
      IsPullback v y' y (Spec.map (CommRingCat.ofHom (algebraMap k K))) ∧
      f' ≫ v = pullback.fst x (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫ f := by
  sorry

/-- A scheme `Y` with structure morphism `y` to `Spec K`, for a field `K`, is projective
over `K` when for some `n` it admits a closed immersion over `K` into projective
`n`-space, the homogeneous spectrum of `K[T₀, …, Tₙ]` graded by total degree. -/
noncomputable def IsProjectiveOver (K : Type u) [Field K] (Y : Scheme.{u})
    (y : Y ⟶ Spec (CommRingCat.of K)) : Prop :=
  ∃ n : ℕ,
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) :=
      MvPolynomial.gradedAlgebra
    ∃ i : Y ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K),
      IsClosedImmersion i ∧
        i ≫ Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K _)) = y

/-- Schröer, Theorem 1.3: if the numerical local system of a proper `k`-scheme `X` is
constant, every contraction of the base change of `X` to an algebraic closure onto a
projective target is the base change of a contraction of `X` onto a projective
`k`-scheme. The target square is cartesian and the source square commutes under the
prescribed identification of the source with its base change. -/
theorem contraction_descends_of_constantNumericalClasses
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x]
    (hnum : HasTrivialNumericalGaloisAction k K X x)
    (Y' : Scheme.{u}) (y' : Y' ⟶ Spec (CommRingCat.of K)) (hY' : IsProjectiveOver K Y' y')
    (f' : pullback x (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶ Y')
    (hf' : IsContraction f')
    (hover : f' ≫ y' = pullback.snd x
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :
    ∃ (Y : Scheme.{u}) (y : Y ⟶ Spec (CommRingCat.of k))
      (f : X ⟶ Y) (v : Y' ⟶ Y),
      IsProjectiveOver k Y y ∧ IsContraction f ∧ f ≫ y = x ∧
      IsPullback v y' y (Spec.map (CommRingCat.ofHom (algebraMap k K))) ∧
      f' ≫ v = pullback.fst x (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫ f := by
  sorry

/-! ## Layer 4: component graphs and contractions of smooth surfaces -/

/-- The simple intersection graph of the irreducible components of a scheme.
Distinct components are adjacent exactly when their underlying closed sets meet;
loops, intersection multiplicities and normalization genera are omitted. -/
def componentGraph (X : Scheme.{u}) :
    SimpleGraph {C : Set X // C ∈ irreducibleComponents X} where
  Adj A B := A ≠ B ∧ (A.1 ∩ B.1).Nonempty
  symm := by
    constructor
    intro A B h
    exact ⟨h.1.symm, h.2.imp (fun _ hx => ⟨hx.2, hx.1⟩)⟩
  loopless := by
    constructor
    intro A h
    exact h.1 rfl

/-- For a proper scheme whose irreducible components all have dimension one,
numerical local-system constancy is equivalent to component-graph descent.
The graph isomorphism must carry every geometric component to the closure of its
image under the prescribed base-change projection. Empty schemes are allowed;
reducedness and perfection are not required (Schröer, Proposition 1.2, p. 6). -/
theorem constantNumericalClasses_iff_componentGraphDescent
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of k)) [IsProper x]
    (hpure : ∀ C : Set X, C ∈ irreducibleComponents X →
      topologicalKrullDim C = 1) :
    let b := Spec.map (CommRingCat.ofHom (algebraMap k K))
    HasTrivialNumericalGaloisAction k K X x ↔
      ∃ e : componentGraph (pullback x b) ≃g componentGraph X,
        ∀ C, closure ((pullback.fst x b) '' C.1) = (e C).1 := by
  sorry

/-- Schröer, Theorem 2.1(i): let `S` be a smooth proper surface over `k` with
`H⁰(S, O_S) = k` and constant numerical local system, `f : S → Z` a contraction onto a
proper `k`-scheme and `ā` a geometric point of `Z` with image `a`. If the geometric
fibre `S ×_Z Spec Ω` is one-dimensional, its component graph is isomorphic to that of
the schematic fibre over `κ(a)`, each geometric component having the same closure in
`S` as the schematic component it is sent to. -/
theorem fibreComponentGraph_descends_of_constantNumericalClasses
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (S : Scheme.{u}) (s : S ⟶ Spec (CommRingCat.of k)) [IsProper s] [Smooth s]
    (hsurf : ∀ C : Set S, C ∈ irreducibleComponents S → topologicalKrullDim C = 2)
    (hconst : IsIso (s.app ⊤))
    (hnum : HasTrivialNumericalGaloisAction k K S s)
    (Z : Scheme.{u}) (z : Z ⟶ Spec (CommRingCat.of k)) [IsProper z]
    (f : S ⟶ Z) (hf : IsContraction f) (hfz : f ≫ z = s)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ā : Spec (CommRingCat.of Ω) ⟶ Z)
    (hfib : topologicalKrullDim (pullback f ā : Scheme.{u}) = 1) :
    ∃ e : componentGraph (pullback f ā) ≃g
        componentGraph (f.fiber (ā (IsLocalRing.closedPoint Ω))),
      ∀ C, closure ((pullback.fst f ā) '' C.1) =
        closure ((f.fiberι (ā (IsLocalRing.closedPoint Ω))) '' (e C).1) := by
  sorry

/-- Rationality of reducible-fibre image points: in the situation of the fibre-graph
theorem, if the one-dimensional geometric fibre is reducible, the map from `Spec κ(a)`
to `Spec k` is an isomorphism, so `κ(a) = k` and `a` is a closed point. This strengthens
the purely inseparable residue extension of Schröer, Theorem 2.1(iii). -/
theorem residueField_eq_of_reducible_geometricFibre
    (k K : Type u) [Field k] [Field K] [Algebra k K] [IsAlgClosure k K]
    (S : Scheme.{u}) (s : S ⟶ Spec (CommRingCat.of k)) [IsProper s] [Smooth s]
    (hsurf : ∀ C : Set S, C ∈ irreducibleComponents S → topologicalKrullDim C = 2)
    (hconst : IsIso (s.app ⊤))
    (hnum : HasTrivialNumericalGaloisAction k K S s)
    (Z : Scheme.{u}) (z : Z ⟶ Spec (CommRingCat.of k)) [IsProper z]
    (f : S ⟶ Z) (hf : IsContraction f) (hfz : f ≫ z = s)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ā : Spec (CommRingCat.of Ω) ⟶ Z)
    (hfib : topologicalKrullDim (pullback f ā : Scheme.{u}) = 1)
    (hred : ¬ IrreducibleSpace (pullback f ā : Scheme.{u})) :
    IsIso (Z.fromSpecResidueField (ā (IsLocalRing.closedPoint Ω)) ≫ z) := by
  sorry

/-! ## Layer 5: numerical theory in families and descent along contractions -/

/-- If a proper flat scheme over a complete DVR has H²(O)=0 on its special
fibre, every invertible sheaf on that fibre is the restriction of an invertible
sheaf on the total scheme. Completeness is adic completeness for the maximal
ideal. The special fibre is the native pullback along the residue-field map.
Hacon–Witaszek, Lemma 6.3, with the same obstruction/existence argument in all
characteristics. -/
theorem lineBundle_lifts_completeDVR_of_h2_zero
    (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
    (X : Scheme.{u}) (x : X ⟶ Spec (CommRingCat.of R)) [IsProper x] [Flat x]
    (h2 : Subsingleton (TauCeti.AlgebraicGeometry.Scheme.Modules.Cohomology
      (TauCeti.AlgebraicGeometry.InvertibleSheaf.trivial
        (pullback x (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))).obj 2))
    (L : TauCeti.AlgebraicGeometry.InvertibleSheaf
      (pullback x (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) :
    ∃ M : TauCeti.AlgebraicGeometry.InvertibleSheaf X,
      Nonempty (((TauCeti.AlgebraicGeometry.InvertibleSheaf.pullback
        (pullback.fst x (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))).obj M).obj
        ≅ L.obj) := by
  sorry

end TauCetiRoadmap.AlgebraicModuliForArithmeticGeometryPartII
