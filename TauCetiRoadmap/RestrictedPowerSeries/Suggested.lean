import Mathlib
import TauCeti.RingTheory.PowerSeries.TateAlgebra
import TauCeti.RingTheory.MvPowerSeries.TateAlgebra.Basic

/-!
# Restricted power series and Tate algebras: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems against the pinned Mathlib and Tau Ceti, each admitted with `sorry`, together with the
few definitions those statements need: evaluation as a convergent sum (§2.1), multiplicative
units and multiplicative distinguishedness (Convention 7, §§3.1 and 4.1), the `X 0`-slices of a
several-variable series (§4.4) and entire series (§7.2). The series carriers are Mathlib's
`PowerSeries.IsRestricted` and `MvPowerSeries.IsRestricted.subring` with Tau Ceti's Gauss-norm
instances; the native Tau Ceti theorems the roadmap consumes (one-variable division and
preparation under a multiplicative norm, one-variable noetherianity, the unit-radius iteration
isometry) are not restated.

Headline theorems not statable at the pins: completeness and polynomial density of the open-disc
and entire algebras for the topology of all their Gauss norms (§§7.1–7.2), which need a carrier
for the topology generated by a family of Gauss norms; and the agreement of the Gauss-norm and
completed Huber topologies (§6.2), whose carrier `Huber.restrictedMvPowerSeriesGaussEquiv` is
pinned with its continuity in both directions, so that nothing remains to state.
-/

namespace TauCetiRoadmap.RestrictedPowerSeries

noncomputable section

open PowerSeries

universe u

/-! ## Layer 2: Evaluation and the maximum principle -/

section Evaluation

variable {R B : Type*} [NormedCommRing R] [NormedCommRing B]

/-- Evaluation of a one-variable series at a point of the closed disc, as a convergent sum
rather than a formal substitution (§2.1). -/
def eval₂ (φ : R →+* B) (f : PowerSeries R) (b : B) : B :=
  ∑' n : ℕ, φ (coeff n f) * b ^ n

/-- Evaluation of a several-variable series at a point of the closed polydisc, as a convergent
monomial sum (§2.1). -/
def mvEval₂ {σ : Type*} (φ : R →+* B) (f : MvPowerSeries σ R) (x : σ → B) : B :=
  ∑' ν : σ →₀ ℕ, φ (MvPowerSeries.coeff ν f) * ν.prod (fun i k ↦ x i ^ k)

/-- For a coefficient map bounded by `C` and a point of norm at most the radius, the sum
defining `eval₂` converges to it (§2.1). -/
theorem hasSum_eval₂ [IsUltrametricDist B] [CompleteSpace B] (φ : R →+* B) {C r : ℝ}
    (hC : 0 ≤ C) (hφ : ∀ a, ‖φ a‖ ≤ C * ‖a‖) (hr : 0 < r)
    {f : PowerSeries R} (hf : f.IsRestricted r) {b : B} (hb : ‖b‖ ≤ r) :
    HasSum (fun n : ℕ ↦ φ (coeff n f) * b ^ n) (eval₂ φ f b) := by
  sorry

/-- The monomial sum defining `mvEval₂` converges at every point of the closed polydisc of the
polyradius at which the series is restricted (§2.1). -/
theorem hasSum_mvEval₂ [IsUltrametricDist B] [CompleteSpace B] {σ : Type*} (φ : R →+* B)
    {C : ℝ} (hC : 0 ≤ C) (hφ : ∀ a, ‖φ a‖ ≤ C * ‖a‖) {r : σ → ℝ} (hr : ∀ i, 0 < r i)
    {f : MvPowerSeries σ R} (hf : MvPowerSeries.IsRestricted r f) {x : σ → B}
    (hx : ∀ i, ‖x i‖ ≤ r i) :
    HasSum (fun ν : σ →₀ ℕ ↦ φ (MvPowerSeries.coeff ν f) * ν.prod (fun i k ↦ x i ^ k))
      (mvEval₂ φ f x) := by
  sorry

end Evaluation

/-! ## Layers 3–4: Multiplicative units and Weierstrass theory over Banach rings -/

section Weierstrass

variable {R : Type*} [NormedCommRing R]

/-- A multiplicative unit (Martin, Definition 1.20; §3.1): a unit `u` with `‖u a‖ = ‖u‖ ‖a‖`
for every `a`. Invertibility alone is insufficient for the division estimate. -/
def IsNormMulUnit (u : R) : Prop :=
  IsUnit u ∧ ∀ a : R, ‖u * a‖ = ‖u‖ * ‖a‖

/-- Multiplicatively distinguished of degree `s` at radius `r` (Martin, Definition 1.24;
Convention 7): the coefficient of degree `s` is a multiplicative unit, its weighted norm attains
the Gauss norm, and every later coefficient has strictly smaller weighted norm. Restrictedness
and positivity of the radius are separate hypotheses of the theorems. -/
def IsMulDistinguished (r : ℝ) (g : PowerSeries R) (s : ℕ) : Prop :=
  IsNormMulUnit (coeff s g) ∧ TauCeti.PowerSeries.IsDistinguished r s g

/-- The multiplication estimate (Martin, Lemma 1.26 and (1.8); §4.1): for a multiplicatively
distinguished divisor `g` of degree `s`, a restricted `q` and a polynomial `b` of degree less
than `s`, `‖g q + b‖_r = max (‖g‖_r ‖q‖_r) ‖b‖_r`. No completeness, `‖1‖ = 1` or global
multiplicativity of the norm enters. -/
theorem gaussNorm_mul_add_eq_max [IsUltrametricDist R] {r : ℝ} (hr : 0 < r)
    {g : PowerSeries R} (hg : g.IsRestricted r) {s : ℕ} (hgs : IsMulDistinguished r g s)
    {q : PowerSeries R} (hq : q.IsRestricted r) {b : Polynomial R} (hb : b.degree < s) :
    gaussNorm norm r (g * q + b.toPowerSeries) =
      max (gaussNorm norm r g * gaussNorm norm r q) (gaussNorm norm r b.toPowerSeries) := by
  sorry

/-- Weierstrass division at every positive real radius over a complete ultrametric normed
commutative ring with `‖1‖ = 1` (Martin, Proposition 1.27; §4.2): quotient and remainder are
unique among all pairs with the remainder of degree less than `s`; the norm identity for every
such pair is `gaussNorm_mul_add_eq_max`. `degree`, rather than `natDegree`, handles zero
remainders and distinguished degree zero. -/
theorem weierstrassDivision_unique [IsUltrametricDist R] [NormOneClass R] [CompleteSpace R]
    {r : ℝ} (hr : 0 < r) {g : PowerSeries R} (hg : g.IsRestricted r) {s : ℕ}
    (hgs : IsMulDistinguished r g s) (f : PowerSeries R) (hf : f.IsRestricted r) :
    ∃! qb : PowerSeries R × Polynomial R,
      qb.1.IsRestricted r ∧ qb.2.degree < s ∧ f = g * qb.1 + qb.2.toPowerSeries := by
  sorry

/-- Weierstrass preparation (Martin, Corollary 1.28; §4.3): a multiplicatively distinguished
`g` of degree `s` is uniquely a multiplicative unit of the restricted algebra times a monic
polynomial of degree `s`. The identity `‖w‖_r = r ^ s` is a consequence, not a normalisation
in the uniqueness class. -/
theorem weierstrassPreparation_unique [IsUltrametricDist R] [NormOneClass R] [CompleteSpace R]
    {r : ℝ} [Fact (0 < r)] {g : PowerSeries R} (hg : g.IsRestricted r) {s : ℕ}
    (hgs : IsMulDistinguished r g s) :
    ∃! we : Polynomial R × PowerSeries.IsRestricted.subring (R := R) r,
      we.1.Monic ∧ we.1.degree = s ∧ IsNormMulUnit we.2 ∧
        g = (we.2 : PowerSeries R) * we.1.toPowerSeries := by
  sorry

end Weierstrass

/-! ## Layer 4: Several variables -/

section SeveralVariables

variable {R : Type*} [NormedCommRing R] {n : ℕ}

/-- The coefficient of `X 0 ^ k` in a series in the variables `Fin (n + 1)`, as a series in the
remaining variables (Convention 8, §4.4). -/
def slice (k : ℕ) (g : MvPowerSeries (Fin (n + 1)) R) : MvPowerSeries (Fin n) R :=
  fun μ ↦ MvPowerSeries.coeff (Finsupp.cons k μ) g

/-- Positivity of the polyradius `Fin.cons r₀ r` from positivity of its parts. -/
instance instFactPosFinCons {r₀ : ℝ} {r : Fin n → ℝ} [h₀ : Fact (0 < r₀)]
    [h : ∀ i, Fact (0 < r i)] : ∀ i, Fact (0 < (Fin.cons r₀ r : Fin (n + 1) → ℝ) i) :=
  fun i ↦ Fin.cases (motive := fun i ↦ Fact (0 < (Fin.cons r₀ r : Fin (n + 1) → ℝ) i)) h₀ h i

/-- Multiplicatively distinguished of degree `s` in the variable `X 0` at the polyradius
`Fin.cons r₀ r` (§4.4): the slice of degree `s` is a multiplicative unit of the coefficient
restricted algebra at the radii `r`, its weighted norm `‖slice s g‖_r r₀ ^ s` attains the Gauss
norm of `g`, and every slice of higher degree has strictly smaller weighted norm. -/
def IsMulDistinguishedAt [IsUltrametricDist R] (r₀ : ℝ) (r : Fin n → ℝ) [∀ i, Fact (0 < r i)]
    (g : MvPowerSeries (Fin (n + 1)) R) (s : ℕ) : Prop :=
  (∃ u : MvPowerSeries.IsRestricted.subring (R := R) r,
      (u : MvPowerSeries (Fin n) R) = slice s g ∧ IsNormMulUnit u) ∧
    (∀ k, MvPowerSeries.gaussNorm norm r (slice k g) * r₀ ^ k ≤
      MvPowerSeries.gaussNorm norm r (slice s g) * r₀ ^ s) ∧
    ∀ k, s < k → MvPowerSeries.gaussNorm norm r (slice k g) * r₀ ^ k <
      MvPowerSeries.gaussNorm norm r (slice s g) * r₀ ^ s

/-- Several-variable Weierstrass division at an arbitrary positive polyradius (§4.4, Martin's
remark after Corollary 1.28 iterated over the coefficient restricted algebra): the remainder is
a polynomial in `X 0` of degree less than `s` whose coefficients are restricted series in the
other variables, and the pair is unique among all such pairs. -/
theorem mvWeierstrassDivision_unique [IsUltrametricDist R] [NormOneClass R] [CompleteSpace R]
    (r₀ : ℝ) [Fact (0 < r₀)] (r : Fin n → ℝ) [∀ i, Fact (0 < r i)]
    {g : MvPowerSeries (Fin (n + 1)) R} (hg : MvPowerSeries.IsRestricted (Fin.cons r₀ r) g)
    {s : ℕ} (hgs : IsMulDistinguishedAt r₀ r g s) (f : MvPowerSeries (Fin (n + 1)) R)
    (hf : MvPowerSeries.IsRestricted (Fin.cons r₀ r) f) :
    ∃! qb : MvPowerSeries (Fin (n + 1)) R × MvPowerSeries (Fin (n + 1)) R,
      MvPowerSeries.IsRestricted (Fin.cons r₀ r) qb.1 ∧
        MvPowerSeries.IsRestricted (Fin.cons r₀ r) qb.2 ∧ (∀ k, s ≤ k → slice k qb.2 = 0) ∧
        f = g * qb.1 + qb.2 := by
  sorry

/-- The several-variable multiplication estimate (§4.4): with `g`, `q` and `b` as in
`mvWeierstrassDivision_unique`, `‖g q + b‖ = max (‖g‖ ‖q‖) ‖b‖` at the polyradius
`Fin.cons r₀ r`. -/
theorem mv_gaussNorm_mul_add_eq_max [IsUltrametricDist R] (r₀ : ℝ) [Fact (0 < r₀)]
    (r : Fin n → ℝ) [∀ i, Fact (0 < r i)]
    {g : MvPowerSeries (Fin (n + 1)) R} (hg : MvPowerSeries.IsRestricted (Fin.cons r₀ r) g)
    {s : ℕ} (hgs : IsMulDistinguishedAt r₀ r g s)
    {q b : MvPowerSeries (Fin (n + 1)) R} (hq : MvPowerSeries.IsRestricted (Fin.cons r₀ r) q)
    (hb : MvPowerSeries.IsRestricted (Fin.cons r₀ r) b) (hbs : ∀ k, s ≤ k → slice k b = 0) :
    MvPowerSeries.gaussNorm norm (Fin.cons r₀ r) (g * q + b) =
      max (MvPowerSeries.gaussNorm norm (Fin.cons r₀ r) g *
        MvPowerSeries.gaussNorm norm (Fin.cons r₀ r) q)
        (MvPowerSeries.gaussNorm norm (Fin.cons r₀ r) b) := by
  sorry

/-- Several-variable Weierstrass preparation (§4.4): a series multiplicatively distinguished of
degree `s` in `X 0` is uniquely a multiplicative unit of the restricted algebra times a
polynomial in `X 0` which is monic of degree `s` with restricted coefficients in the other
variables. -/
theorem mvWeierstrassPreparation_unique [IsUltrametricDist R] [NormOneClass R] [CompleteSpace R]
    (r₀ : ℝ) [Fact (0 < r₀)] (r : Fin n → ℝ) [∀ i, Fact (0 < r i)]
    {g : MvPowerSeries (Fin (n + 1)) R} (hg : MvPowerSeries.IsRestricted (Fin.cons r₀ r) g)
    {s : ℕ} (hgs : IsMulDistinguishedAt r₀ r g s) :
    ∃! we : MvPowerSeries (Fin (n + 1)) R ×
        MvPowerSeries.IsRestricted.subring (R := R) (Fin.cons r₀ r),
      MvPowerSeries.IsRestricted (Fin.cons r₀ r) we.1 ∧ slice s we.1 = 1 ∧
        (∀ k, s < k → slice k we.1 = 0) ∧ IsNormMulUnit we.2 ∧
        g = (we.2 : MvPowerSeries (Fin (n + 1)) R) * we.1 := by
  sorry

end SeveralVariables

/-! ## Layers 2 and 5: Tate algebras over a complete nonarchimedean field -/

section TateAlgebra

variable (K : Type u) [NontriviallyNormedField K] [IsUltrametricDist K] [CompleteSpace K]

/-- Strassmann's bound (§2.4): a one-variable series restricted at radius `r` whose last
Gauss-norm-attaining index is `s` has at most `s` zeros of norm at most `r` in any complete
ultrametric normed field extension of `K` with isometric structure map. -/
theorem strassmann {L : Type*} [NormedField L] [IsUltrametricDist L] [CompleteSpace L]
    [NormedAlgebra K L] (hiso : Isometry (algebraMap K L))
    {r : ℝ} (hr : 0 < r) {f : PowerSeries K} (hf : f.IsRestricted r) {s : ℕ}
    (hs : TauCeti.PowerSeries.IsDistinguished r s f) :
    {x : L | ‖x‖ ≤ r ∧ eval₂ (algebraMap K L) f x = 0}.encard ≤ s := by
  sorry

/-- The maximum-modulus principle (§2.4, BGR 5.1.4): the Gauss norm of an element of the Tate
algebra `K⟨X₁,…,Xₙ⟩` is attained at a point of the closed unit polydisc over some finite
extension of `K`. -/
theorem tate_exists_finiteDimensional_norm_mvEval₂_eq (n : ℕ)
    (f : MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))) :
    ∃ (L : Type u) (_ : NormedField L) (_ : NormedAlgebra K L), FiniteDimensional K L ∧
      Isometry (algebraMap K L) ∧ ∃ x : Fin n → L, (∀ i, ‖x i‖ ≤ 1) ∧
        ‖mvEval₂ (algebraMap K L) (f : MvPowerSeries (Fin n) K) x‖ = ‖f‖ := by
  sorry

/-- Tate algebras are unique factorisation domains (§5.2, BGR 5.2.6). -/
theorem tate_uniqueFactorizationMonoid (n : ℕ) :
    UniqueFactorizationMonoid
      (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))) := by
  sorry

/-- Tate algebras are Jacobson rings (§5.2, BGR 5.2.6 and 7.1.1): every prime ideal is an
intersection of maximal ideals. No discreteness or characteristic-zero restriction. -/
theorem tate_isJacobsonRing (n : ℕ) :
    IsJacobsonRing (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))) := by
  sorry

/-- The Krull dimension of `K⟨X₁,…,Xₙ⟩` is `n` (§5.2, BGR 5.2.6). -/
theorem tate_ringKrullDim (n : ℕ) :
    ringKrullDim (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))) = n := by
  sorry

/-- Strict closedness of submodules of `K⟨X₁,…,Xₙ⟩^m` for the maximum norm (§5.3, Bosch §1.3
Corollaries 9–10): every coset has a representative of least norm. Ideals are the case
`m = 1`. -/
theorem tate_exists_norm_sub_le (n m : ℕ)
    (N : Submodule (MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ)))
      (Fin m → MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))))
    (f : Fin m → MvPowerSeries.IsRestricted.subring (R := K) (fun _ : Fin n ↦ (1 : ℝ))) :
    ∃ g ∈ N, ∀ h ∈ N, ‖f - g‖ ≤ ‖f - h‖ := by
  sorry

/-- Noetherianity at a positive polyradius each of whose coordinates lies in `√|K×|`
(§5.4): the restricted algebra is finite over the unit Tate algebra. -/
theorem isNoetherianRing_isRestricted_subring_of_radii (n : ℕ) (r : Fin n → ℝ)
    (hr : ∀ i, 0 < r i) (h : ∀ i, ∃ (s : ℕ) (c : K), 1 ≤ s ∧ ‖c‖ * r i ^ s = 1) :
    IsNoetherianRing (MvPowerSeries.IsRestricted.subring (R := K) r) := by
  sorry

end TateAlgebra

/-! ## Layer 7: Entire series -/

section Entire

variable {R : Type*} [NormedCommRing R]

/-- Entire means restricted at every positive radius (§7.2). -/
def IsEntire (f : PowerSeries R) : Prop :=
  ∀ r : ℝ, 0 < r → f.IsRestricted r

/-- Entire division by a polynomial with invertible leading coefficient (§7.2, Coleman
Appendix A3): quotient and remainder are unique with the quotient entire; formal division is a
different statement. -/
theorem entire_division_unique [IsUltrametricDist R] [NormOneClass R] [CompleteSpace R]
    (P : Polynomial R) (hP : IsUnit P.leadingCoeff) (F : PowerSeries R) (hF : IsEntire F) :
    ∃! QB : PowerSeries R × Polynomial R,
      IsEntire QB.1 ∧ QB.2.degree < P.degree ∧
        F = P.toPowerSeries * QB.1 + QB.2.toPowerSeries := by
  sorry

end Entire

end

end TauCetiRoadmap.RestrictedPowerSeries
