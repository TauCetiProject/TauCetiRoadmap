/-!
# Surface topology, finite presentations, and classification: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is
`README.md`. The declarations here suggest Lean forms for load-bearing objects and
particular milestones, so that contributors and reviewers converge on names and
signatures; discharging all of them finishes neither a layer nor the roadmap. `sorry` is
allowed in this human-owned roadmap library: these are targets, not completed proofs.

This roadmap chooses two-dimensional generalized maps as the finite hub. Oriented maps,
hypermaps, and polygonal schemas are presentations of the same finite surface data;
realization, Euler characteristic, orientability, and the main operations are defined at the
hub and compared to the other presentations. Layers 1 through 8 end in the classification of
compact surfaces; layers 9 and 10 build mapping class groups and planarity on top of it.

The file therefore pins more object-level vocabulary than many roadmaps do. Where the README
shapes a definition after an open Mathlib pull request, as for connectivity, degree, minors,
and drawings of Mathlib's `Graph α β`, this file compiles the shape that needs no new Mathlib
vocabulary and records the rest as comments, rather than introducing a private synonym to make
the targets parse. A condition that cannot yet be stated honestly is omitted rather than
replaced by `Prop := sorry`.
-/

noncomputable section

namespace TauCetiRoadmap.SurfaceTopology

open Function Set

universe u v w

/-! ## Layer 0: finite conventions -/

/-- A finite cyclic word with repeated labels, modulo cyclic rotation. The implementation
should remain separate from `CircularOrder` and from the topological circle. -/
def CyclicWord (α : Type u) : Type u :=
  sorry

/-- A bundled finite indexing type. Moves which add or remove cells must not pretend to
live on a fixed ambient type. -/
structure BundledFinite where
  ι : Type u
  fintype : Fintype ι
  decEq : DecidableEq ι

/-!
The isomorphism closure used by move relations should be compiled once the concrete
bundled object is known. The important constraint is that `Relation.ReflTransGen` is
applied *after* closing the elementary relation under isomorphism of the bundled index
type; Pachner/schema moves change that type.
-/

/-! ## Layer 1: generalized maps -/

/-- An `n`-dimensional generalized map: `n+1` involutions, with non-neighbouring
involutions commuting. This definition is dimension-polymorphic even though the roadmap
only develops the two-dimensional theory. -/
structure GMap (n : ℕ) (D : Type u) [Fintype D] [DecidableEq D] where
  adj : Fin (n + 1) → Equiv.Perm D
  involutive : ∀ i, Function.Involutive (adj i)
  commute_of_far : ∀ i j, i.1 + 2 ≤ j.1 → Function.Commute (adj i) (adj j)

abbrev GMap2 (D : Type u) [Fintype D] [DecidableEq D] := GMap 2 D

/-- The `i`-cells are the orbits of the group generated by all adjacencies except `αᵢ`. -/
def GMap.Cell {n : ℕ} {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap n D) (i : Fin (n + 1)) : Type u :=
  MulAction.orbitRel.Quotient (Subgroup.closure {σ | ∃ j, j ≠ i ∧ σ = G.adj j}) D

/-- Cells of a finite generalized map are finite orbit quotients. -/
instance GMap.instFiniteCell {n : ℕ} {D : Type u}
    [Fintype D] [DecidableEq D] (G : GMap n D) (i : Fin (n + 1)) :
    Finite (G.Cell i) :=
  inferInstanceAs (Finite (Quotient _))

/-- The connected components: the orbits of the group generated by all the adjacencies. -/
def GMap.Components {n : ℕ} {D : Type u} [Fintype D] [DecidableEq D] (G : GMap n D) : Type u :=
  MulAction.orbitRel.Quotient (Subgroup.closure (Set.range G.adj)) D

/-- Isomorphism of two-dimensional generalized maps, allowing the dart type to change. -/
structure GMap2.Iso {D : Type u} {D' : Type v}
    [Fintype D] [DecidableEq D] [Fintype D'] [DecidableEq D']
    (G : GMap2 D) (G' : GMap2 D') where
  toEquiv : D ≃ D'
  map_adj : ∀ i d, toEquiv (G.adj i d) = G'.adj i (toEquiv d)

/-- Euler characteristic as the cell count. Under the surface condition below this is the
Euler characteristic of the realization; Damiand–Lienhardt's Definition 91, the alternating
sum over all orbit types, is the Euler characteristic of the flag triangulation and is always
correct, but it is the cell count that every later layer wants. -/
def GMap2.eulerChar {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : ℤ :=
  (Nat.card (G.Cell 0) : ℤ) - Nat.card (G.Cell 1) + Nat.card (G.Cell 2)

/-- A boundary dart is a fixed point of the highest-order involution. -/
def GMap2.IsBoundaryDart {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) (d : D) : Prop :=
  G.adj 2 d = d

instance {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    DecidablePred G.IsBoundaryDart :=
  fun d => inferInstanceAs (Decidable (G.adj 2 d = d))

/-- The surface condition. No dart is fixed by `α₀` or `α₁`, so the boundary is recorded by
`α₂` alone, and no edge is folded onto itself, `α₂ d ≠ α₀ d`, so every orbit cell is a cell of
the realization. These are Damiand–Lienhardt's "no 0- or 1-boundary" and "no folded cell"
(§4.3.4.2, pp. 106–107; §8.3.2.1, p. 331). Every generalized map realizes to a surface without
any hypothesis (§2.4); the condition is the price of `eulerChar` being the Euler characteristic. -/
def IsSurfaceGMap {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  (∀ d, G.adj 0 d ≠ d) ∧ (∀ d, G.adj 1 d ≠ d) ∧ (∀ d, G.adj 2 d ≠ G.adj 0 d)

instance {D : Type u} [Fintype D] [DecidableEq D] : DecidablePred (IsSurfaceGMap (D := D)) :=
  fun G => by unfold IsSurfaceGMap; infer_instance

/-- A closed surface map: no boundary darts either. -/
def IsClosedSurfaceGMap {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  IsSurfaceGMap G ∧ ∀ d, G.adj 2 d ≠ d

instance {D : Type u} [Fintype D] [DecidableEq D] :
    DecidablePred (IsClosedSurfaceGMap (D := D)) :=
  fun G => by unfold IsClosedSurfaceGMap; infer_instance

/-- The map on two darts with all three involutions the swap: one edge folded onto itself by a
half-turn about its midpoint. Its realization is a sphere, since the flag triangulation has
three vertices, three edges, and two triangles, but the cell count is `1 - 1 + 1 = 1`. This
is the folded cell the third condition excludes. -/
def allSwap : GMap2 Bool where
  adj _ := Equiv.swap true false
  involutive _ := Equiv.swap_apply_self true false
  commute_of_far _ _ _ := Function.Commute.refl _

example : ¬ IsSurfaceGMap allSwap := fun h => h.2.2 true rfl

/-- The projective plane as the one-face schema `a a`: four darts, `α₀ = (0 1)(2 3)`,
`α₁ = (1 2)(3 0)`, `α₂ = (0 2)(1 3)`. One vertex, one edge, one face, and the surface condition
holds, so this one-cell presentation is admitted, as it must be. -/
def projectivePlane : GMap2 (Fin 4) where
  adj := ![Equiv.swap 0 1 * Equiv.swap 2 3, Equiv.swap 1 2 * Equiv.swap 3 0,
    Equiv.swap 0 2 * Equiv.swap 1 3]
  involutive := by
    intro i
    fin_cases i <;> (intro x; fin_cases x <;> decide)
  commute_of_far := by
    intro i j hij x
    fin_cases i <;> fin_cases j <;> fin_cases x <;> decide

example : IsSurfaceGMap projectivePlane := by decide

example : IsClosedSurfaceGMap projectivePlane := by decide

/-- Orientability as bipartiteness of the dart-adjacency graph, ignoring fixed
adjacencies representing boundary. -/
def GMap2.IsOrientable {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  ∃ S : Set D, ∀ i d, G.adj i d ≠ d → (d ∈ S ↔ G.adj i d ∉ S)

/-- A chosen orientation is extra data; `IsOrientable` is only the existence property. -/
structure GMap2.Orientation {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) where
  side : Set D
  flips : ∀ i d, G.adj i d ≠ d → (d ∈ side ↔ G.adj i d ∉ side)

/-- Orientations of cells are intrinsic: an edge is oriented by choosing one of its two ends,
the two `⟨α₂⟩`-orbits inside its dart orbit. -/
def GMap2.EdgeOrientation {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D)
    (e : G.Cell 1) : Type u :=
  sorry

/-- A face is oriented by choosing one of the two ways round it, the two `⟨α₀ α₁⟩`-orbits
inside its dart orbit. -/
def GMap2.FaceOrientation {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D)
    (f : G.Cell 2) : Type u :=
  sorry

/-- The boundary 1-map: the boundary darts, with `α₀` and the involution that walks around a
boundary vertex to the next boundary dart. Its components are the boundary circles. -/
noncomputable def GMap2.boundary {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    GMap 1 {d // G.IsBoundaryDart d} :=
  sorry

/-- The number of boundary circles. -/
noncomputable def GMap2.boundaryComponentCount {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : ℕ :=
  Nat.card G.boundary.Components

/-- A generalized map with its finite dart type bundled. This is the codomain of moves
which change the number or type of darts. -/
structure BundledGMap2 where
  D : Type u
  fintypeD : Fintype D
  decEqD : DecidableEq D
  map : @GMap 2 D fintypeD decEqD

/-!
Still to pin here: connectedness (`Nat.card G.Components = 1`), the orientation of the
boundary circles induced by a `GMap2.Orientation` (the surface on the left, as `PlanarTopology`
layer 6 fixes it), and the two genus formulas

  def GMap2.orientableGenus (G) (h : G.IsConnected ∧ IsSurfaceGMap G ∧ G.IsOrientable) : ℕ
  def GMap2.nonorientableGenus (G) (h : G.IsConnected ∧ IsSurfaceGMap G ∧ ¬ G.IsOrientable) : ℕ

whose identification with the genera of the standard surfaces is layer 8's. Beside the two
examples above, the implementation should carry a map with an `α₀`-fixed dart and one with an
`α₁`-fixed dart as negative tests, a dangling edge (`α₂ d = α₁ d`) as a positive test of
multiple incidence, and the sphere, torus, Klein bottle, disc, annulus, and Möbius band as
decidable tests of the definition.
-/

/-! ## Layer 2: presentations and comparison theorems -/

/-- An oriented combinatorial map / rotation system. -/
structure CombinatorialMap (D : Type u) [Fintype D] [DecidableEq D] where
  sigma : Equiv.Perm D
  alpha : Equiv.Perm D
  alpha_involutive : Function.Involutive alpha
  alpha_free : ∀ d, alpha d ≠ d

/-- Passing from an oriented map to the unoriented generalized-map hub doubles darts. -/
noncomputable def CombinatorialMap.toGMap2 {D : Type u} [Fintype D] [DecidableEq D]
    (M : CombinatorialMap D) : GMap2 (D × Bool) :=
  sorry

/-- A hypermap in the three-permutation presentation. -/
structure Hypermap (D : Type u) [Fintype D] [DecidableEq D] where
  sigma : Equiv.Perm D
  phi : Equiv.Perm D
  alpha : Equiv.Perm D
  comp : sigma * phi * alpha = 1

/-- Conversion from a hypermap to the generalized-map hub. -/
noncomputable def Hypermap.toGMap2 {D : Type u} [Fintype D] [DecidableEq D]
    (H : Hypermap D) : GMap2 (D × Bool) :=
  sorry

/-- BelyiMaps' finite objects are the orientable boundaryless case: a permutation triple is a
hypermap on `Fin n` in the convention `σinf * σ1 * σ0 = 1`. -/
noncomputable def Hypermap.toPermutationTriple {D : Type u} [Fintype D] [DecidableEq D] {n : ℕ}
    (H : Hypermap D) (e : D ≃ Fin n) : TauCeti.PermutationTriple n :=
  sorry

/-- The converse conversion. -/
noncomputable def PermutationTriple.toHypermap {n : ℕ} (t : TauCeti.PermutationTriple n) :
    Hypermap (Fin n) :=
  sorry

/-- A bipartite ribbon graph is an oriented map whose white vertices all have degree two: the
edges of the ribbon graph are the darts, the black rotation is `σ`, and the white rotation is
the edge involution. -/
noncomputable def CombinatorialMap.toBipartiteRibbonGraph {D : Type u} [Fintype D]
    [DecidableEq D] (M : CombinatorialMap D) : TauCeti.BipartiteRibbonGraph.{u} :=
  sorry

/-- The converse, under the degree-two hypothesis. -/
noncomputable def BipartiteRibbonGraph.toCombinatorialMap (Γ : TauCeti.BipartiteRibbonGraph.{u})
    (h : ∀ w, Γ.whiteDegree w = 2) : CombinatorialMap Γ.E :=
  sorry

/-- The Euler characteristics agree along the conversion. -/
example (Γ : TauCeti.BipartiteRibbonGraph.{u}) (h : ∀ w, Γ.whiteDegree w = 2) :
    (BipartiteRibbonGraph.toCombinatorialMap Γ h).toGMap2.eulerChar = Γ.eulerChar := by
  sorry

/-- Polygonal schemas are bundled because relabelling and cancellation change the label
type. A label occurring twice is glued and a label occurring once is a boundary edge; the
remaining surface validity is a separate predicate, not hidden in an unconstrained field. -/
structure PolygonalSchema where
  label : Type u
  fintypeLabel : Fintype label
  decEqLabel : DecidableEq label
  faces : List (CyclicWord (label × Bool))

/-- The generalized map of a schema: two darts per side, `α₀` along a side, `α₁` around a
corner of the face, `α₂` the gluing of the two occurrences of a label, and `α₂`-fixed darts on
the sides whose label occurs once. -/
noncomputable def PolygonalSchema.toGMap2 (S : PolygonalSchema.{u}) : BundledGMap2.{u} :=
  sorry

/-- The schema of a surface map, given an orientation of each edge: the labels are the edges,
each face contributes its traversal word, with a sign recording whether the traversal agrees
with the edge's orientation, and boundary edges occur once. -/
noncomputable def GMap2.toSchema {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D)
    (h : IsSurfaceGMap G) (o : ∀ e : G.Cell 1, G.EdgeOrientation e) : PolygonalSchema.{u} :=
  sorry

/-!
The comparison theorems are central targets; most wait on the realization and subdivision
APIs. Representative forms:

  -- 1. The flag complex of `K.toGMap2` is the barycentric subdivision of `K`; no subdivision
  --    of `K` is needed, since a flag of a simplicial complex is determined by its cells.
  theorem flagComplex_toGMap2 (hK : IsCombinatorialSurface K) :
      K.toGMap2.flagComplex ≅ K.barycentricSubdivision
  -- 2. The realization of a generalized map is the realization of the flag complex of its
  --    barycentric subdivision (layer 3).
  theorem realization_homeomorph_flagComplex ...
  -- 3. Oriented maps round-trip through the hub, with a chosen orientation.
  theorem toGMap2_toCombinatorialMap ...
  -- 4. Duality is an involution.
  theorem dual_dual ...
  -- 5. Schemas and surface maps round-trip up to relabelling.
  theorem toSchema_toGMap2 ... and theorem toGMap2_toSchema ...
  -- 6. The BelyiMaps comparisons preserve Euler characteristic and connectedness; the
  --    permutation-triple Euler characteristic is on Tau Ceti main
  --    (`Combinatorics/PermutationTriple/EulerCharacteristic.lean`).
  theorem PermutationTriple.eulerChar_toHypermap (t) : t.toHypermap.toGMap2.eulerChar = t.eulerChar

The implementation should exhibit two non-isomorphic surface maps with the same incidence
poset of cells (Damiand–Lienhardt, Fig. 2.29): the poset forgets which of a face's several
incidences to an edge is which, which is why the hub is darts and not a poset.
-/

/-! ## Layer 3: realization -/

/-- Direct topological realization of a generalized map as triangles modulo side gluings.
It is defined for every generalized map, before any surface condition, and not through an
abstract simplicial complex. -/
noncomputable def GMap2.realization {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : Type u :=
  sorry

/-- The quotient realization carries its quotient topology. -/
noncomputable instance GMap2.realizationTopologicalSpace
    {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    TopologicalSpace G.realization :=
  sorry

/-- The direct realization of a finite generalized map is compact. -/
instance GMap2.realizationCompactSpace
    {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    CompactSpace G.realization :=
  sorry

/-- And Hausdorff. -/
instance GMap2.realizationT2Space
    {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    T2Space G.realization :=
  sorry

/-- Every 2-generalized map realizes to a surface with boundary: the structure itself, in
`PlanarTopology`'s half-space family, not an existence statement. -/
@[instance_reducible] noncomputable def GMap2.realizationChartedSpace
    {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    ChartedSpace (EuclideanHalfSpace 2) G.realization :=
  sorry

/-- The realization of a bundled map, with its topology. -/
noncomputable def BundledGMap2.realization (B : BundledGMap2.{u}) : Type u :=
  @GMap2.realization B.D B.fintypeD B.decEqD B.map

noncomputable instance (B : BundledGMap2.{u}) : TopologicalSpace B.realization :=
  @GMap2.realizationTopologicalSpace B.D B.fintypeD B.decEqD B.map

/-- Every compact surface arises, by Radó. -/
example (M : Type*) [TopologicalSpace M] [ChartedSpace (EuclideanHalfSpace 2) M] [T2Space M]
    [CompactSpace M] :
    ∃ (D : Type) (_ : Fintype D) (_ : DecidableEq D) (G : GMap2 D),
      IsSurfaceGMap G ∧ Nonempty (G.realization ≃ₜ M) := by
  sorry

