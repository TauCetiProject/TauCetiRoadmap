/-! ## Layer 4: operations on finite surfaces -/

/-- Edge subdivision changes the dart type, hence returns a bundled map. -/
noncomputable def GMap2.subdivideEdge {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) (e : G.Cell 1) : BundledGMap2 :=
  sorry

/-- Face subdivision likewise changes the dart type. -/
