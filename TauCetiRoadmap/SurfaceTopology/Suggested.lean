/-! ## Layer 8: classification of compact surfaces -/

/-- The standard connected compact surfaces, including boundary. -/
inductive StandardSurface where
  | orientable (g : ℕ) (b : ℕ)
  | nonorientable (k : ℕ) (hk : 0 < k) (b : ℕ)

/-- The canonical schema of a standard surface, from layer 6. -/
noncomputable def StandardSurface.schema : StandardSurface → PolygonalSchema.{0}
  | .orientable g b => normalFormOrientable g b
  | .nonorientable k hk b => normalFormNonorientable k hk b

/-- The model of a standard surface is the realization of its canonical schema: a compact
connected surface with `b` boundary circles, fixed by the construction and not by the
classification theorem. -/
noncomputable def StandardSurface.model (S : StandardSurface) : Type :=
  S.schema.toGMap2.realization

noncomputable instance (S : StandardSurface) : TopologicalSpace S.model :=
  inferInstanceAs (TopologicalSpace S.schema.toGMap2.realization)

/-- Euler characteristic of the standard model. -/
def StandardSurface.eulerChar : StandardSurface → ℤ
  | .orientable g b => 2 - 2 * (g : ℤ) - (b : ℤ)
  | .nonorientable k _ b => 2 - (k : ℤ) - (b : ℤ)

/-- The concrete models by name. -/
abbrev Sphere2 : Type := (StandardSurface.orientable 0 0).model
abbrev Torus : Type := (StandardSurface.orientable 1 0).model
abbrev Disc : Type := (StandardSurface.orientable 0 1).model
abbrev Annulus : Type := (StandardSurface.orientable 0 2).model

/-- The named models are Mathlib's spaces. -/
example : Nonempty (Sphere2 ≃ₜ Metric.sphere (0 : EuclideanSpace ℝ (Fin 3)) 1) := by
  sorry

example : Nonempty (Disc ≃ₜ Metric.closedBall (0 : ℂ) 1) := by
  sorry

example : Nonempty (Torus ≃ₜ Circle × Circle) := by
  sorry

example : Nonempty (Annulus ≃ₜ Circle × Set.Icc (0 : ℝ) 1) := by
  sorry

section Classification

variable {M : Type*} [TopologicalSpace M] [ChartedSpace (EuclideanHalfSpace 2) M] [T2Space M]
  [CompactSpace M] [ConnectedSpace M]

/-- Existence. -/
example : ∃ S : StandardSurface, Nonempty (M ≃ₜ S.model) := by
  sorry

/-- Uniqueness. -/
example {S T : StandardSurface} (h : Nonempty (S.model ≃ₜ T.model)) : S = T := by
  sorry

/-- The library statement, in `∃!` form; a quotient-and-representative form is a bridge to
[lean-eval](https://github.com/leanprover/lean-eval) if it appears at all. -/
example : ∃! S : StandardSurface, Nonempty (M ≃ₜ S.model) := by
  sorry

end Classification

