/-! ## Layer 6: polygonal schemas and normal forms -/

/-- The canonical orientable schema `a₁ b₁ a₁⁻¹ b₁⁻¹ ⋯ a_g b_g a_g⁻¹ b_g⁻¹ c₁ h₁ c₁⁻¹ ⋯ c_b h_b c_b⁻¹`,
a single face with one hole block per boundary component; for `g = 0` and `b = 0` the sphere
is `a a⁻¹`, since a schema without letters has no darts. -/
noncomputable def normalFormOrientable (g b : ℕ) : PolygonalSchema :=
  sorry

/-- The canonical nonorientable schema `a₁ a₁ ⋯ a_k a_k c₁ h₁ c₁⁻¹ ⋯ c_b h_b c_b⁻¹`. -/
noncomputable def normalFormNonorientable (k : ℕ) (hk : 0 < k) (b : ℕ) : PolygonalSchema :=
  sorry

/-!
Once `PolygonalSchema.IsSurface`, `PolygonalSchema.IsConnected`, relabelling, and the
isomorphism closure are concrete, compile the elementary moves and the headline targets:

  -- `cancel` removes an adjacent pair `a a⁻¹` from a face of more than two letters; `cut`
  -- splits a face along a new label; `paste` glues two faces along a label occurring once in
  -- each; `relabel` renames or inverts a label. Boundary labels are never cancelled, cut
  -- through, or pasted along.
  inductive ElementarySchemaMove : PolygonalSchema → PolygonalSchema → Prop
  def SchemaMove := isoClosure ElementarySchemaMove
  def IsNormalForm (N : PolygonalSchema) : Prop

  -- One theorem, with or without boundary, following Gallier–Xu; connectedness is a
  -- hypothesis, since a disconnected schema reduces to several normal forms.
  theorem schema_reduces_to_normalForm (S : PolygonalSchema) (hS : S.IsSurface)
      (hc : S.IsConnected) : ∃ N, IsNormalForm N ∧ Relation.ReflTransGen SchemaMove S N

  theorem SchemaMove.realization_homeomorph (h : SchemaMove S T) :
      S.toGMap2.realization ≃ₜ T.toGMap2.realization
  theorem SchemaMove.boundaryComponentCount_eq (h : SchemaMove S T) :
      S.toGMap2.boundaryComponentCount = T.toGMap2.boundaryComponentCount
-/

/-! ## Layer 7: homology and the edge-path group of a surface map -/

/-- Three finite free modules and two matrices, from a choice of orientation of every cell. -/
structure GMap2.CellOrientations {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) where
  edge : ∀ e : G.Cell 1, G.EdgeOrientation e
  face : ∀ f : G.Cell 2, G.FaceOrientation f

/-- Cellular homology of a surface map, independent of the chosen orientations
(`homology_congr`). Traversing a face in its direction goes `d ↦ α₀ d` along `e(d)`, crossing
from the end of `d` to the end of `α₀ d`, and the sign is `+` when that matches the edge's
orientation; `∂₁ e = head − tail`. -/
noncomputable def GMap2.homology {D : Type u} [Fintype D] [DecidableEq D] {G : GMap2 D}
    (h : IsSurfaceGMap G) (c : G.CellOrientations) (R : Type v) [CommRing R] (i : ℕ) :
    ModuleCat.{v} R :=
  sorry

/-!
The rest of the layer waits on the realization of these modules and on a presented-group
API. Representative targets, all on `GMap2` since there is no separate cellulation type:

  theorem GMap2.d_comp_d (c : G.CellOrientations) : boundary₁ ∘ₗ boundary₂ = 0
  theorem GMap2.homology_congr (c c' : G.CellOrientations) : G.homology h c R i ≅ G.homology h c' R i
  theorem GMap2.eulerPoincare (F : Type*) [Field F] :
      G.eulerChar = ∑ i : Fin 3, (-1 : ℤ) ^ (i : ℕ) * Module.finrank F (G.homology h c F i)
  theorem GMap2.homology_two_iff_orientable ...

  def GMap2.edgePathGroup (h : IsSurfaceGMap G) (c : G.CellOrientations) : Type
  theorem GMap2.edgePathGroup_presentation ...
  theorem GMap2.abelianization_edgePathGroup :
      Abelianization (G.edgePathGroup h c) ≃* G.homology h c ℤ 1

  -- Invariance under the moves, hence under homeomorphism by `PlanarTopology`'s Pachner
  -- theorem; the action of a homeomorphism on `H₁`, the same for isotopic homeomorphisms,
  -- which layer 9 uses.
  theorem GMap2.homology_subdivideEdge ..., GMap2.homology_subdivideFace ..., GMap2.homology_flip ...
  theorem GMap2.homology_congr_homeomorph (e : G.realization ≃ₜ G'.realization) : ...
  def GMap2.homologyMap (e : G.realization ≃ₜ G'.realization) :
      G.homology h c ℤ 1 →ₗ[ℤ] G'.homology h' c' ℤ 1

  -- The normal forms, by the PID structure theorem for the rectangular boundary matrices,
