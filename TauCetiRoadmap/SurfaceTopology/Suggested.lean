import Mathlib
import TauCeti.Topology.Triangulable

/-!
# Surface topology, finite presentations, and classification: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is
`README.md`. These declarations suggest forms for selected objects and milestones;
discharging them finishes neither a layer nor the roadmap. Theorem proofs may use
`sorry`; definitions and data constructors below have actual bodies.

The proof programme is classical surface topology: finite triangles, polygon moves,
explicit V-E+F, orientability and boundary count. Classification does not use homology.
Finite homology is invariant through subdivision and equivalent triangulations.
The polygonal carrier, moves and normal forms are item-level inputs from
FreeGroupsAndLimitGroups §§6.0a–6.0d; generic simplex chains come through
GeometricTopology layer 11, with the separate cellular comparison in AlgebraicTopology.

This prototype gives the generalized-map realization directly by side gluing, rather
than through an abstract flag complex that may identify distinct incidences. The
compact-surface realization theorem and the five-colour drawing theorem are statable.
Other README headlines need vocabulary not implemented at this library pin:

* Heffter–Edmonds–Ringel needs the shared graph-walk adapters, rotation-system
  equivalences and bundled cellular drawings, including their surface identifications.
* Topological normal forms and compact-surface classification need the shared
  SurfaceModel carrier, its moves and canonical models, and the realization adapters.
  No canonical model is represented here by an admitted constructor.
* Finite homology and the mapping-class action need the shared simplex chains and
  the cell-orientation/subdivision comparisons specified in layer 7.
* Dehn–Lickorish needs interior curves/proper arcs, relative isotopies, the actual
  standard models and mapping-class groups. Its positive twist is ([θ],t)↦([θ+t],t),
  giving [[1,1],[0,1]] on a positive ordered torus basis with a·b=+1.
* The combinatorial planarity headlines need plane maps and minors. The available
  drawing formulation of five-colour is stated below without those stand-ins.
* Riemann–Hurwitz needs PlanarTopology's topological Surface.eulerChar; its local
  power-model and positive weighted-fibre-degree targets are concrete below.

The README retains the full APIs, examples and proof routes for these targets.
-/

noncomputable section
namespace TauCetiRoadmap.SurfaceTopology
open Function Set
universe u v w

/-! ## Generalized maps and finite invariants -/

/-- An `n`-dimensional generalized map: `n+1` involutions, with non-neighbouring
involutions commuting. This definition is dimension-polymorphic even though the roadmap
only develops the two-dimensional theory. -/
structure GMap (n : ℕ) (D : Type u) [Fintype D] [DecidableEq D] where
  adj : Fin (n + 1) → Equiv.Perm D
  involutive : ∀ i, Function.Involutive (adj i)
  commute_of_far : ∀ i j, i.1 + 2 ≤ j.1 → Function.Commute (adj i) (adj j)

abbrev GMap2 (D : Type u) [Fintype D] [DecidableEq D] := GMap 2 D

/-- The `i`-cells are the orbits of the group generated by all adjacencies except `αᵢ`. -/
def GMap.Cell {n : ℕ} {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap n D) (i : Fin (n + 1)) : Type u :=
  MulAction.orbitRel.Quotient (Subgroup.closure {σ | ∃ j, j ≠ i ∧ σ = G.adj j}) D

/-- Cells of a finite generalized map are finite orbit quotients. -/
instance GMap.instFiniteCell {n : ℕ} {D : Type u}
    [Fintype D] [DecidableEq D] (G : GMap n D) (i : Fin (n + 1)) :
    Finite (G.Cell i) :=
  inferInstanceAs (Finite (Quotient _))

/-- The connected components: the orbits of the group generated by all the adjacencies. -/
def GMap.Components {n : ℕ} {D : Type u} [Fintype D] [DecidableEq D] (G : GMap n D) : Type u :=
  MulAction.orbitRel.Quotient (Subgroup.closure (Set.range G.adj)) D

/-- Isomorphism of two-dimensional generalized maps, allowing the dart type to change. -/
structure GMap2.Iso {D : Type u} {D' : Type v}
    [Fintype D] [DecidableEq D] [Fintype D'] [DecidableEq D']
    (G : GMap2 D) (G' : GMap2 D') where
  toEquiv : D ≃ D'
  map_adj : ∀ i d, toEquiv (G.adj i d) = G'.adj i (toEquiv d)

/-- Euler characteristic as the cell count. Under the surface condition below this is the
Euler characteristic of the realization; Damiand–Lienhardt's Definition 91, the alternating
sum over all orbit types, is the Euler characteristic of the flag triangulation and is always
correct, but it is the cell count that every later layer wants. -/
def GMap2.eulerChar {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : ℤ :=
  (Nat.card (G.Cell 0) : ℤ) - Nat.card (G.Cell 1) + Nat.card (G.Cell 2)

/-- A boundary dart is a fixed point of the highest-order involution. -/
def GMap2.IsBoundaryDart {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) (d : D) : Prop :=
  G.adj 2 d = d

instance {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    DecidablePred G.IsBoundaryDart :=
  fun d => inferInstanceAs (Decidable (G.adj 2 d = d))

/-- The surface condition. No dart is fixed by `α₀` or `α₁`, so the boundary is recorded by
`α₂` alone, and no edge is folded onto itself, `α₂ d ≠ α₀ d`, so every orbit cell is a cell of
the realization. These are Damiand–Lienhardt's "no 0- or 1-boundary" and "no folded cell"
(§4.3.4.2, pp. 106–107; §8.3.2.1, p. 331). Every generalized map realizes to a surface without
any hypothesis (§2.4); the condition is the price of `eulerChar` being the Euler characteristic. -/
def IsSurfaceGMap {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  (∀ d, G.adj 0 d ≠ d) ∧ (∀ d, G.adj 1 d ≠ d) ∧ (∀ d, G.adj 2 d ≠ G.adj 0 d)

instance {D : Type u} [Fintype D] [DecidableEq D] : DecidablePred (IsSurfaceGMap (D := D)) :=
  fun G => by unfold IsSurfaceGMap; infer_instance

/-- A closed surface map: no boundary darts either. -/
def IsClosedSurfaceGMap {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  IsSurfaceGMap G ∧ ∀ d, G.adj 2 d ≠ d

instance {D : Type u} [Fintype D] [DecidableEq D] :
    DecidablePred (IsClosedSurfaceGMap (D := D)) :=
  fun G => by unfold IsClosedSurfaceGMap; infer_instance

/-- The map on two darts with all three involutions the swap: one edge folded onto itself by a
half-turn about its midpoint. Its realization is a sphere, since the flag triangulation has
three vertices, three edges, and two triangles, but the cell count is `1 - 1 + 1 = 1`. This
is the folded cell the third condition excludes. -/
def allSwap : GMap2 Bool where
  adj _ := Equiv.swap true false
  involutive _ := Equiv.swap_apply_self true false
  commute_of_far _ _ _ := Function.Commute.refl _

example : ¬ IsSurfaceGMap allSwap := fun h => h.2.2 true rfl

/-- The projective plane as the one-face schema `a a`: four darts, `α₀ = (0 1)(2 3)`,
`α₁ = (1 2)(3 0)`, `α₂ = (0 2)(1 3)`. One vertex, one edge, one face, and the surface condition
holds, so this one-cell presentation is admitted, as it must be. -/
def projectivePlane : GMap2 (Fin 4) where
  adj := ![Equiv.swap 0 1 * Equiv.swap 2 3, Equiv.swap 1 2 * Equiv.swap 3 0,
    Equiv.swap 0 2 * Equiv.swap 1 3]
  involutive := by
    intro i
    fin_cases i <;> (intro x; fin_cases x <;> decide)
  commute_of_far := by
    intro i j hij x
    fin_cases i <;> fin_cases j <;> fin_cases x <;> decide

example : IsSurfaceGMap projectivePlane := by decide

example : IsClosedSurfaceGMap projectivePlane := by decide

/-- Orientability as bipartiteness of the dart-adjacency graph, ignoring fixed
adjacencies representing boundary. -/
def GMap2.IsOrientable {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Prop :=
  ∃ S : Set D, ∀ i d, G.adj i d ≠ d → (d ∈ S ↔ G.adj i d ∉ S)

/-- A chosen orientation is extra data; `IsOrientable` is only the existence property. -/
structure GMap2.Orientation {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) where
  side : Set D
  flips : ∀ i d, G.adj i d ≠ d → (d ∈ side ↔ G.adj i d ∉ side)

/-- A generalized map with its finite dart type bundled. This is the codomain of moves
which change the number or type of darts. -/
structure BundledGMap2 where
  D : Type u
  fintypeD : Fintype D
  decEqD : DecidableEq D
  map : @GMap 2 D fintypeD decEqD


/-! ## Direct quotient realization -/

/-- One closed barycentric triangle for each dart, with the coproduct topology. -/
abbrev GMap2.Chamber (D : Type u) := Σ _ : D, Convexity.StdSimplex ℝ (Fin 3)

/-- The side opposite vertex i is glued to the same side in the adjacent chamber.
A fixed adjacency leaves that side unglued. -/
def GMap2.gluingStep {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D)
    (a b : GMap2.Chamber D) : Prop :=
  ∃ i : Fin 3, a.2.weights i = 0 ∧ b = ⟨G.adj i a.1, a.2⟩

def GMap2.gluingSetoid {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) :
    Setoid (GMap2.Chamber D) :=
  Relation.EqvGen.setoid G.gluingStep

/-- Realization retains separate chambers and identifies only the prescribed sides. -/
def GMap2.realization {D : Type u} [Fintype D] [DecidableEq D] (G : GMap2 D) : Type u :=
  Quotient G.gluingSetoid

instance GMap2.realizationTopologicalSpace {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : TopologicalSpace G.realization :=
  inferInstanceAs (TopologicalSpace (Quotient G.gluingSetoid))

instance GMap2.realizationCompactSpace {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : CompactSpace G.realization :=
  inferInstanceAs (CompactSpace (Quotient G.gluingSetoid))

/-- Hausdorffness is a proof target about the actual quotient, not an admitted topology. -/
instance GMap2.realizationT2Space {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : T2Space G.realization := by
  sorry

/-- All finite 2-generalized maps realize to surfaces with boundary. -/
theorem GMap2.exists_realizationChartedSpace {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : Nonempty (ChartedSpace (EuclideanHalfSpace 2) G.realization) := by
  sorry

/-- Every compact Hausdorff surface has a finite generalized-map presentation. -/
theorem exists_gmap_of_compactSurface (M : Type*) [TopologicalSpace M]
    [ChartedSpace (EuclideanHalfSpace 2) M] [T2Space M] [CompactSpace M] :
    ∃ (D : Type) (_ : Fintype D) (_ : DecidableEq D) (G : GMap2 D),
      IsSurfaceGMap G ∧ Nonempty (G.realization ≃ₜ M) := by
  sorry

/-! ## Drawings and the five-colour theorem -/

/-- The range of a path that is injective except that the two endpoints of a loop coincide:
the shape of Mathlib's draft `IsPrimitiveLink` (mathlib4 #43687). -/
def IsPrimitiveLink {M : Type*} [TopologicalSpace M] (A : Set M) (x y : M) : Prop :=
  ∃ γ : Path x y, Set.range γ = A ∧
    ∀ s t, γ s = γ t → s = t ∨ ({s, t} : Set unitInterval) = {0, 1}

/-- A drawing of a multigraph in a space, in the shape of Mathlib's draft `Drawing`: an
injective placement of the vertices and, for each edge, an arc between the placements of its
ends, with vertices lying only on their own edges. -/
structure Drawing {α β : Type*} (Γ : Graph α β) (M : Type*) [TopologicalSpace M] where
  vertex : Γ.vertexSet ↪ M
  edgeRange : Γ.edgeSet → Set M
  edge_isPrimitiveLink : ∀ (e : Γ.edgeSet) (u v : Γ.vertexSet), Γ.IsLink e.1 u.1 v.1 →
    IsPrimitiveLink (edgeRange e) (vertex u) (vertex v)
  inc_of_vertex_mem : ∀ (e : Γ.edgeSet) (v : Γ.vertexSet), vertex v ∈ edgeRange e → Γ.Inc e.1 v.1

namespace Drawing

variable {α β : Type*} {Γ : Graph α β} {M : Type*} [TopologicalSpace M]

/-- Noncrossing: distinct edge interiors are disjoint. -/
def IsNoncrossing (D : Drawing Γ M) : Prop :=
  Pairwise fun e e' =>
    Disjoint (D.edgeRange e \ Set.range D.vertex) (D.edgeRange e' \ Set.range D.vertex)

/-- The support: the vertex placements and the edge arcs. -/
def support (D : Drawing Γ M) : Set M :=
  Set.range D.vertex ∪ ⋃ e, D.edgeRange e

/-- Cellular: every component of the complement of the support is an open disc. -/
def IsCellular (D : Drawing Γ M) : Prop :=
  ∀ x ∉ D.support, Nonempty (connectedComponentIn D.supportᶜ x ≃ₜ Metric.ball (0 : ℂ) 1)

end Drawing

/-- Five Colour Theorem in the drawing formulation of planarity. Connectivity and
cellularity are not hypotheses; the empty graph is included. -/
theorem colorable_five_of_noncrossing_drawing {V : Type*} [Finite V]
    (G : SimpleGraph V) (D : Drawing (Graph.ofSimpleGraph G) ℂ)
    (hD : D.IsNoncrossing) : G.Colorable 5 := by
  sorry

/-! ## Finite branched covers and their degree -/

section BranchedCovers

open scoped Manifold

variable {X Y : Type*} [TopologicalSpace X] [ChartedSpace (EuclideanHalfSpace 2) X]
  [TopologicalSpace Y] [ChartedSpace (EuclideanHalfSpace 2) Y]

/-- A positive local power model in interior disc charts. The source and target
conditions make the coordinate identity an identity of actual local maps. -/
def HasPowerMapModelAt (p : X → Y) (x : X) (n : ℕ) : Prop :=
  0 < n ∧ ∃ (φ : OpenPartialHomeomorph X ℂ) (ψ : OpenPartialHomeomorph Y ℂ),
    x ∈ φ.source ∧ p x ∈ ψ.source ∧ φ x = 0 ∧ ψ (p x) = 0 ∧
    φ.source ⊆ (𝓡∂ 2).interior X ∧ ψ.source ⊆ (𝓡∂ 2).interior Y ∧
    φ.target = Metric.ball (0 : ℂ) 1 ∧ ψ.target = Metric.ball (0 : ℂ) 1 ∧
    Set.MapsTo p φ.source ψ.source ∧ ∀ z ∈ φ.source, ψ (p z) = φ z ^ n

/-- Finite topological branched covers with interior branch values and an unramified
boundary. The local exponents are constrained by the actual coordinate maps. -/
structure IsBranchedCover (p : X → Y) (B : Finset Y) (e : X → ℕ) : Prop where
  continuous : Continuous p
  surjective : Function.Surjective p
  finite_fibers : ∀ y, (p ⁻¹' {y}).Finite
  branch_values_interior : (B : Set Y) ⊆ (𝓡∂ 2).interior Y
  preimage_boundary : p ⁻¹' (𝓡∂ 2).boundary Y = (𝓡∂ 2).boundary X
  covering_off_branch : IsCoveringMap (((B : Set Y)ᶜ).restrictPreimage p)
  local_degree_pos : ∀ x, 0 < e x
  local_degree_one_off_branch : ∀ x, p x ∉ B → e x = 1
  local_power : ∀ x ∈ (𝓡∂ 2).interior X, HasPowerMapModelAt p x (e x)
  boundary_unramified : IsLocalHomeomorphOn p ((𝓡∂ 2).boundary X)
  local_degree_one_boundary : ∀ x ∈ (𝓡∂ 2).boundary X, e x = 1

/-- The correction term in Riemann–Hurwitz is an actual finite sum. -/
theorem IsBranchedCover.finite_preimage_branch {p : X → Y} {B : Finset Y} {e : X → ℕ}
    (hp : IsBranchedCover p B e) : (p ⁻¹' (B : Set Y)).Finite := by
  have h : (⋃ y ∈ (B : Set Y), p ⁻¹' {y}).Finite :=
    B.finite_toSet.biUnion fun y _ => hp.finite_fibers y
  convert h using 1
  ext x
  simp

/-- The local exponent is intrinsic to the topological map, independent of the chosen
charts and of extra unramified values in the marked finite set. -/
theorem IsBranchedCover.local_degree_unique [T2Space X] [T2Space Y]
    {p : X → Y} {B B' : Finset Y} {e e' : X → ℕ}
    (hp : IsBranchedCover p B e) (hp' : IsBranchedCover p B' e') : e = e' := by
  sorry

/-- On compact connected surfaces the weighted fibre count is one positive degree,
including over branch values and boundary points. -/
theorem IsBranchedCover.exists_degree [T2Space X] [T2Space Y]
    [CompactSpace X] [CompactSpace Y] [ConnectedSpace X] [ConnectedSpace Y]
    {p : X → Y} {B : Finset Y} {e : X → ℕ} (hp : IsBranchedCover p B e) :
    ∃ d : ℕ, 0 < d ∧ ∀ y, ∑ x ∈ (hp.finite_fibers y).toFinset, e x = d := by
  sorry

end BranchedCovers

end TauCetiRoadmap.SurfaceTopology
