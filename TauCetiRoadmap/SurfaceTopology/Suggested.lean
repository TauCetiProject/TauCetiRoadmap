/-! ## Layer 5: embedded graphs and the Heffter--Edmonds--Ringel correspondence -/

/-- The range of a path that is injective except that the two endpoints of a loop coincide:
the shape of Mathlib's draft `IsPrimitiveLink` (mathlib4 #43687). -/
def IsPrimitiveLink {M : Type*} [TopologicalSpace M] (A : Set M) (x y : M) : Prop :=
  ∃ γ : Path x y, Set.range γ = A ∧
    ∀ s t, γ s = γ t → s = t ∨ ({s, t} : Set unitInterval) = {0, 1}

/-- A drawing of a multigraph in a space, in the shape of Mathlib's draft `Drawing`: an
injective placement of the vertices and, for each edge, an arc between the placements of its
ends, with vertices lying only on their own edges. -/
structure Drawing {α β : Type*} (Γ : Graph α β) (M : Type*) [TopologicalSpace M] where
  vertex : Γ.vertexSet ↪ M
  edgeRange : Γ.edgeSet → Set M
  edge_isPrimitiveLink : ∀ (e : Γ.edgeSet) (u v : Γ.vertexSet), Γ.IsLink e.1 u.1 v.1 →
    IsPrimitiveLink (edgeRange e) (vertex u) (vertex v)
  inc_of_vertex_mem : ∀ (e : Γ.edgeSet) (v : Γ.vertexSet), vertex v ∈ edgeRange e → Γ.Inc e.1 v.1

namespace Drawing

variable {α β : Type*} {Γ : Graph α β} {M : Type*} [TopologicalSpace M]

/-- Noncrossing: distinct edge interiors are disjoint. -/
def IsNoncrossing (D : Drawing Γ M) : Prop :=
  Pairwise fun e e' =>
    Disjoint (D.edgeRange e \ Set.range D.vertex) (D.edgeRange e' \ Set.range D.vertex)

/-- The support: the vertex placements and the edge arcs. -/
def support (D : Drawing Γ M) : Set M :=
  Set.range D.vertex ∪ ⋃ e, D.edgeRange e

/-- Cellular: every component of the complement of the support is an open disc. -/
def IsCellular (D : Drawing Γ M) : Prop :=
  ∀ x ∉ D.support, Nonempty (connectedComponentIn D.supportᶜ x ≃ₜ Metric.ball (0 : ℂ) 1)

end Drawing

/-- The underlying multigraph of a surface map: vertices and edges are the cells. -/
noncomputable def GMap2.underlyingGraph {D : Type u} [Fintype D] [DecidableEq D]
    (G : GMap2 D) : Graph (G.Cell 0) (G.Cell 1) :=
  sorry

/-- Rotation systems of a finite multigraph: a cyclic order of the darts at each vertex. -/
def RotationSystem {α β : Type u} (Γ : Graph α β) : Type u :=
  sorry

/-- Signed rotation systems (embedding schemes), for the general-surface form. -/
def SignedRotationSystem {α β : Type u} (Γ : Graph α β) : Type u :=
  sorry

/-!
Connectivity and degree of `Graph α β` are targets shaped after the open Mathlib pull
requests (connected graphs as self-components, degree by incidence counting); the PL subclass
of drawings needs `PlanarTopology`'s triangulations; and the correspondence needs the
equivalence of drawings. Once these are pinned:

  def Graph.IsConnected (Γ : Graph α β) : Prop
