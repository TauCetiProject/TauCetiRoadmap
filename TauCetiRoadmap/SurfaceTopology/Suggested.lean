  theorem GMap2.dual_realization (h : IsClosedSurfaceGMap G) : G.dual.realization ≃ₜ G.realization
  theorem GMap2.orientationDoubleCover_isCovering : IsCoveringMap G.orientationDoubleCover.projection
  theorem GMap2.cap_eulerChar : G.cap.eulerChar = G.eulerChar + G.boundaryComponentCount
  theorem GMap2.double_eulerChar : G.double.eulerChar = 2 * G.eulerChar
