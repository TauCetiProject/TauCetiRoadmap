import Mathlib

/-!
# Linear multistep methods: target signatures

This file is not the roadmap: the roadmap is `README.md`. It states the roadmap's headline
theorems against the pinned Mathlib APIs, each with `sorry`, together with the definitions they
need; every definition has a real body. Every headline theorem of the README is statable at the
pins and is stated here. The README's remaining targets, API lists and Checks are not restated.
The instability of the backward differentiation formulas for every `k ≥ 7` (Cryer's theorem) is
statable but is not a target of the roadmap; the README attributes it in prose.

The objects of the one-step theory (the field `f : ℝ → E → E` with time first, solutions as
`IsIntegralCurveOn`, Lipschitz continuity in the state as `∀ t, LipschitzWith L (f t)`) follow
the conventions of the roadmap OneStepMethodsForODEs; none of its definitions is needed here.
-/

noncomputable section

open Filter Topology Set Polynomial
open scoped NNReal ContDiff

namespace TauCetiRoadmap.LinearMultistepMethods

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-! ## Layer 1: methods, consistency and order -/

/-- 1.1: a linear `k`-step method, given by its coefficients `α j` and `β j`, `j = 0, …, k`. It
acts by `∑ j, α j • Y (n + j) = h • ∑ j, β j • f (t (n + j)) (Y (n + j))`. -/
structure LinearMultistepMethod (k : ℕ) where
  /-- The coefficients of the values. -/
  α : Fin (k + 1) → ℝ
  /-- The coefficients of the field values. -/
  β : Fin (k + 1) → ℝ

namespace LinearMultistepMethod

variable {k : ℕ} (m : LinearMultistepMethod k)

/-- 1.1: the first characteristic polynomial `ρ(ζ) = ∑ j, α j ζ ^ j`. -/
def rho : ℝ[X] := ∑ j : Fin (k + 1), C (m.α j) * X ^ (j : ℕ)

/-- 1.1: the second characteristic polynomial `σ(ζ) = ∑ j, β j ζ ^ j`. -/
def sigma : ℝ[X] := ∑ j : Fin (k + 1), C (m.β j) * X ^ (j : ℕ)

/-- 1.1: the method is explicit when `β k = 0`. -/
def IsExplicit : Prop := m.β (Fin.last k) = 0

/-- 1.1: the residual of a sequence `Y` at index `n` on the uniform mesh `t₀ + n h`. A sequence
is generated by the method on the indices `n` with `n + k ≤ N` when its residual vanishes there. -/
def residual (f : ℝ → E → E) (t₀ h : ℝ) (Y : ℕ → E) (n : ℕ) : E :=
  ∑ j : Fin (k + 1), m.α j • Y (n + j) -
    h • ∑ j : Fin (k + 1), m.β j • f (t₀ + ((n + j : ℕ) : ℝ) * h) (Y (n + j))

/-- 1.2: the defect of a curve `y` at `t` with step `h`: the residual of the values of `y` on the
mesh `t + j h`. -/
def defect (f : ℝ → E → E) (y : ℝ → E) (t h : ℝ) : E :=
  ∑ j : Fin (k + 1), m.α j • y (t + (j : ℕ) * h) -
    h • ∑ j : Fin (k + 1), m.β j • f (t + (j : ℕ) * h) (y (t + (j : ℕ) * h))

/-- 1.2: the order conditions up to `p`: `∑ j, α j j ^ q = q ∑ j, β j j ^ (q - 1)` for
`q = 0, …, p`, that is, the method is exact on the polynomials of degree at most `p`. -/
def OrderConditions (p : ℕ) : Prop :=
  ∀ q ≤ p, ∑ j : Fin (k + 1), m.α j * ((j : ℕ) : ℝ) ^ q =
    q * ∑ j : Fin (k + 1), m.β j * ((j : ℕ) : ℝ) ^ (q - 1)

/-- 1.2: consistency, `ρ(1) = 0` and `ρ'(1) = σ(1)`. -/
def IsConsistent : Prop :=
  m.rho.eval 1 = 0 ∧ (derivative m.rho).eval 1 = m.sigma.eval 1

/-- 1.3: order at least `p`: along every smooth real function `y` the defect of the method for
the field `y'` is `O(h ^ (p + 1))` on every bounded interval. -/
def HasOrder (p : ℕ) : Prop :=
  ∀ y : ℝ → ℝ, ContDiff ℝ ∞ y → ∀ a b : ℝ, ∃ C : ℝ, ∀ t h : ℝ, a ≤ t → 0 ≤ h →
    t + k * h ≤ b →
      |∑ j : Fin (k + 1), m.α j * y (t + (j : ℕ) * h) -
          h * ∑ j : Fin (k + 1), m.β j * deriv y (t + (j : ℕ) * h)| ≤ C * h ^ (p + 1)

/-- 1.2: the defect bound. If the order conditions hold up to `p`, the curve `y` solves
`y' = f(t, y)` and is `C^(p+1)` on `[t, t + k h]` with `(p+1)`-st derivative bounded by `M`, then
the defect is at most `M h ^ (p + 1) ∑ j, (|α j| j ^ (p+1) / (p+1)! + |β j| j ^ p / p!)`. -/
theorem norm_defect_le {f : ℝ → E → E} {y : ℝ → E} {t h M : ℝ} {p : ℕ} (hk : 0 < k)
    (hh : 0 ≤ h) (hord : m.OrderConditions p)
    (hy : IsIntegralCurveOn y f (Icc t (t + k * h)))
    (hC : ContDiffOn ℝ (p + 1) y (Icc t (t + k * h)))
    (hM : ∀ s ∈ Icc t (t + k * h), ‖iteratedDerivWithin (p + 1) y (Icc t (t + k * h)) s‖ ≤ M) :
    ‖m.defect f y t h‖ ≤
      M * h ^ (p + 1) * ∑ j : Fin (k + 1),
        (|m.α j| * ((j : ℕ) : ℝ) ^ (p + 1) / (p + 1).factorial +
          |m.β j| * ((j : ℕ) : ℝ) ^ p / p.factorial) :=
  sorry

/-- 1.3: a method has order at least `p` if and only if the order conditions hold up to `p`. -/
theorem hasOrder_iff_orderConditions (p : ℕ) : m.HasOrder p ↔ m.OrderConditions p :=
  sorry

/-! ## Layer 2: zero-stability -/

/-- 2.1: the root condition: every complex root of `ρ` lies in the closed unit disc, and every
root on the unit circle is simple. -/
def RootCondition : Prop :=
  ∀ z : ℂ, (m.rho.map (algebraMap ℝ ℂ)).IsRoot z →
    ‖z‖ ≤ 1 ∧ (‖z‖ = 1 → (m.rho.map (algebraMap ℝ ℂ)).rootMultiplicity z = 1)

/-- 2.1: zero-stability: there is `K` such that every real solution of the recurrence
`∑ j, α j y (n + j) = 0` satisfies `|y n| ≤ K ∑ s < k, |y s|` for all `n`. -/
def IsZeroStable : Prop :=
  ∃ K : ℝ, ∀ y : ℕ → ℝ, (∀ n, ∑ j : Fin (k + 1), m.α j * y (n + j) = 0) →
    ∀ n, |y n| ≤ K * ∑ s ∈ Finset.range k, |y s|

/-- 2.1: the root condition is equivalent to zero-stability. -/
theorem rootCondition_iff_isZeroStable : m.RootCondition ↔ m.IsZeroStable :=
  sorry

/-- 2.2: discrete stability. If `K` is a zero-stability constant, `α k ≠ 0`, `f` is
`L`-Lipschitz in the state, `2 h L |β k| K ≤ |α k|`, and the residuals of `Y` and `Z` differ by at
most `Λ` for `n + k ≤ N`, then for `n ≤ N`, with `B = ∑ j, |β j|`,
`‖Y n - Z n‖ ≤ (2 K ∑ s < k, ‖Y s - Z s‖ + 2 K n Λ / |α k|) exp (2 K L B n h / |α k|)`. -/
theorem norm_sub_le_of_isZeroStable {f : ℝ → E → E} {L : ℝ≥0} {K t₀ h Λ : ℝ} {N : ℕ}
    {Y Z : ℕ → E} (hk : 0 < k) (hαk : m.α (Fin.last k) ≠ 0)
    (hK : ∀ y : ℕ → ℝ, (∀ n, ∑ j : Fin (k + 1), m.α j * y (n + j) = 0) →
      ∀ n, |y n| ≤ K * ∑ s ∈ Finset.range k, |y s|)
    (hf : ∀ t, LipschitzWith L (f t)) (hh : 0 ≤ h)
    (hsmall : 2 * h * L * |m.β (Fin.last k)| * K ≤ |m.α (Fin.last k)|) (hΛ : 0 ≤ Λ)
    (hres : ∀ n, n + k ≤ N → ‖m.residual f t₀ h Y n - m.residual f t₀ h Z n‖ ≤ Λ)
    {n : ℕ} (hn : n ≤ N) :
    ‖Y n - Z n‖ ≤
      (2 * K * ∑ s ∈ Finset.range k, ‖Y s - Z s‖ + 2 * K * n * Λ / |m.α (Fin.last k)|) *
        Real.exp (2 * K * L * (∑ j : Fin (k + 1), |m.β j|) * n * h / |m.α (Fin.last k)|) :=
  sorry

/-! ## Layer 3: convergence -/

/-- 3.1: convergence on `E`: for every jointly continuous field that is Lipschitz in the state,
every solution `y` on `[a, b]` and every `ε > 0` there is `δ > 0` such that every sequence
generated by the method on a mesh `a + n h` with `0 < h ≤ δ` and `a + N h ≤ b`, whose starting
values lie within `δ` of `y a`, stays within `ε` of `y` at every node up to `N`. -/
def IsConvergent (E : Type*) [NormedAddCommGroup E] [NormedSpace ℝ E] : Prop :=
  ∀ (f : ℝ → E → E) (L : ℝ≥0), Continuous (Function.uncurry f) → (∀ t, LipschitzWith L (f t)) →
    ∀ (y : ℝ → E) (a b : ℝ), IsIntegralCurveOn y f (Icc a b) →
      ∀ ε > 0, ∃ δ > 0, ∀ h : ℝ, 0 < h → h ≤ δ → ∀ N : ℕ, a + N * h ≤ b →
        ∀ Y : ℕ → E, (∀ s < k, ‖Y s - y a‖ ≤ δ) →
          (∀ n, n + k ≤ N → m.residual f a h Y n = 0) →
            ∀ n ≤ N, ‖Y n - y (a + n * h)‖ ≤ ε

/-- 3.1: Dahlquist's equivalence theorem: on a nonzero real normed space, a method with
`α k ≠ 0` is convergent if and only if it is consistent and satisfies the root condition. -/
theorem isConvergent_iff [Nontrivial E] (hαk : m.α (Fin.last k) ≠ 0) :
    m.IsConvergent E ↔ m.IsConsistent ∧ m.RootCondition :=
  sorry

/-- 3.2: the rate of convergence. For a method with `α k ≠ 0`, the root condition and the order
conditions up to `p` (which force `0 < k`), a field Lipschitz in the state and a `C^(p+1)`
solution on `[a, b]`, the error at the nodes is at most a constant times the starting error plus
`h ^ p`. -/
theorem exists_norm_sub_le_of_orderConditions {f : ℝ → E → E} {L : ℝ≥0} {y : ℝ → E}
    {a b : ℝ} {p : ℕ} (hαk : m.α (Fin.last k) ≠ 0) (hroot : m.RootCondition)
    (hord : m.OrderConditions p) (hf : ∀ t, LipschitzWith L (f t))
    (hy : IsIntegralCurveOn y f (Icc a b)) (hC : ContDiffOn ℝ (p + 1) y (Icc a b)) :
    ∃ h₀ > 0, ∃ C : ℝ, ∀ h : ℝ, 0 < h → h ≤ h₀ → ∀ N : ℕ, a + N * h ≤ b →
      ∀ Y : ℕ → E, (∀ n, n + k ≤ N → m.residual f a h Y n = 0) →
        ∀ n ≤ N, ‖Y n - y (a + n * h)‖ ≤
          C * (∑ s ∈ Finset.range k, ‖Y s - y (a + s * h)‖ + h ^ p) :=
  sorry

end LinearMultistepMethod

/-! ## Layer 4: the Adams and backward differentiation families -/

open LinearMultistepMethod

/-- 4.1: the `k`-step Adams–Bashforth method: `ρ = ζ ^ k - ζ ^ (k - 1)` and, for `j < k`,
`β j = ∫_(k-1)^k ℓ_j`, where `ℓ_j` is the Lagrange basis polynomial of the nodes `0, …, k - 1`;
`β k = 0`. Used for `k ≥ 1`. -/
def adamsBashforth (k : ℕ) : LinearMultistepMethod k where
  α j := if (j : ℕ) = k then 1 else if (j : ℕ) + 1 = k then -1 else 0
  β j := if (j : ℕ) < k then
      ∫ t in ((k : ℝ) - 1)..(k : ℝ),
        (Lagrange.basis (Finset.range k) (fun i : ℕ ↦ (i : ℝ)) (j : ℕ)).eval t
    else 0

/-- 4.1: the `k`-step Adams–Moulton method: `ρ = ζ ^ k - ζ ^ (k - 1)` and
`β j = ∫_(k-1)^k ℓ_j`, where `ℓ_j` is the Lagrange basis polynomial of the nodes `0, …, k`.
Used for `k ≥ 1`. -/
def adamsMoulton (k : ℕ) : LinearMultistepMethod k where
  α j := if (j : ℕ) = k then 1 else if (j : ℕ) + 1 = k then -1 else 0
  β j := ∫ t in ((k : ℝ) - 1)..(k : ℝ),
    (Lagrange.basis (Finset.range (k + 1)) (fun i : ℕ ↦ (i : ℝ)) (j : ℕ)).eval t

/-- 4.2: the `k`-step backward differentiation formula: `α j = ℓ_j'(k)`, where `ℓ_j` is the
Lagrange basis polynomial of the nodes `0, …, k`, and `σ = ζ ^ k`. Used for `k ≥ 1`. -/
def bdf (k : ℕ) : LinearMultistepMethod k where
  α j := (derivative (Lagrange.basis (Finset.range (k + 1)) (fun i : ℕ ↦ (i : ℝ)) (j : ℕ))).eval
    (k : ℝ)
  β j := if (j : ℕ) = k then 1 else 0

/-- 4.1: the `k`-step Adams–Bashforth method has order exactly `k`. -/
theorem adamsBashforth_orderConditions {k : ℕ} (hk : 0 < k) :
    (adamsBashforth k).OrderConditions k ∧ ¬ (adamsBashforth k).OrderConditions (k + 1) :=
  sorry

/-- 4.1: the `k`-step Adams–Moulton method has order exactly `k + 1`. -/
theorem adamsMoulton_orderConditions {k : ℕ} (hk : 0 < k) :
    (adamsMoulton k).OrderConditions (k + 1) ∧ ¬ (adamsMoulton k).OrderConditions (k + 2) :=
  sorry

/-- 4.2: the `k`-step backward differentiation formula has order exactly `k`. -/
theorem bdf_orderConditions {k : ℕ} (hk : 0 < k) :
    (bdf k).OrderConditions k ∧ ¬ (bdf k).OrderConditions (k + 1) :=
  sorry

/-- 4.2: the `k`-step backward differentiation formula satisfies the root condition for
`1 ≤ k ≤ 6`. -/
theorem bdf_rootCondition_of_le_six {k : ℕ} (hk : 0 < k) (hk6 : k ≤ 6) : (bdf k).RootCondition :=
  sorry

/-! ## Layer 5: the barriers and linear stability -/

namespace LinearMultistepMethod

variable {k : ℕ} (m : LinearMultistepMethod k)

/-- 5.2: the region of absolute stability: the `μ : ℂ` with `α k - μ β k ≠ 0` such that every
root of `ρ - μ σ` lies in the open unit disc. -/
def stabilityRegion : Set ℂ :=
  {μ | (m.α (Fin.last k) : ℂ) - μ * m.β (Fin.last k) ≠ 0 ∧
    ∀ z : ℂ, (m.rho.map (algebraMap ℝ ℂ) - C μ * m.sigma.map (algebraMap ℝ ℂ)).IsRoot z →
      ‖z‖ < 1}

/-- 5.2: A-stability: the open left half-plane lies in the region of absolute stability. -/
def IsAStable : Prop := {μ : ℂ | μ.re < 0} ⊆ m.stabilityRegion

/-- 5.1: Dahlquist's first barrier: a method with `α k ≠ 0` that satisfies the root condition
has order at most `k + 2`, and at most `k + 1` when `k` is odd. -/
theorem not_orderConditions_of_rootCondition (hαk : m.α (Fin.last k) ≠ 0)
    (hroot : m.RootCondition) :
    ¬ m.OrderConditions (k + 3) ∧ (Odd k → ¬ m.OrderConditions (k + 2)) :=
  sorry

/-- 5.2: no consistent explicit method is A-stable. -/
theorem not_isAStable_of_isExplicit (hexp : m.IsExplicit) (hcons : m.IsConsistent) :
    ¬ m.IsAStable :=
  sorry

/-- 5.2: Dahlquist's second barrier: an A-stable method with `α k ≠ 0` has order at most `2`. -/
theorem not_orderConditions_three_of_isAStable (hαk : m.α (Fin.last k) ≠ 0)
    (hA : m.IsAStable) : ¬ m.OrderConditions 3 :=
  sorry

end LinearMultistepMethod

/-- 5.3: the two-step backward differentiation formula is A-stable. -/
theorem isAStable_bdf_two : (bdf 2).IsAStable :=
  sorry

end TauCetiRoadmap.LinearMultistepMethods
