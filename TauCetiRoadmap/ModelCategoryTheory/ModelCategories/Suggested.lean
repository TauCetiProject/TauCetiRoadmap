module

public import Mathlib

/-!
# Lifting properties, presentable categories and combinatorial model categories: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's headline theorems
against the pinned Mathlib, with the few definitions their statements need. Model category
structures are Mathlib's `HomotopicalAlgebra.ModelCategory`; a theorem asserting that a model
structure exists says that some term `M : ModelCategory A` has the prescribed classes
(`HasClasses`), so that no second instance is placed on a Mathlib type.

Statements about a presentable category that build a model structure carry `HasFiniteLimits`
explicitly: completeness of presentable categories is a 1-categorical statement that this
roadmap does not restate.

Not statable at the pins:
* none of the headlines of the Summary. The README's results on homotopy pushout squares (§3.5),
  tensors and cotensors (§8.2), the path-object criterion (§6.4) and the chain filtration of a
  Reedy stage (§7.6) are statable but are not headlines, and are not stated here.
-/

public section

namespace TauCetiRoadmap.ModelCategoryTheory.ModelCategories

open CategoryTheory Limits HomotopicalAlgebra MorphismProperty

universe w v u v' u'

/-! ## Layer 1: compact objects, presentable categories and weak saturation -/

section Saturation

variable {C : Type u} [Category.{v} C]

/-- A class of morphisms is weakly saturated when it is stable under cobase change, under
transfinite composition indexed by well-ordered types in `Type w`, and under retracts.
(HTT, Def. A.1.2.2.) -/
def IsWeaklySaturated (S : MorphismProperty C) : Prop :=
  S.IsStableUnderCobaseChange ∧ S.IsStableUnderTransfiniteComposition.{w} ∧
    S.IsStableUnderRetracts

/-- The weakly saturated class generated by `S`: the intersection of all weakly saturated
classes containing `S`. (HTT, Rem. A.1.2.4.) -/
def weakSaturation (S : MorphismProperty C) : MorphismProperty C :=
  ⨅ (T : MorphismProperty C) (_ : S ≤ T) (_ : IsWeaklySaturated.{w} T), T

/-- In a locally presentable category every small set of morphisms permits the small object
argument. (HTT, Prop. A.1.2.5.) -/
theorem hasSmallObjectArgument_of_isLocallyPresentable [IsLocallyPresentable.{w} C]
    (I : MorphismProperty C) [I.IsSmall.{w}] : HasSmallObjectArgument.{w} I := by
  sorry

/-- In a locally presentable category, the left lifting class of the right lifting class of a
small set `I` is the weakly saturated class generated by `I`. (HTT, Cor. A.1.2.7.) -/
theorem llp_rlp_eq_weakSaturation [IsLocallyPresentable.{w} C]
    (I : MorphismProperty C) [I.IsSmall.{w}] : I.rlp.llp = weakSaturation.{w} I := by
  sorry

/-! ## Layer 2: cell trees and saturation without retracts -/

/-- Saturation without retracts: if `κ` is uncountable, `C` is `κ`-accessible, and a weakly
saturated class `S` is generated by its members between `κ`-presentable objects, then every
member of `S` is a transfinite composition of pushouts of such members. (HTT, Prop. A.1.5.12.) -/
theorem le_transfiniteCompositions_pushouts [IsLocallyPresentable.{w} C] (κ : Cardinal.{w})
    [Fact κ.IsRegular] (hκ : Cardinal.aleph0 < κ) [IsCardinalAccessibleCategory C κ]
        (S : MorphismProperty C)
    (hgen : weakSaturation.{w} (fun X Y (f : X ⟶ Y) ↦ S f ∧ IsCardinalPresentable X κ ∧
      IsCardinalPresentable Y κ) = S) :
    S ≤ transfiniteCompositions.{w}
      (pushouts (fun X Y (f : X ⟶ Y) ↦ S f ∧ IsCardinalPresentable X κ ∧
        IsCardinalPresentable Y κ)) := by
  sorry

end Saturation

/-! ## Layer 3: homotopy, properness and homotopy pushouts in a model category -/

section Classes

variable {C : Type u} [Category.{v} C]

/-- The model structure `M` has cofibrations `cof`, weak equivalences `we` and fibrations
`fib`. -/
def HasClasses (M : ModelCategory C) (cof we fib : MorphismProperty C) : Prop :=
  M.categoryWithCofibrations.cofibrations = cof ∧
    M.categoryWithWeakEquivalences.weakEquivalences = we ∧
    M.categoryWithFibrations.fibrations = fib

end Classes

section ModelCategory

variable (C : Type u) [Category.{v} C] [ModelCategory C]

/-- A model category is left proper when weak equivalences are preserved by pushout along
cofibrations. (HTT, Def. A.2.4.1.) -/
def IsLeftProper : Prop :=
  ∀ ⦃A B A' B' : C⦄ (i : A ⟶ B) (j : A ⟶ A') (j' : B ⟶ B') (i' : A' ⟶ B'),
    IsPushout i j j' i' → Cofibration i → WeakEquivalence j → WeakEquivalence j'

variable {C}

/-- Homotopy extension: a map in the homotopy category from a cofibrant `B` to a fibrant `X`
which restricts along a cofibration `i : A ⟶ B` to the class of `f` is represented by a map of
`C` restricting to `f` on the nose. (HTT, Prop. A.2.3.1.) -/
theorem exists_extension_of_cofibration {D : Type u'} [Category.{v'} D] (L : C ⥤ D)
    [L.IsLocalization (weakEquivalences C)] {A B X : C} [IsCofibrant A] [IsCofibrant B]
    [IsFibrant X] (i : A ⟶ B) [Cofibration i] (f : A ⟶ X) (g : L.obj B ⟶ L.obj X)
    (hg : L.map i ≫ g = L.map f) : ∃ g' : B ⟶ X, i ≫ g' = f ∧ L.map g' = g := by
  sorry

/-- The model structure on the under-category `Under S`: a map under `S` is a cofibration, a
fibration or a weak equivalence when its underlying map in `C` is. It is transported from the
opposite of Mathlib's over-category model structure on `Over (op S)` in `Cᵒᵖ`.
(Hirschhorn, Thm. 7.6.5; May–Ponto, §15.3.) -/
@[instance_reducible]
def modelCategoryUnder (S : C) : ModelCategory (Under S) :=
  letI : CategoryWithCofibrations (Under S) := ⟨(cofibrations C).under⟩
  letI : CategoryWithFibrations (Under S) := ⟨(fibrations C).under⟩
  letI : CategoryWithWeakEquivalences (Under S) := ⟨(weakEquivalences C).under⟩
  ModelCategory.transport ((Over.opEquivOpUnder S).op.trans (opOpEquivalence (Under S))).symm
    rfl rfl rfl

/-- A model category in which every object is cofibrant is left proper. (HTT, Prop. A.2.4.2.) -/
theorem isLeftProper_of_isCofibrant [∀ X : C, IsCofibrant X] : IsLeftProper C := by
  sorry

/-! ## Layer 4: Quillen adjunctions and Quillen equivalences -/

variable {D : Type u'} [Category.{v'} D] [ModelCategory D]

/-- An adjunction between model categories is a Quillen adjunction when its left adjoint
preserves cofibrations and trivial cofibrations. (HTT, §A.2.5, p. 835.) -/
def IsQuillenAdjunction {F : C ⥤ D} {G : D ⥤ C} (_ : F ⊣ G) : Prop :=
  cofibrations C ≤ (cofibrations D).inverseImage F ∧
    trivialCofibrations C ≤ (trivialCofibrations D).inverseImage F

/-- A Quillen equivalence: a Quillen adjunction for which a map from a cofibrant object to the
image of a fibrant object is a weak equivalence exactly when its adjoint is.
(HTT, Prop. A.2.5.1, condition (3).) -/
def IsQuillenEquivalence {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G) : Prop :=
  IsQuillenAdjunction adj ∧ ∀ (X : C) (Y : D), IsCofibrant X → IsFibrant Y →
    ∀ f : X ⟶ G.obj Y, WeakEquivalence f ↔ WeakEquivalence ((adj.homEquiv X Y).symm f)

/-- The four standard characterizations of a Quillen adjunction agree. (HTT, §A.2.5, p. 835.) -/
theorem isQuillenAdjunction_tfae {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G) :
    List.TFAE [IsQuillenAdjunction adj,
      fibrations D ≤ (fibrations C).inverseImage G ∧
        trivialFibrations D ≤ (trivialFibrations C).inverseImage G,
      cofibrations C ≤ (cofibrations D).inverseImage F ∧
        fibrations D ≤ (fibrations C).inverseImage G,
      trivialCofibrations C ≤ (trivialCofibrations D).inverseImage F ∧
        trivialFibrations D ≤ (trivialFibrations C).inverseImage G] := by
  sorry

/-- The left adjoint of a Quillen adjunction has a total left derived functor between the
localizations at the weak equivalences. (HTT, §A.2.5, p. 835.) -/
theorem hasLeftDerivedFunctor_of_isQuillenAdjunction {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)
    (h : IsQuillenAdjunction adj) :
    (F ⋙ (weakEquivalences D).Q).HasLeftDerivedFunctor (weakEquivalences C) := by
  sorry

/-- A Quillen adjunction is a Quillen equivalence exactly when a (any) total left derived
functor of its left adjoint is an equivalence of homotopy categories. (HTT, Prop. A.2.5.1.) -/
theorem isQuillenEquivalence_iff_isEquivalence {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)
    (h : IsQuillenAdjunction adj) {HC : Type*} {HD : Type*} [Category* HC] [Category* HD]
    (LC : C ⥤ HC) [LC.IsLocalization (weakEquivalences C)]
    (LD : D ⥤ HD) [LD.IsLocalization (weakEquivalences D)]
    (LF : HC ⥤ HD) (α : LC ⋙ LF ⟶ F ⋙ LD) [LF.IsLeftDerivedFunctor α (weakEquivalences C)] :
    IsQuillenEquivalence adj ↔ LF.IsEquivalence := by
  sorry

end ModelCategory

/-! ## Layer 5: accessible and perfect classes of morphisms -/

section Accessible

variable {C : Type u} [Category.{v} C]

/-- A full subcategory is `κ`-accessible when it is closed under `κ`-filtered colimits and a
small set of its objects generates it under `κ`-filtered colimits. (HTT, Def. A.2.6.2.) -/
def IsCardinalAccessibleSubcategory (P : ObjectProperty C) (κ : Cardinal.{w})
    [Fact κ.IsRegular] : Prop :=
  (∀ (J : Type w) [SmallCategory J] [IsCardinalFiltered J κ],
    P.IsClosedUnderColimitsOfShape J) ∧
  ∃ Q : ObjectProperty C, Q ≤ P ∧ ObjectProperty.Small.{w} Q ∧
    ∀ X, P X → ∃ (J : Type w) (_ : SmallCategory J) (_ : IsCardinalFiltered J κ),
      Q.colimitsOfShape J X

/-- A full subcategory is accessible when it is `κ`-accessible for some regular `κ`.
(HTT, Def. A.2.6.2.) -/
def IsAccessibleSubcategory (P : ObjectProperty C) : Prop :=
  ∃ (κ : Cardinal.{w}) (_ : Fact κ.IsRegular), IsCardinalAccessibleSubcategory P κ

/-- A class of morphisms is perfect when it contains the isomorphisms, has two-out-of-three, is
stable under filtered colimits, and its members are filtered colimits in `Arrow C` of members
of a small subclass. (HTT, Def. A.2.6.12.) -/
def IsPerfect (W : MorphismProperty C) : Prop :=
  isomorphisms C ≤ W ∧ W.HasTwoOutOfThreeProperty ∧ W.IsStableUnderFilteredColimits.{w, w} ∧
    ∃ W₀ : MorphismProperty C, W₀ ≤ W ∧ W₀.IsSmall.{w} ∧
      ∀ f : Arrow C, W f.hom → ∃ (J : Type w) (_ : SmallCategory J) (_ : IsFiltered J),
        ObjectProperty.colimitsOfShape (fun g : Arrow C ↦ W₀ g.hom) J f

/-- The preimage of a perfect class under a filtered-colimit-preserving functor between locally
presentable categories is perfect. (HTT, Cor. A.2.6.14.) -/
theorem isPerfect_inverseImage {D : Type u'} [Category.{v'} D] [IsLocallyPresentable.{w} C]
    [IsLocallyPresentable.{w} D] (F : C ⥤ D) [PreservesFilteredColimitsOfSize.{w, w} F]
    (W : MorphismProperty D) (hW : IsPerfect.{w} W) : IsPerfect.{w} (W.inverseImage F) := by
  sorry

end Accessible

/-! ## Layer 6: combinatorial model categories -/

section Combinatorial

variable {C : Type u} [Category.{v} C]

variable (C) in
/-- A model category is combinatorial when it is locally presentable and its cofibrations and
trivial cofibrations are generated, as weakly saturated classes, by small sets.
(HTT, Def. A.2.6.1.) -/
def IsCombinatorial [ModelCategory C] : Prop :=
  IsLocallyPresentable.{w} C ∧
    (∃ I : MorphismProperty C, I.IsSmall.{w} ∧ cofibrations C = weakSaturation.{w} I) ∧
    ∃ J : MorphismProperty C, J.IsSmall.{w} ∧ trivialCofibrations C = weakSaturation.{w} J

/-- In a combinatorial model category the fibrations, the weak equivalences and the trivial
fibrations span accessible full subcategories of `Arrow C`. (HTT, Cor. A.2.6.8.) -/
theorem isAccessibleSubcategory_of_isCombinatorial [ModelCategory C]
    (hC : IsCombinatorial.{w} C) :
    IsAccessibleSubcategory.{w} (fun f : Arrow C ↦ fibrations C f.hom) ∧
      IsAccessibleSubcategory.{w} (fun f : Arrow C ↦ weakEquivalences C f.hom) ∧
      IsAccessibleSubcategory.{w} (fun f : Arrow C ↦ trivialFibrations C f.hom) := by
  sorry

/-- Smith's recognition theorem. (HTT, Prop. A.2.6.10.) -/
theorem exists_modelCategory_of_smith [IsLocallyPresentable.{w} C] [HasFiniteLimits C]
    (Cof W : MorphismProperty C)
    (hCof : ∃ C₀ : MorphismProperty C, C₀.IsSmall.{w} ∧ weakSaturation.{w} C₀ = Cof)
    (hCW : IsWeaklySaturated.{w} (Cof ⊓ W))
    (hW : IsAccessibleSubcategory.{w} (fun f : Arrow C ↦ W f.hom))
    [W.HasTwoOutOfThreeProperty] (hrlp : Cof.rlp ≤ W) :
    ∃ M : ModelCategory C, HasClasses M Cof W (Cof ⊓ W).rlp ∧ @IsCombinatorial.{w} C _ M := by
  sorry

/-- Smith's theorem for a perfect class of weak equivalences: a left proper combinatorial model
structure with the given generating cofibrations. (HTT, Prop. A.2.6.15.) -/
theorem exists_modelCategory_of_isPerfect [IsLocallyPresentable.{w} C] [HasFiniteLimits C]
    (W C₀ : MorphismProperty C) [C₀.IsSmall.{w}] (hW : IsPerfect.{w} W)
    (hpush : ∀ ⦃X Y X' Y' X'' Y'' : C⦄ (f : X ⟶ Y) (a : X ⟶ X') (b : Y ⟶ Y') (f' : X' ⟶ Y')
      (g : X' ⟶ X'') (g' : Y' ⟶ Y'') (f'' : X'' ⟶ Y''),
      C₀ f → IsPushout f a b f' → IsPushout f' g g' f'' → W g → W g')
    (hrlp : C₀.rlp ≤ W) :
    ∃ M : ModelCategory C, HasClasses M (weakSaturation.{w} C₀) W (weakSaturation.{w} C₀ ⊓ W).rlp ∧
      @IsCombinatorial.{w} C _ M ∧ @IsLeftProper C _ M := by
  sorry

/-- The transfer theorem: a model structure on `A` whose cofibrations and trivial cofibrations are
generated by small sets `I` and `J` moves along an adjunction
`F ⊣ G` to a locally presentable `B` when `G` carries the cells generated by `F(J)` to weak
equivalences. Weak equivalences and fibrations of `B` are created by `G`.
(Berger–Moerdijk, §2.5.) -/
theorem exists_transferred {A : Type u} [Category.{v} A] [ModelCategory A]
    {B : Type u'} [Category.{v'} B] [IsLocallyPresentable.{w} B]
    [HasFiniteLimits B] {F : A ⥤ B} {G : B ⥤ A} (adj : F ⊣ G) (I J : MorphismProperty A) [I.IsSmall.{w}]
    [J.IsSmall.{w}] (hI : cofibrations A = weakSaturation.{w} I)
    (hJ : trivialCofibrations A = weakSaturation.{w} J)
    (hacyc : weakSaturation.{w} (J.map F) ≤ (weakEquivalences A).inverseImage G) :
    ∃ M : ModelCategory B, HasClasses M (weakSaturation.{w} (I.map F))
      ((weakEquivalences A).inverseImage G) ((fibrations A).inverseImage G) ∧
      @IsCombinatorial.{w} B _ M := by
  sorry

/-! ## Layer 7: model structures on diagram categories -/

/-- The projective model structure on diagrams in a combinatorial model category: levelwise
weak equivalences and fibrations; it is combinatorial. (HTT, Prop. A.2.8.2.) -/
theorem exists_projective {A : Type u} [Category.{v} A] [ModelCategory A]
    (hA : IsCombinatorial.{w} A) (J : Type w) [SmallCategory J] :
    ∃ M : ModelCategory (J ⥤ A),
      HasClasses M ((fibrations A).functorCategory J ⊓ (weakEquivalences A).functorCategory J).llp
        ((weakEquivalences A).functorCategory J) ((fibrations A).functorCategory J) ∧
      @IsCombinatorial.{w} (J ⥤ A) _ M := by
  sorry

end Combinatorial

/-! ### Reedy structures (Layer 7, continued) -/

section Reedy

variable {J : Type w} [SmallCategory J] (W₁ W₂ : MorphismProperty J)
  {A : Type u} [Category.{v} A] [HasColimitsOfSize.{w, w} A] [HasLimitsOfSize.{w, w} A]

/-- The latching category at `j`: the non-identity `W₂`-maps into `j`. (HTT, Not. A.2.9.7.) -/
def latchingIndex (j : J) : ObjectProperty (Over j) :=
  fun f ↦ W₂ f.hom ∧ ¬ identities J f.hom

/-- The matching category at `j`: the non-identity `W₁`-maps out of `j`.
(HTT, Not. A.2.9.7.) -/
def matchingIndex (j : J) : ObjectProperty (Under j) :=
  fun f ↦ W₁ f.hom ∧ ¬ identities J f.hom

/-- The latching map `L_j X ⟶ X j`. (HTT, Not. A.2.9.7.) -/
noncomputable def latchingMap (X : J ⥤ A) (j : J) :
    colimit (((latchingIndex W₂ j).ι ⋙ Over.forget j) ⋙ X) ⟶ X.obj j :=
  colimit.desc _ (X.mapCocone ((Over.forgetCocone j).whisker (latchingIndex W₂ j).ι))

/-- The matching map `X j ⟶ M_j X`. (HTT, Not. A.2.9.7.) -/
noncomputable def matchingMap (X : J ⥤ A) (j : J) :
    X.obj j ⟶ limit (((matchingIndex W₁ j).ι ⋙ Under.forget j) ⋙ X) :=
  limit.lift _ (X.mapCone ((Under.forgetCone j).whisker (matchingIndex W₁ j).ι))

/-- The relative latching map of `f : X ⟶ Y` at `j`, from the pushout of `X j` and `L_j Y` over
`L_j X` to `Y j`.
(HTT, Prop. A.2.9.19.) -/
noncomputable def relativeLatchingMap {X Y : J ⥤ A} (f : X ⟶ Y) (j : J) :
    pushout (latchingMap W₂ X j)
      (colimMap (Functor.whiskerLeft ((latchingIndex W₂ j).ι ⋙ Over.forget j) f)) ⟶ Y.obj j :=
  pushout.desc (f.app j) (latchingMap W₂ Y j) (by
    ext k
    dsimp only [latchingMap]
    erw [colimit.ι_desc_assoc, ι_colimMap_assoc, colimit.ι_desc]
    exact f.naturality _)

/-- The relative matching map of `f : X ⟶ Y` at `j`, from `X j` to the pullback of `Y j` and
`M_j X` over `M_j Y`.
(HTT, Prop. A.2.9.19.) -/
noncomputable def relativeMatchingMap {X Y : J ⥤ A} (f : X ⟶ Y) (j : J) :
    X.obj j ⟶ pullback (matchingMap W₁ Y j)
      (limMap (Functor.whiskerLeft ((matchingIndex W₁ j).ι ⋙ Under.forget j) f)) :=
  pullback.lift (f.app j) (matchingMap W₁ X j) (by
    ext k
    dsimp only [matchingMap]
    erw [Category.assoc, Category.assoc, limit.lift_π, limMap_π, limit.lift_π_assoc]
    exact (f.naturality _).symm)

variable [ModelCategory A]

/-- Reedy cofibrations: all relative latching maps are cofibrations. (HTT, Prop. A.2.9.19 (C).) -/
def reedyCofibrations : MorphismProperty (J ⥤ A) :=
  fun _ _ f ↦ ∀ j, cofibrations A (relativeLatchingMap W₂ f j)

/-- Reedy fibrations: all relative matching maps are fibrations. (HTT, Prop. A.2.9.19 (F).) -/
def reedyFibrations : MorphismProperty (J ⥤ A) :=
  fun _ _ f ↦ ∀ j, fibrations A (relativeMatchingMap W₁ f j)

variable [W₁.IsMultiplicative] [W₂.IsMultiplicative] {α : Type*} [LinearOrder α] [OrderBot α]
  [SuccOrder α] [WellFoundedLT α]

/-- A Reedy cofibration is a levelwise weak equivalence exactly when all its relative latching
maps are trivial cofibrations. (HTT, Prop. A.2.9.19 (WC).) -/
theorem reedyCofibrations_inf_eq (r : ReedyStructure W₁ W₂ α) :
    reedyCofibrations W₂ ⊓ (weakEquivalences A).functorCategory J =
      fun _ _ f ↦ ∀ j, trivialCofibrations A (relativeLatchingMap W₂ f j) := by
  sorry

/-- A Reedy fibration is a levelwise weak equivalence exactly when all its relative matching
maps are trivial fibrations. (HTT, Prop. A.2.9.19 (WF).) -/
theorem reedyFibrations_inf_eq (r : ReedyStructure W₁ W₂ α) :
    reedyFibrations W₁ ⊓ (weakEquivalences A).functorCategory J =
      fun _ _ f ↦ ∀ j, trivialFibrations A (relativeMatchingMap W₁ f j) := by
  sorry

/-- The Reedy model structure on `J ⥤ A` for a small Reedy category `J` and any model category
`A` with small limits and colimits. (HTT, Prop. A.2.9.19.) -/
theorem exists_reedy (r : ReedyStructure W₁ W₂ α) :
    ∃ M : ModelCategory (J ⥤ A), HasClasses M (reedyCofibrations W₂)
      ((weakEquivalences A).functorCategory J) (reedyFibrations W₁) := by
  sorry

end Reedy

end TauCetiRoadmap.ModelCategoryTheory.ModelCategories
