public import Mathlib
public import TauCeti.AlgebraicTopology.SimplicialSet.WeakHomotopyEquivalence

/-!
# Localization of enriched categories, Bousfield localization and Dugger's theorem: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's headline theorems
against the pinned Mathlib and Tau Ceti, with the few definitions their statements need.

Stated below: left Bousfield localization of the Kan–Quillen structure at a small set of
monomorphisms (§3.2, the case A = simplicial sets of HTT, Prop. A.3.7.3), with its left
properness, its simplicial pushout-product axiom and a small set of generating trivial
cofibrations. Every simplicial set is cofibrant, so locality and S-equivalences are conditions on
internal mapping objects.

Not statable at the pins:
* the representability of maps in `hCat_S` by enriched diagram categories (§1.3) and the path
  objects of `Cat_S` (§1.2): even for S = simplicial sets they need the model structure on small
  simplicial categories (Tau Ceti has the category `CategoryTheory.EnrichedCat.category` and its
  weak equivalences `CategoryTheory.EnrichedFunctor.IsDwyerKanEquivalence`, but no model
  structure) and the projective model structure on enriched diagram categories of tensored and
  cotensored enriched model categories, which neither Mathlib nor Tau Ceti defines;
* localization of S-enriched categories, homotopy colimits over posets and the tensor product
  theorem (§2.1, §2.2), homotopy limits in `Cat_S` (§2.3): the same carriers;
* the sifted homotopy colimits of simplicial categories with a fixed object set (§2.4): they need
  the transferred model structure on `Cat_{Δ,O}` and homotopy colimits, neither of which is
  defined;
* Bousfield localization for general A and Dugger's theorem (§3.2, §3.4): they need simplicial
  and combinatorial model categories, which neither Mathlib nor Tau Ceti defines (the case
  A = simplicial sets is stated below);
* the universality of simplicial presheaves (§3.3): it needs cosimplicial resolutions, that is,
  the Reedy model structure on cosimplicial objects (Mathlib has Reedy categories but not the
  Reedy model structure), and the projective model structure on simplicial presheaves;
* the mapping-space form of weak exponentials (§4.2, HTT, Prop. A.3.6.10): it needs simplicial
  model categories and their mapping Kan complexes, and its hypothesis on multiplication needs
  projectively cofibrant poset diagrams, none of which Mathlib or Tau Ceti defines;
* the homotopy limit theorems for weak exponentials and diagram categories (§4.3, §4.4): they need
  homotopy limits and colimits over posets in combinatorial model categories, and for §4.4
  homotopy limits in `Cat_S` and enriched diagram categories. The definition of weak exponentials
  (§4.1) could be phrased in the localization of a Mathlib `ModelCategory` at its weak
  equivalences, but no headline theorem that uses it is statable.
-/

public section

namespace TauCetiRoadmap.ModelCategoryTheory.EnrichedLocalization

open CategoryTheory MonoidalCategory HomotopicalAlgebra

universe u

/-! ## Layer 3: Bousfield localization and Dugger's theorem -/

/-- A simplicial set Z is a fibrant S-local object when it is a Kan complex and restriction along
each member `i : A ⟶ B` of S induces a weak homotopy equivalence `Map(B, Z) → Map(A, Z)`.
(README §3.1.1; HTT, §A.3.7, the definitions before Lemma A.3.7.1, p. 924, for A = simplicial
sets.) -/
def IsLocal (S : MorphismProperty SSet.{u}) (Z : SSet.{u}) : Prop :=
  SSet.KanComplex Z ∧ ∀ ⦃A B : SSet.{u}⦄ (i : A ⟶ B), S i →
    SSet.IsWeakHomotopyEquivalence ((MonoidalClosed.pre i).app Z)

/-- The S-equivalences: maps `f` such that `Map(f, Z)` is a weak homotopy equivalence for every
S-local Z. (README §3.1.1; HTT, §A.3.7, p. 924, for A = simplicial sets.) -/
def localEquivalences (S : MorphismProperty SSet.{u}) : MorphismProperty SSet.{u} :=
  fun _ _ f ↦ ∀ Z, IsLocal S Z → SSet.IsWeakHomotopyEquivalence ((MonoidalClosed.pre f).app Z)

/-- Left Bousfield localization of simplicial sets at a small set S of monomorphisms: there is a
model structure whose cofibrations are the monomorphisms, whose weak equivalences are the
S-equivalences and whose fibrant objects are the S-local Kan complexes; it is left proper (a pushout
of an S-equivalence along a monomorphism is an S-equivalence), simplicial (the pushout-product of
two monomorphisms is an S-equivalence when the first is a weak homotopy equivalence or the second
an S-equivalence) and combinatorial (its trivial cofibrations are generated by a small set; the
monomorphisms are generated by the boundary inclusions and simplicial sets are locally presentable
independently of S). (README §3.2.1; HTT, Prop. A.3.7.3, p. 926, for A = simplicial sets.) -/
theorem exists_localizedModelCategory (S : MorphismProperty SSet.{u}) [S.IsSmall.{u}]
    (hS : S ≤ MorphismProperty.monomorphisms _) :
    ∃ M : ModelCategory SSet.{u},
      @weakEquivalences _ _ M.categoryWithWeakEquivalences = localEquivalences S ∧
        @cofibrations _ _ M.categoryWithCofibrations = MorphismProperty.monomorphisms _ ∧
        (∀ Z : SSet.{u}, @IsFibrant _ _ M.categoryWithFibrations _ Z ↔ IsLocal S Z) ∧
        (∀ ⦃A B X P : SSet.{u}⦄ (f : A ⟶ X) (i : A ⟶ B) (j : X ⟶ P) (g : B ⟶ P),
          IsPushout f i j g → Mono i → localEquivalences S f → localEquivalences S g) ∧
        (∀ ⦃K L X Y : SSet.{u}⦄ (i : K ⟶ L) (j : X ⟶ Y), Mono i → Mono j →
          (SSet.IsWeakHomotopyEquivalence i ∨ localEquivalences S j) →
            localEquivalences S
              ((MonoidalCategory.Arrow.pushoutProduct.obj (Arrow.mk i)).obj (Arrow.mk j)).hom) ∧
        ∃ J : MorphismProperty SSet.{u}, J.IsSmall.{u} ∧
          J.rlp.llp = MorphismProperty.monomorphisms _ ⊓ localEquivalences S := by
  sorry

end TauCetiRoadmap.ModelCategoryTheory.EnrichedLocalization
