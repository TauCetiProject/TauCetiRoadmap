import Mathlib
import TauCeti.AlgebraicGeometry.AdicSpace.Spa.Basic

/-!
# Adic coefficients and scheme comparison: representative target signatures

These are suggested forms, not an exhaustive checklist. The roadmap in `README.md` is the
definitive specification. This file records light definitions and theorem signatures statable
against the pinned Mathlib and Tau Ceti APIs, in the package's namespaces.

Coefficient hypotheses use regular sequences and adic completeness. Scalar localization uses
Mathlib's existing localization of a category. Plus rings are integral closures of `ZMod p`;
the analytic test locus uses Tau Ceti's continuous valuation spectrum. Enhanced étale categories,
scheme v-sheaves, comparison functors and strict compactification refinements are README targets
on the shared carriers specified by their suppliers.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace TauCeti.AdicCoefficientsAndComparisons

/-! ## Coefficient conventions -/

/-- The standing coefficient hypotheses of ECD §26, relative to the characteristic `p` of the
perfectoid test spaces: `Λ` is `I`-adically complete and separated, `I` is generated by a
regular sequence, and `I` contains a positive natural number prime to `p`. For `I = ⊥` (the
empty regular sequence) the last condition gives a positive prime-to-`p` annihilator of `Λ`. -/
structure IsAdicCoefficientPair (p : ℕ) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) : Prop where
  isAdicComplete : IsAdicComplete I Λ
  regular : ∃ rs : List Λ, RingTheory.Sequence.IsRegular Λ rs ∧ I = Ideal.ofList rs
  primeToP : ∃ n : ℕ, 0 < n ∧ n.Coprime p ∧ (n : Λ) ∈ I

/-- A discrete coefficient ring killed by a positive natural number prime to `p`, the
coefficients of the finite-level theories. -/
def IsPrimeToPTorsion (p : ℕ) (Λ : Type u) [CommRing Λ] : Prop :=
  ∃ n : ℕ, 0 < n ∧ n.Coprime p ∧ (n : Λ) = 0

/-- The plus ring of the characteristic-`p` scheme avatar: the integral closure of `𝔽_p`
in `R`. -/
abbrev charPPlus (p : ℕ) (R : Type u) [CommRing R] [Algebra (ZMod p) R] : Subring R :=
  (integralClosure (ZMod p) R).toSubring

/-- The base of the mixed-characteristic comparison: a complete discrete valuation ring with its
adic topology and perfect residue field of characteristic `p`. -/
class IsCompleteDVRBase (p : ℕ) (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] : Prop where
  isAdic : IsAdic (IsLocalRing.maximalIdeal O)
  complete : IsAdicComplete (IsLocalRing.maximalIdeal O) O
  charP_residue : CharP (IsLocalRing.ResidueField O) p
  perfect_residue : PerfectField (IsLocalRing.ResidueField O)

/-- The integers fail the completeness condition for a coefficient pair with ideal `(ℓ)`. -/
theorem not_isAdicCoefficientPair_int (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime]
    (hℓ : ℓ ≠ p) : ¬ IsAdicCoefficientPair p (Ideal.span {(ℓ : ℤ)}) := sorry

/-- A complete DVR with residue characteristic different from `p` fails the base condition. -/
theorem not_isCompleteDVRBase_wrongChar (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime]
    (hℓ : ℓ ≠ p) : ¬ IsCompleteDVRBase p ℤ_[ℓ] := sorry

open scoped PowerSeries.WithPiTopology in
/-- A power-series DVR with imperfect residue field fails the perfect-residue condition. -/
theorem not_isCompleteDVRBase_imperfect (p : ℕ) [Fact p.Prime] (k : Type u) [Field k]
    [CharP k p] [TopologicalSpace k] [DiscreteTopology k] (hk : ¬ PerfectField k) :
    ¬ IsCompleteDVRBase p (PowerSeries k) := sorry

/-! ## Layer L0: scalar localization of integral lattice categories -/

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- Multiplication by `ℓ` on the objects of a `ℤ_ℓ`-linear category. -/
def ellMul : MorphismProperty C := MorphismProperty.ofHoms (fun A : C => (ℓ : ℤ_[ℓ]) • 𝟙 A)

end RationalLattice

/-- `L0/rational-constructible-coefficients`: the rational lattice category `C[1/ℓ]` of a
`ℤ_ℓ`-linear category `C` of integral lattices (intended: `D_cons(X, ℤ_ℓ)`), the localisation of
`C` at multiplication by `ℓ`. -/
abbrev RationalLattice (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime]
    [Linear ℤ_[ℓ] C] :=
  (RationalLattice.ellMul C ℓ).Localization

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- `RationalLattice.localise`: an integral lattice as a rational lattice. -/
def localise : C ⥤ RationalLattice C ℓ := (ellMul C ℓ).Q

/-- Multiplication by ℓ becomes invertible under the specified localization functor. -/
instance invert (A : C) : IsIso ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) :=
  MorphismProperty.Q_inverts _ _ (MorphismProperty.ofHoms.mk A)

/-- `RationalLattice.hom`: morphisms of rational lattices are integral morphisms tensored with
`ℚ_ℓ`: `f` corresponds to `1 ⊗ f`, and `ℓ⁻¹ · f` to `f` composed with the inverse of
multiplication by `ℓ`. -/
theorem hom (A B : C) :
    ∃ e : ((localise C ℓ).obj A ⟶ (localise C ℓ).obj B) ≃ TensorProduct ℤ_[ℓ] ℚ_[ℓ] (A ⟶ B),
      ∀ f : A ⟶ B, e ((localise C ℓ).map f) = TensorProduct.tmul ℤ_[ℓ] (1 : ℚ_[ℓ]) f ∧
        e (inv ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) ≫ (localise C ℓ).map f) =
          TensorProduct.tmul ℤ_[ℓ] (ℓ : ℚ_[ℓ])⁻¹ f :=
  sorry

/-- `L0/rational-constructible-coefficients`, `RationalLattice.torsion`: scalar localization
annihilates every object killed by a power of ℓ, including exponent zero. -/
theorem torsion (A : C) (k : ℕ) (hA : ((ℓ : ℤ_[ℓ]) ^ k) • 𝟙 A = 0) :
    IsZero ((localise C ℓ).obj A) := sorry

end RationalLattice

/-! ## Layer L1: existing scheme carriers and the characteristic-p plus ring -/

/-- Schemes of characteristic `p`: `p = 0` in the global sections. Morphisms are all scheme
morphisms. -/
def IsCharPScheme (p : ℕ) : ObjectProperty Scheme.{u} := fun X => ((p : ℕ) : Γ(X, ⊤)) = 0

/-- The category of schemes of characteristic `p`. -/
abbrev CharPScheme (p : ℕ) : Type (u + 1) := (IsCharPScheme.{u} p).FullSubcategory

/-- Schemes locally of finite type over `Spec O`, using Mathlib's full subcategory of
`Over (Spec O)` cut out by `LocallyOfFiniteType`. -/
abbrev LFTScheme (O : Type u) [CommRing O] :=
  MorphismProperty.Over (@LocallyOfFiniteType) ⊤ (Spec (CommRingCat.of O))

/-- `L1/char-p-scheme-diamond-and-comparison-functor`, §2.9: an algebraic extension of the
prime field has full plus ring in the characteristic-p scheme avatar. -/
theorem charPPlus_eq_top (p : ℕ) [Fact p.Prime] (k : Type u) [Field k]
    [Algebra (ZMod p) k] [Algebra.IsAlgebraic (ZMod p) k] : charPPlus p k = ⊤ := sorry

/-! ## Layer L2: proper-support coefficient convention -/

/-- `Λ` is killed by a positive integer that is invertible on `X`. -/
def IsInvertibleTorsionOn (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] : Prop :=
  ∃ n : ℕ, 0 < n ∧ (n : Λ) = 0 ∧ IsUnit ((n : ℕ) : Γ(X, ⊤))

/-! ## Layer L4: the valuation locus of the analytic DVR test space -/

section TestSpace

open scoped PowerSeries.WithPiTopology

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- The points of `T` inside Tau Ceti's `Spa(O⟦x⟧, O⟦x⟧)`: the continuous valuations, bounded by
`1` on `O⟦x⟧`, that do not vanish at `x`. -/
def DVRTestSpace.pointSet : Set (TauCeti.ValuationSpectrum (PowerSeries O)) :=
  TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)) ∩
    {v | ¬ v.toValuativeRel.vle PowerSeries.X 0}

include p

/-- `L4/analytic-test-space`: over a complete adic DVR base every test-locus point is
analytic and lies in a rational chart with denominator x (ECD proof of Proposition 27.5). -/
theorem DVRTestSpace.analytic (π : O) (hπ : Irreducible π) :
    ∀ v ∈ DVRTestSpace.pointSet O, ¬ IsOpen (v.supp : Set (PowerSeries O)) ∧
      ∃ n : ℕ, v ∈ TauCeti.ValuationSpectrum.basicOpen (PowerSeries.C π ^ n) PowerSeries.X :=
  sorry

end TestSpace

open scoped PowerSeries.WithPiTopology in
/-- Over a perfect field containing a transcendental element, a continuous valuation can be
nonzero at `x` and exceed `1` on a coefficient unit, so it lies outside the test locus. -/
theorem DVRTestSpace.unbounded_continuous_point (p : ℕ) [Fact p.Prime] (k : Type u)
    [Field k] [CharP k p] [PerfectField k] [Algebra (ZMod p) k]
    [TopologicalSpace k] [DiscreteTopology k] (s : k) (hs : Transcendental (ZMod p) s) :
    ∃ v ∈ TauCeti.ValuationSpectrum.cont (PowerSeries (PowerSeries k)),
      ¬ v.toValuativeRel.vle PowerSeries.X 0 ∧
      ¬ v.toValuativeRel.vle (PowerSeries.C (PowerSeries.C s)) 1 ∧
      v ∉ DVRTestSpace.pointSet (PowerSeries k) := sorry

