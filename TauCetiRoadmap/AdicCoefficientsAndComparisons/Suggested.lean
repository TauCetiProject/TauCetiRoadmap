import Mathlib
import TauCeti.AlgebraicGeometry.AdicSpace.Spa.Basic
import TauCeti.AlgebraicGeometry.EffectiveCartierDivisor.Basic

/-!
# Adic coefficients and scheme comparison: representative target signatures

These are suggested forms, not an exhaustive checklist. The roadmap in `README.md` is the
definitive specification. This file records light definitions and theorem signatures statable
against the pinned Mathlib and Tau Ceti APIs, in the package's namespaces.

Coefficient hypotheses use regular sequences and adic completeness. Scalar localization uses
Mathlib's existing localization of a category. Plus rings are integral closures of `ZMod p`;
the analytic test locus uses Tau Ceti's continuous valuation spectrum. Enhanced étale categories,
scheme v-sheaves, comparison functors and strict compactification refinements are README targets
on the shared carriers specified by their suppliers.
-/

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace TauCeti.AdicCoefficientsAndComparisons

/-! ## Coefficient conventions -/


/-- The standing coefficient hypotheses of ECD §26, relative to the characteristic `p` of the
perfectoid test spaces: `Λ` is `I`-adically complete and separated, `I` is generated by a
regular sequence, and `I` contains an integer prime to `p`. For `I = ⊥` (the empty regular
sequence) the last condition says that `Λ` is killed by an integer prime to `p`. -/
structure IsAdicCoefficientPair (p : ℕ) {Λ : Type u} [CommRing Λ] (I : Ideal Λ) : Prop where
  isAdicComplete : IsAdicComplete I Λ
  regular : ∃ rs : List Λ, RingTheory.Sequence.IsRegular Λ rs ∧ I = Ideal.ofList rs
  primeToP : ∃ n : ℕ, n.Coprime p ∧ (n : Λ) ∈ I

/-- A discrete coefficient ring killed by an integer prime to `p`, the coefficients of the
finite-level theories. -/
def IsPrimeToPTorsion (p : ℕ) (Λ : Type u) [CommRing Λ] : Prop :=
  ∃ n : ℕ, n.Coprime p ∧ (n : Λ) = 0

/-- The plus ring of the characteristic-`p` scheme avatar: the integral closure of `𝔽_p`
in `R`. -/
abbrev charPPlus (p : ℕ) (R : Type u) [CommRing R] [Algebra (ZMod p) R] : Subring R :=
  (integralClosure (ZMod p) R).toSubring

/-- The base of the mixed-characteristic comparison: a complete discrete valuation ring with its
adic topology and perfect residue field of characteristic `p`. -/
class IsCompleteDVRBase (p : ℕ) (O : Type u) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [TopologicalSpace O] : Prop where
  isAdic : IsAdic (IsLocalRing.maximalIdeal O)
  complete : IsAdicComplete (IsLocalRing.maximalIdeal O) O
  charP_residue : CharP (IsLocalRing.ResidueField O) p
  perfect_residue : PerfectField (IsLocalRing.ResidueField O)

/-- The principal ℓ-adic coefficient pair satisfies the regularity and prime-to-p conditions. -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hℓ : ℓ ≠ p) :
    IsAdicCoefficientPair p (Ideal.span {(ℓ : ℤ_[ℓ])}) := sorry

/-- The empty regular sequence gives the zero-ideal pair for prime-to-p finite coefficients. -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hℓ : ℓ ≠ p) :
    IsAdicCoefficientPair p (⊥ : Ideal (ZMod ℓ)) := sorry

/-- The unit ideal is excluded, including over the zero ring, by regular-sequence generation. -/
example (p : ℕ) (Λ : Type u) [CommRing Λ] :
    ¬ IsAdicCoefficientPair p (⊤ : Ideal Λ) := sorry

/-- The ideal (p) of ℤ_p is excluded by the prime-to-p condition. -/
example (p : ℕ) [Fact p.Prime] :
    ¬ IsAdicCoefficientPair p (Ideal.span {(p : ℤ_[p])}) := sorry

/-- Prime-to-p finite coefficients include ZMod ℓ when ℓ and p are distinct primes. -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hℓ : ℓ ≠ p) :
    IsPrimeToPTorsion p (ZMod ℓ) := sorry

/-- p-torsion fails the prime-to-p annihilator condition. -/
example (p : ℕ) [Fact p.Prime] : ¬ IsPrimeToPTorsion p (ZMod p) := sorry

/-- The zero ring has prime-to-p annihilator one. -/
example (p : ℕ) (Λ : Type u) [CommRing Λ] [Subsingleton Λ] :
    IsPrimeToPTorsion p Λ := sorry

/-- Characteristic-zero ℤ_ℓ is not a discrete prime-to-p torsion ring. -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] :
    ¬ IsPrimeToPTorsion p ℤ_[ℓ] := sorry

/-- The complete DVR base includes ℤ_p with its p-adic topology. -/
example (p : ℕ) [Fact p.Prime] : IsCompleteDVRBase p ℤ_[p] := sorry

open scoped PowerSeries.WithPiTopology

/-- Power series over a discrete perfect characteristic-p field give an equal-characteristic base. -/
example (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] [PerfectField k]
    [TopologicalSpace k] [DiscreteTopology k] : IsCompleteDVRBase p (PowerSeries k) := sorry

/-- Discrete topology on a nonfield DVR is excluded from the base convention. -/
example (p : ℕ) (O : Type u) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [TopologicalSpace O] [DiscreteTopology O] : ¬ IsCompleteDVRBase p O := sorry

/-- Indiscrete topology on ℤ_p fails the maximal-ideal-adic base condition. -/
example (p : ℕ) [Fact p.Prime] :
    letI : TopologicalSpace ℤ_[p] := ⊤
    ¬ IsCompleteDVRBase p ℤ_[p] := sorry

/-! ## Layer L0: scalar localization of integral lattice categories -/

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- Multiplication by `ℓ` on the objects of a `ℤ_ℓ`-linear category. -/
def ellMul : MorphismProperty C := MorphismProperty.ofHoms (fun A : C => (ℓ : ℤ_[ℓ]) • 𝟙 A)

end RationalLattice

/-- `L0/rational-constructible-coefficients`: the rational lattice category `C[1/ℓ]` of a
`ℤ_ℓ`-linear category `C` of integral lattices (intended: `D_cons(X, ℤ_ℓ)`), the localisation of
`C` at multiplication by `ℓ`. -/
abbrev RationalLattice (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime]
    [Linear ℤ_[ℓ] C] :=
  (RationalLattice.ellMul C ℓ).Localization

namespace RationalLattice

variable (C : Type*) [Category C] [Preadditive C] (ℓ : ℕ) [Fact ℓ.Prime] [Linear ℤ_[ℓ] C]

/-- `RationalLattice.localise`: an integral lattice as a rational lattice. -/
def localise : C ⥤ RationalLattice C ℓ := (ellMul C ℓ).Q

/-- Multiplication by ℓ becomes invertible under the specified localization functor. -/
instance invert (A : C) : IsIso ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) :=
  MorphismProperty.Q_inverts _ _ (MorphismProperty.ofHoms.mk A)


/-- `RationalLattice.hom`: morphisms of rational lattices are integral morphisms tensored with
`ℚ_ℓ`: `f` corresponds to `1 ⊗ f`, and `ℓ⁻¹ · f` to `f` composed with the inverse of
multiplication by `ℓ`. -/
theorem hom (A B : C) :
    ∃ e : ((localise C ℓ).obj A ⟶ (localise C ℓ).obj B) ≃ TensorProduct ℤ_[ℓ] ℚ_[ℓ] (A ⟶ B),
      ∀ f : A ⟶ B, e ((localise C ℓ).map f) = TensorProduct.tmul ℤ_[ℓ] (1 : ℚ_[ℓ]) f ∧
        e (inv ((localise C ℓ).map ((ℓ : ℤ_[ℓ]) • 𝟙 A)) ≫ (localise C ℓ).map f) =
          TensorProduct.tmul ℤ_[ℓ] (ℓ : ℚ_[ℓ])⁻¹ f :=
  sorry


/-- The localized rank-one module has endomorphisms ℚ_ℓ, with its unit and composition. -/
example :
    let Q := localise (ModuleCat ℤ_[ℓ]) ℓ
    let A := ModuleCat.of ℤ_[ℓ] ℤ_[ℓ]
    ∃ e : (Q.obj A ⟶ Q.obj A) ≃ ℚ_[ℓ],
      e (𝟙 _) = 1 ∧ ∀ f g, e (f ≫ g) = e f * e g := sorry

open scoped ZeroObject

/-- Scalar localization preserves the zero object of a linear category. -/
example [HasZeroObject C] : IsZero ((localise C ℓ).obj (0 : C)) := sorry

/-- An ℓ-power-torsion object becomes zero; the zero case includes exponent zero. -/
example (A : C) (k : ℕ) (hA : ((ℓ : ℤ_[ℓ]) ^ k) • 𝟙 A = 0) :
    IsZero ((localise C ℓ).obj A) := sorry

end RationalLattice

/-! ## Layer L1: existing scheme carriers and the characteristic-p plus ring -/

/-- Schemes of characteristic `p`: `p = 0` in the global sections. Morphisms are all scheme
morphisms. -/
def IsCharPScheme (p : ℕ) : ObjectProperty Scheme.{u} := fun X => ((p : ℕ) : Γ(X, ⊤)) = 0

/-- The category of schemes of characteristic `p`. -/
abbrev CharPScheme (p : ℕ) : Type (u + 1) := (IsCharPScheme.{u} p).FullSubcategory


/-- `O`-schemes locally of finite type. -/
def IsLFTOver (O : Type u) [CommRing O] : ObjectProperty (Over (Spec (CommRingCat.of O))) :=
  fun X => LocallyOfFiniteType X.hom

/-- Schemes locally of finite type over `Spec O`. -/
abbrev LFTScheme (O : Type u) [CommRing O] : Type (u + 1) := (IsLFTOver O).FullSubcategory

/-- The characteristic-p carrier contains Spec of ZMod p. -/
example (p : ℕ) : IsCharPScheme p (Spec (CommRingCat.of (ZMod p))) := sorry

/-- The empty scheme has characteristic p because its section ring is the zero ring. -/
example (p : ℕ) : IsCharPScheme p (Scheme.empty : Scheme.{u}) := sorry

/-- Spec ℤ does not lie in the characteristic-p carrier for a prime p. -/
example (p : ℕ) [Fact p.Prime] : ¬ IsCharPScheme p (Spec (CommRingCat.of ℤ)) := sorry

/-- The identity base scheme is locally of finite type over itself. -/
example (O : Type u) [CommRing O] :
    IsLFTOver O (Over.mk (𝟙 (Spec (CommRingCat.of O)))) := sorry

/-- The affine line is locally of finite type over any coefficient ring. -/
example (O : Type u) [CommRing O] :
    IsLFTOver O (Over.mk (Spec.map (CommRingCat.ofHom (Polynomial.C : O →+* Polynomial O)))) :=
  sorry

/-- Affine space in countably infinitely many variables is not locally of finite type. -/
example (k : Type u) [Field k] :
    ¬ IsLFTOver k (Over.mk (Spec.map
      (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial ℕ k)))) := sorry

/-- Algebraic fields over the prime field have full plus ring. -/
theorem charPPlus_eq_top (p : ℕ) [Fact p.Prime] (k : Type u) [Field k]
    [Algebra (ZMod p) k] [Algebra.IsAlgebraic (ZMod p) k] : charPPlus p k = ⊤ := sorry

/-- The prime field has full plus ring. -/
example (p : ℕ) [Fact p.Prime] : charPPlus p (ZMod p) = ⊤ := sorry

/-- An element transcendental over the prime field is not in the plus ring. -/
example (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [Algebra (ZMod p) k]
    (t : k) (ht : Transcendental (ZMod p) t) : t ∉ charPPlus p k := sorry

/-! ## Layer L2: native effective Cartier ideals and support coefficients -/

/-- `Λ` is killed by a positive integer that is invertible on `X`. -/
def IsInvertibleTorsionOn (X : Scheme.{u}) (Λ : Type u) [CommRing Λ] : Prop :=
  ∃ n : ℕ, 0 < n ∧ (n : Λ) = 0 ∧ IsUnit ((n : ℕ) : Γ(X, ⊤))

/-- The unit ideal defines the empty effective Cartier divisor. -/
example (Z : Scheme.{u}) : (⊤ : Z.IdealSheafData).IsEffectiveCartier :=
  Scheme.IdealSheafData.isEffectiveCartier_top Z

/-- On a nonempty scheme the zero ideal is not an effective Cartier ideal. -/
example (Z : Scheme.{u}) [Nonempty Z] : ¬ (⊥ : Z.IdealSheafData).IsEffectiveCartier := sorry

/-- The coordinate ideal of the affine line is Cartier, but its pullback to the origin is not. -/
example (k : Type u) [Field k] :
    let S := Spec (CommRingCat.of (Polynomial k))
    let t := (Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))).inv (Polynomial.X : Polynomial k)
    let I : S.IdealSheafData := Scheme.IdealSheafData.ofIdealTop (Ideal.span {t})
    let origin := Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : k)))
    I.IsEffectiveCartier ∧ ¬ (I.comap origin).IsEffectiveCartier := sorry

/-- The square-zero coordinate ideal of the dual numbers fails the Cartier condition. -/
example (k : Type u) [Field k] :
    let J : Ideal (Polynomial k) := Ideal.span {(Polynomial.X : Polynomial k) ^ 2}
    let A := Polynomial k ⧸ J
    let ε := Ideal.Quotient.mk J (Polynomial.X : Polynomial k)
    let e := (Scheme.ΓSpecIso (CommRingCat.of A)).inv ε
    ¬ (Scheme.IdealSheafData.ofIdealTop (Ideal.span {e})).IsEffectiveCartier := sorry

/-- No base admits a positive integer annihilating characteristic-zero ℤ_ℓ. -/
example (X : Scheme.{u}) (ℓ : ℕ) [Fact ℓ.Prime] :
    ¬ IsInvertibleTorsionOn X (ULift.{u} ℤ_[ℓ]) := sorry

/-- On an empty scheme every positive finite-characteristic coefficient ring qualifies. -/
example (X : Scheme.{u}) [IsEmpty X] (Λ : Type u) [CommRing Λ]
    (n : ℕ) (hn : 0 < n) (hΛ : (n : Λ) = 0) : IsInvertibleTorsionOn X Λ := sorry

/-- Prime-to-p finite coefficients are invertible torsion on Spec of a characteristic-p field. -/
example (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] (hℓ : ℓ ≠ p)
    (k : Type u) [Field k] [CharP k p] :
    IsInvertibleTorsionOn (Spec (CommRingCat.of k)) (ULift.{u} (ZMod ℓ)) := sorry

/-- p-torsion on Spec of a characteristic-p field fails the invertibility condition. -/
example (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] :
    ¬ IsInvertibleTorsionOn (Spec (CommRingCat.of k)) (ULift.{u} (ZMod p)) := sorry

/-! ## Layer L4: the valuation locus of the analytic DVR test space -/

section TestSpace

variable (p : ℕ) [Fact p.Prime] (O : Type u) [CommRing O] [IsDomain O]
  [IsDiscreteValuationRing O] [TopologicalSpace O] [IsCompleteDVRBase p O]

/-- The points of `T` inside Tau Ceti's `Spa(O⟦x⟧, O⟦x⟧)`: the continuous valuations, bounded by
`1` on `O⟦x⟧`, that do not vanish at `x`. -/
def DVRTestSpace.pointSet : Set (TauCeti.ValuationSpectrum (PowerSeries O)) :=
  TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)) ∩
    {v | ¬ v.toValuativeRel.vle PowerSeries.X 0}

include p

/-- Over a complete adic DVR base every test-locus point is analytic and lies in a rational
chart with denominator x (ECD proof of Proposition 27.5, p. 166). -/
theorem DVRTestSpace.analytic (π : O) (hπ : Irreducible π) :
    ∀ v ∈ DVRTestSpace.pointSet O, ¬ IsOpen (v.supp : Set (PowerSeries O)) ∧
      ∃ n : ℕ, v ∈ TauCeti.ValuationSpectrum.basicOpen (PowerSeries.C π ^ n) PowerSeries.X :=
  sorry


/-- Over a complete adic DVR base the test locus meets the special fibre with nonzero
topologically nilpotent x. -/
example (π : O) (hπ : Irreducible π) :
    ∃ v ∈ DVRTestSpace.pointSet O, PowerSeries.C π ∈ v.supp ∧
      v.toValuativeRel.vlt PowerSeries.X 1 := sorry


/-- Over a complete adic DVR base the test locus meets the generic fibre with π and x
topologically nilpotent. -/
example (π : O) (hπ : Irreducible π) :
    ∃ v ∈ DVRTestSpace.pointSet O, PowerSeries.C π ∉ v.supp ∧
      v.toValuativeRel.vlt (PowerSeries.C π) 1 ∧ v.toValuativeRel.vlt PowerSeries.X 1 := sorry


/-- Over a complete adic DVR base points with x in their support are excluded, and such
ambient points exist. -/
example : (∃ v ∈ TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)),
      (PowerSeries.X : PowerSeries O) ∈ v.supp) ∧
    ∀ v : TauCeti.ValuationSpectrum (PowerSeries O),
      (PowerSeries.X : PowerSeries O) ∈ v.supp → v ∉ DVRTestSpace.pointSet O := sorry

end TestSpace

/-- With discrete coefficients the x-adic valuation misses every proposed DVR rational chart. -/
example (q : ℕ) [Fact q.Prime] :
    letI : TopologicalSpace ℤ_[q] := ⊥
    ∃ v ∈ DVRTestSpace.pointSet ℤ_[q], ∀ n : ℕ,
      v ∉ TauCeti.ValuationSpectrum.basicOpen
        (PowerSeries.C (q : ℤ_[q]) ^ n) PowerSeries.X := sorry

/-- Indiscrete coefficients give an empty continuous valuation spectrum of power series. -/
example (O : Type u) [CommRing O] [TopologicalSpace O] [IndiscreteTopology O] :
    TauCeti.ValuationSpectrum.spa (⊤ : Subring (PowerSeries O)) = ∅ := sorry

