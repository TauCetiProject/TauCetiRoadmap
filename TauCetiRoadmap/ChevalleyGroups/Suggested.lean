import TauCetiRoadmap.ReductiveGroups.ChevalleyModelTargets
import Mathlib.FieldTheory.IsAlgClosed.Basic
import TauCeti.LinearAlgebra.RootSystem.SimplyConnectedRootDatum.DiagramAutomorphism
import TauCeti.LinearAlgebra.RootSystem.Isogeny.Special
import TauCeti.GroupTheory.TitsSystem.Basic

/-!
# Chevalley groups and the Chevalley–Demazure group schemes: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is `README.md`.
The declarations here suggest Lean forms for the points of the simply connected Chevalley group of
a valid Dynkin type and the maps between them. Discharging all of them finishes neither a work item
nor the roadmap. `sorry` is allowed in this human-owned roadmap library: these are targets, not
completed definitions or proofs.

The carrier and root/torus maps alias the single RG constructor companion; they are not
independent admitted types.
The group scheme itself, the Chevalley datum structure, and the big-cell statements are specified in
`README.md` against the existing generic toral-closure API; they are not displayed here. What is
displayed is the interface on points that downstream roadmaps consume: root subgroups, the torus,
the elementary subgroup, and the endomorphisms with their character maps, which are checked data
(`IsCharacterMap`) rather than a function of the endomorphism.
-/

namespace TauCetiRoadmap.ChevalleyGroups

open TauCeti

variable (t : DynkinType) (ht : t.Valid)

/-! ## C2: points, root subgroups, and the torus -/

/-- The points over `A` of the simply connected Chevalley–Demazure group scheme of `t`, built as the
Kostant toral closure of the direct sum of the fundamental modules with their admissible lattices. -/
noncomputable abbrev ChevalleyGroup (t : DynkinType) (ht : t.Valid) (A : Type) [CommRing A] :=
  TauCetiRoadmap.ReductiveGroups.ChevalleyModels.Points t ht A

noncomputable instance (A : Type) [CommRing A] : Group (ChevalleyGroup t ht A) := inferInstance

/-- The root subgroup `u ↦ x_α(u)` for every root `α`, in the enumeration of
`DynkinType.simplyConnectedRootDatum`. -/
noncomputable abbrev rootSubgroup (A : Type) [CommRing A] (α : Fin t.numRoots) :
    Multiplicative A →* ChevalleyGroup t ht A :=
  TauCetiRoadmap.ReductiveGroups.ChevalleyModels.rootPoint t ht A α

/-- The split maximal torus `Hom(P, Aˣ)`, `P` the full weight lattice, with coordinates indexed by
the fundamental weights: `s` is the point `χ ↦ ∏ i, s i ^ χ i`. For a general Chevalley datum the
torus has character lattice the span `Λ(D)` of its weights instead (`README.md`, C2). -/
noncomputable abbrev torus (A : Type) [CommRing A] : (Fin t.rank → Aˣ) →* ChevalleyGroup t ht A :=
  TauCetiRoadmap.ReductiveGroups.ChevalleyModels.torusPoint t ht A

/-- The pinning equation `s x_α(u) s⁻¹ = x_α(α(s) u)`, with `α` read as a character in the weight
lattice of `DynkinType.simplyConnectedRootDatum`. -/
theorem torus_conj_rootSubgroup (A : Type) [CommRing A] (s : Fin t.rank → Aˣ)
    (α : Fin t.numRoots) (u : A) :
    torus t ht A s * rootSubgroup t ht A α (.ofAdd u) * (torus t ht A s)⁻¹ =
      rootSubgroup t ht A α
        (.ofAdd ((∏ i, ((s i : Aˣ) ^ ((t.simplyConnectedRootDatum ht).root α i) : Aˣ) : A) * u)) :=
  sorry

/-! ## C3 and C4: the group over a field -/

/-- The subgroup generated by the root subgroups. -/
noncomputable def elementary (k : Type) [Field k] : Subgroup (ChevalleyGroup t ht k) :=
  Subgroup.closure (⋃ α, Set.range (rootSubgroup t ht k α))

/-- Over an algebraically closed field every point is generated by root subgroups (C4). -/
theorem elementary_eq_top (k : Type) [Field k] [IsAlgClosed k] : elementary t ht k = ⊤ := sorry

/-- The Tits system of the elementary group: `B = U T`, `N` generated by `T` and the Weyl
representatives, and the simple reflections of the pinned base (C3). -/
def titsSystem (k : Type) [Field k] : TitsSystem (elementary t ht k) := sorry

/-! ## C5: endomorphisms and their character maps -/

/-- The value at a torus parameter `s` of the character `χ`, both in fundamental-weight
coordinates: `χ(s) = ∏ i, s i ^ χ i`. -/
def charEval {n : ℕ} {M : Type*} [CommGroup M] (χ : Fin n → ℤ) (s : Fin n → M) : M :=
  ∏ i, s i ^ χ i

/-- `φ` is a character map of `F`: `F` maps the torus into itself and pulls characters back along
`φ`, so `χ (F (torus s)) = (φ χ) s`. This is data checked against `F`, not extracted from it: an
abstract endomorphism of the points need not act on the torus through characters (entrywise complex
conjugation on `SL₂(ℂ)`, or a non-integral element of `Gal(𝔽̄_p / 𝔽_p) ≅ Ẑ`). Over a finite field
`φ` is not determined by `F`. -/
def IsCharacterMap {k : Type} [Field k] (F : ChevalleyGroup t ht k →* ChevalleyGroup t ht k)
    (φ : (Fin t.rank → ℤ) →+ (Fin t.rank → ℤ)) : Prop :=
  ∀ s, F (torus t ht k s) = torus t ht k (fun i => charEval (φ (Pi.single i 1)) s)

/-- Character maps compose contravariantly. -/
theorem IsCharacterMap.comp {k : Type} [Field k]
    {F G : ChevalleyGroup t ht k →* ChevalleyGroup t ht k}
    {φ ψ : (Fin t.rank → ℤ) →+ (Fin t.rank → ℤ)}
    (hF : IsCharacterMap t ht F φ) (hG : IsCharacterMap t ht G ψ) :
    IsCharacterMap t ht (F.comp G) (ψ.comp φ) := sorry

/-- Over an infinite field a character map is unique. -/
theorem IsCharacterMap.unique {k : Type} [Field k] [Infinite k]
    {F : ChevalleyGroup t ht k →* ChevalleyGroup t ht k}
    {φ φ' : (Fin t.rank → ℤ) →+ (Fin t.rank → ℤ)}
    (h : IsCharacterMap t ht F φ) (h' : IsCharacterMap t ht F φ') : φ = φ' := sorry

/-- A *standard* endomorphism over an algebraically closed field: it has an injective character
map and maps each root subgroup onto a root subgroup. A *based* one also maps positive root
subgroups to positive root subgroups; that refinement is specified in `README.md`, C5. -/
def IsStandard {k : Type} [Field k] [IsAlgClosed k]
    (F : ChevalleyGroup t ht k →* ChevalleyGroup t ht k) : Prop :=
  (∃ φ : (Fin t.rank → ℤ) →+ (Fin t.rank → ℤ),
      Function.Injective φ ∧ IsCharacterMap t ht F φ) ∧
    ∀ α, ∃ β, (F.comp (rootSubgroup t ht k α)).range = (rootSubgroup t ht k β).range

/-- **Lang's equation on the torus.** If some positive power of a character map of `F` is a
positive power of `p`, then every torus point has the form `u F(u)⁻¹`. This is the step that turns
`F = Int(s) ∘ F₀` from rigidity into a conjugacy `F = Int(u) ∘ F₀ ∘ Int(u)⁻¹`. -/
theorem exists_torus_eq_mul_inv {k : Type} [Field k] [IsAlgClosed k] (p : ℕ) [CharP k p]
    (F : ChevalleyGroup t ht k →* ChevalleyGroup t ht k)
    (φ : AddMonoid.End (Fin t.rank → ℤ)) (hF : IsCharacterMap t ht F φ)
    {n r : ℕ} (hn : 0 < n) (hr : 0 < r) (hφ : φ ^ n = ((p ^ r : ℕ) : ℤ) • (1 : AddMonoid.End _))
    (s : Fin t.rank → kˣ) :
    ∃ u, torus t ht k s = torus t ht k u * (F (torus t ht k u))⁻¹ := sorry

/-- The graph automorphism of a diagram symmetry, induced by the numbered symmetry of the
full-weight module. -/
def graphAut (k : Type) [Field k] {σ : Equiv.Perm (Fin t.rank)} (hσ : σ ∈ t.diagramSymmetry) :
    ChevalleyGroup t ht k ≃* ChevalleyGroup t ht k := sorry

/-- `γ_σ (x_{α_i}(u)) = x_{α_{σ i}}(u)` on the positive simple root subgroups. The same equation holds
on the negative simple root subgroups, and the two together determine `γ_σ`: the positive ones
alone do not, since conjugation by a highest-root element fixes each of them. -/
theorem graphAut_rootSubgroup_simpleIndex (k : Type) [Field k] {σ : Equiv.Perm (Fin t.rank)}
    (hσ : σ ∈ t.diagramSymmetry) (i : Fin t.rank) (u : Multiplicative k) :
    graphAut t ht k hσ (rootSubgroup t ht k (t.simpleIndex ht i) u) =
      rootSubgroup t ht k (t.simpleIndex ht (σ i)) u := sorry

end TauCetiRoadmap.ChevalleyGroups
