import Mathlib
import TauCeti.Algebra.Lie.AdjointAction.InnerAutomorphismGroup
import TauCeti.Algebra.Lie.AdjointAction.Regular
import TauCeti.LinearAlgebra.SymmetricAlgebra.Homogeneous
import TauCeti.LinearAlgebra.SymmetricAlgebra.LieModule

/-!
# Nilpotent orbits, Springer resolution and subregular geometry: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states, each admitted, the headline
theorems of the roadmap that are statable against the pinned Mathlib and Tau Ceti. They are
written for a finite-dimensional complex Lie algebra `L` with nondegenerate Killing form, such as
the Lie algebra `𝔤` of the group `G` of the README. The polynomial functions on `L` are the
symmetric algebra `S(L*)` of the dual, a point `x` evaluating them through
`SymmetricAlgebra.lift (Module.Dual.eval ℂ L x)`, and the invariant ones are Tau Ceti's
`TauCeti.SymmetricAlgebra.lieInvariants ℂ L (Module.Dual ℂ L)`. A Zariski closure is expressed
through these functions: `x` lies in the closure of a set when every polynomial function vanishing
on the set vanishes at `x`.

* Finiteness of the nilpotent orbits under the group `TauCeti.intLieAlgebra ℂ L` of inner
  automorphisms (README §2.4).
* Density of the regular nilpotent elements in the nilpotent cone, and
  `dim 𝒩 = dim L - rank L` (README §2.3).
* The subregular orbit of a simple Lie algebra: its centralizer has dimension `rank L + 2`, it is
  the only nilpotent orbit with that centralizer dimension, and its closure is the set of
  nilpotent elements that are not regular (README §3.1).
* Kostant's theorem: the ideal of `S(L*)` generated by the invariants of positive degree is
  generated by a regular sequence of `rank L` homogeneous invariants and is prime (README §§1.3
  and 5.0), and its quotient, the coordinate ring of the nilpotent cone, is integrally closed
  (README §7.2).

These headline theorems are not statable at the pins:

* the exponential isomorphism between the nilpotent scheme and the unipotent variety of `G`
  (README §5.2): the unipotent variety of an affine algebraic group as a reduced closed
  subscheme, and morphisms of schemes between it and the nilpotent scheme, are missing;
* the Springer resolution `T*ℬ → 𝒩` (README §7.1): the flag variety `G/B` as a smooth projective
  scheme is missing;
* the identification of the subregular slice surfaces with the ADE surface singularities and of
  their exceptional curves with the Dynkin diagram (README §§6.2 and 8.1–8.3): completed local
  rings of these surfaces, minimal resolutions of surfaces and intersection numbers of curves on
  them are missing;
* the component actions on those curves and the folding comparison (README §§9.1–9.3), which act
  on the same missing objects.

The headline results of the lower layers are Tau Ceti declarations and are not restated here: the
internal Jordan decomposition (`TauCeti.LieAlgebra.jordanDecomposition`), the Jacobson–Morozov
theorem (`TauCeti.exists_isSl2Triple_of_isNilpotent_ad`), the transversality of the Slodowy slice
(`IsSl2Triple.isCompl_range_ad_e_ker_ad_f`), the classification and closure order of nilpotent
matrices (`Module.End.exists_linearEquiv_conj_eq_iff_jordanPartition_parts_eq`,
`Matrix.mem_closure_orbit_iff_forall_rank_pow_le`) and the inverse laws of the nilpotent
exponential and logarithm (`IsNilpotent.log_exp`, `IsNilpotent.exp_log`).
-/

namespace TauCetiRoadmap.NilpotentOrbits

open LieAlgebra Module

/-! ## Layer 1: the nilpotent cone, the adjoint quotient and the incidence variety -/

/-- The ideal of the nilpotent cone (README §1.1): the ideal of the algebra `S(L*)` of polynomial
functions on `L` generated by the invariant polynomial functions with zero constant term. Its
common zeros are the elements `x` with `ad x` nilpotent
(`TauCeti.isNilpotent_ad_iff_forall_lift_eval_eq_zero`). -/
noncomputable def nilpotentConeIdeal (K L : Type*) [Field K] [LieRing L] [LieAlgebra K L] :
    Ideal (SymmetricAlgebra K (Dual K L)) :=
  Ideal.span {p | p ∈ TauCeti.SymmetricAlgebra.lieInvariants K L (Dual K L) ∧
    SymmetricAlgebra.algebraMapInv p = 0}

/-! ## Layer 2: sl₂-triples, finiteness of orbits and the dense regular orbit -/

/-- **Finitely many nilpotent orbits** (README §2.4). In a finite-dimensional complex Lie algebra
with nondegenerate Killing form, the elements `x` with `ad x` nilpotent fall into finitely many
orbits of the group of inner automorphisms, the group generated by the `exp (ad y)` with `ad y`
nilpotent. The proof attaches to `x` an `sl₂`-triple and its weighted Dynkin diagram, and shows
that the diagram determines the orbit. -/
theorem finite_orbits_isNilpotent_ad {L : Type*} [LieRing L] [LieAlgebra ℂ L] [LieAlgebra ℚ L]
    [FiniteDimensional ℂ L] [IsKilling ℂ L] :
    (Set.range fun x : {x : L // IsNilpotent (ad ℂ L x)} ↦
      MulAction.orbit (TauCeti.intLieAlgebra ℂ L) (x : L)).Finite := by
  sorry

/-- **The regular nilpotent elements are dense in the nilpotent cone** (README §2.3). A polynomial
function on `L` that vanishes at every nilpotent element whose centralizer has minimal dimension
vanishes at every nilpotent element: the regular nilpotent elements are Zariski dense among the
nilpotent ones. -/
theorem lift_eval_eq_zero_of_forall_isCentralizerRegular {L : Type*} [LieRing L]
    [LieAlgebra ℂ L] [FiniteDimensional ℂ L] [IsKilling ℂ L] (p : SymmetricAlgebra ℂ (Dual ℂ L))
    (hp : ∀ x : L, IsNilpotent (ad ℂ L x) → IsCentralizerRegular ℂ x →
      SymmetricAlgebra.lift (Dual.eval ℂ L x) p = 0)
    {x : L} (hx : IsNilpotent (ad ℂ L x)) :
    SymmetricAlgebra.lift (Dual.eval ℂ L x) p = 0 := by
  sorry

/-- **The dimension of the nilpotent cone** (README §2.3): `dim 𝒩 = dim L - rank L`, the Krull
dimension of the quotient of `S(L*)` by the ideal of the nilpotent cone. -/
theorem ringKrullDim_quotient_nilpotentConeIdeal {L : Type*} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] [IsKilling ℂ L] :
    ringKrullDim (SymmetricAlgebra ℂ (Dual ℂ L) ⧸ nilpotentConeIdeal ℂ L) =
      ((finrank ℂ L - LieAlgebra.rank ℂ L : ℕ) : WithBot ℕ∞) := by
  sorry

/-! ## Layer 3: subregular strata and semisimple products -/

/-- **The subregular orbit** (README §3.1). In a simple complex Lie algebra `L` there is an
element `e` with `ad e` nilpotent whose centralizer `ker (ad e)` has dimension `rank L + 2`, so
that its orbit has codimension two in the nilpotent cone. Every nilpotent element with a
centralizer of that dimension lies in the orbit of `e` under the inner automorphisms, and an
element `x` lies in the Zariski closure of that orbit exactly when `ad x` is nilpotent and `x` is
not regular: the complement of the regular orbit in the nilpotent cone is the closure of the
subregular orbit. -/
theorem exists_subregular_orbit {L : Type*} [LieRing L] [LieAlgebra ℂ L] [LieAlgebra ℚ L]
    [FiniteDimensional ℂ L] [IsSimple ℂ L] :
    ∃ e : L, IsNilpotent (ad ℂ L e) ∧
      finrank ℂ (LinearMap.ker (ad ℂ L e)) = LieAlgebra.rank ℂ L + 2 ∧
      (∀ x : L, IsNilpotent (ad ℂ L x) →
        finrank ℂ (LinearMap.ker (ad ℂ L x)) = LieAlgebra.rank ℂ L + 2 →
        x ∈ MulAction.orbit (TauCeti.intLieAlgebra ℂ L) e) ∧
      ∀ x : L, (∀ p : SymmetricAlgebra ℂ (Dual ℂ L),
          (∀ y ∈ MulAction.orbit (TauCeti.intLieAlgebra ℂ L) e,
            SymmetricAlgebra.lift (Dual.eval ℂ L y) p = 0) →
          SymmetricAlgebra.lift (Dual.eval ℂ L x) p = 0) ↔
        IsNilpotent (ad ℂ L x) ∧ ¬ IsCentralizerRegular ℂ x := by
  sorry

/-! ## Layer 5: the polynomial exponential and the unipotent variety -/

/-- **Kostant: the nilpotent cone is a complete intersection** (README §5.0). The ideal of `S(L*)`
generated by the invariants of positive degree is generated by a regular sequence of `rank L`
homogeneous invariant polynomial functions. -/
theorem exists_isRegular_ofList_eq_nilpotentConeIdeal {L : Type*} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] [IsKilling ℂ L] :
    ∃ rs : List (SymmetricAlgebra ℂ (Dual ℂ L)), rs.length = LieAlgebra.rank ℂ L ∧
      (∀ p ∈ rs, p ∈ TauCeti.SymmetricAlgebra.lieInvariants ℂ L (Dual ℂ L) ∧
        ∃ n, p ∈ TauCeti.SymmetricAlgebra.homogeneousSubmodule ℂ (Dual ℂ L) n) ∧
      Ideal.ofList rs = nilpotentConeIdeal ℂ L ∧
      RingTheory.Sequence.IsRegular (SymmetricAlgebra ℂ (Dual ℂ L)) rs := by
  sorry

/-- **Kostant: the nilpotent cone is reduced and irreducible** (README §§1.3 and 5.0). The ideal
of `S(L*)` generated by the invariants of positive degree is prime. In particular it is radical,
so it is the ideal of all polynomial functions vanishing on the ad-nilpotent elements. -/
theorem nilpotentConeIdeal_isPrime {L : Type*} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] [IsKilling ℂ L] :
    (nilpotentConeIdeal ℂ L).IsPrime := by
  sorry

/-! ## Layer 7: the Springer resolution and the geometry of the cone -/

/-- **Kostant: the nilpotent cone is normal** (README §7.2). The coordinate ring of the nilpotent
cone, the quotient of `S(L*)` by the ideal generated by the invariants of positive degree, is
integrally closed. -/
theorem isIntegrallyClosed_quotient_nilpotentConeIdeal {L : Type*} [LieRing L] [LieAlgebra ℂ L]
    [FiniteDimensional ℂ L] [IsKilling ℂ L] :
    IsIntegrallyClosed (SymmetricAlgebra ℂ (Dual ℂ L) ⧸ nilpotentConeIdeal ℂ L) := by
  sorry

end TauCetiRoadmap.NilpotentOrbits
