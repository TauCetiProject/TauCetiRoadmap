/-! ## Supplier copies: DimerModelsAndLozengeTilings, Layer 4 -/

/-- Local copy of `Subshift` (DimerModelsAndLozengeTilings 4.4): a closed set of configurations
`I → S` invariant under the action `(g • ω) i = ω (g⁻¹ • i)` of `Γ`. -/
structure Subshift (Γ I S : Type*) [Group Γ] [MulAction Γ I] [TopologicalSpace S] where
  /-- The configurations. -/
  carrier : Set (I → S)
  /-- The set of configurations is closed for the product topology. -/
  isClosed : IsClosed carrier
  /-- The set of configurations is invariant under the action. -/
  smul_mem : ∀ (g : Γ) {ω : I → S}, ω ∈ carrier → (fun i => ω (g⁻¹ • i)) ∈ carrier

/-- A subshift is used as the type of its configurations (local copy). -/
instance {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S] :
    CoeSort (Subshift Γ I S) (Type _) :=
  ⟨fun X => X.carrier⟩

/-- Local copy of `Subshift.exterior` (DimerModelsAndLozengeTilings 4.5): the trace of the
σ-algebra generated by the coordinates outside `Λ`. -/
abbrev Subshift.exterior {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]
    [MeasurableSpace S] (X : Subshift Γ I S) (Λ : Set I) : MeasurableSpace X :=
  MeasurableSpace.comap Subtype.val (cylinderEvents (X := fun _ : I => S) Λᶜ)

/-- Local copy of `Specification` (DimerModelsAndLozengeTilings 4.5): Markov kernels measurable
for `𝓕_{Λᶜ}` on the source, each proper, and consistent. -/
structure Specification {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]
    [MeasurableSpace S] (X : Subshift Γ I S) where
  /-- The kernel of a finite set. -/
  kernel (Λ : Finset I) : @Kernel X X (X.exterior Λ) _
  /-- Each kernel is Markov. -/
  isMarkovKernel (Λ : Finset I) : IsMarkovKernel (kernel Λ)
  /-- Each kernel is proper. -/
  isProper (Λ : Finset I) : (kernel Λ).IsProper
  /-- Consistency: resampling `Δ` and then `Λ ⊆ Δ` is resampling `Δ`. -/
  comp_eq ⦃Λ Δ : Finset I⦄ (h : Λ ⊆ Δ) :
    (kernel Λ).comap id (measurable_id'' (MeasurableSpace.comap_mono cylinderEvents_le_pi)) ∘ₖ
      kernel Δ = kernel Δ

/-- Local copy of `Specification.IsGibbs` (DimerModelsAndLozengeTilings 4.5). -/
def Specification.IsGibbs {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]
    [MeasurableSpace S] {X : Subshift Γ I S} (γ : Specification X) (μ : Measure X) : Prop :=
  ∀ Λ : Finset I, μ.bind (γ.kernel Λ) = μ

/-- Local copy of quasilocality (DimerModelsAndLozengeTilings 4.5, prose): every cylinder
probability is a continuous function of the boundary condition. -/
def Specification.IsQuasilocal {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S]
    [MeasurableSpace S] {X : Subshift Γ I S} (γ : Specification X) : Prop :=
  ∀ (Λ : Finset I), ∀ C ∈ measurableCylinders (fun _ : I ↦ S),
    Continuous fun ω : X ↦ γ.kernel Λ ω (Subtype.val ⁻¹' C)

/-! ## Layer 1: tail triviality and the extremal Gibbs measures -/

section Extremal

variable {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S] [MeasurableSpace S]

variable (Γ I S) in
/-- The full shift: the subshift of all configurations. -/
def Subshift.univ : Subshift Γ I S where
  carrier := Set.univ
  isClosed := isClosed_univ
  smul_mem _ _ _ := Set.mem_univ _

variable (Γ I S) in
/-- The configurations of the full shift. -/
abbrev FullShift : Type _ := Subshift.univ Γ I S

/-- A configuration as a point of the full shift. -/
def toFullShift (ω : I → S) : FullShift Γ I S := ⟨ω, Set.mem_univ _⟩

variable (Γ I S) in
/-- The tail σ-algebra on the full shift: the trace of `⋂_Λ 𝓕_{Λᶜ}` over finite `Λ`
(DimerModelsAndLozengeTilings 4.1). -/
@[instance_reducible]
def tailSigma : MeasurableSpace (FullShift Γ I S) :=
  MeasurableSpace.comap Subtype.val (⨅ Λ : Finset I, cylinderEvents (X := fun _ : I ↦ S) (↑Λ)ᶜ)

variable (Γ I S) in
/-- The cylinder events of the full shift. -/
def cylinderSets : Set (Set (FullShift Γ I S)) :=
  {A | ∃ C ∈ measurableCylinders (fun _ : I ↦ S), A = Subtype.val ⁻¹' C}

/-- An exhaustion of `I`: an increasing sequence of finite sets with union `I`. -/
def IsExhaustion (Λ : ℕ → Finset I) : Prop := Monotone Λ ∧ ∀ s, ∃ n, s ∈ Λ n

/-- An extremal Gibbs probability measure: not a proper convex combination of two other Gibbs
probability measures. -/
def IsExtremalGibbs (γ : Specification (Subshift.univ Γ I S)) (μ : Measure (FullShift Γ I S)) :
    Prop :=
  IsProbabilityMeasure μ ∧ γ.IsGibbs μ ∧
    ∀ (ν₁ ν₂ : Measure (FullShift Γ I S)) (t : ℝ≥0∞), IsProbabilityMeasure ν₁ →
      IsProbabilityMeasure ν₂ → γ.IsGibbs ν₁ → γ.IsGibbs ν₂ → 0 < t → t < 1 →
        μ = t • ν₁ + (1 - t) • ν₂ → ν₁ = μ ∧ ν₂ = μ

/-- 1.1: the converse of DimerModelsAndLozengeTilings 4.6(a). If a probability measure with a
density with respect to a Gibbs probability measure is Gibbs, the density agrees almost
everywhere with a tail-measurable function. -/
theorem exists_tail_ae_eq_of_isGibbs_withDensity (γ : Specification (Subshift.univ Γ I S))
    {μ : Measure (FullShift Γ I S)} [IsProbabilityMeasure μ] (hμ : γ.IsGibbs μ)
    {f : FullShift Γ I S → ℝ≥0∞} (hf : Measurable f) (hf1 : ∫⁻ ω, f ω ∂μ = 1)
    (hfμ : γ.IsGibbs (μ.withDensity f)) :
    ∃ g : FullShift Γ I S → ℝ≥0∞, Measurable[tailSigma Γ I S] g ∧ f =ᵐ[μ] g := by
  sorry

/-- 1.1: two Gibbs probability measures that agree on the tail σ-algebra are equal. -/
theorem eq_of_forall_tail_eq (γ : Specification (Subshift.univ Γ I S))
    {μ ν : Measure (FullShift Γ I S)} [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (hμ : γ.IsGibbs μ) (hν : γ.IsGibbs ν)
    (h : ∀ A, MeasurableSet[tailSigma Γ I S] A → μ A = ν A) : μ = ν := by
  sorry

/-- 1.2: a Gibbs probability measure is extremal if and only if it is trivial on the tail
σ-algebra. -/
theorem isExtremalGibbs_iff_tail_trivial (γ : Specification (Subshift.univ Γ I S))
    (μ : Measure (FullShift Γ I S)) [IsProbabilityMeasure μ] (hμ : γ.IsGibbs μ) :
    IsExtremalGibbs γ μ ↔ ∀ A, MeasurableSet[tailSigma Γ I S] A → μ A = 0 ∨ μ A = 1 := by
  sorry

/-- 1.2: an extremal Gibbs measure has short-range correlations: every event is asymptotically
independent of the events outside large finite sets. -/
theorem IsExtremalGibbs.decorrelation {γ : Specification (Subshift.univ Γ I S)}
    {μ : Measure (FullShift Γ I S)} (hμ : IsExtremalGibbs γ μ) {A : Set (FullShift Γ I S)}
    (hA : MeasurableSet A) {ε : ℝ} (hε : 0 < ε) :
    ∃ Λ : Finset I, ∀ B, MeasurableSet[(Subshift.univ Γ I S).exterior Λ] B →
      |(μ (A ∩ B)).toReal - (μ A).toReal * (μ B).toReal| ≤ ε := by
  sorry

/-- 1.2: distinct extremal Gibbs measures are carried by disjoint tail events. -/
theorem IsExtremalGibbs.exists_tail_separating {γ : Specification (Subshift.univ Γ I S)}
    {μ ν : Measure (FullShift Γ I S)} (hμ : IsExtremalGibbs γ μ) (hν : IsExtremalGibbs γ ν)
    (hne : μ ≠ ν) :
    ∃ A, MeasurableSet[tailSigma Γ I S] A ∧ μ A = 0 ∧ ν A = 1 := by
  sorry

/-- 1.3: an extremal Gibbs measure is, for almost every boundary condition, the limit of the
kernels along any exhaustion, tested on cylinder events. -/
theorem IsExtremalGibbs.ae_tendsto [Countable I] [Finite S] [DiscreteMeasurableSpace S]
    {γ : Specification (Subshift.univ Γ I S)} {μ : Measure (FullShift Γ I S)}
    (hμ : IsExtremalGibbs γ μ) {Λ : ℕ → Finset I} (hΛ : IsExhaustion Λ) :
    ∀ᵐ ω ∂μ, ∀ C ∈ cylinderSets Γ I S, Tendsto (fun n ↦ γ.kernel (Λ n) ω C) atTop (𝓝 (μ C)) := by
  sorry

/-- 1.3: the extremal decomposition. For a finite spin space there is one tail-measurable
kernel that, for every Gibbs probability measure `μ`, takes extremal values `μ`-almost surely
and decomposes `μ`. -/
theorem exists_extremalDecomposition [Countable I] [Finite S] [DiscreteMeasurableSpace S]
    (γ : Specification (Subshift.univ Γ I S)) :
    ∃ Q : Kernel[tailSigma Γ I S] (FullShift Γ I S) (FullShift Γ I S),
      ∀ μ : Measure (FullShift Γ I S), IsProbabilityMeasure μ → γ.IsGibbs μ →
        (∀ᵐ ω ∂μ, IsExtremalGibbs γ (Q ω)) ∧ ∀ B, MeasurableSet B → μ B = ∫⁻ ω, Q ω B ∂μ := by
  sorry

end Extremal

/-! ## Layer 2: existence and Gibbsian specifications -/

section Existence

variable {Γ I S : Type*} [Group Γ] [MulAction Γ I] [Countable I] [TopologicalSpace S]
  [DiscreteTopology S] [MeasurableSpace S] [DiscreteMeasurableSpace S] [Finite S] [Nonempty S]

/-- 2.1: a quasilocal specification on a finite spin space has a Gibbs probability measure. -/
theorem exists_isGibbs_of_isQuasilocal (γ : Specification (Subshift.univ Γ I S))
    (hq : γ.IsQuasilocal) :
    ∃ μ : Measure (FullShift Γ I S), IsProbabilityMeasure μ ∧ γ.IsGibbs μ := by
  sorry

/-- 2.1: a Gibbs probability measure of a quasilocal specification is the only one exactly when
every boundary condition and every exhaustion give kernels converging to it on cylinder events. -/
theorem isGibbs_unique_iff_tendsto (γ : Specification (Subshift.univ Γ I S))
    (hq : γ.IsQuasilocal) (μ : Measure (FullShift Γ I S)) [IsProbabilityMeasure μ]
    (hμ : γ.IsGibbs μ) :
    (∀ ν : Measure (FullShift Γ I S), IsProbabilityMeasure ν → γ.IsGibbs ν → ν = μ) ↔
      ∀ (ω : FullShift Γ I S) (Λ : ℕ → Finset I), IsExhaustion Λ →
        ∀ C ∈ cylinderSets Γ I S, Tendsto (fun n ↦ γ.kernel (Λ n) ω C) atTop (𝓝 (μ C)) := by
  sorry

end Existence

section Potential

variable {I S : Type*}

variable (I S) in
/-- A potential: for each finite `B` a real function of the configuration that depends only on
the spins in `B`. -/
structure Potential where
  /-- The interaction energy of the set `B`. -/
  toFun : Finset I → (I → S) → ℝ
  /-- The energy of `B` depends only on the spins in `B`. -/
  local' : ∀ (B : Finset I) (ω η : I → S), (∀ i ∈ B, ω i = η i) → toFun B ω = toFun B η

namespace Potential

/-- The sup norm `‖Φ_B‖∞` of the energy of `B`. -/
def supNorm (Φ : Potential I S) (B : Finset I) : ℝ := ⨆ ω, |Φ.toFun B ω|

/-- The oscillation `δ(Φ_B) = sup |Φ_B ω − Φ_B η|`. -/
def osc (Φ : Potential I S) (B : Finset I) : ℝ :=
  ⨆ (ω : I → S) (η : I → S), |Φ.toFun B ω - Φ.toFun B η|

/-- Absolute summability: for each site, the sup norms of the energies of the sets containing
it are summable. -/
def IsAbsSummable (Φ : Potential I S) : Prop :=
  ∀ i : I, Summable fun B : {B : Finset I // i ∈ B} ↦ Φ.supNorm B

/-- The potential `β Φ`. -/
def smul (β : ℝ) (Φ : Potential I S) : Potential I S where
  toFun B ω := β * Φ.toFun B ω
  local' B ω η h := by rw [Φ.local' B ω η h]

/-- The Hamiltonian in `Λ`: the sum of the energies of the finite sets meeting `Λ`. -/
def hamiltonian (Φ : Potential I S) (Λ : Finset I) (ω : I → S) : ℝ :=
  ∑' B : {B : Finset I // (B ∩ Λ).Nonempty}, Φ.toFun B ω

end Potential

/-- The configuration equal to `ζ` on `Λ` and to `η` outside. -/
def juxt (Λ : Finset I) (η : I → S) (ζ : Λ → S) (x : I) : S :=
  if h : x ∈ Λ then ζ ⟨x, h⟩ else η x

variable [Fintype S]

/-- The partition function in `Λ` with boundary condition `ω`. -/
def partitionFunction (Φ : Potential I S) (Λ : Finset I) (ω : I → S) : ℝ :=
  ∑ τ : (Λ → S), Real.exp (-Φ.hamiltonian Λ (juxt Λ ω τ))

variable {Γ : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S] [MeasurableSpace S]

variable (Γ) in
/-- The Gibbs kernel of a potential on the full shift: the Boltzmann weights `exp (-H_Λ) / Z`
on the configurations that agree with the boundary condition outside `Λ`. -/
def gibbsKernel (Φ : Potential I S) (Λ : Finset I) (ω : FullShift Γ I S) :
    Measure (FullShift Γ I S) :=
  ∑ τ : (Λ → S), ENNReal.ofReal (Real.exp (-Φ.hamiltonian Λ (juxt Λ ω.1 τ)) /
    partitionFunction Φ Λ ω.1) • Measure.dirac (toFullShift (juxt Λ ω.1 τ))

/-- The DLR condition for a raw family of measure-valued functions on a subshift, in integrated
form. -/
def IsGibbsFamily {X : Subshift Γ I S} (κ : Finset I → X → Measure X) (μ : Measure X) : Prop :=
  ∀ (Λ : Finset I) ⦃A : Set X⦄, MeasurableSet A → ∫⁻ ω, κ Λ ω A ∂μ = μ A

variable [DiscreteTopology S] [DiscreteMeasurableSpace S] [Nonempty S]

/-- 2.2: an absolutely summable potential defines a quasilocal specification whose kernels are
the Gibbs kernels; its Gibbs measures are the measures satisfying the integrated DLR condition
for those kernels. -/
theorem exists_specification_gibbsKernel [Countable I] (Φ : Potential I S)
    (hΦ : Φ.IsAbsSummable) :
    ∃ γ : Specification (Subshift.univ Γ I S), (∀ Λ, ⇑(γ.kernel Λ) = gibbsKernel Γ Φ Λ) ∧
      γ.IsQuasilocal ∧ ∀ μ, γ.IsGibbs μ ↔ IsGibbsFamily (gibbsKernel Γ Φ) μ := by
  sorry

end Potential

/-! ## Layer 3: uniqueness -/

section Uniqueness

variable {Γ I S : Type*} [Group Γ] [MulAction Γ I] [TopologicalSpace S] [MeasurableSpace S]

/-- Dobrushin's interdependence coefficient: the largest total variation distance, measured as
`sup_A |p A − q A|`, between the single-site kernels at `i` for two boundary conditions that
differ only at `j`. -/
def dobrushinCoeff (κ : Finset I → FullShift Γ I S → Measure (FullShift Γ I S)) (i j : I) :
    ℝ≥0∞ :=
  ⨆ (ω : FullShift Γ I S) (ω' : FullShift Γ I S) (_ : ∀ k, k ≠ j → ω.1 k = ω'.1 k)
    (A : Set (FullShift Γ I S)) (_ : MeasurableSet A),
      ENNReal.ofReal |(κ {i} ω A).toReal - (κ {i} ω' A).toReal|

variable [Countable I] [Fintype S] [Nonempty S] [DiscreteMeasurableSpace S] [DiscreteTopology S]

/-- 3.1: Dobrushin's uniqueness theorem. -/
theorem existsUnique_isGibbs_of_dobrushin (γ : Specification (Subshift.univ Γ I S))
    (hq : γ.IsQuasilocal) (hc : (⨆ i, ∑' j, dobrushinCoeff (fun Λ ↦ ⇑(γ.kernel Λ)) i j) < 1) :
    ∃! μ : Measure (FullShift Γ I S), IsProbabilityMeasure μ ∧ γ.IsGibbs μ := by
  sorry

/-- 3.1: Dobrushin's coefficient of a Gibbs kernel is at most half the summed oscillations of the
energies of the sets containing both sites. -/
theorem dobrushinCoeff_gibbsKernel_le (Φ : Potential I S) (hΦ : Φ.IsAbsSummable) {i j : I}
    (hij : i ≠ j) :
    dobrushinCoeff (gibbsKernel Γ Φ) i j ≤
      ENNReal.ofReal ((1 / 2) * ∑' B : {B : Finset I // i ∈ B ∧ j ∈ B}, Φ.osc B) := by
  sorry

/-- 3.1: uniqueness at high temperature for a potential with
`sup_i Σ_{B ∋ i} (|B| − 1) ‖Φ_B‖∞ ≤ b`, when `2 β b < 1`. -/
theorem existsUnique_isGibbsFamily_of_highTemperature (Φ : Potential I S)
    (hΦ : Φ.IsAbsSummable) {b β : ℝ}
    (hsum : ∀ i : I, Summable fun B : {B : Finset I // i ∈ B} ↦
      (((B : Finset I).card : ℝ) - 1) * Φ.supNorm B)
    (hb : ∀ i : I,
      ∑' B : {B : Finset I // i ∈ B}, (((B : Finset I).card : ℝ) - 1) * Φ.supNorm B ≤ b)
    (hβ : 0 ≤ β) (hβb : 2 * β * b < 1) :
    ∃! μ : Measure (FullShift Γ I S),
      IsProbabilityMeasure μ ∧ IsGibbsFamily (gibbsKernel Γ (Φ.smul β)) μ := by
  sorry

/-- 3.2: uniqueness in one dimension when the interaction between an interval and its exterior
is bounded uniformly in the interval. -/
theorem existsUnique_isGibbsFamily_of_boundary_bounded (Φ : Potential ℤ S)
    (hΦ : Φ.IsAbsSummable) {D : ℝ}
    (hD : ∀ (n : ℕ) (ω ω' : ℤ → S), (∀ i ∈ Finset.Icc (-(n : ℤ)) n, ω i = ω' i) →
      |Φ.hamiltonian (Finset.Icc (-(n : ℤ)) n) ω -
        Φ.hamiltonian (Finset.Icc (-(n : ℤ)) n) ω'| ≤ D) :
    ∃! μ : Measure (FullShift (Multiplicative ℤ) ℤ S),
      IsProbabilityMeasure μ ∧ IsGibbsFamily (gibbsKernel (Multiplicative ℤ) Φ) μ := by
  sorry

/-- 3.2: every bounded finite-range potential on `ℤ` has exactly one Gibbs measure. -/
theorem existsUnique_isGibbsFamily_of_finiteRange_int (Φ : Potential ℤ S) (R : ℕ) {M : ℝ}
    (hR : ∀ (B : Finset ℤ) (ω : ℤ → S), (∃ i ∈ B, ∃ j ∈ B, (R : ℤ) < |i - j|) →
      Φ.toFun B ω = 0)
    (hM : ∀ (B : Finset ℤ) (ω : ℤ → S), |Φ.toFun B ω| ≤ M) :
    ∃! μ : Measure (FullShift (Multiplicative ℤ) ℤ S),
      IsProbabilityMeasure μ ∧ IsGibbsFamily (gibbsKernel (Multiplicative ℤ) Φ) μ := by
  sorry

end Uniqueness

/-! ## Layer 4: the Ising model, monotonicity and the plus and minus states -/

section Ising

/-- The sites of `ℤ^d`. -/
abbrev Site (d : ℕ) := Fin d → ℤ

/-- The Ising configurations: the full shift over `ℤ^d` with spins in `Bool`, `ℤ^d` acting by
translation. -/
abbrev IsingConfig (d : ℕ) : Type := FullShift (Multiplicative (Site d)) (Site d) Bool

/-- The value `±1` of an Ising spin; `true` is `−1`. -/
def spin (b : Bool) : ℝ := if b then -1 else 1

/-- The nearest-neighbour Ising potential at inverse temperature `β` and field `h`:
`−β σ_i σ_j` on nearest-neighbour pairs, `−h σ_i` on singletons. -/
def isingPotential (d : ℕ) (β h : ℝ) : Potential (Site d) Bool where
  toFun B ω :=
    if ∃ i j : Site d, B = {i, j} ∧ ∑ k, |i k - j k| = 1 then -β * ∏ i ∈ B, spin (ω i)
    else if ∃ i : Site d, B = {i} then -h * ∏ i ∈ B, spin (ω i) else 0
  local' B ω η hωη := by
    have : ∏ i ∈ B, spin (ω i) = ∏ i ∈ B, spin (η i) :=
      Finset.prod_congr rfl fun i hi ↦ by rw [hωη i hi]
    simp only [this]

/-- The finite-volume Ising kernels with boundary conditions. -/
def isingKernel (d : ℕ) (β h : ℝ) : Finset (Site d) → IsingConfig d → Measure (IsingConfig d) :=
  gibbsKernel _ (isingPotential d β h)

/-- The Gibbs probability measures of the Ising model. -/
def IsIsingGibbs (d : ℕ) (β h : ℝ) (μ : Measure (IsingConfig d)) : Prop :=
  IsProbabilityMeasure μ ∧ IsGibbsFamily (isingKernel d β h) μ

/-- The all-plus configuration. -/
def plusConfig (d : ℕ) : IsingConfig d := toFullShift fun _ ↦ false

/-- The all-minus configuration. -/
def minusConfig (d : ℕ) : IsingConfig d := toFullShift fun _ ↦ true

/-- Translation of configurations by `a`. -/
def translate {d : ℕ} (a : Site d) (ω : IsingConfig d) : IsingConfig d :=
  toFullShift fun i ↦ ω.1 (i + a)

/-- The global spin flip. -/
def flip {d : ℕ} (ω : IsingConfig d) : IsingConfig d := toFullShift fun i ↦ !ω.1 i

/-- A function of the configuration that depends on finitely many spins. -/
def IsLocal {d : ℕ} (f : IsingConfig d → ℝ) : Prop :=
  ∃ Λ : Finset (Site d), ∀ ω ω' : IsingConfig d, (∀ i ∈ Λ, ω.1 i = ω'.1 i) → f ω = f ω'

/-- `μ` is the plus state: the limit, on cylinder events, of the kernels with the plus boundary
condition along every exhaustion. -/
def IsPlusState (d : ℕ) (β h : ℝ) (μ : Measure (IsingConfig d)) : Prop :=
  IsProbabilityMeasure μ ∧ ∀ Λ : ℕ → Finset (Site d), IsExhaustion Λ →
    ∀ C ∈ cylinderSets _ _ _,
      Tendsto (fun n ↦ isingKernel d β h (Λ n) (plusConfig d) C) atTop (𝓝 (μ C))

/-- `μ` is the minus state. -/
def IsMinusState (d : ℕ) (β h : ℝ) (μ : Measure (IsingConfig d)) : Prop :=
  IsProbabilityMeasure μ ∧ ∀ Λ : ℕ → Finset (Site d), IsExhaustion Λ →
    ∀ C ∈ cylinderSets _ _ _,
      Tendsto (fun n ↦ isingKernel d β h (Λ n) (minusConfig d) C) atTop (𝓝 (μ C))

/-- The event that the spin at the origin is `+1`. -/
def plusAtOrigin (d : ℕ) : Set (IsingConfig d) := {ω | ω.1 0 = false}

variable {d : ℕ}

/-- 4.1: the FKG inequality for the finite-volume Ising kernels with an arbitrary boundary
condition and field, for `β ≥ 0`, and functions nondecreasing in the spins. -/
theorem isingKernel_fkg {β : ℝ} (hβ : 0 ≤ β) (h : ℝ) (Λ : Finset (Site d)) (ω : IsingConfig d)
    {f g : IsingConfig d → ℝ} (hf : Antitone f) (hg : Antitone g) :
    (∫ x, f x ∂isingKernel d β h Λ ω) * (∫ x, g x ∂isingKernel d β h Λ ω) ≤
      ∫ x, f x * g x ∂isingKernel d β h Λ ω := by
  sorry

/-- 4.1: the kernels are monotone in the boundary condition, for `β ≥ 0`: a boundary condition
with more plus spins (`η ≤ ω` in the order of `Bool`, where `false` is `+1`) gives larger
expectations of functions nondecreasing in the spins. -/
theorem isingKernel_mono_boundary {β : ℝ} (hβ : 0 ≤ β) (h : ℝ) (Λ : Finset (Site d))
    {η ω : IsingConfig d} (hηω : η ≤ ω) {f : IsingConfig d → ℝ} (hf : Antitone f) :
    ∫ x, f x ∂isingKernel d β h Λ ω ≤ ∫ x, f x ∂isingKernel d β h Λ η := by
  sorry

/-- 4.1: with the plus boundary condition, expectations of nondecreasing functions decrease as
the volume grows. -/
theorem isingKernel_plus_antitone {β : ℝ} (hβ : 0 ≤ β) (h : ℝ) {Λ₁ Λ₂ : Finset (Site d)}
    (hΛ : Λ₁ ⊆ Λ₂) {f : IsingConfig d → ℝ} (hf : Antitone f) :
    ∫ x, f x ∂isingKernel d β h Λ₂ (plusConfig d) ≤
      ∫ x, f x ∂isingKernel d β h Λ₁ (plusConfig d) := by
  sorry

/-- 4.2: the plus state exists; it is a translation-invariant Gibbs measure. -/
theorem exists_isPlusState {β : ℝ} (hβ : 0 ≤ β) (h : ℝ) :
    ∃ μ, IsPlusState d β h μ ∧ IsIsingGibbs d β h μ ∧ ∀ a : Site d, μ.map (translate a) = μ := by
  sorry

/-- 4.2: the global spin flip maps the plus state at field `h` to the minus state at `−h`. -/
theorem IsPlusState.isMinusState_map_flip {β h : ℝ} {μ : Measure (IsingConfig d)}
    (hμ : IsPlusState d β h μ) : IsMinusState d β (-h) (μ.map flip) := by
  sorry

/-- 4.2: every Ising Gibbs measure lies between the minus and the plus state on nondecreasing
local functions. -/
theorem IsIsingGibbs.integral_between {β : ℝ} (hβ : 0 ≤ β) (h : ℝ)
    {μp μm ν : Measure (IsingConfig d)} (hp : IsPlusState d β h μp) (hm : IsMinusState d β h μm)
    (hν : IsIsingGibbs d β h ν) {f : IsingConfig d → ℝ} (hf : Antitone f) (hloc : IsLocal f) :
    ∫ x, f x ∂μm ≤ ∫ x, f x ∂ν ∧ ∫ x, f x ∂ν ≤ ∫ x, f x ∂μp := by
  sorry

/-- 4.2: the plus state is extremal for the Ising specification. -/
theorem IsPlusState.isExtremalGibbs {β : ℝ} (hβ : 0 ≤ β) (h : ℝ) {μ : Measure (IsingConfig d)}
    (hμ : IsPlusState d β h μ) (γ : Specification (Subshift.univ _ (Site d) Bool))
    (hγ : ∀ Λ, ⇑(γ.kernel Λ) = isingKernel d β h Λ) : IsExtremalGibbs γ μ := by
  sorry

/-- 4.2: the plus state is trivial on translation-invariant events. -/
theorem IsPlusState.measure_eq_zero_or_one {β : ℝ} (hβ : 0 ≤ β) (h : ℝ)
    {μ : Measure (IsingConfig d)} (hμ : IsPlusState d β h μ) {A : Set (IsingConfig d)}
    (hA : MeasurableSet A) (hinv : ∀ a : Site d, translate a ⁻¹' A = A) : μ A = 0 ∨ μ A = 1 := by
  sorry

/-- 4.3: uniqueness of the Ising Gibbs measure is equivalent to the equality of the plus and
minus states, and that to the equality of their magnetizations at the origin. -/
theorem existsUnique_isIsingGibbs_iff {β : ℝ} (hβ : 0 ≤ β) (h : ℝ)
    {μp μm : Measure (IsingConfig d)} (hp : IsPlusState d β h μp) (hm : IsMinusState d β h μm) :
    ((∃! ν, IsIsingGibbs d β h ν) ↔ μp = μm) ∧
      (μp = μm ↔ μp (plusAtOrigin d) = μm (plusAtOrigin d)) := by
  sorry

/-- 4.3: the magnetization of the plus state is nondecreasing and right-continuous in the
field. -/
theorem plusState_magnetization_mono_continuousWithinAt {β : ℝ} (hβ : 0 ≤ β)
    (μ : ℝ → Measure (IsingConfig d)) (hμ : ∀ h, IsPlusState d β h (μ h)) :
    Monotone (fun h ↦ μ h (plusAtOrigin d)) ∧
      ∀ h₀, ContinuousWithinAt (fun h ↦ (μ h (plusAtOrigin d)).toReal) (Ici h₀) h₀ := by
  sorry

/-! ## Layer 5: the phase diagram -/

/-- 5.1: the one-dimensional Ising model has exactly one Gibbs measure at every `β` and `h`. -/
theorem existsUnique_isIsingGibbs_one (β h : ℝ) : ∃! ν, IsIsingGibbs 1 β h ν := by
  sorry

/-- 5.1: uniqueness at high temperature, `2 d tanh |β| < 1`, in every dimension and field. -/
theorem existsUnique_isIsingGibbs_of_tanh {β : ℝ} (h : ℝ) (hβ : 2 * d * Real.tanh |β| < 1) :
    ∃! ν, IsIsingGibbs d β h ν := by
  sorry

/-- The box `{−n, …, n}^d`. -/
def box (d n : ℕ) : Finset (Site d) := Fintype.piFinset fun _ ↦ Finset.Icc (-(n : ℤ)) n

/-- Peierls' bound `δ(β) = (2/3) Σ_{k ≥ 4} k 3^k e^{−2βk}`. -/
def peierlsBound (β : ℝ) : ℝ :=
  (2 / 3) * ∑' k : ℕ, ((k + 4 : ℕ) : ℝ) * 3 ^ (k + 4) * Real.exp (-2 * β * (k + 4 : ℕ))

/-- 5.2: Peierls' estimate in two dimensions: with the plus boundary condition and zero field,
the probability of a minus spin at the origin is at most `δ(β)`, uniformly in the box. -/
theorem isingKernel_box_minusAtOrigin_le {β : ℝ} (hβ : 0 < β) (h3 : 3 * Real.exp (-2 * β) < 1)
    (n : ℕ) :
    (isingKernel 2 β 0 (box 2 n) (plusConfig 2) (plusAtOrigin 2)ᶜ).toReal ≤ peierlsBound β := by
  sorry

/-- 5.2: spontaneous magnetization and non-uniqueness in two dimensions when `δ(β) < 1/2`. -/
theorem IsPlusState.magnetization_ge_and_not_unique {β : ℝ} (hβ : 0 < β)
    (h3 : 3 * Real.exp (-2 * β) < 1) (hδ : peierlsBound β < 1 / 2) {μ : Measure (IsingConfig 2)}
    (hμ : IsPlusState 2 β 0 μ) :
    1 - peierlsBound β ≤ (μ (plusAtOrigin 2)).toReal ∧ ¬ ∃! ν, IsIsingGibbs 2 β 0 ν := by
  sorry

/-- The critical inverse temperature at zero field: the supremum of the `β ≥ 0` with a unique
Gibbs measure, in `[0, ∞]`. -/
def isingCriticalBeta (d : ℕ) : ℝ≥0∞ :=
  ⨆ (β : ℝ) (_ : 0 ≤ β) (_ : ∃! ν, IsIsingGibbs d β 0 ν), ENNReal.ofReal β

/-- 5.3: `β_c(d)` is at least every `β ≥ 0` with `2 d tanh β < 1`, and it is positive. -/
theorem le_isingCriticalBeta {β : ℝ} (hβ : 0 ≤ β) (h : 2 * d * Real.tanh β < 1) :
    ENNReal.ofReal β ≤ isingCriticalBeta d ∧ 0 < isingCriticalBeta d := by
  sorry

/-- 5.3: in two dimensions `0 < β_c(2) ≤ 0.88`. -/
theorem isingCriticalBeta_two_mem :
    0 < isingCriticalBeta 2 ∧ isingCriticalBeta 2 ≤ ENNReal.ofReal 0.88 := by
  sorry

/-- 5.3: in one dimension `β_c(1) = ∞`. -/
theorem isingCriticalBeta_one : isingCriticalBeta 1 = ⊤ := by
  sorry

end Ising

