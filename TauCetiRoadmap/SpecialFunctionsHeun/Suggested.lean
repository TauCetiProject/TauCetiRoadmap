/-! ## Heun's equation (README Conventions) -/

/-- The fifth exponent parameter `ε = α + β + 1 − γ − δ`, fixed by the Fuchs relation
(DLMF 31.2.1). -/
def heunEps (α β γ δ : ℂ) : ℂ := α + β + 1 - γ - δ

/-- Heun's equation (DLMF 31.2.1) holds for `w` on the set `U`: `w` is complex differentiable on
`U` and `w″ + (γ/z + δ/(z − 1) + ε/(z − a)) w′ + (αβz − q)/(z(z − 1)(z − a)) w = 0` at each
point of `U`. Used for open `U` avoiding `0`, `1`, `a`. -/
def IsHeunSolutionOn (a q α β γ δ : ℂ) (w : ℂ → ℂ) (U : Set ℂ) : Prop :=
  DifferentiableOn ℂ w U ∧ ∀ z ∈ U,
    deriv (deriv w) z + (γ / z + δ / (z - 1) + heunEps α β γ δ / (z - a)) * deriv w z
      + (α * β * z - q) / (z * (z - 1) * (z - a)) * w z = 0

/-- The coefficient `P_j = (j − 1 + α)(j − 1 + β)` of the three-term recurrence (DLMF 31.3.4). -/
def heunP (α β : ℂ) (j : ℕ) : ℂ := ((j : ℂ) - 1 + α) * ((j : ℂ) - 1 + β)

/-- The coefficient `Q_j = j((j − 1 + γ)(1 + a) + aδ + ε)` (DLMF 31.3.4). -/
def heunQ (a α β γ δ : ℂ) (j : ℕ) : ℂ :=
  (j : ℂ) * (((j : ℂ) - 1 + γ) * (1 + a) + a * δ + heunEps α β γ δ)

/-- The coefficient `R_j = a(j + 1)(j + γ)` (DLMF 31.3.4). -/
def heunR (a γ : ℂ) (j : ℕ) : ℂ := a * ((j : ℂ) + 1) * ((j : ℂ) + γ)

/-- The Maclaurin coefficients `c_j` of `Hl(a, q; α, β, γ, δ; z)` (README 3.1; DLMF 31.3.2–31.3.3):
`c₀ = 1`, `aγ c₁ = q c₀`, `R_j c_{j+1} = (Q_j + q) c_j − P_j c_{j−1}`. When `a = 0` or
`γ ∈ {0, −1, −2, …}` some `R_j` vanishes and Lean's `x / 0 = 0` gives junk values, which no
theorem uses. -/
def heunLocalCoeff (a q α β γ δ : ℂ) : ℕ → ℂ
  | 0 => 1
  | 1 => q / (a * γ)
  | j + 2 =>
      ((heunQ a α β γ δ (j + 1) + q) * heunLocalCoeff a q α β γ δ (j + 1)
        - heunP α β (j + 1) * heunLocalCoeff a q α β γ δ j) / heunR a γ (j + 1)

/-- The local Heun function `Hl(a, q; α, β, γ, δ; z) = ∑ c_j z^j` (README 3.1; DLMF 31.3.1).
Outside its disc of convergence this is Lean's value of a divergent `tsum`; theorems use it only
on `‖z‖ < min 1 ‖a‖` and where 3.1 proves convergence. -/
def heunLocal (a q α β γ δ z : ℂ) : ℂ := ∑' j : ℕ, heunLocalCoeff a q α β γ δ j * z ^ j

/-- The tridiagonal matrix of DLMF 31.5.1 of size `n + 1`: diagonal `−Q_j`, superdiagonal `R_j`,
subdiagonal `P_j` (README 4.1). It does not depend on `q`. -/
def heunPolyMatrix (a α β γ δ : ℂ) (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ :=
  Matrix.of fun i j =>
    if (j : ℕ) = i then -heunQ a α β γ δ i
    else if (j : ℕ) = i + 1 then heunR a γ i
    else if (i : ℕ) = j + 1 then heunP α β i
    else 0

/-- `q` is an eigenvalue of the Heun-function problem relative to `{0, 1}` (README 5.1; DLMF
31.4): `Hl(a, q; α, β, γ, δ; ·)` continues analytically from the unit disc to the disc
`‖z‖ < ‖a‖`, that is, it is analytic at `z = 1`. Used for `1 < ‖a‖`. -/
def IsHeunEigenvalue01 (a α β γ δ q : ℂ) : Prop :=
  ∃ f : ℂ → ℂ, AnalyticOnNhd ℂ f (ball 0 ‖a‖) ∧ ∀ z ∈ ball (0 : ℂ) 1, f z = heunLocal a q α β γ δ z

/-- The confluent Heun equation (DLMF 31.12.1) holds for `w` on `U`:
`w″ + (γ/z + δ/(z − 1) + ε) w′ + (αz − q)/(z(z − 1)) w = 0`. -/
def IsConfluentHeunSolutionOn (ε α q γ δ : ℂ) (w : ℂ → ℂ) (U : Set ℂ) : Prop :=
  DifferentiableOn ℂ w U ∧ ∀ z ∈ U,
    deriv (deriv w) z + (γ / z + δ / (z - 1) + ε) * deriv w z
      + (α * z - q) / (z * (z - 1)) * w z = 0

/-- The Maclaurin coefficients of the local solution of the confluent Heun equation at `0`
(README 7.2): `c₀ = 1`, `γ c₁ = −q`, and
`(j + 2)(j + 1 + γ) c_{j+2} = ((j + 1)(j + γ + δ − ε) − q) c_{j+1} + (εj + α) c_j`. -/
def confluentHeunLocalCoeff (ε α q γ δ : ℂ) : ℕ → ℂ
  | 0 => 1
  | 1 => -q / γ
  | j + 2 =>
      ((((j : ℂ) + 1) * ((j : ℂ) + γ + δ - ε) - q) * confluentHeunLocalCoeff ε α q γ δ (j + 1)
        + (ε * j + α) * confluentHeunLocalCoeff ε α q γ δ j) / (((j : ℂ) + 2) * ((j : ℂ) + 1 + γ))

/-- The local solution of the confluent Heun equation at `0` with value `1` there (README 7.2). -/
def confluentHeunLocal (ε α q γ δ z : ℂ) : ℂ :=
  ∑' j : ℕ, confluentHeunLocalCoeff ε α q γ δ j * z ^ j

/-! ## Layer 1: Fuchsian equations -/

/-- **Fuchs' theorem for second-order equations** (README 1.1; Haraoka Theorem 4.3, p. 31;
Kristensson Theorem 3.1, p. 32). If `f`, `g` are analytic off a finite set `A`, have poles of
order at most `1` and `2` at its points, and `z f(z)`, `z² g(z)` are bounded near `∞` (every
point of `A` and `∞` regular singular or ordinary), then `f` and `g` have the Fuchsian
partial-fraction form, with the residues of `g` summing to `0`. -/
theorem fuchsian_partial_fractions {A : Finset ℂ} {f g : ℂ → ℂ}
    (hf : ∀ z ∉ A, AnalyticAt ℂ f z) (hg : ∀ z ∉ A, AnalyticAt ℂ g z)
    (hfA : ∀ c ∈ A, MeromorphicAt f c ∧ (-1 : WithTop ℤ) ≤ meromorphicOrderAt f c)
    (hgA : ∀ c ∈ A, MeromorphicAt g c ∧ (-2 : WithTop ℤ) ≤ meromorphicOrderAt g c)
    (hf_inf : ∃ R C : ℝ, ∀ z : ℂ, R < ‖z‖ → ‖z * f z‖ ≤ C)
    (hg_inf : ∃ R C : ℝ, ∀ z : ℂ, R < ‖z‖ → ‖z ^ 2 * g z‖ ≤ C) :
    ∃ A₁ B₁ C₁ : ℂ → ℂ, ∑ c ∈ A, C₁ c = 0 ∧ ∀ z ∉ A,
      f z = ∑ c ∈ A, A₁ c / (z - c) ∧
      g z = ∑ c ∈ A, (B₁ c / (z - c) ^ 2 + C₁ c / (z - c)) := by
  sorry

/-- **The Fuchs relation** (README 1.1; Haraoka Theorem 7.1, p. 124; Kristensson (3.4), p. 32;
IKSY Ch. 1, Proposition 4.3, p. 11). For the Fuchsian form with finite singular points `A`, the
exponents at `c ∈ A` are the roots of `X² + (A₁(c) − 1)X + B₁(c)` and those at `∞` the roots of
`X² + (1 − ∑ A₁)X + ∑ (B₁(c) + c C₁(c))`; all exponents together sum to `#A − 1`, the number of
singular points (with `∞`) minus `2`. As stated this is the algebraic step, about numbers given
by the partial-fraction data, and serves as a check of the conventions. -/
theorem fuchs_relation {A : Finset ℂ} (A₁ B₁ C₁ ρ ρ' : ℂ → ℂ) (σ σ' : ℂ)
    (hρ : ∀ c ∈ A, ∀ X : ℂ, X ^ 2 + (A₁ c - 1) * X + B₁ c = (X - ρ c) * (X - ρ' c))
    (hσ : ∀ X : ℂ, X ^ 2 + (1 - ∑ c ∈ A, A₁ c) * X + ∑ c ∈ A, (B₁ c + c * C₁ c)
      = (X - σ) * (X - σ')) :
    ∑ c ∈ A, (ρ c + ρ' c) + (σ + σ') = (A.card : ℂ) - 1 := by
  sorry

/-- **The accessory parameter** (README 1.3; Ronveaux Part A, §1.1, p. 7; Kristensson §4.4.1,
p. 56). A Fuchsian equation with singular points `0, 1, a, ∞` and exponents `{0, 1 − γ}`,
`{0, 1 − δ}`, `{0, 1 − ε}`, `{α, β}` has `w`-coefficient `C₀/z + C₁/(z − 1) + C_a/(z − a)` with
`C₀ + C₁ + C_a = 0` and `C₁ + a C_a = αβ`; it is Heun's coefficient with `q = −a C₀`, and the
map `(C₀, C₁, C_a) ↦ q` is injective on such triples. As stated this is the algebraic step of
the headline and serves as a check of the conventions. -/
theorem heun_accessory_parameter {a α β C₀ C₁ Ca : ℂ} (ha₀ : a ≠ 0) (ha₁ : a ≠ 1)
    (hsum : C₀ + C₁ + Ca = 0) (hinf : C₁ + a * Ca = α * β) :
    (∀ z : ℂ, z ≠ 0 → z ≠ 1 → z ≠ a →
      C₀ / z + C₁ / (z - 1) + Ca / (z - a) = (α * β * z - (-a * C₀)) / (z * (z - 1) * (z - a)))
    ∧ ∀ {D₀ D₁ Da : ℂ}, D₀ + D₁ + Da = 0 → D₁ + a * Da = α * β → D₀ = C₀ →
      D₁ = C₁ ∧ Da = Ca := by
  sorry

/-- **The normal form** (README 1.4; DLMF 31.2.2–31.2.4; Ronveaux Part A, §2.3). On an open set
where `z`, `z − 1`, `z − a` lie in the slit plane, `w = z^{−γ/2}(z − 1)^{−δ/2}(z − a)^{−ε/2} W`
solves Heun's equation if and only if `W″ = (A/z + B/(z − 1) + C/(z − a) + D/z² + E/(z − 1)²
+ F/(z − a)²) W`, with the coefficients of 31.2.4; and `A + B + C = 0`. -/
theorem heun_normal_form {a q α β γ δ : ℂ} (ha₀ : a ≠ 0) (ha₁ : a ≠ 1) {U : Set ℂ}
    (hU : IsOpen U) (hU' : ∀ z ∈ U, z ∈ slitPlane ∧ z - 1 ∈ slitPlane ∧ z - a ∈ slitPlane)
    {W : ℂ → ℂ} (hW : DifferentiableOn ℂ W U) :
    let ε := heunEps α β γ δ
    let cA := -(γ * δ) / 2 - γ * ε / (2 * a) + q / a
    let cB := γ * δ / 2 - δ * ε / (2 * (a - 1)) - (q - α * β) / (a - 1)
    let cC := γ * ε / (2 * a) + δ * ε / (2 * (a - 1)) - (a * α * β - q) / (a * (a - 1))
    (IsHeunSolutionOn a q α β γ δ
        (fun z => z ^ (-γ / 2) * (z - 1) ^ (-δ / 2) * (z - a) ^ (-ε / 2) * W z) U ↔
      ∀ z ∈ U, deriv (deriv W) z = (cA / z + cB / (z - 1) + cC / (z - a)
        + γ / 2 * (γ / 2 - 1) / z ^ 2 + δ / 2 * (δ / 2 - 1) / (z - 1) ^ 2
        + ε / 2 * (ε / 2 - 1) / (z - a) ^ 2) * W z) ∧ cA + cB + cC = 0 := by
  sorry

/-! ## Layer 2: transformations -/

/-- **The F-homotopic transformation at `0`** (README 2.1; DLMF §31.2(v); Ronveaux Part A,
(2.2.5)). -/
theorem heun_fHomotopic_zero {a q α β γ δ : ℂ} {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) (hU' : ∀ z ∈ U, z ∈ slitPlane) {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn a (q + (a * δ + heunEps α β γ δ) * (1 - γ)) (α + 1 - γ) (β + 1 - γ)
      (2 - γ) δ w U) :
    IsHeunSolutionOn a q α β γ δ (fun z => z ^ (1 - γ) * w z) U := by
  sorry

/-- **The F-homotopic transformation at `1`** (README 2.1; DLMF §31.2(v)). -/
theorem heun_fHomotopic_one {a q α β γ δ : ℂ} {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) (hU' : ∀ z ∈ U, z - 1 ∈ slitPlane) {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn a (q + a * γ * (1 - δ)) (α + 1 - δ) (β + 1 - δ) γ (2 - δ) w U) :
    IsHeunSolutionOn a q α β γ δ (fun z => (z - 1) ^ (1 - δ) * w z) U := by
  sorry

/-- **The F-homotopic transformation at `a`** (README 2.1; DLMF §31.2(v)). The transformed
equation has `ε₃ = 2 − ε` and the same `γ`, `δ`. -/
theorem heun_fHomotopic_a {a q α β γ δ : ℂ} {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) (hU' : ∀ z ∈ U, z - a ∈ slitPlane) {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn a (q + γ * (1 - heunEps α β γ δ)) (α + 1 - heunEps α β γ δ)
      (β + 1 - heunEps α β γ δ) γ δ w U) :
    IsHeunSolutionOn a q α β γ δ (fun z => (z - a) ^ (1 - heunEps α β γ δ) * w z) U := by
  sorry

/-- **The homography `z ↦ z/a`** (README 2.2; DLMF §31.2(v)): parameters `(1/a, q/a; α, β, γ, ε)`,
so that `δ` and `ε` are exchanged. -/
theorem heun_moebius_div {a q α β γ δ : ℂ} (ha : a ≠ 0) {U : Set ℂ} {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn a⁻¹ (q / a) α β γ (heunEps α β γ δ) w ((fun z => z / a) '' U)) :
    IsHeunSolutionOn a q α β γ δ (fun z => w (z / a)) U := by
  sorry

/-- **The homography `z ↦ 1 − z`** (README 2.2; DLMF 31.3.6): parameters
`(1 − a, αβ − q; α, β, δ, γ)`. -/
theorem heun_moebius_one_sub {a q α β γ δ : ℂ} {U : Set ℂ} {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn (1 - a) (α * β - q) α β δ γ w ((fun z => 1 - z) '' U)) :
    IsHeunSolutionOn a q α β γ δ (fun z => w (1 - z)) U := by
  sorry

/-- **The homography `z ↦ z/(z − 1)`** (README 2.2; DLMF 31.3.13): with the prefactor
`(1 − z)^{−α}`, parameters `(a/(a − 1), −(q − aαγ)/(a − 1); α, α + 1 − δ, γ, α + 1 − β)`. -/
theorem heun_moebius_div_sub_one {a q α β γ δ : ℂ} (ha : a ≠ 1) {U : Set ℂ} (hU : IsOpen U)
    (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) (hU' : ∀ z ∈ U, 1 - z ∈ slitPlane) {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn (a / (a - 1)) (-(q - a * α * γ) / (a - 1)) α (α + 1 - δ) γ
      (α + 1 - β) w ((fun z => z / (z - 1)) '' U)) :
    IsHeunSolutionOn a q α β γ δ (fun z => (1 - z) ^ (-α) * w (z / (z - 1))) U := by
  sorry

/-- **The trigonometric form** (README 2.4; DLMF 31.2.5–31.2.6; Ronveaux Part A, (2.4.19)–(2.4.20)).
If `w` solves Heun's equation near `sin² θ`, then `W(θ) = w(sin² θ)` solves 31.2.6 at `θ`. -/
theorem heun_trigonometric_form {a q α β γ δ : ℂ} {U : Set ℂ} (hU : IsOpen U) {w : ℂ → ℂ}
    (hw : IsHeunSolutionOn a q α β γ δ w U) {θ : ℂ} (hθ : sin θ ^ 2 ∈ U)
    (hs : sin θ ≠ 0) (hc : cos θ ≠ 0) (ha : sin θ ^ 2 ≠ a) :
    let W := fun θ : ℂ => w (sin θ ^ 2)
    deriv (deriv W) θ
      + ((2 * γ - 1) * (cos θ / sin θ) - (2 * δ - 1) * (sin θ / cos θ)
        - heunEps α β γ δ * sin (2 * θ) / (a - sin θ ^ 2)) * deriv W θ
      + 4 * (α * β * sin θ ^ 2 - q) / (a - sin θ ^ 2) * W θ = 0 := by
  sorry

/-! ## Layer 3: local solutions -/

/-- **The local Heun function** (README 3.1; DLMF 31.3.1–31.3.4; Ronveaux Part A, §3.3,
pp. 34–36; Kristensson (8.4)–(8.6), pp. 143–144). For `a ≠ 0` and `γ ∉ {0, −1, −2, …}` the
series converges on `‖z‖ < min 1 ‖a‖`, its sum is analytic there with value `1` at `0`, and it
solves Heun's equation on the punctured disc. -/
theorem heunLocal_isHeunSolutionOn {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ -n) :
    (∀ z ∈ ball (0 : ℂ) (min 1 ‖a‖),
      HasSum (fun j => heunLocalCoeff a q α β γ δ j * z ^ j) (heunLocal a q α β γ δ z)) ∧
    AnalyticOnNhd ℂ (heunLocal a q α β γ δ) (ball 0 (min 1 ‖a‖)) ∧
    heunLocal a q α β γ δ 0 = 1 ∧
    IsHeunSolutionOn a q α β γ δ (heunLocal a q α β γ δ) (ball 0 (min 1 ‖a‖) \ {0}) := by
  sorry

/-- **Uniqueness of the local solution** (README 3.1). For `γ ∉ {0, −1, −2, …}`, a solution on a
punctured neighbourhood of `0` that extends analytically to `0` with value `1` is `Hl` near `0`. -/
theorem heunLocal_unique {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ -n) {w : ℂ → ℂ}
    {r : ℝ} (hr : 0 < r) (hw : IsHeunSolutionOn a q α β γ δ w (ball 0 r \ {0}))
    (hw0 : AnalyticAt ℂ w 0) (hw1 : w 0 = 1) :
    w =ᶠ[𝓝 0] heunLocal a q α β γ δ := by
  sorry

/-- **The radius of convergence** (README 3.1; Ronveaux Part A, (3.3.9), p. 35; Kristensson
Theorem 8.1, p. 145). For `1 < ‖a‖` and `γ ∉ {0, −1, −2, …}` the radius of the series of `Hl`
is `1` or at least `‖a‖`. -/
theorem radius_heunLocalSeries {a q α β γ δ : ℂ} (ha : 1 < ‖a‖) (hγ : ∀ n : ℕ, γ ≠ -n) :
    (FormalMultilinearSeries.ofScalars ℂ (heunLocalCoeff a q α β γ δ)).radius = 1 ∨
      (‖a‖₊ : ENNReal) ≤ (FormalMultilinearSeries.ofScalars ℂ (heunLocalCoeff a q α β γ δ)).radius
      := by
  sorry

/-- **The second solution at `0`** (README 3.2; DLMF 31.3.5). For `γ ∉ {2, 3, 4, …}`; at `γ = 1`
it is `Hl` itself. -/
theorem heunLocal_second_at_zero {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ n + 2) :
    IsHeunSolutionOn a q α β γ δ
      (fun z => z ^ (1 - γ) * heunLocal a ((a * δ + heunEps α β γ δ) * (1 - γ) + q)
        (α + 1 - γ) (β + 1 - γ) (2 - γ) δ z)
      ({z | ‖z‖ < min 1 ‖a‖ ∧ z ∈ slitPlane}) := by
  sorry

/-- **The solutions at `1`** (README 3.2; DLMF 31.3.6–31.3.7), on the disc `‖1 − z‖ <
min 1 ‖1 − a‖`, the second on its part with `1 − z ∈ slitPlane`; for `δ ∉ {0, −1, −2, …}`,
respectively `δ ∉ {2, 3, 4, …}`. -/
theorem heunLocal_at_one {a q α β γ δ : ℂ} (ha : a ≠ 1) :
    ((∀ n : ℕ, δ ≠ -n) → IsHeunSolutionOn a q α β γ δ
      (fun z => heunLocal (1 - a) (α * β - q) α β δ γ (1 - z))
      ({z | ‖1 - z‖ < min 1 ‖1 - a‖ ∧ z ≠ 1})) ∧
    ((∀ n : ℕ, δ ≠ n + 2) → IsHeunSolutionOn a q α β γ δ
      (fun z => (1 - z) ^ (1 - δ) * heunLocal (1 - a)
        (((1 - a) * γ + heunEps α β γ δ) * (1 - δ) + α * β - q) (α + 1 - δ) (β + 1 - δ)
        (2 - δ) γ (1 - z))
      ({z | ‖1 - z‖ < min 1 ‖1 - a‖ ∧ 1 - z ∈ slitPlane})) := by
  sorry

/-- **The solutions at `a`** (README 3.2; DLMF 31.3.8–31.3.9), in the variable
`(a − z)/(a − 1)`, on the disc where it has modulus less than `min 1 ‖a/(a − 1)‖`; for
`ε ∉ {0, −1, −2, …}`, respectively `ε ∉ {2, 3, 4, …}`. -/
theorem heunLocal_at_a {a q α β γ δ : ℂ} (ha₀ : a ≠ 0) (ha₁ : a ≠ 1) :
    let ε := heunEps α β γ δ
    ((∀ n : ℕ, ε ≠ -n) → IsHeunSolutionOn a q α β γ δ
      (fun z => heunLocal (a / (a - 1)) ((α * β * a - q) / (a - 1)) α β ε δ ((a - z) / (a - 1)))
      ({z | ‖(a - z) / (a - 1)‖ < min 1 ‖a / (a - 1)‖ ∧ z ≠ a})) ∧
    ((∀ n : ℕ, ε ≠ n + 2) → IsHeunSolutionOn a q α β γ δ
      (fun z => ((a - z) / (a - 1)) ^ (1 - ε) * heunLocal (a / (a - 1))
        ((a * (δ + γ) - γ) * (1 - ε) / (a - 1) + (α * β * a - q) / (a - 1))
        (α + 1 - ε) (β + 1 - ε) (2 - ε) δ ((a - z) / (a - 1)))
      ({z | ‖(a - z) / (a - 1)‖ < min 1 ‖a / (a - 1)‖ ∧ (a - z) / (a - 1) ∈ slitPlane})) := by
  sorry

/-- **The solutions at `∞`** (README 3.2; DLMF 31.3.10–31.3.11 in the corrected form of the
online DLMF (V1.1.7): the accessory parameter is `q/a − α(β − ε) − (α/a)(β − δ)`, the negative
of the value printed in the 2010 Handbook). On `‖z‖ > max 1 ‖a‖` with `z ∈ slitPlane`, for
`β − α ∉ {1, 2, 3, …}`, respectively `α − β ∉ {1, 2, 3, …}`. -/
theorem heunLocal_at_infty {a q α β γ δ : ℂ} (ha : a ≠ 0) :
    let ε := heunEps α β γ δ
    ((∀ n : ℕ, β - α ≠ n + 1) → IsHeunSolutionOn a q α β γ δ
      (fun z => z ^ (-α) * heunLocal a⁻¹ (q / a - α * (β - ε) - α / a * (β - δ))
        α (α - γ + 1) (α - β + 1) δ z⁻¹)
      ({z | max 1 ‖a‖ < ‖z‖ ∧ z ∈ slitPlane})) ∧
    ((∀ n : ℕ, α - β ≠ n + 1) → IsHeunSolutionOn a q α β γ δ
      (fun z => z ^ (-β) * heunLocal a⁻¹ (q / a - β * (α - ε) - β / a * (α - δ))
        β (β - γ + 1) (β - α + 1) δ z⁻¹)
      ({z | max 1 ‖a‖ < ‖z‖ ∧ z ∈ slitPlane})) := by
  sorry

/-- **`Hl` under `z ↦ z/a`** (README 3.3; DLMF 31.3.12; Ronveaux Part A, (3.4.3), p. 37). -/
theorem heunLocal_eq_div {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ -n) {z : ℂ}
    (hz : ‖z‖ < min 1 ‖a‖) :
    heunLocal a q α β γ δ z = heunLocal a⁻¹ (q / a) α β γ (heunEps α β γ δ) (z / a) := by
  sorry

/-- **`Hl` under `z ↦ z/(z − 1)`** (README 3.3; DLMF 31.3.13; Ronveaux Part A, (3.4.5)–(3.4.11)). -/
theorem heunLocal_eq_div_sub_one {a q α β γ δ : ℂ} (ha₀ : a ≠ 0) (ha₁ : a ≠ 1)
    (hγ : ∀ n : ℕ, γ ≠ -n) {z : ℂ} (hz : ‖z‖ < min 1 ‖a‖)
    (hz' : ‖z / (z - 1)‖ < min 1 ‖a / (a - 1)‖) :
    heunLocal a q α β γ δ z = (1 - z) ^ (-α) *
      heunLocal (a / (a - 1)) (-(q - a * α * γ) / (a - 1)) α (α + 1 - δ) γ (α + 1 - β)
        (z / (z - 1)) := by
  sorry

/-- **Absolute convergence on the unit circle** (README 3.4; Kristensson Theorem 8.1, p. 145).
For `1 < ‖a‖`, `γ ∉ {0, −1, −2, …}` and `Re δ < 1` the coefficients of `Hl` are absolutely
summable. -/
theorem summable_norm_heunLocalCoeff {a q α β γ δ : ℂ} (ha : 1 < ‖a‖) (hγ : ∀ n : ℕ, γ ≠ -n)
    (hδ : δ.re < 1) :
    Summable fun j => ‖heunLocalCoeff a q α β γ δ j‖ := by
  sorry

/-! ## Layer 4: Heun polynomials -/

/-- **The coefficients as determinants** (README 4.1; Ronveaux Part A, (3.6.5), p. 43):
`R₀ ⋯ R_n c_{n+1} = det(q − M_n)` with `M_n` the matrix of DLMF 31.5.1. -/
theorem prod_heunR_mul_heunLocalCoeff {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ -n)
    (n : ℕ) :
    (∏ i ∈ Finset.range (n + 1), heunR a γ i) * heunLocalCoeff a q α β γ δ (n + 1) =
      (heunPolyMatrix a α β γ δ n).charpoly.eval q := by
  sorry

/-- **The polynomial criterion** (README 4.1; DLMF 31.5.1–31.5.2; Ronveaux Part A, §3.6,
pp. 41–44; Kristensson (8.7), p. 146). For `a ≠ 0` and `γ ∉ {0, −1, −2, …}`, `Hl` is a polynomial
if and only if `α` or `β` is a nonpositive integer `−n` and `q` is an eigenvalue of `M_n`. -/
theorem heunLocal_polynomial_iff {a q α β γ δ : ℂ} (ha : a ≠ 0) (hγ : ∀ n : ℕ, γ ≠ -n) :
    (∃ N : ℕ, ∀ j, N ≤ j → heunLocalCoeff a q α β γ δ j = 0) ↔
      ∃ n : ℕ, (α = -n ∨ β = -n) ∧ (heunPolyMatrix a α β γ δ n).charpoly.eval q = 0 := by
  sorry

/-- **Real simple eigenvalues, `a < 0`** (README 4.2). For real `a < 0`, `γ > 0`, `β > 0` and real
`δ`, the `n + 1` eigenvalues of `M_n` with `α = −n` are real and simple. -/
theorem heunPolyMatrix_eigenvalues_real_of_neg {a β γ δ : ℝ} (ha : a < 0) (hγ : 0 < γ)
    (hβ : 0 < β) (n : ℕ) :
    ∃ e : Fin (n + 1) → ℝ, StrictMono e ∧ ∀ x : ℂ,
      (heunPolyMatrix a (-n) β γ δ n).charpoly.eval x = 0 ↔ ∃ i, x = e i := by
  sorry

/-- **Real simple eigenvalues, `a > 1`** (README 4.2). For real `a > 1`, `δ > 0`, `β > 0` and real
`γ`, the `n + 1` eigenvalues of `M_n` with `α = −n` are real and simple. -/
theorem heunPolyMatrix_eigenvalues_real_of_one_lt {a β γ δ : ℝ} (ha : 1 < a) (hδ : 0 < δ)
    (hβ : 0 < β) (n : ℕ) :
    ∃ e : Fin (n + 1) → ℝ, StrictMono e ∧ ∀ x : ℂ,
      (heunPolyMatrix a (-n) β γ δ n).charpoly.eval x = 0 ↔ ∃ i, x = e i := by
  sorry

/-! ## Layer 5: Heun functions -/

/-- **The eigenvalues form the zero set of an entire function** (README 5.2; DLMF §31.4;
Ronveaux Part A, §3.5, pp. 39–41). For `1 < ‖a‖` and `γ, δ ∉ {0, −1, −2, …}` there is an entire
function of `q` whose zeros are exactly the eigenvalues. That it is not identically zero is proved
only under the hypotheses of `heunEigenvalue01_real`, where it follows from that theorem. -/
theorem exists_entire_heunEigenvalue01_iff {a α β γ δ : ℂ} (ha : 1 < ‖a‖)
    (hγ : ∀ n : ℕ, γ ≠ -n) (hδ : ∀ n : ℕ, δ ≠ -n) :
    ∃ F : ℂ → ℂ, Differentiable ℂ F ∧
      ∀ q, IsHeunEigenvalue01 a α β γ δ q ↔ F q = 0 := by
  sorry

/-- **The real eigenvalue problem** (README 5.2). For real `a > 1`, `α`, `β`, and `γ, δ > 0`, the
eigenvalues are real and simple and form a strictly decreasing sequence `q₀ > q₁ > ⋯ → −∞`, and
the Heun function of `q_m` has exactly `m` zeros in `(0, 1)`. -/
theorem heunEigenvalue01_real {a α β γ δ : ℝ} (ha : 1 < a) (hγ : 0 < γ) (hδ : 0 < δ) :
    ∃ e : ℕ → ℝ, StrictAnti e ∧ Tendsto e atTop atBot ∧
      (∀ q : ℂ, IsHeunEigenvalue01 a α β γ δ q ↔ ∃ m, q = e m) ∧
      ∀ m, {x : ℝ | x ∈ Ioo 0 1 ∧ heunLocal a (e m) α β γ δ x = 0}.ncard = m := by
  sorry

/-! ## Layer 6: orthogonality and integral equations -/

/-- **Orthogonality on `[0, 1]`** (README 6.1; DLMF 31.9.1–31.9.2; Ronveaux Part A, (5.2.9)).
For `1 < ‖a‖`, `Re γ > 0`, `Re δ > 0`, the Heun functions of two distinct eigenvalues are
orthogonal on `[0, 1]` with the weight `t^{γ−1}(1 − t)^{δ−1}(a − t)^{ε−1}`. -/
theorem heun_orthogonal_Icc {a α β γ δ q q' : ℂ} (ha : 1 < ‖a‖) (hγ : 0 < γ.re)
    (hδ : 0 < δ.re) (hq : IsHeunEigenvalue01 a α β γ δ q) (hq' : IsHeunEigenvalue01 a α β γ δ q')
    (hne : q ≠ q') :
    ∫ t in (0 : ℝ)..1, (t : ℂ) ^ (γ - 1) * (1 - (t : ℂ)) ^ (δ - 1) *
      (a - t) ^ (heunEps α β γ δ - 1) * heunLocal a q α β γ δ t * heunLocal a q' α β γ δ t = 0 := by
  sorry

/-- **Double orthogonality of Heun polynomials** (README 6.2; DLMF 31.9.5–31.9.6; Ronveaux
Part A, §5.3). For real `a > 1` and `γ, δ, ε > 0`, let `β_n = γ + δ + ε + n − 1`, so that
`Hl(a, q; −n, β_n, γ, δ; ·)` belongs to the equation with these `γ, δ, ε`. If `q₁`, `q₂` are
eigenvalues of `M_{n₁}`, `M_{n₂}` and `(n₁, q₁) ≠ (n₂, q₂)`, the products `w_k(s) w_k(t)` are
orthogonal on `(0, 1) × (1, a)` with the weight `(t − s) ρ(s) ρ(t)`. -/
theorem heunPoly_double_orthogonal {a γ δ ε : ℝ} (ha : 1 < a) (hγ : 0 < γ) (hδ : 0 < δ)
    (hε : 0 < ε) {n₁ n₂ : ℕ} {q₁ q₂ : ℂ}
    (h₁ : (heunPolyMatrix a (-n₁) (γ + δ + ε + n₁ - 1) γ δ n₁).charpoly.eval q₁ = 0)
    (h₂ : (heunPolyMatrix a (-n₂) (γ + δ + ε + n₂ - 1) γ δ n₂).charpoly.eval q₂ = 0)
    (hne : (n₁, q₁) ≠ (n₂, q₂)) :
    let ρ : ℝ → ℝ := fun x => x ^ (γ - 1) * |1 - x| ^ (δ - 1) * |a - x| ^ (ε - 1)
    let w₁ := heunLocal a q₁ (-n₁) (γ + δ + ε + n₁ - 1) γ δ
    let w₂ := heunLocal a q₂ (-n₂) (γ + δ + ε + n₂ - 1) γ δ
    ∫ s in (0 : ℝ)..1, ∫ t in (1 : ℝ)..a,
      ((t - s) * ρ s * ρ t : ℝ) * (w₁ s * w₁ t * w₂ s * w₂ t) = 0 := by
  sorry

/-- **Integral equations of the first type** (README 6.3; DLMF 31.10.1–31.10.6; Ronveaux Part A,
(6.2.1)–(6.2.7)). Let `D_x` be Heun's operator 31.10.4. Let `w` solve Heun's equation (with
accessory parameter `q`) near the real segment `[x₀, x₁] ⊂ (0, 1)`, and let `K` be analytic on
`U × V` with `D_z K = D_t K`. If the bracket `p(t)(∂_t K · w − K · w′)` takes equal values at the
two ends for every `z ∈ U`, then `W(z) = ∫ K(z, t) w(t) ρ(t) dt` solves Heun's equation on `U`. -/
theorem heun_integral_equation {a q α β γ δ : ℝ} (ha : 1 < a) {x₀ x₁ : ℝ} (h₀ : 0 < x₀)
    (h₀₁ : x₀ < x₁) (h₁ : x₁ < 1) {U V : Set ℂ} (hU : IsOpen U) (hV : IsOpen V)
    (hUs : ∀ z ∈ U, z ≠ 0 ∧ z ≠ 1 ∧ z ≠ a) (hseg : ∀ x ∈ Icc x₀ x₁, (x : ℂ) ∈ V)
    {w : ℂ → ℂ} (hw : IsHeunSolutionOn a q α β γ δ w (V \ {0, 1, (a : ℂ)}))
    {K : ℂ → ℂ → ℂ} (hK : AnalyticOnNhd ℂ (fun p : ℂ × ℂ => K p.1 p.2) (U ×ˢ V)) :
    let ε : ℂ := heunEps α β γ δ
    let D : (ℂ → ℂ) → ℂ → ℂ := fun f x => x * (x - 1) * (x - a) * deriv (deriv f) x
      + (γ * (x - 1) * (x - a) + δ * x * (x - a) + ε * x * (x - 1)) * deriv f x
      + α * β * x * f x
    let p : ℝ → ℂ := fun x =>
      (x : ℂ) ^ (γ : ℂ) * ((1 - x : ℝ) : ℂ) ^ (δ : ℂ) * ((a - x : ℝ) : ℂ) ^ ε
    let bracket : ℂ → ℝ → ℂ := fun z x =>
      p x * (deriv (K z) x * w x - K z x * deriv w x)
    (∀ z ∈ U, ∀ t ∈ V, D (K · t) z = D (K z) t) →
    (∀ z ∈ U, bracket z x₀ = bracket z x₁) →
    IsHeunSolutionOn a q α β γ δ
      (fun z => ∫ x in x₀..x₁, K z x * w x * (p x / (x * (1 - x) * (a - x)))) U := by
  sorry

/-! ## Layer 7: confluent forms -/

/-- **The local solution of the confluent Heun equation** (README 7.2). For
`γ ∉ {0, −1, −2, …}` the series converges on the unit disc, has value `1` at `0`, and solves
DLMF 31.12.1 on the punctured disc. -/
theorem confluentHeunLocal_isSolution {ε α q γ δ : ℂ} (hγ : ∀ n : ℕ, γ ≠ -n) :
    (∀ z ∈ ball (0 : ℂ) 1, HasSum (fun j => confluentHeunLocalCoeff ε α q γ δ j * z ^ j)
      (confluentHeunLocal ε α q γ δ z)) ∧
    confluentHeunLocal ε α q γ δ 0 = 1 ∧
    IsConfluentHeunSolutionOn ε α q γ δ (confluentHeunLocal ε α q γ δ) (ball 0 1 \ {0}) := by
  sorry

/-- **The confluence limit** (README 7.2; Ronveaux Part A, §2.7, pp. 26–29). Let `‖aₙ‖ → ∞` with
`εₙ/aₙ → −ε`, `αₙβₙ/aₙ → −α` and `qₙ/aₙ → −q`, where `εₙ = αₙ + βₙ + 1 − γ − δ`. Then
`Hl(aₙ, qₙ; αₙ, βₙ, γ, δ; ·)` tends to the confluent local solution locally uniformly on the
unit disc. -/
theorem tendstoLocallyUniformlyOn_heunLocal_confluent {ε α q γ δ : ℂ} (hγ : ∀ n : ℕ, γ ≠ -n)
    {aₙ qₙ αₙ βₙ : ℕ → ℂ} (ha : Tendsto (fun n => ‖aₙ n‖) atTop atTop)
    (hε : Tendsto (fun n => heunEps (αₙ n) (βₙ n) γ δ / aₙ n) atTop (𝓝 (-ε)))
    (hα : Tendsto (fun n => αₙ n * βₙ n / aₙ n) atTop (𝓝 (-α)))
    (hq : Tendsto (fun n => qₙ n / aₙ n) atTop (𝓝 (-q))) :
    TendstoLocallyUniformlyOn (fun n z => heunLocal (aₙ n) (qₙ n) (αₙ n) (βₙ n) γ δ z)
      (confluentHeunLocal ε α q γ δ) atTop (ball 0 1) := by
  sorry

/-! ## Layer 8: reductions to the hypergeometric function -/

/-- **`a = 1`** (README 8.1; DLMF 31.7.1, first equality; Kristensson Comment 8.1, p. 143;
Ronveaux Part A, (1.3.2)). -/
theorem heunLocal_one_eq_ordinaryHypergeometric {α β γ δ z : ℂ} (hγ : ∀ n : ℕ, γ ≠ -n)
    (hz : ‖z‖ < 1) :
    heunLocal 1 (α * β) α β γ δ z = ordinaryHypergeometric α β γ z := by
  sorry

/-- **`ε = 0`** (README 8.1; DLMF 31.7.1, third equality; Ronveaux Part A, (1.3.6)–(1.3.7)). -/
theorem heunLocal_eps_zero_eq_ordinaryHypergeometric {a α β γ z : ℂ} (ha : a ≠ 0)
    (hγ : ∀ n : ℕ, γ ≠ -n) (hz : ‖z‖ < min 1 ‖a‖) :
    heunLocal a (a * α * β) α β γ (α + β + 1 - γ) z = ordinaryHypergeometric α β γ z := by
  sorry

/-- **The quadratic reduction** (README 8.2; DLMF 31.7.2). -/
theorem heunLocal_two_eq_ordinaryHypergeometric {α β γ z : ℂ} (hγ : ∀ n : ℕ, γ ≠ -n)
    (hz : ‖z‖ < Real.sqrt 2 - 1) :
    heunLocal 2 (α * β) α β γ (α + β - 2 * γ + 1) z =
      ordinaryHypergeometric (α / 2) (β / 2) γ (1 - (1 - z) ^ 2) := by
  sorry

/-- **The cubic reduction** (README 8.2; DLMF 31.7.3). -/
theorem heunLocal_four_eq_ordinaryHypergeometric {α β z : ℂ} (hz : ‖z‖ < 1 / 3) :
    heunLocal 4 (α * β) α β (1 / 2) (2 * (α + β) / 3) z =
      ordinaryHypergeometric (α / 3) (β / 3) (1 / 2) (1 - (1 - z) ^ 2 * (1 - z / 4)) := by
  sorry

