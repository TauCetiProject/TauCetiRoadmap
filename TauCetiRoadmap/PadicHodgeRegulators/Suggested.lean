import Mathlib

/-!
# PadicHodgeRegulators: target signatures

The roadmap is README.md; this file is not the roadmap. It states the
roadmap's headline theorems against the pinned APIs: finite-residue
spanning for the local K₃ calculation, and the basis, determinant and exact
coordinate image of simultaneous evaluation constraints.

The completed local K₃ regulator isomorphism, global K₃ regulator,
Bloch–Kato logarithm comparisons and curve regulator formulas are not
statable here: the completed K-groups, continuous period-cohomology
realizations and syntomic Chern-class carriers are missing at the pins.
The Perrin–Riou, Wach/Coleman arithmetic image and de Rham interpolation
headlines lack (φ,Γ)-modules over the Robba ring (étale or not, with their
Herr cohomology and Bloch–Kato maps), Wach modules and locally analytic
distribution realizations. The elementary constraint
headlines below use the actual native submodule, not surrogate input data.
-/

noncomputable section
open scoped BigOperators
open Polynomial

namespace TauCetiRoadmap.PadicHodgeRegulators

/-! ## Layer 5: the unramified local K₃ isomorphism -/

/-- Kontsevich's finite polylogarithm, including integral indices. -/
def finitePolylog (p : ℕ) [Fact p.Prime] (n : ℤ) : (ZMod p)[X] :=
  ∑ k ∈ Finset.Ico 1 p, C (((k : ZMod p) ^ n)⁻¹) * X ^ k


/-- The reduction of p^-2 D(ζ^p); the caller must exclude x=1. -/
def residueDilogValue (p : ℕ) [Fact p.Prime] {F : Type*} [Field F]
    [Algebra (ZMod p) F] (x : F) : F :=
  (finitePolylog p 2).aeval x / (x - 1) ^ p


/-- Values and pairwise differences of the residue dilogarithm span F_q over F_p
for p>3 and positive extension degree, using the domain F_q^× minus {1}. -/
theorem residueDilogValue_spans (p s : ℕ) [Fact p.Prime]
    (hp : 3 < p) (hs : 0 < s) :
    Submodule.span (ZMod p)
      {y : GaloisField p s | ∃ x : GaloisField p s,
        x ≠ 0 ∧ x ≠ 1 ∧ residueDilogValue p x = y} = ⊤ ∧
    Submodule.span (ZMod p)
      {y : GaloisField p s | ∃ x x' : GaloisField p s,
        x ≠ 0 ∧ x ≠ 1 ∧ x' ≠ 0 ∧ x' ≠ 1 ∧
        residueDilogValue p x - residueDilogValue p x' = y} = ⊤ := by
  sorry

/-! ## Layer 9: Coleman images and de Rham interpolation -/

section Constraints
variable {E R : Type*} [Field E] [CommRing R] [Algebra E R] {d m : ℕ}

/-- Rows whose specializations lie in prescribed E-subspaces. -/
def evaluationConstraints (J : Finset (Fin m)) (ev : Fin m → R →ₐ[E] E)
    (V : Fin m → Submodule E (Fin d → E)) : Submodule R (Fin d → R) where
  carrier := {F | ∀ j ∈ J, (fun k => ev j (F k)) ∈ V j}
  zero_mem' := by
    intro j hj
    convert (V j).zero_mem using 1
    ext k
    simp
  add_mem' := by
    intro F G hF hG j hj
    convert (V j).add_mem (hF j hj) (hG j hj) using 1
    ext k
    simp
  smul_mem' := by
    intro a F hF j hj
    convert (V j).smul_mem (ev j a) (hF j hj) using 1
    ext k
    simp

/-- Simultaneous constraints admit a basis with the prescribed determinant
ideal (README §§9.7–9.8). The evaluation kernels are explicit hypotheses. -/
theorem constraint_basis_and_determinant [IsDomain R]
    (J : Finset (Fin m)) (t : R) (x : Fin m → E)
    (ev : Fin m → R →ₐ[E] E) (V : Fin m → Submodule E (Fin d → E))
    (hx : Set.InjOn x (↑J : Set (Fin m))) (hev : ∀ j ∈ J, ev j t = x j)
    (hq : ∀ j ∈ J, t - algebraMap E R (x j) ≠ 0)
    (hker : ∀ j ∈ J, ∀ f, ev j f = 0 ↔ t - algebraMap E R (x j) ∣ f) :
    ∃ b : Module.Basis (Fin d) R (evaluationConstraints J ev V),
      Associated (Matrix.det (fun i k => (b i : Fin d → R) k))
        (∏ j ∈ J, (t - algebraMap E R (x j)) ^ (d - Module.finrank E (V j))) := by
  sorry

/-- Product of the evaluation factors at precisely the constraints forcing
coordinate k to vanish; the empty product is one. -/
def coordinateImageGenerator (J : Finset (Fin m)) (t : R) (x : Fin m → E)
    (V : Fin m → Submodule E (Fin d → E)) (k : Fin d) : R := by
  classical
  exact ∏ j ∈ J, if ∀ v ∈ V j, v k = 0 then t - algebraMap E R (x j) else 1

/-- The k-th coordinate image of the actual simultaneous constraint module
is exactly the principal ideal generated by its forced-zero factors
(LLZ2011 Lemma 4.3). Assumptions concern only imposed indices. -/
theorem evaluationConstraints_coordinate_image [IsDomain R]
    (J : Finset (Fin m)) (t : R) (x : Fin m → E)
    (ev : Fin m → R →ₐ[E] E) (V : Fin m → Submodule E (Fin d → E))
    (hx : Set.InjOn x (↑J : Set (Fin m))) (hev : ∀ j ∈ J, ev j t = x j)
    (hq : ∀ j ∈ J, t - algebraMap E R (x j) ≠ 0)
    (hker : ∀ j ∈ J, ∀ f, ev j f = 0 ↔ t - algebraMap E R (x j) ∣ f)
    (k : Fin d) (r : R) :
    (∃ F ∈ evaluationConstraints J ev V, F k = r) ↔
      coordinateImageGenerator J t x V k ∣ r := by
  sorry

end Constraints

end TauCetiRoadmap.PadicHodgeRegulators
