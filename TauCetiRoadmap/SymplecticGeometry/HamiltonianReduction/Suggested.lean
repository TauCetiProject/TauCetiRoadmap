import Mathlib
import TauCeti.Geometry.Lie.Adjoint.Derivation
import TauCeti.Geometry.Lie.Adjoint.Representation.Coadjoint.Stabilizer
import TauCeti.Geometry.Lie.Subgroup.LieAlgebra
