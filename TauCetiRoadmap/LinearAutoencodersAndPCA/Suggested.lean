import Mathlib
import TauCeti.Geometry.Neuromanifold.Dense
import TauCeti.Geometry.Neuromanifold.Neurovariety
import TauCeti.Geometry.Neuromanifold.MLP.Symmetry

/-!
# Linear autoencoders and principal components: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib and Tau Ceti, each with `sorry`, together with the few
definitions they need; every definition has a real body. Every headline theorem of the README is
statable at the pins and is stated here. The README's remaining targets, API lists and Checks are
not restated.

The network is Tau Ceti's two-layer bias-free linear model: the composite
`TauCeti.Neuromanifold.compose Matrix.mulVec Matrix.mulVec` of an encoder `A` (`p × n`) and a
decoder `B` (`n × p`), which realizes `x ↦ (B * A) *ᵥ x` (`compose_mulVec_mulVec`), and, for the
hidden-neuron symmetries, the same network read as the specification
`MLPSpec.linear ![n, p, n]` of depth two. Layer 1 works over any field; Layers 2 and 3 work over
`ℝ`, with a data matrix `X` (`n × m`, one sample per column), the square loss
`Σ_t ‖x_t − B A x_t‖²` and the second-moment matrix `X * Xᴴ`, which is `X Xᵀ` over `ℝ`.
-/

noncomputable section

open Set Matrix MvPolynomial TauCeti.Neuromanifold
open scoped RealInnerProductSpace

namespace TauCetiRoadmap.LinearAutoencodersAndPCA

/-! ## Layer 1: the function space and the parameter fibres -/

section Layer1

variable {K : Type*} [Field K]

/-- 1.1 The linear autoencoder with input and output dimension `n` and hidden width `p`: Tau
Ceti's composite of the linear layers `Matrix.mulVec`, with parameters the pairs `(A, B)` of an
encoder `A : K^(p × n)` and a decoder `B : K^(n × p)`; the pair realizes `x ↦ B (A x)`. Its
realized maps are the maps `x ↦ M x` with `M` of rank at most `p`, by Tau Ceti's
`realizedFunctions_compose_mulVec_mulVec` and `Matrix.rank_le_iff_exists_eq_mul`; this is not a
target. -/
def linearAutoencoder (K : Type*) [Field K] (n p : ℕ) :
    Matrix (Fin p) (Fin n) K × Matrix (Fin n) (Fin p) K → (Fin n → K) → Fin n → K :=
  compose (Matrix.mulVec : Matrix (Fin p) (Fin n) K → (Fin n → K) → Fin p → K)
    (Matrix.mulVec : Matrix (Fin n) (Fin p) K → (Fin p → K) → Fin n → K)

/-- 1.2 The coefficient map of the linear autoencoder: the entries of the product `B * A`,
indexed by `Fin n × Fin n`. -/
def productCoefficients (K : Type*) [Field K] (n p : ℕ)
    (q : Matrix (Fin p) (Fin n) K × Matrix (Fin n) (Fin p) K) : Fin n × Fin n → K :=
  fun ij => (q.2 * q.1) ij.1 ij.2

/-- 1.2 The coefficient image is algebraic: it is Zariski closed, and it is the zero locus of the
ideal generated by the `(p + 1) × (p + 1)` minors of the generic `n × n` matrix (the
determinantal variety). -/
theorem isAlgebraicImage_productCoefficients (n p : ℕ) :
    IsAlgebraicImage (productCoefficients K n p) ∧
      Set.range (productCoefficients K n p) =
        zeroLocus K (determinantalIdeal K (Fin n) (Fin n) (Fin (p + 1))) := by
  sorry

/-- 1.3 The `GL_p` symmetry of the linear autoencoder: the equivalence relation generated by
`(A, B) ~ (C * A, B * C⁻¹)` for invertible `C : K^(p × p)`. Its classes are the orbits. -/
def glSetoid (K : Type*) [Field K] (n p : ℕ) :
    Setoid (Matrix (Fin p) (Fin n) K × Matrix (Fin n) (Fin p) K) :=
  Relation.EqvGen.setoid fun q q' => ∃ C : GL (Fin p) K,
    q' = ((C : Matrix (Fin p) (Fin p) K) * q.1, q.2 * ((C⁻¹ : GL (Fin p) K) : Matrix _ _ K))

/-- 1.3 The fibre of the linear autoencoder through `(A, B)` is a single `GL_p`-orbit exactly when
`B * A` has the largest possible rank `min p n`. -/
theorem identifiableAt_glSetoid_iff {n p : ℕ}
    (q : Matrix (Fin p) (Fin n) K × Matrix (Fin n) (Fin p) K) :
    IdentifiableAt (linearAutoencoder K n p) (glSetoid K n p) q ↔
      (q.2 * q.1).rank = min p n := by
  sorry

/-- 1.4 The encoder of a bias-free weight tuple of `MLPSpec.linear ![n, p, n]`: its first weight
matrix. -/
def encoderWeight {n p : ℕ} (w : (MLPSpec.linear ![n, p, n] : MLPSpec K 2).Weights) :
    Matrix (Fin p) (Fin n) K :=
  w 0

/-- 1.4 The decoder of a bias-free weight tuple of `MLPSpec.linear ![n, p, n]`: its second weight
matrix. -/
def decoderWeight {n p : ℕ} (w : (MLPSpec.linear ![n, p, n] : MLPSpec K 2).Weights) :
    Matrix (Fin n) (Fin p) K :=
  w 1

/-- 1.4 Hidden-neuron permutations and rescalings do not exhaust the fibres: for `n ≥ 1`, at a
weight tuple of `MLPSpec.linear ![n, p, n]` whose product has rank `min p n`, the bias-free
realization is identifiable modulo Tau Ceti's hidden-neuron symmetries (exponent `1`) exactly when
`p ≤ 1`. -/
theorem identifiableAt_hiddenSymmetrySetoid_iff {n p : ℕ} (hn : 1 ≤ n)
    (w : (MLPSpec.linear ![n, p, n] : MLPSpec K 2).Weights)
    (hw : (decoderWeight w * encoderWeight w).rank = min p n) :
    IdentifiableAt (MLPSpec.linear ![n, p, n] : MLPSpec K 2).realizeWeights
        ((MLPSpec.linear ![n, p, n] : MLPSpec K 2).hiddenSymmetrySetoid fun _ => 1) w ↔
      p ≤ 1 := by
  sorry

end Layer1

/-! ## Layer 2: the loss landscape -/

section Layer2

variable {n m p : ℕ}

/-- 2.1 The square loss of the linear autoencoder `q = (A, B)` on the data matrix `X`, whose
columns are the samples: `Σ_t ‖x_t − B A x_t‖²`, with the network evaluated through
`linearAutoencoder`. -/
def loss (X : Matrix (Fin n) (Fin m) ℝ)
    (q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ) : ℝ :=
  ∑ t, ∑ i, (X i t - linearAutoencoder ℝ n p q (fun j => X j t) i) ^ 2

/-- 2.1 A critical point of the loss: every directional derivative vanishes, that is, along every
line `t ↦ q + t • d` through `q` the derivative at `t = 0` is `0`. -/
def IsCriticalPoint (X : Matrix (Fin n) (Fin m) ℝ)
    (q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ) : Prop :=
  ∀ d : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ,
    HasDerivAt (fun t : ℝ => loss X (q + t • d)) 0 0

/-- 2.1 At a critical point `(A, B)` the orthogonal projection `P` onto the column space of `B`
commutes with `X Xᵀ`, the network maps the data to `P X`, and the loss is
`tr (X Xᵀ) − tr (P X Xᵀ)`. -/
theorem exists_projection_of_isCriticalPoint (X : Matrix (Fin n) (Fin m) ℝ)
    {q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ} (hq : IsCriticalPoint X q) :
    ∃ P : Matrix (Fin n) (Fin n) ℝ, P.IsHermitian ∧ P * P = P ∧
      P * (X * Xᴴ) = X * Xᴴ * P ∧ P * q.2 = q.2 ∧ P.rank = q.2.rank ∧
      q.2 * q.1 * X = P * X ∧ loss X q = (X * Xᴴ).trace - (P * (X * Xᴴ)).trace := by
  sorry

/-- 2.1 Conversely, every orthogonal projection of rank at most `p` that commutes with `X Xᵀ` is
the product `B * A` at some critical point. -/
theorem exists_isCriticalPoint_of_projection (X : Matrix (Fin n) (Fin m) ℝ)
    {P : Matrix (Fin n) (Fin n) ℝ} (hP : P.IsHermitian) (hPP : P * P = P)
    (hPX : P * (X * Xᴴ) = X * Xᴴ * P) (hrank : P.rank ≤ p) :
    ∃ q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ,
      IsCriticalPoint X q ∧ q.2 * q.1 = P := by
  sorry

/-- 2.2 The least value of the loss is the sum of the eigenvalues of `X Xᵀ` of index at least
`p` in decreasing order, that is, of its `n − p` smallest eigenvalues (`0` when `p ≥ n`). -/
theorem isLeast_loss (X : Matrix (Fin n) (Fin m) ℝ) :
    IsLeast (Set.range (loss (p := p) X))
      (∑ j ∈ Finset.univ.filter (fun j : Fin (Fintype.card (Fin n)) => p ≤ (j : ℕ)),
        (isHermitian_mul_conjTranspose_self X).eigenvalues₀ j) := by
  sorry

/-- 2.2 The spectral projection of `X Xᵀ` for the eigenvalues at least `c`: the sum of `v vᵀ` over
the eigenvectors `v` of Mathlib's orthonormal eigenbasis whose eigenvalue is at least `c`. -/
def principalProjection (X : Matrix (Fin n) (Fin m) ℝ) (c : ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  ∑ j ∈ Finset.univ.filter (fun j => c ≤ (isHermitian_mul_conjTranspose_self X).eigenvalues j),
    vecMulVec ⇑((isHermitian_mul_conjTranspose_self X).eigenvectorBasis j)
      ⇑((isHermitian_mul_conjTranspose_self X).eigenvectorBasis j)

/-- 2.2 If exactly `p` eigenvalues of `X Xᵀ` (with multiplicity) are at least `c`, so that the
`p`-th and `(p + 1)`-th largest eigenvalues differ, the global minimizers of the loss are exactly
the pairs `(A, B)` with `B A X = P X`, `P` the projection onto the top `p` eigenvectors. -/
theorem isMinOn_loss_iff (X : Matrix (Fin n) (Fin m) ℝ) {c : ℝ}
    (hc : (Finset.univ.filter
      (fun j => c ≤ (isHermitian_mul_conjTranspose_self X).eigenvalues j)).card = p)
    (q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ) :
    IsMinOn (loss X) Set.univ q ↔ q.2 * q.1 * X = principalProjection X c * X := by
  sorry

/-- 2.3 No spurious local minima: every local minimum of the loss is a global minimum. -/
theorem isMinOn_of_isLocalMin (X : Matrix (Fin n) (Fin m) ℝ)
    {q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ} (hq : IsLocalMin (loss X) q) :
    IsMinOn (loss X) Set.univ q := by
  sorry

/-- 2.3 For `p ≥ 1` and nonzero data the loss has no local maximum; hence every critical point
that is not a global minimum is a saddle point. -/
theorem not_isLocalMax_loss (X : Matrix (Fin n) (Fin m) ℝ) (hp : 1 ≤ p) (hX : X ≠ 0)
    (q : Matrix (Fin p) (Fin n) ℝ × Matrix (Fin n) (Fin p) ℝ) :
    ¬ IsLocalMax (loss X) q := by
  sorry

end Layer2

/-! ## Layer 3: stability of the one-dimensional optimum -/

section Layer3

variable {n m : ℕ}

/-- 3.1 For hidden width one, let `θ` be a unit eigenvector of `X Xᵀ` for an eigenvalue `γ` with
gap `ν > 0` on `θ^⊥`, and let `‖X' X'ᵀ − X Xᵀ‖ < ν / 2`. Then the global minimizers for `X`
are the pairs with `B A X = θ θᵀ X`, and there is a unit vector `θ̂` with `⟪θ̂, θ⟫ ≥ 0`, within the
Davis–Kahan distance of `θ`, such that the global minimizers for `X'` are the pairs with
`B A X' = θ̂ θ̂ᵀ X'`. -/
theorem rankOne_minimizers_perturbation (X X' : Matrix (Fin n) (Fin m) ℝ)
    {θ : EuclideanSpace ℝ (Fin n)} (hθ : ‖θ‖ = 1) {γ ν : ℝ}
    (hγ : toEuclideanCLM (𝕜 := ℝ) (X * Xᴴ) θ = γ • θ) (hν : 0 < ν)
    (hgap : ∀ u, ⟪u, θ⟫ = 0 → ⟪u, toEuclideanCLM (𝕜 := ℝ) (X * Xᴴ) u⟫ ≤ (γ - ν) * ‖u‖ ^ 2)
    (hP : ‖toEuclideanCLM (𝕜 := ℝ) (X' * X'ᴴ - X * Xᴴ)‖ < ν / 2) :
    ∃ θh : EuclideanSpace ℝ (Fin n), ‖θh‖ = 1 ∧ 0 ≤ ⟪θh, θ⟫ ∧
      ‖θh - θ‖ ≤ √2 * ‖toEuclideanCLM (𝕜 := ℝ) (X' * X'ᴴ - X * Xᴴ) θ -
          ⟪θ, toEuclideanCLM (𝕜 := ℝ) (X' * X'ᴴ - X * Xᴴ) θ⟫ • θ‖ /
        (ν - 2 * ‖toEuclideanCLM (𝕜 := ℝ) (X' * X'ᴴ - X * Xᴴ)‖) ∧
      (∀ q : Matrix (Fin 1) (Fin n) ℝ × Matrix (Fin n) (Fin 1) ℝ,
        IsMinOn (loss X) Set.univ q ↔ q.2 * q.1 * X = vecMulVec ⇑θ ⇑θ * X) ∧
      (∀ q : Matrix (Fin 1) (Fin n) ℝ × Matrix (Fin n) (Fin 1) ℝ,
        IsMinOn (loss X') Set.univ q ↔ q.2 * q.1 * X' = vecMulVec ⇑θh ⇑θh * X') := by
  sorry

end Layer3

end TauCetiRoadmap.LinearAutoencodersAndPCA
