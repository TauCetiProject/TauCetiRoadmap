/-!
# Arithmetic Fuchsian groups, commensurators and isospectral covers: target signatures

**This file is not the roadmap and is not exhaustive.** The definitive document is
`README.md`. These declarations pin the squared-trace field and trace envelope of a subgroup of
`PSL(2,ℝ)`, quaternion orders, real splittings and the norm-one images `Γ(O)`, the arithmetic
predicate, the named Layer 1 and Layer 2 targets, and the finite order-32 data of Layer 3.

The effective action of `PSL(2,ℝ)` on the upper half-plane is FuchsianOrbifolds'
`pslSubgroupMulAction`. Quaternion algebras are presented as `ℍ[k,a,b]`; the reduced norm is
Tau Ceti's `QuaternionAlgebra.normForm`, the reduced trace is `x + star x = 2 * x.re`, and the
reduced-norm-one group is Mathlib's `unitary`.
-/

namespace TauCetiRoadmap.ArithmeticFuchsianGroups

open Matrix MeasureTheory TauCetiRoadmap.FuchsianOrbifolds
open scoped MatrixGroups UpperHalfPlane Quaternion NumberField Pointwise TensorProduct

/-! ## Squared-trace data -/

/-- The projection `SL(2,ℝ) → PSL(2,ℝ)`. -/
abbrev projSL : SL(2, ℝ) →* PSL(2, ℝ) := QuotientGroup.mk' (Subgroup.center SL(2, ℝ))

/-- The full preimage of `Γ` in `SL(2,ℝ)`: both determinant-one lifts of every element. -/
def liftSL (Γ : Subgroup PSL(2, ℝ)) : Subgroup SL(2, ℝ) :=
  Γ.comap projSL

/-- `Γ^(2)`, the subgroup generated by the squares of the elements of `Γ`. -/
def squareSubgroup (Γ : Subgroup PSL(2, ℝ)) : Subgroup PSL(2, ℝ) :=
  Subgroup.closure ((fun γ ↦ γ ^ 2) '' (Γ : Set PSL(2, ℝ)))

/-- `K₀(Γ) = ℚ(tr(γ̃²) : γ ∈ Γ)`. Both lifts `±γ̃` give the same `tr(γ̃²)`. -/
noncomputable def squaredTraceField (Γ : Subgroup PSL(2, ℝ)) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ
    ((fun g : SL(2, ℝ) ↦ ((g : Matrix (Fin 2) (Fin 2) ℝ) ^ 2).trace) '' (liftSL Γ : Set SL(2, ℝ)))

/-- The trace envelope `A_Γ`: the `K₀(Γ)`-span in `M₂(ℝ)` of every determinant-one lift of every
element of `Γ^(2)`. Layer 1.3 proves it is a four-dimensional central simple subalgebra. -/
noncomputable def traceEnvelope (Γ : Subgroup PSL(2, ℝ)) :
    Submodule (squaredTraceField Γ) (Matrix (Fin 2) (Fin 2) ℝ) :=
  Submodule.span (squaredTraceField Γ)
    ((fun g : SL(2, ℝ) ↦ (g : Matrix (Fin 2) (Fin 2) ℝ)) ''
      (liftSL (squareSubgroup Γ) : Set SL(2, ℝ)))

/-- A subgroup of `PSL(2,ℝ)` is nonelementary when none of its finite-index subgroups is
solvable; equivalently, it has no finite orbit on the closed hyperbolic plane. -/
def IsNonelementary (Γ : Subgroup PSL(2, ℝ)) : Prop :=
  ∀ H : Subgroup Γ, H.FiniteIndex → ¬ Group.IsSolvable H

/-- Finite-index invariance of the squared-trace field and of the trace envelope, the latter as
the same subset of `M₂(ℝ)`. -/
theorem invariant_squared_trace_data_finite_index {Γ Δ : Subgroup PSL(2, ℝ)} (hΔΓ : Δ ≤ Γ)
    (hindex : Δ.IsFiniteRelIndex Γ) (hfg : Group.FG Γ) (hΓ : IsNonelementary Γ) :
    squaredTraceField Δ = squaredTraceField Γ ∧
      (traceEnvelope Δ : Set (Matrix (Fin 2) (Fin 2) ℝ)) = traceEnvelope Γ := by
  sorry

/-- Commensurability up to conjugacy by `c` preserves the squared-trace field and transports the
trace envelope by conjugation with a lift of `c`. -/
theorem invariant_squared_trace_data_commensurable {Γ Δ : Subgroup PSL(2, ℝ)} (c : SL(2, ℝ))
    (hcomm : (MulAut.conj (projSL c) • Δ).Commensurable Γ) (hfg : Group.FG Γ)
    (hΓ : IsNonelementary Γ) :
    squaredTraceField Δ = squaredTraceField Γ ∧
      (traceEnvelope Γ : Set (Matrix (Fin 2) (Fin 2) ℝ)) =
        (fun X ↦ (c : Matrix (Fin 2) (Fin 2) ℝ) * X * ((c⁻¹ : SL(2, ℝ)) : Matrix (Fin 2) (Fin 2) ℝ)) ''
          traceEnvelope Δ := by
  sorry

/-! ## Quaternion orders -/

section Orders

variable {K : Type*} [Field K] (a b : K)

/-- An order of `(a,b)_K`: an `𝓞 K`-subalgebra that is finitely generated as an `𝓞 K`-module and
spans the algebra over `K`. -/
structure IsQuaternionOrder (O : Subalgebra (𝓞 K) ℍ[K, a, b]) : Prop where
  fg : (Subalgebra.toSubmodule O).FG
  span_eq_top : Submodule.span K (O : Set ℍ[K, a, b]) = ⊤

/-- A maximal order: an order contained in no strictly larger order. -/
def IsMaximalQuaternionOrder (O : Subalgebra (𝓞 K) ℍ[K, a, b]) : Prop :=
  IsQuaternionOrder a b O ∧
    ∀ O' : Subalgebra (𝓞 K) ℍ[K, a, b], IsQuaternionOrder a b O' → O ≤ O' → O' = O

/-- A subgroup of the norm-one group whose `K`-span is the algebra and whose reduced traces are
algebraic integers generates an order over `𝓞 K`, and that order lies in a maximal order. -/
theorem integral_trace_lattice_order [NumberField K] (ha : a ≠ 0) (hb : b ≠ 0)
    (H : Subgroup (unitary ℍ[K, a, b]))
    (hspan : Submodule.span K
      ((fun h : unitary ℍ[K, a, b] ↦ (h : ℍ[K, a, b])) '' (H : Set (unitary ℍ[K, a, b]))) = ⊤)
    (htrace : ∀ h ∈ H, IsIntegral ℤ (2 * ((h : unitary ℍ[K, a, b]) : ℍ[K, a, b]).re)) :
    ∃ R : Subalgebra (𝓞 K) ℍ[K, a, b],
      Subalgebra.toSubmodule R = Submodule.span (𝓞 K)
        ((fun h : unitary ℍ[K, a, b] ↦ (h : ℍ[K, a, b])) '' (H : Set (unitary ℍ[K, a, b]))) ∧
        IsQuaternionOrder a b R ∧ ∃ O, IsMaximalQuaternionOrder a b O ∧ R ≤ O := by
  sorry

/-- The localization of the global reduced-norm form is the reduced-norm form of the base-changed
quaternion algebra, for every field extension, completions included. -/
theorem global_reduced_norm_localization [Invertible (2 : K)] (L : Type*) [Field L] [Algebra K L]
    (x : L ⊗[K] ℍ[K, a, b]) :
    QuadraticForm.baseChange L (QuaternionAlgebra.normForm a 0 b) x =
      QuaternionAlgebra.normForm (algebraMap K L a) 0 (algebraMap K L b)
        (TauCeti.QuaternionAlgebra.baseChangeTwoParams K L a b x) := by
  sorry

end Orders

/-! ## Arithmetic Fuchsian groups -/

/-- A splitting of `(a,b)_k` at exactly one real place. `place` is the distinguished real
embedding, every other real embedding ramifies, and `splitting` restricts to `place` on scalars,
so it is a chosen isomorphism `(a,b)_k ⊗_{k,place} ℝ ≃ M₂(ℝ)`. -/
structure RealSplitting (k : Type*) [Field k] (a b : k) where
  place : k →+* ℝ
  a_ne_zero : a ≠ 0
  b_ne_zero : b ≠ 0
  ramified : ∀ σ : k →+* ℝ, σ ≠ place → σ a < 0 ∧ σ b < 0
  splitting : ℍ[k, a, b] →+* Matrix (Fin 2) (Fin 2) ℝ
  splitting_algebraMap :
    ∀ x : k, splitting (algebraMap k ℍ[k, a, b] x) = Matrix.scalar (Fin 2) (place x)

/-- `Γ(O)`: the subgroup of `PSL(2,ℝ)` generated by the images of the reduced-norm-one elements
of the order `O` under the real splitting. -/
def normOneImage {k : Type*} [Field k] {a b : k} (S : RealSplitting k a b)
    (O : Subalgebra (𝓞 k) ℍ[k, a, b]) : Subgroup PSL(2, ℝ) :=
  Subgroup.closure {γ | ∃ x ∈ unitary ℍ[k, a, b], x ∈ O ∧
    ∃ g : SL(2, ℝ), (g : Matrix (Fin 2) (Fin 2) ℝ) = S.splitting x ∧ projSL g = γ}

/-- Arithmetic Fuchsian groups (Layer 1 item 1): subgroups that, after conjugation in
`PSL(2,ℝ)`, are commensurable with `Γ(O)` for an order `O` of a quaternion algebra over a totally
real field split at exactly one real place. -/
def IsArithmetic (Γ : Subgroup PSL(2, ℝ)) : Prop :=
  ∃ (k : Type) (_ : Field k) (_ : NumberField k), NumberField.IsTotallyReal k ∧
    ∃ (a b : k) (S : RealSplitting k a b) (O : Subalgebra (𝓞 k) ℍ[k, a, b]),
      IsQuaternionOrder a b O ∧ ∃ c : PSL(2, ℝ), (MulAut.conj c • Γ).Commensurable (normOneImage S O)

/-- Every element of an arithmetic group has algebraic-integer trace and squared trace, for
either determinant-one lift. -/
theorem squared_trace_integrality_of_commensurable_arithmetic_group {Γ : Subgroup PSL(2, ℝ)}
    (hΓ : IsArithmetic Γ) {g : SL(2, ℝ)} (hg : g ∈ liftSL Γ) :
    IsIntegral ℤ ((g : Matrix (Fin 2) (Fin 2) ℝ) ^ 2).trace ∧
      IsIntegral ℤ (g : Matrix (Fin 2) (Fin 2) ℝ).trace := by
  sorry

/-! ## Tamagawa number one for the norm-one group -/

section Tamagawa

open NumberField

variable {k : Type*} [Field k] [NumberField k] (a b : k)

/-- `(a,b)_k ⊗_k 𝔸_k`, presented by the images of the three structure constants. -/
noncomputable abbrev AdelicQuaternion :=
  ℍ[AdeleRing (𝓞 k) k, algebraMap k (AdeleRing (𝓞 k) k) a, algebraMap k (AdeleRing (𝓞 k) k) 0,
    algebraMap k (AdeleRing (𝓞 k) k) b]

/-- The coordinatewise topology on `(a,b)_k ⊗_k 𝔸_k`. -/
noncomputable instance : TopologicalSpace (AdelicQuaternion a b) :=
  TopologicalSpace.induced (QuaternionAlgebra.equivTuple _ _ _) inferInstance

/-- `SL₁(B)(𝔸_k)` for `B = (a,b)_k`, with the subspace topology and its Borel σ-algebra. -/
noncomputable abbrev AdelicNormOne := unitary (AdelicQuaternion a b)

noncomputable instance : MeasurableSpace (AdelicNormOne a b) := borel _

instance : BorelSpace (AdelicNormOne a b) := ⟨rfl⟩

/-- The diagonal embedding `SL₁(B)(k) → SL₁(B)(𝔸_k)`. -/
noncomputable def diagonalNormOne : unitary ℍ[k, a, b] →* AdelicNormOne a b :=
  (Unitary.map
    { (TauCeti.QuaternionAlgebra.map a 0 b (algebraMap k (AdeleRing (𝓞 k) k))).toMonoidHom with
      map_star' := TauCeti.QuaternionAlgebra.map_star a 0 b _ }).toMonoidHom

/-- `SL₁(B)(k)` acts on `SL₁(B)(𝔸_k)` by left multiplication through the diagonal embedding. -/
noncomputable instance : MulAction (unitary ℍ[k, a, b]) (AdelicNormOne a b) :=
  MulAction.compHom _ (diagonalNormOne a b)

/-- The AdelicAlgebraicGroups AA.2.4 Tamagawa measure on `SL₁(B)(𝔸_k)`: `|d_k|^(-3/2)` times the
restricted product of the local measures of the invariant gauge form obtained as the
reduced-norm-fibre residue of the reduced-trace top form. -/
noncomputable def tamagawaMeasure : Measure (AdelicNormOne a b) := by
  sorry

/-- **Tamagawa number one for `SL₁(B)`.** The quotient `SL₁(B)(k)\SL₁(B)(𝔸_k)` has Tamagawa
volume one. -/
theorem tamagawaNumberOne_SL1_quaternion (ha : a ≠ 0) (hb : b ≠ 0) :
    ∃ s : Set (AdelicNormOne a b),
      IsFundamentalDomain (unitary ℍ[k, a, b]) s (tamagawaMeasure a b) ∧
        tamagawaMeasure a b s = 1 := by
  sorry

end Tamagawa

/-! ## The commensurator criterion -/

/-- A lattice of `PSL(2,ℝ)` with dense commensurator has a number field as squared-trace field. -/
theorem dense_commensurator_squared_trace_field_is_number_field (Γ : Subgroup PSL(2, ℝ))
    [DiscreteTopology Γ]
    (hcov : letI := pslSubgroupMulAction Γ
      ∃ s : Set UpperHalfPlane, IsFundamentalDomain Γ s volume ∧ volume s < ⊤)
    (hdense : Dense (Subgroup.Commensurable.commensurator Γ : Set PSL(2, ℝ))) :
    FiniteDimensional ℚ (squaredTraceField Γ) := by
  sorry

/-! ## The order-32 almost-conjugate pair -/

def p85Scale (u : (ZMod 8)ˣ) : MulAut (Multiplicative (ZMod 8)) where
  toFun x := Multiplicative.ofAdd ((u : ZMod 8) * x.toAdd)
  invFun x := Multiplicative.ofAdd (((u⁻¹ : (ZMod 8)ˣ) : ZMod 8) * x.toAdd)
  left_inv x := by simp [← mul_assoc]
  right_inv x := by simp [← mul_assoc]
  map_mul' x y := by
    change Multiplicative.ofAdd ((u : ZMod 8) * (x.toAdd + y.toAdd)) =
      Multiplicative.ofAdd ((u : ZMod 8) * x.toAdd + (u : ZMod 8) * y.toAdd)
    rw [mul_add]

def p85ScaleHom : (ZMod 8)ˣ →* MulAut (Multiplicative (ZMod 8)) where
  toFun := p85Scale
  map_one' := by ext x; simp [p85Scale]
  map_mul' u v := by ext x; simp [p85Scale, mul_assoc]

abbrev p85AffineGroup := Multiplicative (ZMod 8) ⋊[p85ScaleHom] (ZMod 8)ˣ

instance : Fintype p85AffineGroup :=
  Fintype.ofEquiv (Multiplicative (ZMod 8) × (ZMod 8)ˣ) SemidirectProduct.equivProd.symm

def p85Unit3 : (ZMod 8)ˣ := ⟨3, 3, by decide, by decide⟩
def p85Unit5 : (ZMod 8)ˣ := ⟨5, 5, by decide, by decide⟩
def p85Unit7 : (ZMod 8)ˣ := ⟨7, 7, by decide, by decide⟩

def p85Element (u : (ZMod 8)ˣ) (a : ZMod 8) : p85AffineGroup :=
  ⟨Multiplicative.ofAdd a, u⟩

@[simp] theorem p85Element_mul (u v : (ZMod 8)ˣ) (a b : ZMod 8) :
    p85Element u a * p85Element v b = p85Element (u*v) (a+(u : ZMod 8)*b) := rfl

def p85H1Elements : Finset p85AffineGroup :=
  {p85Element 1 0, p85Element p85Unit3 0, p85Element p85Unit5 0, p85Element p85Unit7 0}
def p85H2Elements : Finset p85AffineGroup :=
  {p85Element 1 0, p85Element p85Unit3 4, p85Element p85Unit5 4, p85Element p85Unit7 0}

def p85H₁ : Subgroup p85AffineGroup where
  carrier := {x | x ∈ p85H1Elements}
  one_mem' := by decide +kernel
  mul_mem' := by decide +kernel
  inv_mem' := by decide +kernel

def p85H₂ : Subgroup p85AffineGroup where
  carrier := {x | x ∈ p85H2Elements}
  one_mem' := by decide +kernel
  mul_mem' := by decide +kernel
  inv_mem' := by decide +kernel

theorem p85_card : Fintype.card p85AffineGroup = 32 := by decide

theorem p85H₁_card : p85H1Elements.card = 4 := by decide

theorem p85H₂_card : p85H2Elements.card = 4 := by decide

instance (x : p85AffineGroup) : Decidable (x ∈ p85H₁) :=
  inferInstanceAs (Decidable (x ∈ p85H1Elements))
instance (x : p85AffineGroup) : Decidable (x ∈ p85H₂) :=
  inferInstanceAs (Decidable (x ∈ p85H2Elements))

instance : Fintype p85H₁ := Fintype.ofFinset p85H1Elements (by intro x; rfl)
instance : Fintype p85H₂ := Fintype.ofFinset p85H2Elements (by intro x; rfl)

theorem p85H₁_subgroup_card : Fintype.card p85H₁ = 4 := by decide
theorem p85H₂_subgroup_card : Fintype.card p85H₂ = 4 := by decide

/-- The number of elements of a finite subgroup in a named conjugacy class. -/
def p85ConjugacyCount (S : Finset p85AffineGroup) (q : p85AffineGroup) : ℕ :=
  (Finset.univ.filter fun x => x ∈ S ∧ ∃ g : p85AffineGroup, g*q*g⁻¹=x).card

/-- The two subgroups have equal intersection counts with every conjugacy class. -/
theorem p85AlmostConjugate (q : p85AffineGroup) :
    p85ConjugacyCount p85H1Elements q = p85ConjugacyCount p85H2Elements q := by
  revert q
  decide +kernel

/-- No inner automorphism carries the first subgroup to the second. -/
theorem p85_not_conjugate :
    ¬ ∃ g : p85AffineGroup, ∀ x : p85AffineGroup,
      x ∈ p85H₂ ↔ g⁻¹*x*g ∈ p85H₁ := by
  decide +kernel

def p85Translation : p85AffineGroup := p85Element 1 1
def p85Dilation3 : p85AffineGroup := p85Element p85Unit3 0
def p85Dilation5 : p85AffineGroup := p85Element p85Unit5 0

theorem p85_normalForm (x : p85AffineGroup) :
    ∃ i : Fin 8, ∃ j k : Fin 2,
      x = p85Translation^i.val * p85Dilation3^j.val * p85Dilation5^k.val := by
  revert x
  decide +kernel

/-- Translation and the two specified dilations generate the entire affine group. -/
theorem p85_generates :
    Subgroup.closure ({p85Translation,p85Dilation3,p85Dilation5} : Set p85AffineGroup) = ⊤ := by
  apply (Subgroup.eq_top_iff' _).mpr
  intro x
  obtain ⟨i,j,k,rfl⟩ := p85_normalForm x
  have ht : p85Translation ∈ Subgroup.closure
      ({p85Translation,p85Dilation3,p85Dilation5} : Set p85AffineGroup) :=
    Subgroup.subset_closure (by simp)
  have h3 : p85Dilation3 ∈ Subgroup.closure
      ({p85Translation,p85Dilation3,p85Dilation5} : Set p85AffineGroup) :=
    Subgroup.subset_closure (by simp)
  have h5 : p85Dilation5 ∈ Subgroup.closure
      ({p85Translation,p85Dilation3,p85Dilation5} : Set p85AffineGroup) :=
    Subgroup.subset_closure (by simp)
  exact mul_mem (mul_mem (pow_mem ht _) (pow_mem h3 _)) (pow_mem h5 _)

/-- The concrete counts give almost-conjugacy in the sense of `Subgroup.AlmostConjugate`: the two
subgroups meet every conjugacy class of `p85AffineGroup` in the same number of elements. -/
theorem p85H₁_almostConjugate_p85H₂ : p85H₁.AlmostConjugate p85H₂ := by
  decide +kernel

end TauCetiRoadmap.ArithmeticFuchsianGroups
