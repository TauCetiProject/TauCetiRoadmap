/-!
# Enriques surfaces: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs. Two headlines are statable at the pins on
this roadmap's side of its supplier boundary: the full image of the mod-two T246
reflection action (§5.3) and Cossec–Dolgachev's descriptions of its two congruence
kernels as normal closures of longest parabolic elements (§§5.2–5.3). The general
faithfulness, root-sign and integral realization theorems for the native Coxeter
geometric representation are RootSystems §§1.1–1.4; the T246 integral/real comparison
of §5.2 is their instance and is a README target, not a declaration here.

The remaining headlines are not statable at the pins with a few simple definitions.
Layer 1's canonical K3 cover, Picard specialization and integral numerical-lattice
isometry need the Enriques predicate, surface numerical quotient and specialization
maps. Its coefficient comparisons additionally need integral étale cycle maps.
Layer 2's hyperelliptic classification and double-plane theorem need half-fibres,
complete linear systems and their resolved presentation carrier. Layer 3's equivalence
needs that presentation groupoid. Layer 4's Reye-family theorem needs the universal
web degeneracy family and its parameter quotient. Layer 5's integral overlattice
comparisons need the geometric Reye lattice and its marking adapter. Layer 6's nodal
automorphism and curve-transitivity theorems need the Reye open locus and its surface
action. Its unnodal lifting criterion, very-general automorphism theorem and algebraic
generic-open theorem need canonical-cover markings, Hodge isometries, period families
and relative Jacobian deformations. Layer 7's model counts need the source's
presentation equivalence relation and its comparison with the intrinsic groupoid. No
formal placeholder for any of these objects is introduced.
-/

namespace TauCetiRoadmap.EnriquesSurfaces

/-! ## Layer 5: the two lattices and the faithful reflection action -/

/-- The T246 graph has chain 1--9 and the extra edge 0--4. -/
def reyeAdjacent (i j : Fin 10) : Prop :=
  (i.val > 0 ∧ j.val > 0 ∧ (i.val + 1 = j.val ∨ j.val + 1 = i.val)) ∨
  (i = 0 ∧ j = 4) ∨ (i = 4 ∧ j = 0)

/-- Adjacency in this finite graph is decidable. -/
instance reyeAdjacentDecidable (i j : Fin 10) : Decidable (reyeAdjacent i j) := by
  unfold reyeAdjacent
  infer_instance

/-- Coxeter exponents are 1 on the diagonal, 3 on edges and 2 elsewhere. -/
def reyeCoxeterEntry : Matrix (Fin 10) (Fin 10) ℕ :=
  fun i j ↦ if i = j then 1 else if reyeAdjacent i j then 3 else 2

/-- The abstract T246 Coxeter matrix, with its actual entries. -/
def reyeDiagram : CoxeterMatrix (Fin 10) where
  M := reyeCoxeterEntry
  isSymm := by decide +kernel
  diagonal i := by simp [reyeCoxeterEntry]
  off_diagonal i j h := by
    simp only [reyeCoxeterEntry, h, ite_false]
    split_ifs <;> decide

/-- `w` is the longest element of the standard parabolic subgroup on the node set `J`: it lies in
the subgroup generated by the simple reflections indexed by `J`, and no element of that subgroup
has greater Coxeter length. For a finite parabolic subgroup exactly one element satisfies this. -/
def IsParabolicLongest (J : Set (Fin 10)) (w : reyeDiagram.Group) : Prop :=
  w ∈ Subgroup.closure (reyeDiagram.toCoxeterSystem.simple '' J) ∧
    ∀ v ∈ Subgroup.closure (reyeDiagram.toCoxeterSystem.simple '' J),
      reyeDiagram.toCoxeterSystem.length v ≤ reyeDiagram.toCoxeterSystem.length w

/-- The simple-root coordinates of the Reye lattice modulo twice that lattice. -/
abbrev ReyeReduction := Fin 10 → ZMod 2

/-- Half the even integral norm modulo two; each unoriented edge occurs once. -/
def reyeQuadratic (x : ReyeReduction) : ZMod 2 :=
  (∑ i, x i) + ∑ i, ∑ j,
    if i.val < j.val ∧ reyeAdjacent i j then x i * x j else 0

/-- The polar pairing of the half-norm quadratic form. -/
def reyePolar (x y : ReyeReduction) : ZMod 2 :=
  reyeQuadratic (x + y) - reyeQuadratic x - reyeQuadratic y

/-- The mod-two simple reflections generate exactly the quadratic isometries
fixing the polar radical pointwise, including the nontrivial shear subgroup. -/
theorem reyeReductionImage :
    ∃ ρ : reyeDiagram.Group →* Module.End (ZMod 2) ReyeReduction,
      (∀ i x, ρ (reyeDiagram.toCoxeterSystem.simple i) x =
        x + reyePolar x (Pi.single i 1) • Pi.single i 1) ∧
      ∀ g : ReyeReduction ≃ₗ[ZMod 2] ReyeReduction,
        ((∀ x, reyeQuadratic (g x) = reyeQuadratic x) ∧
          ∀ x, (∀ y, reyePolar x y = 0) → g x = x) ↔
        ∃ w, ∀ x, ρ w x = g x := by
  sorry

/-- Cossec–Dolgachev, Proposition 1 (Bull. AMS 12 (1985), p. 248). Let `ρ` be the mod-two
action given by the simple-generator formula, `B` and `K` the longest elements of the E₈
parabolic on `{0, 2, …, 8}` and the E₇ parabolic on `{0, 1, …, 6}`, and `K'` that of the E₇
parabolic on `{0, 2, …, 7}`. (i) The kernel `W(2)` of `ρ` is the normal closure of `B` and `K`.
(ii) An element acts trivially on the quotient of `ReyeReduction` by the polar radical exactly
when it lies in the normal closure `Wbar(2)` of `B`, `K` and `G = K' s₉`. -/
theorem reyeCongruenceKernels
    (ρ : reyeDiagram.Group →* Module.End (ZMod 2) ReyeReduction)
    (hρ : ∀ i x, ρ (reyeDiagram.toCoxeterSystem.simple i) x =
      x + reyePolar x (Pi.single i 1) • Pi.single i 1)
    (B K K' : reyeDiagram.Group)
    (hB : IsParabolicLongest {0, 2, 3, 4, 5, 6, 7, 8} B)
    (hK : IsParabolicLongest {0, 1, 2, 3, 4, 5, 6} K)
    (hK' : IsParabolicLongest {0, 2, 3, 4, 5, 6, 7} K') :
    ρ.ker = Subgroup.normalClosure {B, K} ∧
      ∀ w, (∀ x y, reyePolar (ρ w x - x) y = 0) ↔
        w ∈ Subgroup.normalClosure {B, K, K' * reyeDiagram.toCoxeterSystem.simple 9} := by
  sorry

end TauCetiRoadmap.EnriquesSurfaces
