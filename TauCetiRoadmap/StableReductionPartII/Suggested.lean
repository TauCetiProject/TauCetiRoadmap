module

public import Mathlib

/-!
# Stable reduction, Part II: target signatures

The roadmap is README.md; this file is not the roadmap. It states the roadmap's
headline theorems against the pinned APIs.

Not statable at the pins:
* The formally versal pointed-node hull lacks nodal deformation groupoids and formal hulls.
* The coherent-sheaf globalization of relative stable reflexivity on nodal families
  lacks coherent sheaf Ext on schemes; the module-level criterion and the two-base
  completion theorem are stated below.
* Expansion–contraction and the universal-curve equivalence lack pointed stable
  families, their moduli stacks, and relative Proj of the expansion sheaf.
* Decorated boundary normalization and smoothing conormal descent lack clutching,
  algebraic-stack normalization, and marking cotangent lines.
* Connected fine symplectic curve level lacks the polarized relative Jacobian and
  curve level moduli with the pairing and dual/twist comparison.
* The integral Noether isomorphism lacks stable moduli, Hodge pushforward,
  determinant of cohomology, and the Deligne pairing.
* Stable compactification after finite base change lacks stable-family and
  classifying-stack carriers.
* Compactified Torelli and Hodge nefness/bigness lack relative Jacobians,
  Siegel minimal compactifications, Torelli, and line positivity interfaces.
* Degree-Picard parameters, lifting obstructions and torsors, and infinitesimal
  Hodge comparison lack relative Picard and stack cohomology carriers.

The polynomial results are independent local headline theorems, not substitutes
for any of these geometric theorems.
-/

@[expose] public section

namespace TauCetiRoadmap.StableReductionPartII

open CategoryTheory TensorProduct

/-! ## Layer 2: universal curves and the full pointed stable range -/

universe u v

noncomputable section

/-- The equation q(X,Y) - q(s,t), where q(X,Y) = X² + γXY + δY². -/
def pointedNodeEquation (A : Type u) [CommRing A] (γ δ s t : A) :
    MvPolynomial (Fin 2) A :=
  MvPolynomial.X 0 ^ 2 + MvPolynomial.C γ * MvPolynomial.X 0 * MvPolynomial.X 1 +
    MvPolynomial.C δ * MvPolynomial.X 1 ^ 2 - MvPolynomial.C (s ^ 2 + γ * s * t + δ * t ^ 2)

/-- The actual polynomial quotient by the pointed quadratic equation. -/
abbrev pointedNodeRing (A : Type u) [CommRing A] (γ δ s t : A) :=
  MvPolynomial (Fin 2) A ⧸ Ideal.span {pointedNodeEquation A γ δ s t}

/-- The section ideal generated by the coordinate differences X-s and Y-t. -/
def pointedSectionIdeal (A : Type u) [CommRing A] (γ δ s t : A) :
    Ideal (pointedNodeRing A γ δ s t) :=
  Ideal.span {
    Ideal.Quotient.mk _ (MvPolynomial.X 0) - algebraMap A _ s,
    Ideal.Quotient.mk _ (MvPolynomial.X 1) - algebraMap A _ t}

/-- The left node-section matrix, with columns (a,-c) and (b,d). -/
def nodePhi (A : Type u) [CommRing A] (γ δ s t : A) :
    Matrix (Fin 2) (Fin 2) (pointedNodeRing A γ δ s t) :=
  let u := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 0)
  let v := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 1)
  let ι := algebraMap A (pointedNodeRing A γ δ s t)
  Matrix.of ![![ι δ * v + ι δ * ι t + ι γ * u, u + ι s + ι γ * ι t],
    ![-(u - ι s), v - ι t]]

/-- The right node-section matrix, the adjugate of the left matrix. -/
def nodePsi (A : Type u) [CommRing A] (γ δ s t : A) :
    Matrix (Fin 2) (Fin 2) (pointedNodeRing A γ δ s t) :=
  let u := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 0)
  let v := Ideal.Quotient.mk (Ideal.span {pointedNodeEquation A γ δ s t}) (MvPolynomial.X 1)
  let ι := algebraMap A (pointedNodeRing A γ δ s t)
  Matrix.of ![![v - ι t, -(u + ι s + ι γ * ι t)],
    ![u - ι s, ι δ * v + ι δ * ι t + ι γ * u]]

/-- Stable reflexivity (Ile, Definition 3.1): canonical biduality together with vanishing of
every positive Ext of M and of its dual into R. No finiteness is imposed. -/
def IsStablyReflexive (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] :
    Prop :=
  Module.IsReflexive R M ∧ ∀ n : ℕ,
    Limits.IsZero (((Ext R (ModuleCat.{u} R) (n + 1)).obj
      (Opposite.op (ModuleCat.of R M))).obj (ModuleCat.of R R)) ∧
    Limits.IsZero (((Ext R (ModuleCat.{u} R) (n + 1)).obj
      (Opposite.op (ModuleCat.of R (Module.Dual R M)))).obj (ModuleCat.of R R))

/-- Stable reflexivity relative to A → R (Ile, Definition 3.4): M is A-flat and, for every
maximal ideal q of R with contraction p to A, the fibre `M ⊗_A κ(p)`, written as the base
change of M to `R ⊗_A κ(p)`, is stably reflexive over `R ⊗_A κ(p)`. -/
def IsRelativelyStablyReflexive (A R : Type u) [CommRing A] [CommRing R] [Algebra A R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module A M] [IsScalarTower A R M] : Prop :=
  Module.Flat A M ∧ ∀ (q : Ideal R) [q.IsMaximal],
    IsStablyReflexive (R ⊗[A] (q.comap (algebraMap A R)).ResidueField)
      ((R ⊗[A] (q.comap (algebraMap A R)).ResidueField) ⊗[R] M)

/-- Universal coefficients over A: for every A-module N the canonical maps
`f ⊗ n ↦ (m ↦ f m ⊗ n)` from `M* ⊗_A N` to `Hom_R(M, R ⊗_A N)` and `m ⊗ n ↦ (f ↦ f m ⊗ n)`
from `M ⊗_A N` to `Hom_R(M*, R ⊗_A N)` are bijective, and every positive Ext of M and of M*
into `R ⊗_A N` vanishes. -/
def HasUniversalCoefficients (A R : Type u) [CommRing A] [CommRing R] [Algebra A R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module A M] [IsScalarTower A R M] : Prop :=
  ∀ (N : Type u) [AddCommGroup N] [Module A N],
    (∃ e : Module.Dual R M ⊗[A] N ≃ₗ[A] (M →ₗ[R] R ⊗[A] N),
      ∀ (f : Module.Dual R M) (n : N) (m : M), e (f ⊗ₜ n) m = f m ⊗ₜ n) ∧
    (∃ e : M ⊗[A] N ≃ₗ[A] (Module.Dual R M →ₗ[R] R ⊗[A] N),
      ∀ (m : M) (n : N) (f : Module.Dual R M), e (m ⊗ₜ n) f = f m ⊗ₜ n) ∧
    ∀ i : ℕ,
      Limits.IsZero (((Ext R (ModuleCat.{u} R) (i + 1)).obj
        (Opposite.op (ModuleCat.of R M))).obj (ModuleCat.of R (R ⊗[A] N))) ∧
      Limits.IsZero (((Ext R (ModuleCat.{u} R) (i + 1)).obj
        (Opposite.op (ModuleCat.of R (Module.Dual R M)))).obj (ModuleCat.of R (R ⊗[A] N)))

/-- The node-section complex and its transpose remain exact after tensoring over A
with any A-module. No discriminant, Noetherian, domain, or flatness hypothesis is
needed for this polynomial theorem. Knudsen §3 gives the nodal starting point;
monic division and coefficient-flat cokernels give the arbitrary-ring extension. -/
theorem nodeSection_universallyExact
    (A : Type u) [CommRing A] (γ δ s t : A)
    (N : Type v) [AddCommGroup N] [Module A N] :
    let f := (nodePhi A γ δ s t).mulVecLin.restrictScalars A
    let g := (nodePsi A γ δ s t).mulVecLin.restrictScalars A
    let ft := (nodePhi A γ δ s t).transpose.mulVecLin.restrictScalars A
    let gt := (nodePsi A γ δ s t).transpose.mulVecLin.restrictScalars A
    Function.Exact (f.rTensor N) (g.rTensor N) ∧
      Function.Exact (g.rTensor N) (f.rTensor N) ∧
      Function.Exact (ft.rTensor N) (gt.rTensor N) ∧
      Function.Exact (gt.rTensor N) (ft.rTensor N) := by
  sorry

/-- Canonical evaluation into the double dual is an isomorphism for the actual
polynomial section ideal, over every commutative base, including a zero ring or a repeated
quadratic root (Knudsen, §3 and Proposition 3.1). Reflexivity of its ring-linear dual then
follows from Mathlib's `Module.instIsReflexiveDual`. -/
theorem pointedSection_reflexive
    (A : Type u) [CommRing A] (γ δ s t : A) :
    Module.IsReflexive (pointedNodeRing A γ δ s t) (pointedSectionIdeal A γ δ s t) := by
  sorry

/-- The pointed section ideal has universal coefficients over A: for every A-module N the
canonical maps `J* ⊗_A N → Hom_R(J, R ⊗_A N)` and `J ⊗_A N → Hom_R(J*, R ⊗_A N)` are
bijective and all positive Ext of J and of J* into `R ⊗_A N` vanish. No flatness of N,
Noetherian, discriminant or nontriviality hypothesis is needed. -/
theorem pointedSection_universalCoefficients (A : Type u) [CommRing A] (γ δ s t : A) :
    HasUniversalCoefficients A (pointedNodeRing A γ δ s t) (pointedSectionIdeal A γ δ s t) := by
  sorry

/-- Universal coefficient criterion (Ile, Definition 3.4, Proposition 3.5 and Remark 3.6):
for a flat map of Noetherian rings A → R and a finite R-module M, M is stably reflexive
relative to A exactly when it has universal coefficients over A. -/
theorem relativelyStablyReflexive_iff_universalCoefficients
    (A R : Type u) [CommRing A] [CommRing R] [IsNoetherianRing A] [IsNoetherianRing R]
    [Algebra A R] [Module.Flat A R]
    (M : Type u) [AddCommGroup M] [Module R M] [Module A M] [IsScalarTower A R M]
    [Module.Finite R M] :
    IsRelativelyStablyReflexive A R M ↔ HasUniversalCoefficients A R M := by
  sorry

/-- Knudsen's completion theorem (Knudsen II, Appendix, Proposition 6; Ile, Proposition 4.3
and Remark 4.4): for a flat local homomorphism `A → R` of Noetherian local rings and a finite
`R`-module `M`, with `Â`, `R̂` the maximal-ideal completions and `M̂` the completion of `M`, the
ring `R̂` is flat over `Â`, and `M` is relatively stably reflexive over `A` exactly when `M̂` is
relatively stably reflexive over `A`, exactly when `M̂` is relatively stably reflexive over `Â`.
The `Â`-algebra structure on `R̂` is a datum pinned by two laws: it restricts to `A → R` and
is local; this forces it to be the continuous extension of `A → R`. The `Â`-module structure
on `M̂` is pinned by the scalar tower through `R̂`. -/
theorem relativelyStablyReflexive_iff_completion
    (A R : Type u) [CommRing A] [CommRing R] [IsNoetherianRing A] [IsNoetherianRing R]
    [IsLocalRing A] [IsLocalRing R] [Algebra A R] [Module.Flat A R]
    [IsLocalHom (algebraMap A R)]
    (M : Type u) [AddCommGroup M] [Module R M] [Module A M] [IsScalarTower A R M]
    [Module.Finite R M]
    [Algebra (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal R) R)]
    [IsScalarTower A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal R) R)]
    [IsLocalHom (algebraMap (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal R) R))]
    [IsScalarTower A (AdicCompletion (IsLocalRing.maximalIdeal R) R)
      (AdicCompletion (IsLocalRing.maximalIdeal R) M)]
    [Module (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal R) M)]
    [IsScalarTower (AdicCompletion (IsLocalRing.maximalIdeal A) A)
      (AdicCompletion (IsLocalRing.maximalIdeal R) R)
      (AdicCompletion (IsLocalRing.maximalIdeal R) M)] :
    Module.Flat (AdicCompletion (IsLocalRing.maximalIdeal A) A)
        (AdicCompletion (IsLocalRing.maximalIdeal R) R) ∧
      (IsRelativelyStablyReflexive A R M ↔
        IsRelativelyStablyReflexive A (AdicCompletion (IsLocalRing.maximalIdeal R) R)
          (AdicCompletion (IsLocalRing.maximalIdeal R) M)) ∧
      (IsRelativelyStablyReflexive A (AdicCompletion (IsLocalRing.maximalIdeal R) R)
          (AdicCompletion (IsLocalRing.maximalIdeal R) M) ↔
        IsRelativelyStablyReflexive (AdicCompletion (IsLocalRing.maximalIdeal A) A)
          (AdicCompletion (IsLocalRing.maximalIdeal R) R)
          (AdicCompletion (IsLocalRing.maximalIdeal R) M)) := by
  sorry

end

end TauCetiRoadmap.StableReductionPartII
