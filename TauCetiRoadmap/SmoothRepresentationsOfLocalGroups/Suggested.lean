/-!
# Smooth representations of local groups: headline target statements

**This file is not the roadmap and is not exhaustive.** The definitive document is `README.md`.
The statements here suggest Lean forms for headline milestones; proving them finishes neither
a layer nor the roadmap.

The statements cover the Grothendieck property of the smooth category (SR.0d), Whittaker
multiplicity one for irreducible infinite-dimensional complex representations of GL₂ (SR.2),
admissibility and uniform admissibility for all connected reductive local groups (SR.3a),
Howe's finite-length theorem, noetherianity and finiteness of Hecke algebras over their centres
(SR.3), and Grothendieck monodromy with complete normed coefficients and Frobenius
semisimplification of raw Weil–Deligne parameters and scalar endomorphisms of co-Whittaker
families (SR.5.2), together with their endomorphism comparison after arbitrary coefficient-module
tensoring (SR.5.3).

The Bernstein decomposition and its centre formula require cuspidal data and inertial blocks;
Casselman's criterion and the conditional Langlands classification require the split-centre
exponents, cones and tempered-support datum. Their signatures are deferred to these
constructions. The pins have algebraic induction and coinvariants but no smooth parabolic
induction or Jacquet functors for stating second adjointness (SR.2a and SR.5.2). Classical and
derived Satake (SR.4) require the rational root, hyperspecial and dual-torus data and the actual
Satake transform. Integral families (SR.5) require the mirabolic functors, distinguished types,
integral blocks, universal Whittaker projectives and the normalized local Langlands
correspondence. The finite-wild quotient and excursion theorems (SR.6) require the local Weil
discretisation, cocycle coordinate algebra and excursion colimit. These are roadmap targets;
their signatures are deferred rather than replaced by predicates for missing objects.

The rational-point carrier below is Tau Ceti's convolution group, with its evaluation topology.
The raw Weil–Deligne fields use Mathlib representations and endomorphisms; their specified
arithmetic degree permits the Frobenius-semisimplification statement without a new Weil-group
carrier. The monodromy statement uses Tau Ceti's actual local inertia and tame character.
-/

namespace TauCetiRoadmap.SmoothRepresentationsOfLocalGroups

noncomputable section

namespace Representation

variable {A : Type*} [CommRing A] {G : Type*} [Group G] [TopologicalSpace G]
  {V : Type*} [AddCommGroup V] [Module A V]

/-- Smoothness on the algebraic representation carrier: every vector has open stabiliser. -/
class IsSmooth (ρ : _root_.Representation A G V) : Prop where
  isOpen_stabilizer : ∀ v : V, IsOpen ((ρ.stabilizer v : Subgroup G) : Set G)

/-- Admissibility over a commutative ring means finite generation of compact-open invariants. -/
def IsAdmissible (ρ : _root_.Representation A G V) : Prop :=
  IsSmooth ρ ∧ ∀ U : OpenSubgroup G, IsCompact (U : Set G) →
    Module.Finite A (_root_.Representation.invariants (ρ.comp U.toSubgroup.subtype))

/-- The subrepresentation generated by vectors with open stabiliser. In a topological group,
finite linear combinations and translates of such vectors again have open stabiliser. -/
def smoothVectors [IsTopologicalGroup G] (ρ : _root_.Representation A G V) :
    Subrepresentation ρ :=
  Subrepresentation.ofSubmodule' (Submodule.span (MonoidAlgebra A G)
    {v : ρ.asModule | IsOpen ((ρ.stabilizer v : Subgroup G) : Set G)})

end Representation

open CategoryTheory

universe u v

/-- The full subcategory of Mathlib representations with open vector stabilisers. -/
abbrev SmoothRep (A G : Type u) [CommRing A] [Group G] [TopologicalSpace G] :=
  ObjectProperty.FullSubcategory fun X : Rep.{u} A G => Representation.IsSmooth X.ρ

/-- SR.0d.1: smooth representations form a Grothendieck abelian category over any commutative
ring ([Ber87], §§1.1–1.2, pp. 3–4). -/
theorem SmoothRep.grothendieck (A G : Type u) [CommRing A] [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [LocallyCompactSpace G]
    [TotallyDisconnectedSpace G] [T2Space G] :
    ∃ h : Abelian (SmoothRep A G), letI := h; IsGrothendieckAbelian.{u} (SmoothRep A G) := sorry

/-- The canonical inverse-character-twist coinvariants, on Mathlib’s quotient carrier. -/
abbrev WhittakerCoinvariants {A U V : Type*} [CommRing A] [Group U]
    [AddCommGroup V] [Module A V] (ρ : _root_.Representation A U V) (ψ : U →* Aˣ) :=
  _root_.Representation.Coinvariants (_root_.Representation.charTwist ψ⁻¹ ρ)

/-- SR.2.3: Whittaker multiplicity one for every irreducible infinite-dimensional smooth
complex representation of GL₂(F) ([BH06], 36.1 Theorem and Corollary 1, pp. 226–227). -/
theorem whittakerCoinvariants_one_dimensional
    {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (ψ : TauCeti.upperUnitriangularGroup (Fin 2) F →* ℂˣ)
    (hψ : IsOpen (ψ.ker : Set (TauCeti.upperUnitriangularGroup (Fin 2) F))) (hψ1 : ψ ≠ 1)
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (ρ : _root_.Representation ℂ (GL (Fin 2) F) V)
    (hs : Representation.IsSmooth ρ) (hi : ρ.IsIrreducible)
    (hinf : ¬ Module.Finite ℂ V) :
    Nonempty (WhittakerCoinvariants
      (ρ.comp (TauCeti.upperUnitriangularGroup (Fin 2) F).subtype) ψ ≃ₗ[ℂ] ℂ) := sorry

section Reductive

variable {F : Type u} [Field F] [TopologicalSpace F]

/-- The native convolution group of F-points of the affine group Spec H. -/
abbrev Points (H : TauCeti.FiniteTypeCommHopfAlgCat.{u, u} F) : Type u :=
  WithConv ((H : Type u) →ₐ[F] F)

/-- The evaluation topology on the convolution group of rational points. -/
local instance pointsTopology (H : TauCeti.FiniteTypeCommHopfAlgCat.{u, u} F) :
    TopologicalSpace (Points H) :=
  ⨅ a : (H : Type u), TopologicalSpace.induced
    (fun f : Points H => WithConv.ofConv f a) ‹TopologicalSpace F›

variable {H : TauCeti.FiniteTypeCommHopfAlgCat.{u, u} F}
  [ValuativeRel F] [IsNonarchimedeanLocalField F]

/-- SR.3a.1: every irreducible smooth complex representation of a connected reductive group
over a nonarchimedean local field is admissible ([Ber92], Ch. II §1.3, Theorem 12, p. 37). -/
theorem isAdmissible_of_isIrreducible
    (hH : TauCeti.reductiveCommHopfAlgProperty F H)
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (ρ : _root_.Representation ℂ (Points H) V)
    (hs : Representation.IsSmooth ρ) (hi : ρ.IsIrreducible) :
    Representation.IsAdmissible ρ := sorry

/-- SR.3a.2: the dimensions of compact-open invariants are bounded uniformly over all
irreducible smooth complex representations ([Ber92], Ch. II §1.4, pp. 37–38). -/
theorem exists_finrank_invariants_le
    (hH : TauCeti.reductiveCommHopfAlgProperty F H)
    (K : OpenSubgroup (Points H)) (hK : IsCompact (K : Set (Points H))) :
    ∃ c : ℕ, ∀ (V : Type v) [AddCommGroup V] [Module ℂ V]
      (ρ : _root_.Representation ℂ (Points H) V),
      Representation.IsSmooth ρ → ρ.IsIrreducible →
      Module.Finite ℂ (_root_.Representation.invariants (ρ.comp K.toSubgroup.subtype)) ∧
        Module.finrank ℂ (_root_.Representation.invariants (ρ.comp K.toSubgroup.subtype)) ≤ c := sorry

/-- SR.3.1, Howe's theorem: a finitely generated admissible smooth complex representation
has finite length ([Cas95], Corollaries 6.3.7–6.3.8 and Theorem 6.3.10, pp. 59–61). -/
theorem isFiniteLength_of_isAdmissible
    (hH : TauCeti.reductiveCommHopfAlgProperty F H)
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (ρ : _root_.Representation ℂ (Points H) V)
    (hfg : Module.Finite (MonoidAlgebra ℂ (Points H)) ρ.asModule)
    (hadm : Representation.IsAdmissible ρ) :
    IsFiniteLength (MonoidAlgebra ℂ (Points H)) ρ.asModule := sorry

/-- SR.3.2: every finitely generated smooth complex representation is noetherian
([Ber92], Ch. III §2.2, Lemma 29 and Propositions 32–33, pp. 59–61). -/
theorem isNoetherian_of_finite
    (hH : TauCeti.reductiveCommHopfAlgProperty F H)
    {V : Type v} [AddCommGroup V] [Module ℂ V]
    (ρ : _root_.Representation ℂ (Points H) V)
    (hs : Representation.IsSmooth ρ)
    (hfg : Module.Finite (MonoidAlgebra ℂ (Points H)) ρ.asModule) :
    IsNoetherian (MonoidAlgebra ℂ (Points H)) ρ.asModule := sorry

/-- The level Hecke algebra as endomorphisms of the native permutation module A[G/U]. -/
abbrev HeckeAlgebraLevel (A G : Type*) [CommRing A] [Group G] (U : Subgroup G) :=
  Module.End (MonoidAlgebra A G) (_root_.Representation.ofMulAction A G (G ⧸ U)).asModule

/-- SR.3.2: every compact-open complex Hecke algebra is finite over its centre, and that
centre is a finitely generated complex algebra ([BD84], Proposition 3.3 and Corollaire 3.4,
pp. 26–27). -/
theorem heckeAlgebra_finite_over_center
    (hH : TauCeti.reductiveCommHopfAlgProperty F H)
    (K : OpenSubgroup (Points H)) (hK : IsCompact (K : Set (Points H))) :
    let R := HeckeAlgebraLevel ℂ (Points H) K.toSubgroup
    Module.Finite (Subalgebra.center ℂ R) R ∧
      Algebra.FiniteType ℂ (Subalgebra.center ℂ R) := sorry

end Reductive

section CoWhittaker

variable {k G V : Type u} [Field k] [Group G] [TopologicalSpace G] [AddCommGroup V] [Module k V]

/-- Absolute irreducibility: irreducible after every extension of the coefficient field. -/
def AbsolutelyIrreducible (ρ : _root_.Representation k G V) : Prop :=
  ∀ (L : Type u) [Field L] [Algebra k L], (_root_.Representation.baseChange L ρ).IsIrreducible

/-- Genericity for Whittaker data `(U, ψ)`: the Whittaker coinvariants are nonzero. -/
def IsGeneric (ρ : _root_.Representation k G V) (U : Subgroup G) (ψ : U →* kˣ) : Prop :=
  Nontrivial (WhittakerCoinvariants (ρ.comp U.subtype) ψ)

/-- Essentially AIG ([Hel12], Definition 3.3, p. 5): smooth, with an absolutely irreducible
generic socle `S` (an absolutely irreducible subrepresentation containing every irreducible one),
zero Whittaker coinvariants of `V/S`, and every vector in a finite-length subrepresentation. -/
def EssentiallyAIG (ρ : _root_.Representation k G V) (U : Subgroup G) (ψ : U →* kˣ) : Prop :=
  Representation.IsSmooth ρ ∧ ∃ S : Subrepresentation ρ,
    AbsolutelyIrreducible S.toRepresentation ∧ IsGeneric S.toRepresentation U ψ ∧
    (∀ T : Subrepresentation ρ, T.toRepresentation.IsIrreducible → T ≤ S) ∧
    Subsingleton (WhittakerCoinvariants
      ((ρ.quotient S.toSubmodule fun g => S.apply_mem_toSubmodule g).comp U.subtype) ψ) ∧
    ∀ v : V, ∃ T : Subrepresentation ρ, v ∈ T.toSubmodule ∧
      IsFiniteLength (MonoidAlgebra k G) T.toRepresentation.asModule

variable {A G V : Type u} [CommRing A] [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [AddCommGroup V] [Module A V]

/-- Co-Whittaker families ([Hel12], Definition 6.1, p. 12): admissible, with Whittaker coinvariants
free of rank one over `A`, and with the smooth dual of every fibre `κ(𝔭) ⊗_A V` at a prime `𝔭`
essentially AIG. -/
def CoWhittaker (ρ : _root_.Representation A G V) (U : Subgroup G) (ψ : U →* Aˣ) : Prop :=
  Representation.IsAdmissible ρ ∧
    Nonempty (WhittakerCoinvariants (ρ.comp U.subtype) ψ ≃ₗ[A] A) ∧
    ∀ (P : Ideal A) [P.IsPrime],
      EssentiallyAIG (Representation.smoothVectors
          (_root_.Representation.dual (_root_.Representation.baseChange P.ResidueField ρ))).toRepresentation
        U ((Units.map (algebraMap A P.ResidueField).toMonoidHom).comp ψ)

end CoWhittaker

open ValuativeRel in
/-- SR.5.2: every endomorphism of a co-Whittaker GL_n family is a unique scalar
([Hel12], Proposition 6.2, p. 12). The character on the actual upper unitriangular subgroup is
specified by its simple-superdiagonal formula over W(k), then extended to A. -/
theorem CoWhittaker.scalars {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] {ℓ : ℕ} [Fact ℓ.Prime]
    {k : Type u} [Field k] [IsAlgClosed k] [CharP k ℓ]
    (hℓ : ringChar 𝓀[F] ≠ ℓ) {A : Type u} [CommRing A]
    [IsNoetherianRing A] [Algebra (WittVector ℓ k) A] (n : ℕ) (hn : 0 < n)
    (χ : Multiplicative F →* (WittVector ℓ k)ˣ)
    (hχ : IsOpen (χ.ker : Set (Multiplicative F))) (hχ1 : χ ≠ 1)
    (ψ : TauCeti.upperUnitriangularGroup (Fin n) F →* Aˣ)
    (hψ : ∀ u, ψ u = Units.map (algebraMap (WittVector ℓ k) A).toMonoidHom
      (χ (Multiplicative.ofAdd (∑ i : Fin n, ∑ j : Fin n,
        if (j : ℕ) = i + 1 then ((u : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) i j else 0))))
    {V : Type u} [AddCommGroup V] [Module A V]
    (ρ : _root_.Representation A (GL (Fin n) F) V)
    (h : CoWhittaker ρ (TauCeti.upperUnitriangularGroup (Fin n) F) ψ)
    (f : ρ.IntertwiningMap ρ) : ∃! a : A, ∀ v, f v = a • v := sorry

open scoped TensorProduct in
open ValuativeRel in
/-- SR.5.3: arbitrary coefficient-module tensoring preserves the endomorphism algebra of a
co-Whittaker family, with the comparison fixed on pure tensors ([Nak], Lemma B.10, p. 274;
the all-rank Schwartz argument specified in SR.5.3). -/
theorem CoWhittaker.tensor_endomorphisms {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F] {ℓ : ℕ} [Fact ℓ.Prime]
    {k : Type u} [Field k] [IsAlgClosed k] [CharP k ℓ]
    (hℓ : ringChar 𝓀[F] ≠ ℓ) {A : Type u} [CommRing A]
    [IsNoetherianRing A] [Algebra (WittVector ℓ k) A] (n : ℕ) (hn : 0 < n)
    (χ : Multiplicative F →* (WittVector ℓ k)ˣ)
    (hχ : IsOpen (χ.ker : Set (Multiplicative F))) (hχ1 : χ ≠ 1)
    (ψ : TauCeti.upperUnitriangularGroup (Fin n) F →* Aˣ)
    (hψ : ∀ u, ψ u = Units.map (algebraMap (WittVector ℓ k) A).toMonoidHom
      (χ (Multiplicative.ofAdd (∑ i : Fin n, ∑ j : Fin n,
        if (j : ℕ) = i + 1 then ((u : GL (Fin n) F) : Matrix (Fin n) (Fin n) F) i j else 0))))
    {V : Type u} [AddCommGroup V] [Module A V]
    (ρ : _root_.Representation A (GL (Fin n) F) V)
    (h : CoWhittaker ρ (TauCeti.upperUnitriangularGroup (Fin n) F) ψ)
    (M : Type u) [AddCommGroup M] [Module A M] :
    let τ := (_root_.Representation.trivial A (GL (Fin n) F) M).tprod ρ
    ∃ e : Module.End A M ≃+* Module.End (MonoidAlgebra A (GL (Fin n) F)) τ.asModule,
      ∀ (f : Module.End A M) (m : M) (v : V), e f (m ⊗ₜ[A] v) = f m ⊗ₜ[A] v := sorry


section WeilDeligne

variable {E W V : Type*} [Field E] [CharZero E] [Group W] [TopologicalSpace W]
  [AddCommGroup V] [Module E V] [FiniteDimensional E V]

/-- The shared raw Weil–Deligne fields, with nilpotent monodromy and the arithmetic degree
relation, before imposing Frobenius semisimplicity ([Del73], §8.4.1, p. 568).
The local construction uses the ClassFieldTheory Weil group and its degree homomorphism. -/
structure WeilDeligneParameter (E W V : Type*) [Field E] [CharZero E] [Group W]
    [TopologicalSpace W] [AddCommGroup V] [Module E V] [FiniteDimensional E V]
    (deg : W →* Multiplicative ℤ) (q : ℕ) where
  /-- The Weil action. -/
  r : _root_.Representation E W V
  /-- The action is locally constant. -/
  open_kernel : IsOpen {w : W | r w = 1}
  /-- The monodromy operator. -/
  N : Module.End E V
  /-- Monodromy is nilpotent. -/
  nilpotent : IsNilpotent N
  /-- Arithmetic Frobenius scales monodromy by the residue cardinality. -/
  relation : ∀ w, r w * N * r w⁻¹ = (q : E) ^ Multiplicative.toAdd (deg w) • N

/-- Frobenius semisimplicity is a predicate on the raw fields: every Weil element of nonzero
degree acts semisimply ([Del73], §§8.5–8.6, p. 570). -/
def WeilDeligneParameter.IsFrobeniusSemisimple {deg : W →* Multiplicative ℤ} {q : ℕ}
    (D : WeilDeligneParameter E W V deg q) : Prop :=
  ∀ w, Multiplicative.toAdd (deg w) ≠ 0 → Module.End.IsSemisimple (D.r w)

/-- SR.5.2: Frobenius semisimplification retains monodromy, inertia and every Weil
characteristic polynomial ([Del73], §§8.5–8.6, p. 570). -/
theorem WeilDeligneParameter.exists_frobeniusSemisimple [IsTopologicalGroup W]
    {deg : W →* Multiplicative ℤ} {q : ℕ} (hq : 1 < q)
    (hdeg : Continuous deg) (hsurj : Function.Surjective deg)
    (D : WeilDeligneParameter E W V deg q)
    (hfinite : Set.Finite (D.r '' (deg.ker : Set W))) :
    ∃ Dss : WeilDeligneParameter E W V deg q,
      Dss.IsFrobeniusSemisimple ∧ Dss.N = D.N ∧
      (∀ w ∈ deg.ker, Dss.r w = D.r w) ∧
      ∀ w, (Dss.r w).charpoly = (D.r w).charpoly := sorry

end WeilDeligne

open ValuativeRel in
/-- SR.5.2, Grothendieck monodromy over a complete normed extension of `ℚ_ℓ`: there is a unique
nilpotent operator giving the tame exponential on open inertia and the cyclotomic conjugation
relation. The linear construction uses these fields without an arithmetic `ContinuousRep`
wrapper ([Del73], §8.1 and Theorem 8.2, p. 566). -/
theorem grothendieck_quasiUnipotent_complete
    (K : Type*) [Field K] [ValuativeRel K] [TopologicalSpace K]
    [IsNonarchimedeanLocalField K] (ℓ : ℕ) [Fact ℓ.Prime]
    (hℓ : ℓ.Coprime (ringChar 𝓀[K]))
    (T : TauCeti.PadicTateTwist ℓ (AlgebraicClosure K) ≃ₗ[ℤ_[ℓ]] ℤ_[ℓ])
    {E : Type*} [NormedField E] [NormedAlgebra ℚ_[ℓ] E] [CompleteSpace E]
    {V : Type*} [AddCommGroup V] [Module E V] [FiniteDimensional E V]
    [TopologicalSpace V] [IsModuleTopology E V]
    (ρ : _root_.Representation E (Field.absoluteGaloisGroup K) V)
    (hρ : Continuous fun gv : Field.absoluteGaloisGroup K × V => ρ gv.1 gv.2) :
    ∃! N : Module.End E V, IsNilpotent N ∧
      (∀ w, ρ w ∘ₗ N = algebraMap ℚ_[ℓ] E
        ((TauCeti.localCyclotomicCharacter ℓ K w : ℤ_[ℓ]) : ℚ_[ℓ]) • (N ∘ₗ ρ w)) ∧
      ∃ J : Subgroup (TauCeti.inertiaSubgroup K),
        IsOpen (J : Set (TauCeti.inertiaSubgroup K)) ∧
        ∀ σ ∈ J, ρ (σ : Field.absoluteGaloisGroup K) =
          ∑ i ∈ Finset.range (Module.finrank E V),
            ((algebraMap ℚ_[ℓ] E
              (T (TauCeti.inertiaPadicTameCharacter K hℓ σ).toAdd : ℚ_[ℓ])) ^ i /
                (i.factorial : E)) • N ^ i :=
  sorry

end

end TauCetiRoadmap.SmoothRepresentationsOfLocalGroups
