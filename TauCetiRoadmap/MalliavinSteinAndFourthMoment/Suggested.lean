module

public import Mathlib
public import TauCeti.MeasureTheory.OptimalTransport.Wasserstein.Basic
public import TauCeti.MeasureTheory.Measure.TotalVariation

/-!
# The Malliavin–Stein method and the fourth moment theorem: target signatures

This file is not the roadmap: the roadmap is `README.md`, and this file is not an exhaustive
checklist. It states, against the pinned Mathlib and Tau Ceti and each with `sorry`, the headlines
of the README that carry a Lean name, each with every conclusion the README attaches to it,
together with the definitions their statements need. The README's other headlines are targets of
the same standing, stated there in prose with their locators or proof routes, and are not stated
here.

The conventions of the README are used throughout. Total variation is Mathlib's `tvDist`, the
total variation norm of the difference, with values in `[0, 2]`; it is twice the distance `d_TV`
of Nourdin–Peccati and Nualart–Nualart, so every total-variation constant of those sources is
doubled here. The Kolmogorov distance is written out through `cdf`, as a bound at every point. The
Wasserstein distance of order one is Tau Ceti's `TauCeti.wassersteinEDist 1`, with values in
`ℝ≥0∞`. Gaussian laws are `gaussianReal 0 v` with a variance `v : ℝ≥0`; `gaussianReal 0 0` is the
Dirac mass at `0`.

The definitions of WienerChaosAndMalliavinCalculus (isonormal processes, the chaos, multiple
integrals and contractions, the Malliavin derivative, the divergence relation, the
Ornstein–Uhlenbeck semigroup and the pseudo-inverse of its generator) and the Stein solution of
SteinsMethodForNormalApproximation are verbatim copies, each with a docstring naming its owner and
section; this roadmap owns none of them.

The implementation namespace of the README is `TauCeti`; the prototypes live in this roadmap's
namespace.
-/

@[expose] public section

noncomputable section

open MeasureTheory ProbabilityTheory Filter Set Topology
open scoped ENNReal NNReal InnerProductSpace

namespace TauCetiRoadmap.MalliavinSteinAndFourthMoment

attribute [local instance] Classical.propDecidable

variable {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}

/-! ## Copies of supplier definitions -/

section Copies

/-- Copy of WienerChaosAndMalliavinCalculus (Conventions), verbatim: the `L²` class of a
function, and `0` when the function is not square integrable. -/
def toL2 {E : Type*} [NormedAddCommGroup E] (P : Measure Ω) (f : Ω → E) : Lp E 2 P :=
  if h : MemLp f 2 P then h.toLp f else 0

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Copy of WienerChaosAndMalliavinCalculus §1.1, verbatim: an isonormal Gaussian process on `H`:
a centred Gaussian family of measurable random variables indexed by `H` whose covariance is the
inner product. -/
structure IsIsonormal (W : H → Ω → ℝ) (P : Measure Ω) : Prop where
  /-- Each `W h` is measurable. -/
  measurable : ∀ h, Measurable (W h)
  /-- The family is jointly Gaussian. -/
  isGaussianProcess : IsGaussianProcess W P
  /-- The family is centred. -/
  integral_eq_zero : ∀ h, ∫ ω, W h ω ∂P = 0
  /-- The covariance is the inner product. -/
  integral_mul : ∀ h g, ∫ ω, W h ω * W g ω ∂P = ⟪h, g⟫_ℝ

/-- Copy of WienerChaosAndMalliavinCalculus §1.1, verbatim: the σ-algebra generated by an
isonormal process. -/
@[instance_reducible]
def isonormalSigma (W : H → Ω → ℝ) : MeasurableSpace Ω :=
  ⨆ h, MeasurableSpace.comap (W h) inferInstance

/-- Copy of WienerChaosAndMalliavinCalculus §1.1, verbatim: the square-integrable functionals of
`W`, the classes measurable for `σ(W)` up to null sets. -/
def gaussianL2 (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P) :=
  lpMeas ℝ ℝ (isonormalSigma W) 2 P

/-- Copy of WienerChaosAndMalliavinCalculus §1.2, verbatim: the Wick power
`:W(h)ⁿ: = ‖h‖ⁿ Heₙ(W(h)/‖h‖)`. -/
def wickPower (W : H → Ω → ℝ) (n : ℕ) (h : H) (ω : Ω) : ℝ :=
  ‖h‖ ^ n * Polynomial.aeval (W h ω / ‖h‖) (Polynomial.hermite n)

/-- Copy of WienerChaosAndMalliavinCalculus §2.1, verbatim: the Wiener chaos of order `n`, the
closed span of the Wick powers `:W(h)ⁿ:`. -/
def wienerChaos (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) : Submodule ℝ (Lp ℝ 2 P) :=
  (Submodule.span ℝ (Set.range fun h : H ↦ toL2 P (wickPower W n h))).topologicalClosure

instance (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) :
    (wienerChaos W P n).HasOrthogonalProjection := by
  unfold wienerChaos; infer_instance

/-- Copy of WienerChaosAndMalliavinCalculus §2.1, verbatim: the orthogonal projection `Jₙ` onto
the chaos of order `n`. -/
def chaosProj (W : H → Ω → ℝ) (P : Measure Ω) (n : ℕ) : Lp ℝ 2 P →L[ℝ] Lp ℝ 2 P :=
  (wienerChaos W P n).starProjection

/-- Copy of WienerChaosAndMalliavinCalculus §4.1, verbatim: smooth functions of `n` variables all
of whose derivatives grow at most polynomially. -/
def IsSmoothPolyGrowth {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) : Prop :=
  ContDiff ℝ (⊤ : ℕ∞) f ∧
    ∀ k : ℕ, ∃ (C : ℝ) (m : ℕ), ∀ x, ‖iteratedFDeriv ℝ k f x‖ ≤ C * (1 + ‖x‖) ^ m

/-- Copy of WienerChaosAndMalliavinCalculus §4.1, verbatim: the vector `(W h₁, …, W hₙ)`. -/
def wVec (W : H → Ω → ℝ) {n : ℕ} (h : Fin n → H) (ω : Ω) : EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 fun i ↦ W (h i) ω

/-- Copy of WienerChaosAndMalliavinCalculus §4.1, verbatim: the gradient part
`∑ᵢ ∂ᵢ f(W h₁, …, W hₙ) hᵢ` of the derivative of a cylinder functional. -/
def cylinderGrad (W : H → Ω → ℝ) {n : ℕ} (h : Fin n → H) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (ω : Ω) : H :=
  ∑ i, fderiv ℝ f (wVec W h ω) (EuclideanSpace.single i 1) • h i

/-- Copy of WienerChaosAndMalliavinCalculus §4.1, verbatim: the pairs `(F, DF)` with
`F = f(W h₁, …, W hₙ)` a smooth cylinder functional. -/
def smoothGraph (W : H → Ω → ℝ) (P : Measure Ω) : Set (Lp ℝ 2 P × Lp H 2 P) :=
  {x | ∃ (n : ℕ) (h : Fin n → H) (f : EuclideanSpace ℝ (Fin n) → ℝ), IsSmoothPolyGrowth f ∧
    x.1 = toL2 P (fun ω ↦ f (wVec W h ω)) ∧ x.2 = toL2 P (cylinderGrad W h f)}

/-- Copy of WienerChaosAndMalliavinCalculus §4.2, verbatim: the graph of the closed Malliavin
derivative, the closure of the smooth graph. -/
def malliavinGraph (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P × Lp H 2 P) :=
  (Submodule.span ℝ (smoothGraph W P)).topologicalClosure

/-- Copy of WienerChaosAndMalliavinCalculus §4.2, verbatim: the Sobolev space `𝔻^{1,2}`, the
domain of the closed derivative. -/
def sobolev12 (W : H → Ω → ℝ) (P : Measure Ω) : Submodule ℝ (Lp ℝ 2 P) :=
  (malliavinGraph W P).map (LinearMap.fst ℝ _ _)

/-- Copy of WienerChaosAndMalliavinCalculus §4.2, verbatim: the Malliavin derivative
`DF ∈ L²(Ω; H)` of `F ∈ 𝔻^{1,2}`, and `0` outside `𝔻^{1,2}`. -/
def malliavinDeriv (W : H → Ω → ℝ) (P : Measure Ω) (F : Lp ℝ 2 P) : Lp H 2 P :=
  if h : ∃ G, (F, G) ∈ malliavinGraph W P then h.choose else 0

/-- Copy of WienerChaosAndMalliavinCalculus §5.1, verbatim: `G` is a divergence of `u`:
`E[F G] = E⟪DF, u⟫` for every `F ∈ 𝔻^{1,2}`. -/
def IsDivergence (W : H → Ω → ℝ) (P : Measure Ω) (u : Lp H 2 P) (G : Lp ℝ 2 P) : Prop :=
  ∀ F ∈ sobolev12 W P, ⟪F, G⟫_ℝ = ⟪malliavinDeriv W P F, u⟫_ℝ

/-- Copy of WienerChaosAndMalliavinCalculus §6.1, verbatim: the Ornstein–Uhlenbeck semigroup
`P_t F = ∑ₙ e^{−nt} Jₙ F`. -/
def ouSemigroup (W : H → Ω → ℝ) (P : Measure Ω) (t : ℝ) (F : Lp ℝ 2 P) : Lp ℝ 2 P :=
  ∑' n : ℕ, Real.exp (-(n * t)) • chaosProj W P n F

/-- Copy of WienerChaosAndMalliavinCalculus §6.2, verbatim: the pseudo-inverse
`L⁻¹ F = −∑_{n ≥ 1} n⁻¹ Jₙ F`. -/
def ouPseudoInverse (W : H → Ω → ℝ) (P : Measure Ω) (F : Lp ℝ 2 P) : Lp ℝ 2 P :=
  -∑' n : ℕ, (n : ℝ)⁻¹ • chaosProj W P n F

end Copies

section KernelCopies

variable {T : Type*} [MeasurableSpace T] (μ : Measure T) [SigmaFinite μ]

/-- Copy of WienerChaosAndMalliavinCalculus §3.1, verbatim: the product measure `μ^q` on
`Fin q → T`, on which kernels of order `q` live. -/
def kernelMeasure (q : ℕ) : Measure (Fin q → T) :=
  Measure.pi fun _ ↦ μ

/-- Copy of WienerChaosAndMalliavinCalculus §3.1, verbatim: the tensor power
`h^{⊗q}(t) = ∏ᵢ h(tᵢ)`. -/
def tensorPow (h : Lp ℝ 2 μ) (q : ℕ) : Lp ℝ 2 (kernelMeasure μ q) :=
  toL2 _ fun t ↦ ∏ i, h (t i)

/-- Copy of WienerChaosAndMalliavinCalculus §3.1, verbatim: the symmetric kernels of order `q`,
the closed span of the tensor powers. -/
def symmetricKernels (q : ℕ) : Submodule ℝ (Lp ℝ 2 (kernelMeasure μ q)) :=
  (Submodule.span ℝ (Set.range fun h : Lp ℝ 2 μ ↦ tensorPow μ h q)).topologicalClosure

/-- Copy of WienerChaosAndMalliavinCalculus §3.1, verbatim: a family `I q` of continuous linear
maps is the family of multiple Wiener–Itô integrals of `W` if it sends `h^{⊗q}` to the Wick power
`:W(h)^q:` and vanishes on the kernels orthogonal to every symmetric kernel. -/
structure IsMultipleWienerIntegral (W : Lp ℝ 2 μ → Ω → ℝ) (P : Measure Ω)
    (I : (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q) →L[ℝ] Lp ℝ 2 P) : Prop where
  /-- Tensor powers go to Wick powers. -/
  apply_tensorPow : ∀ q h, I q (tensorPow μ h q) = toL2 P (wickPower W q h)
  /-- The integral only sees the symmetric part of a kernel. -/
  apply_eq_zero : ∀ q f, f ∈ (symmetricKernels μ q)ᗮ → I q f = 0

/-- Copy of WienerChaosAndMalliavinCalculus §3.3, verbatim: the variables of `f` in the
contraction: the first `p − r` come from `x`, the last `r` from the integration variable `u`.
Used only for `r ≤ min p q`. -/
def contractionArgLeft (p q r : ℕ) (x : Fin (p + q - 2 * r) → T) (u : Fin r → T) : Fin p → T :=
  fun i ↦ if hi : (i : ℕ) < p - r ∧ (i : ℕ) < p + q - 2 * r then x ⟨i, hi.2⟩
    else u ⟨i - (p - r), by have := i.isLt; omega⟩

/-- Copy of WienerChaosAndMalliavinCalculus §3.3, verbatim: the variables of `g` in the
contraction: the first `q − r` come from the last `q − r` coordinates of `x`, the last `r` from
`u`. Used only for `r ≤ min p q`. -/
def contractionArgRight (p q r : ℕ) (x : Fin (p + q - 2 * r) → T) (u : Fin r → T) : Fin q → T :=
  fun j ↦ if hj : (j : ℕ) < q - r ∧ p - r + (j : ℕ) < p + q - 2 * r then x ⟨p - r + j, hj.2⟩
    else u ⟨j - (q - r), by have := j.isLt; omega⟩

/-- Copy of WienerChaosAndMalliavinCalculus §3.3, verbatim: the contraction `f ⊗ᵣ g` of `r`
variables, `(f ⊗ᵣ g)(s, t) = ∫ f(s, u) g(t, u) dμ^r(u)` for `s ∈ T^{p−r}`, `t ∈ T^{q−r}`. -/
def contraction (r : ℕ) {p q : ℕ} (f : Lp ℝ 2 (kernelMeasure μ p))
    (g : Lp ℝ 2 (kernelMeasure μ q)) : Lp ℝ 2 (kernelMeasure μ (p + q - 2 * r)) :=
  toL2 _ fun x ↦ ∫ u, f (contractionArgLeft p q r x u) * g (contractionArgRight p q r x u)
    ∂(kernelMeasure μ r)

end KernelCopies

/-- Copy of SteinsMethodForNormalApproximation §1.1, verbatim: the solution of the Stein equation
for a test function `h`, `f_h(w) = e^(w²/2) ∫_{t ≤ w} (h(t) - E h(Z)) e^(-t²/2) dt`, with `Z`
standard normal. -/
def steinSolution (h : ℝ → ℝ) (w : ℝ) : ℝ :=
  Real.exp (w ^ 2 / 2) *
    ∫ t in Set.Iic w, (h t - ∫ x, h x ∂gaussianReal 0 1) * Real.exp (-(t ^ 2) / 2)

/-! ## Layer 1: Stein bounds for total variation and Kolmogorov distances -/

section SteinBounds

/-- 1.1: for every test function integrable against the standard normal law, the Stein solution
is the integral of `w ↦ w f_h(w) + h(w) - E h(Z)`, so it is locally absolutely continuous and
satisfies the Stein equation almost everywhere, with no continuity of `h`. -/
theorem steinSolution_sub_eq_integral {h : ℝ → ℝ} (hh : Integrable h (gaussianReal 0 1))
    (x y : ℝ) :
    steinSolution h y - steinSolution h x =
      ∫ w in x..y, (w * steinSolution h w + h w - ∫ t, h t ∂gaussianReal 0 1) := by
  sorry

/-- 1.1: for a measurable test function with values in `[0, 1]`, the Stein solution is bounded
by `√(π/2)` and is `2`-Lipschitz. -/
theorem abs_steinSolution_le_of_mem_Icc {h : ℝ → ℝ} (hm : Measurable h)
    (hh : ∀ x, h x ∈ Set.Icc (0 : ℝ) 1) :
    (∀ x, |steinSolution h x| ≤ √(Real.pi / 2)) ∧ LipschitzWith 2 (steinSolution h) := by
  sorry

/-- 1.1: for the indicator of a half-line `(−∞, z]` the Stein solution is bounded by `√(2π)/4`
and is `1`-Lipschitz. -/
theorem steinSolution_indicator_Iic (z : ℝ) :
    (∀ x, |steinSolution ((Set.Iic z).indicator 1) x| ≤ √(2 * Real.pi) / 4) ∧
      LipschitzWith 1 (steinSolution ((Set.Iic z).indicator 1)) := by
  sorry

/-- 1.2: the total-variation Stein class for the variance `v`: `C¹` functions with
`|f| ≤ √(π/2)/√v` and `|f'| ≤ 2/v`. -/
def tvSteinClass (v : ℝ≥0) : Set (ℝ → ℝ) :=
  {f | ContDiff ℝ 1 f ∧ (∀ x, |f x| ≤ √(Real.pi / 2) / √(v : ℝ)) ∧
    ∀ x, |deriv f x| ≤ 2 / (v : ℝ)}

/-- 1.2: the Kolmogorov Stein class for the variance `v`: `C¹` functions with
`|f| ≤ √(2π)/(4√v)` and `|f'| ≤ 1/v`. -/
def kolSteinClass (v : ℝ≥0) : Set (ℝ → ℝ) :=
  {f | ContDiff ℝ 1 f ∧ (∀ x, |f x| ≤ √(2 * Real.pi) / (4 * √(v : ℝ))) ∧
    ∀ x, |deriv f x| ≤ 1 / (v : ℝ)}

/-- 1.2: Stein's bound for the total variation distance to `N(0, v)`, through the `C¹` class
and with no density hypothesis on `μ`. -/
theorem tvDist_le_iSup_tvSteinClass (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable id μ) {v : ℝ≥0} (hv : v ≠ 0) :
    ENNReal.ofReal (tvDist μ (gaussianReal 0 v)) ≤
      2 * ⨆ f ∈ tvSteinClass v, ENNReal.ofReal |∫ x, ((v : ℝ) * deriv f x - x * f x) ∂μ| := by
  sorry

/-- 1.2: Stein's bound for the Kolmogorov distance to `N(0, v)`, at every point, through the `C¹`
class. -/
theorem abs_cdf_sub_le_iSup_kolSteinClass (μ : Measure ℝ) [IsProbabilityMeasure μ]
    (hμ : Integrable id μ) {v : ℝ≥0} (hv : v ≠ 0) (z : ℝ) :
    ENNReal.ofReal |cdf μ z - cdf (gaussianReal 0 v) z| ≤
      ⨆ f ∈ kolSteinClass v, ENNReal.ofReal |∫ x, ((v : ℝ) * deriv f x - x * f x) ∂μ| := by
  sorry

/-- 1.3: total variation between two centred Gaussian laws,
`tvDist ≤ 4 |v₁ − v₂| / max v₁ v₂`. -/
theorem tvDist_gaussianReal_le (v₁ v₂ : ℝ≥0) :
    tvDist (gaussianReal 0 v₁) (gaussianReal 0 v₂) ≤
      4 * |(v₁ : ℝ) - v₂| / max (v₁ : ℝ) v₂ := by
  sorry

end SteinBounds

/-! ## Layer 2: the Malliavin–Stein bounds -/

section MalliavinStein

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable [IsProbabilityMeasure P] {W : H → Ω → ℝ}

/-- 2.1: the integration-by-parts formula for a function of finitely many elements of
`𝔻^{1,2}`: `E[G φ(F)] = E G · E φ(F) + ∑ᵢ E[∂ᵢφ(F) ⟪DFᵢ, −DL⁻¹G⟫]`. -/
theorem IsIsonormal.integral_mul_comp_euclidean (hW : IsIsonormal W P) {m : ℕ}
    {F : Fin m → Lp ℝ 2 P} (hF : ∀ i, F i ∈ sobolev12 W P) {G : Lp ℝ 2 P}
    (hG : G ∈ gaussianL2 W P) {φ : EuclideanSpace ℝ (Fin m) → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφ' : ∃ C, ∀ x, ‖fderiv ℝ φ x‖ ≤ C) :
    ∫ ω, G ω * φ (WithLp.toLp 2 fun i ↦ F i ω) ∂P =
      (∫ ω, G ω ∂P) * (∫ ω, φ (WithLp.toLp 2 fun i ↦ F i ω) ∂P) +
        ∑ i, ∫ ω, fderiv ℝ φ (WithLp.toLp 2 fun i ↦ F i ω) (EuclideanSpace.single i 1) *
          ⟪malliavinDeriv W P (F i) ω,
            -(malliavinDeriv W P (ouPseudoInverse W P G) ω)⟫_ℝ ∂P := by
  sorry

/-- 2.1: the conditional expectation of `⟪DF, −DL⁻¹F⟫` given `F` is nonnegative. -/
theorem IsIsonormal.condExp_inner_nonneg (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) :
    0 ≤ᵐ[P] P[fun ω ↦ ⟪malliavinDeriv W P F ω,
        -(malliavinDeriv W P (ouPseudoInverse W P F) ω)⟫_ℝ |
      MeasurableSpace.comap (⇑F) inferInstance] := by
  sorry

/-- 2.1: the Mehler representation `⟪−DL⁻¹F, h⟫ = ∫₀^∞ e^{−t} P_t ⟪DF, h⟫ dt`. -/
theorem IsIsonormal.inner_malliavinDeriv_ouPseudoInverse (hW : IsIsonormal W P)
    {F : Lp ℝ 2 P} (hF : F ∈ sobolev12 W P) (h : H) :
    toL2 P (fun ω ↦ ⟪-(malliavinDeriv W P (ouPseudoInverse W P F) ω), h⟫_ℝ) =
      ∫ t in Set.Ioi (0 : ℝ), Real.exp (-t) •
        ouSemigroup W P t (toL2 P fun ω ↦ ⟪malliavinDeriv W P F ω, h⟫_ℝ) := by
  sorry

/-- 2.2: the Malliavin–Stein bounds for a divergence `F = δ(u)` in `𝔻^{1,2}`: total variation
and Kolmogorov distances to `N(0, v)` for every `v > 0`, and the Wasserstein distance to
`N(0, 1)`. -/
theorem IsIsonormal.tvDist_map_le_of_isDivergence (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) {u : Lp H 2 P} (hu : IsDivergence W P u F) {v : ℝ≥0}
    (hv : v ≠ 0) :
    tvDist (P.map F) (gaussianReal 0 v) ≤
        4 / v * ∫ ω, |(v : ℝ) - ⟪malliavinDeriv W P F ω, u ω⟫_ℝ| ∂P ∧
      (∀ z, |cdf (P.map F) z - cdf (gaussianReal 0 v) z| ≤
        1 / v * ∫ ω, |(v : ℝ) - ⟪malliavinDeriv W P F ω, u ω⟫_ℝ| ∂P) ∧
      TauCeti.wassersteinEDist 1 (P.map F) (gaussianReal 0 1) ≤
        ENNReal.ofReal (√(2 / Real.pi) * ∫ ω, |1 - ⟪malliavinDeriv W P F ω, u ω⟫_ℝ| ∂P) := by
  sorry

/-- 2.2: the Malliavin–Stein bounds for a centred `F ∈ 𝔻^{1,2}`, with `⟪DF, −DL⁻¹F⟫` in place
of `⟪DF, u⟫`. -/
theorem IsIsonormal.tvDist_map_le_of_mem_sobolev12 (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) (hF0 : ∫ ω, F ω ∂P = 0) {v : ℝ≥0} (hv : v ≠ 0) :
    tvDist (P.map F) (gaussianReal 0 v) ≤
        4 / v * ∫ ω, |(v : ℝ) - ⟪malliavinDeriv W P F ω,
          -(malliavinDeriv W P (ouPseudoInverse W P F) ω)⟫_ℝ| ∂P ∧
      (∀ z, |cdf (P.map F) z - cdf (gaussianReal 0 v) z| ≤
        1 / v * ∫ ω, |(v : ℝ) - ⟪malliavinDeriv W P F ω,
          -(malliavinDeriv W P (ouPseudoInverse W P F) ω)⟫_ℝ| ∂P) ∧
      TauCeti.wassersteinEDist 1 (P.map F) (gaussianReal 0 1) ≤
        ENNReal.ofReal (√(2 / Real.pi) * ∫ ω, |1 - ⟪malliavinDeriv W P F ω,
          -(malliavinDeriv W P (ouPseudoInverse W P F) ω)⟫_ℝ| ∂P) := by
  sorry

/-- 2.3: the multivariate smart-path bound: for `h` of class `C²` with every second partial
derivative bounded by `K`,
`|E h(F) − E h(N)| ≤ (K/2) ∑ᵢⱼ E|C(i, j) − ⟪DFⱼ, −DL⁻¹Fᵢ⟫|` with `N ~ N(0, C)`. -/
theorem IsIsonormal.abs_integral_sub_multivariateGaussian_le (hW : IsIsonormal W P) {d : ℕ}
    {F : Fin d → Lp ℝ 2 P} (hF : ∀ i, F i ∈ sobolev12 W P) (hF0 : ∀ i, ∫ ω, F i ω ∂P = 0)
    {C : Matrix (Fin d) (Fin d) ℝ} (hC : C.PosSemidef) {h : EuclideanSpace ℝ (Fin d) → ℝ}
    (hh : ContDiff ℝ 2 h) {K : ℝ}
    (hK : ∀ x i j, |iteratedFDeriv ℝ 2 h x
      ![EuclideanSpace.single i 1, EuclideanSpace.single j 1]| ≤ K) :
    |∫ ω, h (WithLp.toLp 2 fun i ↦ F i ω) ∂P - ∫ x, h x ∂(multivariateGaussian 0 C)| ≤
      K / 2 * ∑ i, ∑ j, ∫ ω, |C i j - ⟪malliavinDeriv W P (F j) ω,
        -(malliavinDeriv W P (ouPseudoInverse W P (F i)) ω)⟫_ℝ| ∂P := by
  sorry

/-! ## Layer 3: absolute continuity -/

/-- 3.1: the Bouleau–Hirsch criterion: on the event `{DF ≠ 0}` the law of `F ∈ 𝔻^{1,2}` is
absolutely continuous. -/
theorem IsIsonormal.absolutelyContinuous_map_restrict (hW : IsIsonormal W P) {F : Lp ℝ 2 P}
    (hF : F ∈ sobolev12 W P) :
    (P.restrict {ω | malliavinDeriv W P F ω ≠ 0}).map F ≪ volume := by
  sorry

/-- 3.2: a nonzero element of a chaos of order `q ≥ 1` has an absolutely continuous law. -/
theorem IsIsonormal.absolutelyContinuous_map_of_mem_wienerChaos (hW : IsIsonormal W P)
    {q : ℕ} (hq : 1 ≤ q) {F : Lp ℝ 2 P} (hF : F ∈ wienerChaos W P q) (hF0 : F ≠ 0) :
    P.map F ≪ volume := by
  sorry

end MalliavinStein

/-! ## Layers 4 and 5: a fixed chaos, and vectors of chaos elements -/

section FixedChaos

variable {T : Type*} [MeasurableSpace T] (μ : Measure T) [SigmaFinite μ]

instance (q : ℕ) : (symmetricKernels μ q).HasOrthogonalProjection := by
  unfold symmetricKernels; infer_instance

/-- 4.1: the symmetrized contraction `f ⊗̃ᵣ g`, the orthogonal projection of `f ⊗ᵣ g` onto the
symmetric kernels. -/
def symContraction (r : ℕ) {p q : ℕ} (f : Lp ℝ 2 (kernelMeasure μ p))
    (g : Lp ℝ 2 (kernelMeasure μ q)) : Lp ℝ 2 (kernelMeasure μ (p + q - 2 * r)) :=
  (symmetricKernels μ (p + q - 2 * r)).starProjection (contraction μ r f g)

/-- 4.1: the contraction inequality `‖f ⊗ᵣ g‖² ≤ ‖f ⊗_{p−r} f‖ ‖g ⊗_{q−r} g‖` for symmetric
kernels. -/
theorem norm_contraction_sq_le {p q r : ℕ} (hr : r ≤ min p q)
    {f : Lp ℝ 2 (kernelMeasure μ p)} {g : Lp ℝ 2 (kernelMeasure μ q)}
    (hf : f ∈ symmetricKernels μ p) (hg : g ∈ symmetricKernels μ q) :
    ‖contraction μ r f g‖ ^ 2 ≤ ‖contraction μ (p - r) f f‖ * ‖contraction μ (q - r) g g‖ := by
  sorry

variable [IsProbabilityMeasure P] {W : Lp ℝ 2 μ → Ω → ℝ}
  {I : (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q) →L[ℝ] Lp ℝ 2 P}

variable {μ}

/-- 4.2: `‖DF‖²/q = E F² + q ∑_{r=1}^{q−1} (r−1)! (q−1 choose r−1)² I_{2q−2r}(f ⊗ᵣ f)` for
`F = I_q(f)`. -/
theorem IsMultipleWienerIntegral.norm_malliavinDeriv_sq (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} (hq : 1 ≤ q)
    {f : Lp ℝ 2 (kernelMeasure μ q)} (hf : f ∈ symmetricKernels μ q) :
    toL2 P (fun ω ↦ ‖malliavinDeriv W P (I q f) ω‖ ^ 2 / q) =
      toL2 P (fun _ ↦ (q.factorial : ℝ) * ‖f‖ ^ 2) +
        (q : ℝ) • ∑ r ∈ Finset.Icc 1 (q - 1),
          (((r - 1).factorial * (q - 1).choose (r - 1) ^ 2 : ℕ) : ℝ) •
            I (q + q - 2 * r) (contraction μ r f f) := by
  sorry

/-- 4.2: `Var(‖DF‖²/q) = ∑_{r=1}^{q−1} (r²/q²) r!² (q choose r)⁴ (2q−2r)! ‖f ⊗̃ᵣ f‖²`. -/
theorem IsMultipleWienerIntegral.variance_norm_malliavinDeriv_sq (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} {f : Lp ℝ 2 (kernelMeasure μ q)}
    (hf : f ∈ symmetricKernels μ q) :
    variance (fun ω ↦ ‖malliavinDeriv W P (I q f) ω‖ ^ 2 / q) P =
      ∑ r ∈ Finset.Icc 1 (q - 1), (r : ℝ) ^ 2 / (q : ℝ) ^ 2 *
        ((r.factorial ^ 2 * q.choose r ^ 4 * (2 * q - 2 * r).factorial : ℕ) : ℝ) *
          ‖symContraction μ r f f‖ ^ 2 := by
  sorry

/-- 4.2: the fourth cumulant `κ₄(F) = E F⁴ − 3 (E F²)²` of `F = I_q(f)` in its two contraction
forms. -/
theorem IsMultipleWienerIntegral.fourth_cumulant_eq (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} (hq : 1 ≤ q)
    {f : Lp ℝ 2 (kernelMeasure μ q)} (hf : f ∈ symmetricKernels μ q) :
    ∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2 =
        3 / q * ∑ r ∈ Finset.Icc 1 (q - 1), (r : ℝ) *
          ((r.factorial ^ 2 * q.choose r ^ 4 * (2 * q - 2 * r).factorial : ℕ) : ℝ) *
            ‖symContraction μ r f f‖ ^ 2 ∧
      ∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2 =
        ∑ r ∈ Finset.Icc 1 (q - 1), ((q.factorial ^ 2 * q.choose r ^ 2 : ℕ) : ℝ) *
          (‖contraction μ r f f‖ ^ 2 +
            ((2 * q - 2 * r).choose (q - r) : ℝ) * ‖symContraction μ r f f‖ ^ 2) := by
  sorry

/-- 4.2: `Var(‖DF‖²/q) ≤ (q − 1)/(3q) κ₄(F) ≤ (q − 1) Var(‖DF‖²/q)` for `F = I_q(f)`. -/
theorem IsMultipleWienerIntegral.variance_le_fourth_cumulant (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} {f : Lp ℝ 2 (kernelMeasure μ q)}
    (hf : f ∈ symmetricKernels μ q) :
    variance (fun ω ↦ ‖malliavinDeriv W P (I q f) ω‖ ^ 2 / q) P ≤
        ((q : ℝ) - 1) / (3 * q) * (∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2) ∧
      ((q : ℝ) - 1) / (3 * q) * (∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2) ≤
        ((q : ℝ) - 1) * variance (fun ω ↦ ‖malliavinDeriv W P (I q f) ω‖ ^ 2 / q) P := by
  sorry

/-- 4.3: on a chaos of order `q ≥ 2`, a nonzero element has `E F⁴ > 3 (E F²)²`, so it is not
Gaussian. -/
theorem IsMultipleWienerIntegral.three_mul_sq_lt_integral_pow_four (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} (hq : 2 ≤ q)
    {f : Lp ℝ 2 (kernelMeasure μ q)} (hf : f ∈ symmetricKernels μ q) (hf0 : f ≠ 0) :
    3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2 < ∫ ω, I q f ω ^ 4 ∂P := by
  sorry

/-- 4.3: the fourth-moment bounds for `F = I_q(f)` with `v = E F²`:
`tvDist ≤ (4/v) √((q−1)/(3q) κ₄(F))` and the Kolmogorov bound with `1/v`. -/
theorem IsMultipleWienerIntegral.tvDist_map_le (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} (hq : 1 ≤ q)
    {f : Lp ℝ 2 (kernelMeasure μ q)} (hf : f ∈ symmetricKernels μ q) :
    tvDist (P.map (I q f)) (gaussianReal 0 (∫ ω, I q f ω ^ 2 ∂P).toNNReal) ≤
        4 / (∫ ω, I q f ω ^ 2 ∂P) * √(((q : ℝ) - 1) / (3 * q) *
          (∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2)) ∧
      ∀ z, |cdf (P.map (I q f)) z - cdf (gaussianReal 0 (∫ ω, I q f ω ^ 2 ∂P).toNNReal) z| ≤
        1 / (∫ ω, I q f ω ^ 2 ∂P) * √(((q : ℝ) - 1) / (3 * q) *
          (∫ ω, I q f ω ^ 4 ∂P - 3 * (∫ ω, I q f ω ^ 2 ∂P) ^ 2)) := by
  sorry

/-- 4.4: the fourth moment theorem of Nualart and Peccati, with the contraction conditions and
convergence in total variation. -/
theorem IsMultipleWienerIntegral.fourth_moment_tfae (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {q : ℕ} (hq : 1 ≤ q)
    {f : ℕ → Lp ℝ 2 (kernelMeasure μ q)} (hf : ∀ n, f n ∈ symmetricKernels μ q)
    {σ2 : ℝ≥0} (hσ : σ2 ≠ 0)
    (hvar : Tendsto (fun n ↦ ∫ ω, I q (f n) ω ^ 2 ∂P) atTop (𝓝 (σ2 : ℝ))) :
    [TendstoInDistribution (fun n ↦ ⇑(I q (f n))) atTop id (fun _ ↦ P) (gaussianReal 0 σ2),
      Tendsto (fun n ↦ ∫ ω, I q (f n) ω ^ 4 ∂P) atTop (𝓝 (3 * (σ2 : ℝ) ^ 2)),
      Tendsto (fun n ↦ variance (fun ω ↦ ‖malliavinDeriv W P (I q (f n)) ω‖ ^ 2) P) atTop
        (𝓝 0),
      ∀ r ∈ Finset.Icc 1 (q - 1),
        Tendsto (fun n ↦ ‖symContraction μ r (f n) (f n)‖) atTop (𝓝 0),
      ∀ r ∈ Finset.Icc 1 (q - 1), Tendsto (fun n ↦ ‖contraction μ r (f n) (f n)‖) atTop (𝓝 0),
      Tendsto (fun n ↦ tvDist (P.map (I q (f n))) (gaussianReal 0 σ2)) atTop (𝓝 0)].TFAE := by
  sorry

/-- 5.1: the variance of `⟪DF, DG⟫` for `F = I_p(f)`, `G = I_q(g)`, `p ≤ q`, through the
symmetrized contractions. -/
theorem IsMultipleWienerIntegral.variance_inner_malliavinDeriv (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {p q : ℕ} (hpq : p ≤ q)
    {f : Lp ℝ 2 (kernelMeasure μ p)} {g : Lp ℝ 2 (kernelMeasure μ q)}
    (hf : f ∈ symmetricKernels μ p) (hg : g ∈ symmetricKernels μ q) :
    variance (fun ω ↦ ⟪malliavinDeriv W P (I p f) ω, malliavinDeriv W P (I q g) ω⟫_ℝ) P =
      (p : ℝ) ^ 2 * (q : ℝ) ^ 2 * ∑ r ∈ Finset.Icc 1 (min p (q - 1)),
        (((r - 1).factorial ^ 2 * (p - 1).choose (r - 1) ^ 2 * (q - 1).choose (r - 1) ^ 2 *
          (p + q - 2 * r).factorial : ℕ) : ℝ) * ‖symContraction μ r f g‖ ^ 2 := by
  sorry

/-- 5.2: the Peccati–Tudor theorem: for vectors of chaos elements whose covariances converge,
joint convergence to the Gaussian law is equivalent to convergence of each component. -/
theorem IsMultipleWienerIntegral.peccati_tudor (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {d : ℕ} (q : Fin d → ℕ) (hq : ∀ i, 1 ≤ q i)
    {f : ℕ → (i : Fin d) → Lp ℝ 2 (kernelMeasure μ (q i))}
    (hf : ∀ n i, f n i ∈ symmetricKernels μ (q i)) {C : Matrix (Fin d) (Fin d) ℝ}
    (hC : ∀ i j, Tendsto (fun n ↦ ∫ ω, I (q i) (f n i) ω * I (q j) (f n j) ω ∂P) atTop
      (𝓝 (C i j))) :
    TendstoInDistribution
        (fun n ω ↦ (WithLp.toLp 2 fun i ↦ I (q i) (f n i) ω : EuclideanSpace ℝ (Fin d)))
        atTop id (fun _ ↦ P) (multivariateGaussian 0 C) ↔
      ∀ i, TendstoInDistribution (fun n ↦ ⇑(I (q i) (f n i))) atTop id (fun _ ↦ P)
        (gaussianReal 0 (C i i).toNNReal) := by
  sorry

/-- 5.3: the central limit theorem through chaos expansions: convergence of the variances on each
chaos, uniform smallness of the tails and vanishing contractions on each chaos give convergence
to `N(0, σ²)`. -/
theorem IsMultipleWienerIntegral.tendstoInDistribution_of_chaos (hW : IsIsonormal W P)
    (hI : IsMultipleWienerIntegral μ W P I) {F : ℕ → Lp ℝ 2 P}
    {f : ℕ → (q : ℕ) → Lp ℝ 2 (kernelMeasure μ q)}
    (hf : ∀ n q, f n q ∈ symmetricKernels μ q) (hF : ∀ n, HasSum (fun q ↦ I q (f n q)) (F n))
    (hf0 : ∀ n, f n 0 = 0) {σ : ℕ → ℝ}
    (hσ : ∀ q, Tendsto (fun n ↦ (q.factorial : ℝ) * ‖f n q‖ ^ 2) atTop (𝓝 (σ q ^ 2)))
    (hσs : Summable fun q ↦ σ q ^ 2)
    (hc : ∀ q r, 1 ≤ r → r < q →
      Tendsto (fun n ↦ ‖contraction μ r (f n q) (f n q)‖) atTop (𝓝 0))
    (htail : ∀ ε > 0, ∃ N : ℕ, ∀ n,
      ∑' q, (Set.Ioi N).indicator (fun q ↦ (q.factorial : ℝ) * ‖f n q‖ ^ 2) q ≤ ε) :
    TendstoInDistribution (fun n ↦ ⇑(F n)) atTop id (fun _ ↦ P)
      (gaussianReal 0 (∑' q, σ q ^ 2).toNNReal) := by
  sorry

end FixedChaos

/-! ## Layer 6: the Breuer–Major theorem -/

section BreuerMajor

/-- 6.1: the `q`-th Hermite coefficient `a_q = (1/q!) ∫ f Heₛ dγ` of `f`, so that
`f = ∑_q a_q He_q` in `L²(γ)`. -/
def hermiteCoeff (f : ℝ → ℝ) (q : ℕ) : ℝ :=
  (∫ x, f x * Polynomial.aeval x (Polynomial.hermite q) ∂gaussianReal 0 1) / q.factorial

/-- 6.1: the Hermite rank of `f`, the least `q ≥ 1` with a nonzero Hermite coefficient (and `0`
when there is none). -/
def hermiteRank (f : ℝ → ℝ) : ℕ :=
  sInf {q | 1 ≤ q ∧ hermiteCoeff f q ≠ 0}

/-- 6.1: Sanity check of the definition: the Hermite polynomial `He_q`, `q ≥ 1`, has rank `q`. -/
theorem hermiteRank_hermite {q : ℕ} (hq : 1 ≤ q) :
    hermiteRank (fun x ↦ Polynomial.aeval x (Polynomial.hermite q)) = q := by
  sorry

/-- 6.1: Sanity check of the definition: the centred absolute value `|x| − √(2/π)` has rank
`2`. -/
theorem hermiteRank_abs_sub : hermiteRank (fun x ↦ |x| - √(2 / Real.pi)) = 2 := by
  sorry

variable [IsProbabilityMeasure P] {X : ℕ → Ω → ℝ}

/-- 6.1: the Breuer–Major theorem: for a centred stationary Gaussian sequence with unit variance
and correlation `ρ`, and a centred `f ∈ L²(γ)` of Hermite rank `d` with `∑_v |ρ(v)|^d < ∞`,
`n^{−1/2} ∑_{k<n} f(X_k)` converges in law to `N(0, σ²)`,
`σ² = ∑_q q! a_q² ∑_v ρ(v)^q`. -/
theorem tendstoInDistribution_breuerMajor (hXm : ∀ k, Measurable (X k))
    (hX : IsGaussianProcess X P) (hX0 : ∀ k, ∫ ω, X k ω ∂P = 0) {ρ : ℤ → ℝ}
    (hρ : ∀ k l, ∫ ω, X k ω * X l ω ∂P = ρ ((k : ℤ) - l)) (hρ0 : ρ 0 = 1) {f : ℝ → ℝ}
    (hf : MemLp f 2 (gaussianReal 0 1)) (hf0 : ∫ x, f x ∂gaussianReal 0 1 = 0)
    (hsum : Summable fun v : ℤ ↦ |ρ v| ^ hermiteRank f) :
    TendstoInDistribution (fun (n : ℕ) ω ↦ (√(n : ℝ))⁻¹ * ∑ k ∈ Finset.range n, f (X k ω))
      atTop id (fun _ ↦ P)
      (gaussianReal 0 (∑' q : ℕ, (q.factorial : ℝ) * hermiteCoeff f q ^ 2 *
        ∑' v : ℤ, ρ v ^ q).toNNReal) := by
  sorry

/-- 6.2: the total-variation rate for quadratic variations: for `S = ∑_{k<n} (X_k² − 1)`,
`tvDist(S/√(E S²), N(0, 1)) ≤ (8√2 √n / E S²) (∑_{|k|<n} |ρ(k)|^{4/3})^{3/2}`. -/
theorem tvDist_map_quadratic_le (hXm : ∀ k, Measurable (X k)) (hX : IsGaussianProcess X P)
    (hX0 : ∀ k, ∫ ω, X k ω ∂P = 0) {ρ : ℤ → ℝ}
    (hρ : ∀ k l, ∫ ω, X k ω * X l ω ∂P = ρ ((k : ℤ) - l)) (hρ0 : ρ 0 = 1) {n : ℕ}
    (hn : 1 ≤ n) :
    tvDist (P.map fun ω ↦ (∑ k ∈ Finset.range n, (X k ω ^ 2 - 1)) /
        √(∫ ω', (∑ k ∈ Finset.range n, (X k ω' ^ 2 - 1)) ^ 2 ∂P)) (gaussianReal 0 1) ≤
      8 * √2 * √(n : ℝ) / (∫ ω, (∑ k ∈ Finset.range n, (X k ω ^ 2 - 1)) ^ 2 ∂P) *
        (∑ k ∈ Finset.Ioo (-(n : ℤ)) n, |ρ k| ^ (4 / 3 : ℝ)) ^ (3 / 2 : ℝ) := by
  sorry

/-- 6.3: the covariance `ρ_H(v) = (|v + 1|^{2H} + |v − 1|^{2H} − 2|v|^{2H})/2` of fractional
Gaussian noise with Hurst index `H`. -/
def fgnCov (H : ℝ) (v : ℤ) : ℝ :=
  (|(v : ℝ) + 1| ^ (2 * H) + |(v : ℝ) - 1| ^ (2 * H) - 2 * |(v : ℝ)| ^ (2 * H)) / 2

/-- 6.3: Sanity check of the definition: at `H = 1/2` the noise is white,
`ρ_{1/2}(v) = 1` for `v = 0` and `0` otherwise. -/
theorem fgnCov_half (v : ℤ) : fgnCov (1 / 2) v = if v = 0 then 1 else 0 := by
  sorry

/-- 6.3: `ρ_H` is a covariance: it is positive semidefinite on `ℤ` for `0 < H ≤ 1`. -/
theorem fgnCov_posSemidef {H : ℝ} (hH0 : 0 < H) (hH1 : H ≤ 1) {n : ℕ} (t : Fin n → ℤ)
    (c : Fin n → ℝ) : 0 ≤ ∑ i, ∑ j, c i * c j * fgnCov H (t i - t j) := by
  sorry

/-- 6.3: `∑_v |ρ_H(v)|^q < ∞` exactly when `H < 1 − 1/(2q)` or `H = 1/2`. -/
theorem summable_abs_fgnCov_pow_iff {H : ℝ} (hH0 : 0 < H) (hH1 : H < 1) {q : ℕ}
    (hq : 1 ≤ q) :
    Summable (fun v : ℤ ↦ |fgnCov H v| ^ q) ↔ H < 1 - 1 / (2 * q) ∨ H = 1 / 2 := by
  sorry

/-- 6.3: Hermite variations of fractional Gaussian noise: for `q ≥ 1` and `H < 1 − 1/(2q)` or
`H = 1/2`, `n^{−1/2} ∑_{k<n} He_q(X_k)` converges in law to `N(0, q! ∑_v ρ_H(v)^q)`. -/
theorem tendstoInDistribution_hermiteVariation (hXm : ∀ k, Measurable (X k))
    (hX : IsGaussianProcess X P) (hX0 : ∀ k, ∫ ω, X k ω ∂P = 0) {H : ℝ} (hH0 : 0 < H)
    (hH1 : H < 1) (hρ : ∀ k l, ∫ ω, X k ω * X l ω ∂P = fgnCov H ((k : ℤ) - l)) {q : ℕ}
    (hq : 1 ≤ q) (hHq : H < 1 - 1 / (2 * q) ∨ H = 1 / 2) :
    TendstoInDistribution
      (fun (n : ℕ) ω ↦ (√(n : ℝ))⁻¹ *
        ∑ k ∈ Finset.range n, Polynomial.aeval (X k ω) (Polynomial.hermite q))
      atTop id (fun _ ↦ P)
      (gaussianReal 0 ((q.factorial : ℝ) * ∑' v : ℤ, fgnCov H v ^ q).toNNReal) := by
  sorry

end BreuerMajor

/-! ## Layer 7: second-order Poincaré inequalities in finite dimension -/

section SecondOrder

variable {n : ℕ}

local notation "E" => EuclideanSpace ℝ (Fin n)

/-- 7.1: the Stein factor `T_g(x) = ∫₀^∞ e^{−t} E⟪∇g(x), ∇g(e^{−t}x + √(1 − e^{−2t}) Y)⟫ dt` of
`g` under the standard Gaussian law, `Y` standard Gaussian. -/
def gaussianSteinFactor (g : E → ℝ) (x : E) : ℝ :=
  ∫ t in Set.Ioi (0 : ℝ), Real.exp (-t) *
    ∫ y, ⟪gradient g x, gradient g (Real.exp (-t) • x + √(1 - Real.exp (-(2 * t))) • y)⟫_ℝ
      ∂(stdGaussian E)

/-- 7.1: Sanity check of the definition: for a linear function `⟪a, ·⟫` the Stein factor is the
constant `‖a‖²`, its variance. -/
theorem gaussianSteinFactor_inner (a x : E) :
    gaussianSteinFactor (fun y ↦ ⟪a, y⟫_ℝ) x = ‖a‖ ^ 2 := by
  sorry

/-- 7.1: the Gaussian covariance representation `E[g(Z) φ(g(Z))] = E[φ'(g(Z)) T_g(Z)]` for a
centred `C¹` function `g` with polynomially growing gradient. -/
theorem integral_mul_comp_stdGaussian {g : E → ℝ} (hg : ContDiff ℝ 1 g)
    (hg' : ∃ (C : ℝ) (m : ℕ), ∀ x, ‖fderiv ℝ g x‖ ≤ C * (1 + ‖x‖) ^ m)
    (hg0 : ∫ x, g x ∂(stdGaussian E) = 0) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφ' : ∃ C, ∀ x, |deriv φ x| ≤ C) :
    ∫ x, g x * φ (g x) ∂(stdGaussian E) =
      ∫ x, deriv φ (g x) * gaussianSteinFactor g x ∂(stdGaussian E) := by
  sorry

/-- 7.2: `E|v − T_g(Z)| ≤ (3/2) (E‖∇²g(Z)‖⁴)^{1/4} (E‖∇g(Z)‖⁴)^{1/4}` with `v = E g(Z)²`. -/
theorem integral_abs_sub_gaussianSteinFactor_le {g : E → ℝ} (hg : ContDiff ℝ 2 g)
    (hg2 : ∃ (C : ℝ) (m : ℕ), ∀ x, ‖iteratedFDeriv ℝ 2 g x‖ ≤ C * (1 + ‖x‖) ^ m)
    (hg0 : ∫ x, g x ∂(stdGaussian E) = 0) :
    ∫ x, |(∫ y, g y ^ 2 ∂(stdGaussian E)) - gaussianSteinFactor g x| ∂(stdGaussian E) ≤
      3 / 2 * (∫ x, ‖iteratedFDeriv ℝ 2 g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ) *
        (∫ x, ‖fderiv ℝ g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ) := by
  sorry

/-- 7.2: the second-order Poincaré inequality in total variation:
`tvDist(g(Z), N(0, v)) ≤ (6/v) (E‖∇²g(Z)‖⁴)^{1/4} (E‖∇g(Z)‖⁴)^{1/4}` with `v = E g(Z)²`. -/
theorem tvDist_map_stdGaussian_le {g : E → ℝ} (hg : ContDiff ℝ 2 g)
    (hg2 : ∃ (C : ℝ) (m : ℕ), ∀ x, ‖iteratedFDeriv ℝ 2 g x‖ ≤ C * (1 + ‖x‖) ^ m)
    (hg0 : ∫ x, g x ∂(stdGaussian E) = 0) :
    tvDist ((stdGaussian E).map g)
        (gaussianReal 0 (∫ x, g x ^ 2 ∂(stdGaussian E)).toNNReal) ≤
      6 / (∫ x, g x ^ 2 ∂(stdGaussian E)) *
        (∫ x, ‖iteratedFDeriv ℝ 2 g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ) *
          (∫ x, ‖fderiv ℝ g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ) := by
  sorry

/-- 7.2: the second-order Poincaré inequality in the Wasserstein distance, for `E g(Z)² = 1`:
`W₁(g(Z), N(0, 1)) ≤ (3/√(2π)) (E‖∇²g(Z)‖⁴)^{1/4} (E‖∇g(Z)‖⁴)^{1/4}`. -/
theorem wassersteinEDist_map_stdGaussian_le {g : E → ℝ} (hg : ContDiff ℝ 2 g)
    (hg2 : ∃ (C : ℝ) (m : ℕ), ∀ x, ‖iteratedFDeriv ℝ 2 g x‖ ≤ C * (1 + ‖x‖) ^ m)
    (hg0 : ∫ x, g x ∂(stdGaussian E) = 0) (hv : ∫ x, g x ^ 2 ∂(stdGaussian E) = 1) :
    TauCeti.wassersteinEDist 1 ((stdGaussian E).map g) (gaussianReal 0 1) ≤
      ENNReal.ofReal (3 / √(2 * Real.pi) *
        (∫ x, ‖iteratedFDeriv ℝ 2 g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ) *
          (∫ x, ‖fderiv ℝ g x‖ ^ 4 ∂(stdGaussian E)) ^ (1 / 4 : ℝ)) := by
  sorry

end SecondOrder

