module

public import Mathlib

/-!
# Smooth mod p representations of GL₂ over a local field: target signatures

The roadmap is `README.md`; this file is not the roadmap. It states the roadmap's headline
theorems that are statable against the pinned Mathlib and Tau Ceti, each with `sorry`, together
with the few definitions they need.

Stated here:

* coherence: the kernel of a map between finitely presented smooth torsion representations of
  `GL₂(F)/ϖ^ℤ` is finitely presented, for every finite extension `F/ℚ_p` (Layer 0);
* finite length and the subobject property for admissible finitely presented torsion
  representations of `GL₂(F)`, and, for `F ≠ ℚ_p`, the approximation of an admissible Banach
  lattice by the continuous induction from the lower Borel of a representation of the torus on a
  finite `𝒪_L`-module, with finite kernel and cokernel (Layer 2);
* for `F = ℚ_p`: finite type implies finite presentation, finite cosocle implies finite length,
  and finite length is equivalent to finite dimension of the smooth dual (Layer 1).

Not statable at the pins, with what each lacks:

* the local Gelfand–Kirillov bound `dim_{GL₂(F)} π ≤ f` (Layer 7): there is no
  Gelfand–Kirillov dimension of an admissible smooth representation (canonical dimension of its
  dual over an Iwasawa algebra), no Serre weights `F(λ)` of `GL₂(𝔽_q)` with their labelled
  coordinates, and no tame weight set `W(ρ̄)` or Diamond module `D₁(ρ̄)`;
* the Iwahori multiplicity criterion `dim_I V ≤ f` (Layer 4): the same dimension, and the pro-`p`
  Iwahori projective truncations `W_{χ,3}` of pseudocompact modules;
* the description of `Proj_{K/Z₁} σ / 𝔪_{K₁}²` as the reduction of an explicit lattice, the
  commutativity of its endomorphism ring and the relative projectivity of its quotients
  (Layers 8–9): Serre weights, projective covers in the pseudocompact `k[[K/Z₁]]`-module category
  and the gluing lattice;
* the finite-error counit `Ind_{B̄}^G Ord_B(π) → π` for `F ≠ ℚ_p` (Layer 2): Emerton's
  ordinary-parts functor `Ord_B`, which the statement specifies as the source of the counit (the
  Banach approximation stated below asserts only the existence of some induced map);
* the absence of supersingular constituents in admissible finitely presented representations for
  `F ≠ ℚ_p` (Layer 2): the supersingular notion and an API of smooth principal series (Borel
  induction of torus characters with its constituents); `ContRepresentation.coind` supplies only
  the induced module.
-/

public section

namespace TauCetiRoadmap.ModpRepresentationsOfGL2OverLocalFields

open ValuativeRel

universe u uA uG uV

/-- The group `G' = GL₂(F)/ϖ^ℤ`, quotient of `GL₂(F)` by the subgroup generated by the scalar
matrix `ϖ` (central, so its normal closure is the cyclic group it generates), with the quotient
topology. -/
abbrev GL2ModScalar (F : Type u) [Field F] [TopologicalSpace F] (ϖ : F) : Type u :=
  GL (Fin 2) F ⧸ Subgroup.normalClosure
    {g : GL (Fin 2) F | (g : Matrix (Fin 2) (Fin 2) F) = Matrix.scalar (Fin 2) ϖ}

/-! ## Layer 0: Smooth finiteness and augmented Iwasawa algebras -/

section SmoothFiniteness

variable {A : Type uA} [CommRing A] {G : Type uG} [Group G] [TopologicalSpace G]
  {V : Type uV} [AddCommGroup V] [Module A V]

/-- A representation is smooth when every vector has an open stabiliser (the predicate of
SmoothRepresentationsOfLocalGroups *is-smooth*, on a module without topology). -/
def IsSmoothRep (ρ : Representation A G V) : Prop :=
  ∀ v : V, IsOpen ((ρ.stabilizer v : Subgroup G) : Set G)

/-- Torsion admissibility: for every compact open subgroup `U` and every `j`, the vectors fixed
by `U` and killed by `p ^ j` form an `A`-module of finite length. -/
def IsTorsionAdmissible (p : ℕ) (ρ : Representation A G V) : Prop :=
  ∀ U : OpenSubgroup G, IsCompact (U : Set G) → ∀ j : ℕ,
    IsFiniteLength A
      ↥((⨅ g ∈ (U : Subgroup G), LinearMap.ker (ρ g - 1)) ⊓
        LinearMap.ker (((p : A) ^ j) • LinearMap.id : V →ₗ[A] V))

/-- Finite presentation in the smooth category: an exact sequence
`c-Ind_{U₁}^G W₁ → c-Ind_{U₂}^G W₂ → V → 0` with `U₁, U₂` compact open and `W₁, W₂` smooth
representations of finite length over `A`. For an open subgroup, Mathlib's induction
`A[G] ⊗_{A[U]} W` is compact induction. -/
def IsFinitelyPresented (ρ : Representation A G V) : Prop :=
  ∃ (U₁ U₂ : OpenSubgroup G) (_ : IsCompact (U₁ : Set G)) (_ : IsCompact (U₂ : Set G))
    (W₁ : Rep.{uA} A U₁) (W₂ : Rep.{uA} A U₂),
    IsFiniteLength A W₁.V ∧ IsSmoothRep W₁.ρ ∧ IsFiniteLength A W₂.V ∧ IsSmoothRep W₂.ρ ∧
    ∃ (f : Representation.IntertwiningMap
          (Representation.ind (U₁ : Subgroup G).subtype W₁.ρ)
          (Representation.ind (U₂ : Subgroup G).subtype W₂.ρ))
      (g : Representation.IntertwiningMap
          (Representation.ind (U₂ : Subgroup G).subtype W₂.ρ) ρ),
      LinearMap.range f.toLinearMap = LinearMap.ker g.toLinearMap ∧
        Function.Surjective g.toLinearMap

end SmoothFiniteness

/-- **Coherence** (Shotton, Theorem 4.5 and Corollary 5.2; Colmez–Dospinescu–Nizioł,
Proposition 1.3 and Remarque 1.4). Let `F/ℚ_p` be finite with uniformiser `ϖ` and let `𝒪_L` be
the integers of a finite extension `L/ℚ_p`. The kernel of an intertwining map between finitely
presented `𝒪_L`-representations of `GL₂(F)/ϖ^ℤ` is finitely presented. (A finitely presented
representation is a quotient of a compact induction of a smooth finite-length module, hence
smooth and `p`-power torsion.) -/
theorem isFinitelyPresented_ker {F L : Type u}
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [CharZero L]
    (p : ℕ) [Fact p.Prime] [CharP 𝓀[F] p] [CharP 𝓀[L] p] (ϖ : 𝒪[F]) (hϖ : Irreducible ϖ)
    {V W : Type u} [AddCommGroup V] [Module 𝒪[L] V] [AddCommGroup W] [Module 𝒪[L] W]
    {ρ : Representation 𝒪[L] (GL2ModScalar F (ϖ : F)) V}
    {σ : Representation 𝒪[L] (GL2ModScalar F (ϖ : F)) W}
    (hρf : IsFinitelyPresented ρ) (hσf : IsFinitelyPresented σ)
    (f : Representation.IntertwiningMap ρ σ) :
    IsFinitelyPresented f.ker.toRepresentation := by
  sorry

/-! ## Layer 1: Finite-length criteria over ℚ_p -/

section SmoothDual

variable {A : Type uA} [CommRing A] {G : Type uG} [Group G] [TopologicalSpace G]
  {V : Type uV} [AddCommGroup V] [Module A V]

/-- The span of the smooth vectors of the contragredient of `ρ` on the full linear dual
`Hom_A(V, A)`, where `g` acts by `f ↦ f ∘ ρ(g⁻¹)`; a functional is smooth when its stabiliser
`{g | f ∘ ρ g = f}` is open. -/
def smoothDualSpan (ρ : Representation A G V) : Submodule A (Module.Dual A V) :=
  Submodule.span A {f : Module.Dual A V | IsOpen {g : G | f ∘ₗ ρ g = f}}

end SmoothDual

/-- **Finite type implies finite presentation over `ℚ_p`** (Colmez–Dospinescu–Nizioł,
Proposition 1.20). Every smooth representation of `GL₂(ℚ_p)/p^ℤ` over a finite field of
characteristic `p` that is finitely generated over the group algebra is finitely presented. -/
theorem isFinitelyPresented_of_finite (p : ℕ) [Fact p.Prime]
    {k : Type} [Field k] [Finite k] [CharP k p]
    {V : Type} [AddCommGroup V] [Module k V]
    {ρ : Representation k (GL2ModScalar ℚ_[p] (p : ℚ_[p])) V} (hρ : IsSmoothRep ρ)
    (hfin : Module.Finite (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule) :
    IsFinitelyPresented ρ := by
  sorry

/-- **Finite cosocle implies finite length over `ℚ_p`** (Colmez–Dospinescu–Nizioł,
Théorème 1.21). Let `V` be a finitely generated smooth representation of `GL₂(ℚ_p)/p^ℤ` over a
finite field of characteristic `p`. If the semisimple quotients of `V` have bounded length
(equivalently, the cosocle of `V` has finite length), then `V` has finite length. -/
theorem isFiniteLength_of_bounded_semisimple_quotients (p : ℕ) [Fact p.Prime]
    {k : Type} [Field k] [Finite k] [CharP k p]
    {V : Type} [AddCommGroup V] [Module k V]
    {ρ : Representation k (GL2ModScalar ℚ_[p] (p : ℚ_[p])) V} (hρ : IsSmoothRep ρ)
    (hfin : Module.Finite (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule)
    (hcosoc : ∃ N : ℕ,
      ∀ X : Submodule (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule,
        IsSemisimpleModule (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p])))
            (ρ.asModule ⧸ X) →
          Module.length (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p])))
            (ρ.asModule ⧸ X) ≤ N) :
    IsFiniteLength (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule := by
  sorry

/-- **Finite length is detected by the smooth dual over `ℚ_p`** (Colmez–Dospinescu–Nizioł,
Théorème 1.24). A finitely generated smooth representation of `GL₂(ℚ_p)/p^ℤ` over a finite
field of characteristic `p` has finite length if and only if the smooth vectors of its full
linear dual span a finite-dimensional space. -/
theorem isFiniteLength_iff_finite_smoothDualSpan (p : ℕ) [Fact p.Prime]
    {k : Type} [Field k] [Finite k] [CharP k p]
    {V : Type} [AddCommGroup V] [Module k V]
    {ρ : Representation k (GL2ModScalar ℚ_[p] (p : ℚ_[p])) V} (hρ : IsSmoothRep ρ)
    (hfin : Module.Finite (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule) :
    IsFiniteLength (MonoidAlgebra k (GL2ModScalar ℚ_[p] (p : ℚ_[p]))) ρ.asModule ↔
      Module.Finite k (smoothDualSpan ρ) := by
  sorry

/-! ## Layer 2: Admissible finite presentation and ordinary parts -/

/-- **Admissible finitely presented representations have finite length** (Colmez–Dospinescu–
Nizioł, Théorème 1.26(i), from Hu and Vignéras). For every finite extension `F/ℚ_p`, an
`𝒪_L`-representation of `GL₂(F)` that is torsion-admissible and finitely presented (hence smooth
and `p`-power torsion) has finite length over the group algebra. -/
theorem isFiniteLength_of_admissible_of_finitelyPresented {F L : Type u}
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [CharZero L]
    (p : ℕ) [Fact p.Prime] [CharP 𝓀[F] p] [CharP 𝓀[L] p]
    {V : Type u} [AddCommGroup V] [Module 𝒪[L] V] {ρ : Representation 𝒪[L] (GL (Fin 2) F) V}
    (hadm : IsTorsionAdmissible p ρ)
    (hfp : IsFinitelyPresented ρ) :
    IsFiniteLength (MonoidAlgebra 𝒪[L] (GL (Fin 2) F)) ρ.asModule := by
  sorry

/-- **Subobjects of admissible finitely presented representations** (Colmez–Dospinescu–Nizioł,
Théorème 1.26(ii)). In the setting of the previous theorem every subrepresentation is again
finitely presented (it is admissible because the invariants of a subrepresentation are a
submodule). -/
theorem isFinitelyPresented_subrepresentation_of_admissible {F L : Type u}
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [Field L] [ValuativeRel L] [TopologicalSpace L] [IsNonarchimedeanLocalField L] [CharZero L]
    (p : ℕ) [Fact p.Prime] [CharP 𝓀[F] p] [CharP 𝓀[L] p]
    {V : Type u} [AddCommGroup V] [Module 𝒪[L] V] {ρ : Representation 𝒪[L] (GL (Fin 2) F) V}
    (hadm : IsTorsionAdmissible p ρ)
    (hfp : IsFinitelyPresented ρ) (W : Subrepresentation ρ) :
    IsFinitelyPresented W.toRepresentation := by
  sorry

/-- **Induced approximation of an admissible Banach lattice** (Colmez–Dospinescu–Nizioł,
Corollaire 1.34). Let `F/ℚ_p` be finite with `F ≠ ℚ_p`, that is `ef ≥ 2`: `p` is not a
uniformiser of `𝒪_F` or the residue field of `F` is larger than `𝔽_p`. Let `E` be an `L`-Banach
space and `Θ ⊆ E` an open bounded `𝒪_L`-submodule (a lattice) with a jointly continuous
`𝒪_L`-linear action of `GL₂(F)` whose reduction `Θ/ϖ_LΘ` is torsion-admissible and finitely
presented. (The action extends `L`-linearly to a unitary Banach representation on `E = L·Θ`, which
is admissible because its reduction is.) Then there are a finite `𝒪_L`-module `M` with its
canonical (`ϖ_L`-adic) topology, a jointly continuous representation `σ` of the lower Borel `B̄`
on `M` that is trivial on the lower unipotent matrices (a representation of the diagonal torus
inflated to `B̄`), and a continuous `GL₂(F)`-equivariant map from the continuous induction
`Ind_{B̄}^{GL₂(F)} σ = {f ∈ C(GL₂(F), M) | f(b̄g) = σ(b̄) f(g)}`, with `GL₂(F)` acting by right
translation, to `Θ`, whose kernel and cokernel are finite `𝒪_L`-modules. -/
theorem exists_coind_approximation_of_lattice {F L : Type u}
    [Field F] [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F] [CharZero F]
    [NontriviallyNormedField L] [ValuativeRel L] [IsNonarchimedeanLocalField L] [CharZero L]
    (p : ℕ) [Fact p.Prime] [CharP 𝓀[F] p] [CharP 𝓀[L] p]
    (hF : ¬ (Irreducible (p : 𝒪[F]) ∧ Nat.card 𝓀[F] = p))
    (ϖ : 𝒪[L]) (hϖ : Irreducible ϖ)
    (B : Subgroup (GL (Fin 2) F))
    (hB : ∀ g, g ∈ B ↔ (g : Matrix (Fin 2) (Fin 2) F) 0 1 = 0)
    {E : Type u} [NormedAddCommGroup E] [NormedSpace L E] [CompleteSpace E]
    (Θ : Submodule 𝒪[L] E) (hopen : IsOpen (Θ : Set E))
    (hbdd : Bornology.IsBounded (Θ : Set E))
    (ρ : ContRepresentation 𝒪[L] (GL (Fin 2) F) Θ)
    (hρ : Continuous fun x : GL (Fin 2) F × Θ => ρ x.1 x.2)
    (S : Subrepresentation ρ.toRepresentation)
    (hS : S.toSubmodule = Ideal.span {ϖ} • (⊤ : Submodule 𝒪[L] Θ))
    (hadm : IsTorsionAdmissible p S.quotient)
    (hfp : IsFinitelyPresented S.quotient) :
    ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module 𝒪[L] M) (_ : TopologicalSpace M)
      (_ : IsTopologicalAddGroup M) (_ : ContinuousSMul 𝒪[L] M) (_ : IsModuleTopology 𝒪[L] M),
      Module.Finite 𝒪[L] M ∧
      ∃ σ : ContRepresentation 𝒪[L] B M,
        (Continuous fun x : B × M => σ x.1 x.2) ∧
        (∀ b : B, ((b : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 0 0 = 1 →
          ((b : GL (Fin 2) F) : Matrix (Fin 2) (Fin 2) F) 1 1 = 1 → σ b = 1) ∧
        ∃ f : ContIntertwiningMap
            (σ.coind (⟨B.subtype, continuous_subtype_val⟩ : B →ₜ* GL (Fin 2) F)) ρ,
          Module.Finite 𝒪[L] (LinearMap.ker f.toContinuousLinearMap.toLinearMap) ∧
          Module.Finite 𝒪[L] (Θ ⧸ LinearMap.range f.toContinuousLinearMap.toLinearMap) := by
  sorry

end TauCetiRoadmap.ModpRepresentationsOfGL2OverLocalFields
