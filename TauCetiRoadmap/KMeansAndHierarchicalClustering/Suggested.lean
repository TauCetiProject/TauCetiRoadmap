import Mathlib

/-!
# K-means and hierarchical clustering: target signatures

**This file is not the roadmap.** The roadmap is `README.md`. This file states the roadmap's
headline theorems against the pinned Mathlib and Tau Ceti, each with `sorry`, together with the
few definitions they need; every definition has a real body. Every headline theorem of the README
is statable at the pins and is stated here.

A data family is `x : Fin n → E` in a real inner product space `E`, repetitions allowed. A
k-means state is a pair of a labelling `Fin n → Fin k` and a centre map `Fin k → E`; Lloyd's
iteration is the map `lloydMap x` on such pairs, with the tie rule and the empty-cluster rule of
the README's design section. Partitions of a type are Mathlib `Setoid`s, ordered by refinement
(`r ≤ s` when `r` is finer). A dendrogram is a family of partitions indexed by `ℝ`, discrete at
every scale `≤ 0`. Single linkage at scale `r` is the equivalence relation generated by
`d x y ≤ r`.
-/

noncomputable section

open Finset Function

namespace TauCetiRoadmap.KMeansAndHierarchicalClustering

/-! ## Layer 1: the k-means cost and Lloyd's map -/

section Lloyd

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {n k : ℕ}

/-- 1.1 The k-means cost of a pair `(a, c)` of a labelling and a centre map:
`∑ᵢ ‖xᵢ − c (a i)‖²`. -/
def pairCost (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E)) : ℝ :=
  ∑ i, ‖x i - s.2 (s.1 i)‖ ^ 2

/-- 1.1 The label `j` is a nearest centre to the point `x i` for the centre map `c`. -/
def IsNearest (x : Fin n → E) (c : Fin k → E) (i : Fin n) (j : Fin k) : Prop :=
  ∀ j', ‖x i - c j‖ ≤ ‖x i - c j'‖

open Classical in
/-- 1.1 The assignment step: a point keeps its label when that label is a nearest centre, and
otherwise takes the least nearest label. -/
def assignStep (x : Fin n → E) (a : Fin n → Fin k) (c : Fin k → E) : Fin n → Fin k :=
  fun i =>
    if IsNearest x c i (a i) then a i
    else if h : ∃ j, IsNearest x c i j then Fin.find (IsNearest x c i) h else a i

/-- 1.1 The points with label `j`. -/
def cluster (a : Fin n → Fin k) (j : Fin k) : Finset (Fin n) :=
  univ.filter fun i => a i = j

/-- 1.1 The update step: a nonempty cluster moves its centre to the centroid of its points, and
an empty cluster keeps its centre. -/
def updateStep (x : Fin n → E) (a : Fin n → Fin k) (c : Fin k → E) : Fin k → E :=
  fun j => if (cluster a j).Nonempty then (cluster a j).centroid ℝ x else c j

/-- 1.1 Lloyd's map on pairs: assign with respect to the current centres, then update the
centres of the new clusters. -/
def lloydMap (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E)) :
    (Fin n → Fin k) × (Fin k → E) :=
  (assignStep x s.1 s.2, updateStep x (assignStep x s.1 s.2) s.2)

/-- 1.2 Lloyd's map does not increase the k-means cost. -/
theorem pairCost_lloydMap_le (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E)) :
    pairCost x (lloydMap x s) ≤ pairCost x s := by
  sorry

/-- 1.2 Lloyd's map strictly decreases the k-means cost at every pair it moves. -/
theorem pairCost_lloydMap_lt (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E))
    (hs : lloydMap x s ≠ s) : pairCost x (lloydMap x s) < pairCost x s := by
  sorry

/-- 1.3 The fixed points of Lloyd's map are the pairs in which every label is a nearest centre
and every nonempty cluster has its centroid as centre. -/
theorem isFixedPt_lloydMap_iff (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E)) :
    IsFixedPt (lloydMap x) s ↔
      (∀ i, IsNearest x s.2 i (s.1 i)) ∧
        ∀ j, (cluster s.1 j).Nonempty → s.2 j = (cluster s.1 j).centroid ℝ x := by
  sorry

/-- 1.4 The iterates reach a fixed point: the `k ^ n`-th iterate of Lloyd's map is a fixed point. -/
theorem isFixedPt_lloydMap_iterate (x : Fin n → E) (s : (Fin n → Fin k) × (Fin k → E)) :
    IsFixedPt (lloydMap x) ((lloydMap x)^[k ^ n] s) := by
  sorry

end Lloyd

/-! ## Layer 2: D² seeding -/

section Seeding

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {n k : ℕ}

/-- 2.1 The cost of a centre tuple: `∑ᵢ minⱼ ‖xᵢ − zⱼ‖²`. -/
def centreCost [NeZero k] (x : Fin n → E) (z : Fin k → E) : ℝ :=
  ∑ i, univ.inf' univ_nonempty fun j => ‖x i - z j‖ ^ 2

/-- 2.1 The optimal k-means cost: the infimum of `centreCost x z` over all centre tuples. -/
def optCost [NeZero k] (x : Fin n → E) : ℝ :=
  ⨅ z : Fin k → E, centreCost x z

/-- 2.1 For a tuple `c` of chosen indices, the squared distance from `x i` to the nearest of the
points chosen before step `j` (used for `j ≥ 1`). -/
def seedSqDist (x : Fin n → E) (c : Fin k → Fin n) (j : Fin k) (i : Fin n) : ℝ :=
  ⨅ l : {l : Fin k // l < j}, ‖x i - x (c l)‖ ^ 2

/-- 2.1 The probability of the choice `c j` at step `j` of D² seeding given the earlier
choices: uniform at step `0`, proportional to the squared distance afterwards, and uniform when
every squared distance vanishes. -/
def seedStep (x : Fin n → E) (c : Fin k → Fin n) (j : Fin k) : ℝ :=
  if (j : ℕ) = 0 then 1 / n
  else if ∑ m, seedSqDist x c j m = 0 then 1 / n
  else seedSqDist x c j (c j) / ∑ m, seedSqDist x c j m

/-- 2.1 The probability of the index tuple `c` under D² seeding. -/
def seedProb (x : Fin n → E) (c : Fin k → Fin n) : ℝ :=
  ∏ j, seedStep x c j

/-- 2.2 D² seeding is a probability mass function on index tuples when there is a point. -/
theorem seedProb_nonneg_and_sum_eq_one (x : Fin n → E) (hn : 0 < n) :
    (∀ c : Fin k → Fin n, 0 ≤ seedProb x c) ∧ ∑ c : Fin k → Fin n, seedProb x c = 1 := by
  sorry

/-- 2.3 The Arthur–Vassilvitskii bound: the expected cost of the centres chosen by D² seeding is
at most `8 (ln k + 2)` times the optimal cost. -/
theorem expected_centreCost_seed_le [NeZero k] (x : Fin n → E) :
    ∑ c : Fin k → Fin n, seedProb x c * centreCost x (x ∘ c) ≤
      8 * (Real.log k + 2) * optCost (k := k) x := by
  sorry

end Seeding

/-! ## Layer 3: dendrograms, ultrametrics and single linkage -/

section Hierarchical

variable {X Y : Type*}

/-- 3.1 A distance function: vanishing exactly on the diagonal, nonnegative and symmetric. -/
def IsDistance (d : X → X → ℝ) : Prop :=
  (∀ x y, d x y = 0 ↔ x = y) ∧ (∀ x y, 0 ≤ d x y) ∧ ∀ x y, d x y = d y x

/-- 3.1 A metric: a distance function with the triangle inequality. -/
def IsMetricDist (d : X → X → ℝ) : Prop :=
  IsDistance d ∧ ∀ x y z, d x z ≤ d x y + d y z

/-- 3.1 An ultrametric: vanishing exactly on the diagonal, symmetric, with
`u x z ≤ max (u x y) (u y z)`. -/
def IsUltrametric (u : X → X → ℝ) : Prop :=
  (∀ x y, u x y = 0 ↔ x = y) ∧ (∀ x y, u x y = u y x) ∧
    ∀ x y z, u x z ≤ max (u x y) (u y z)

/-- 3.1 A dendrogram: a nested family of partitions, discrete at every scale `≤ 0`, eventually
the one-block partition, and constant on an interval `[r, r + ε]` to the right of every `r`. -/
def IsDendrogram (θ : ℝ → Setoid X) : Prop :=
  (∀ r ≤ 0, θ r = ⊥) ∧ Monotone θ ∧ (∃ t, θ t = ⊤) ∧
    ∀ r, ∃ ε > 0, ∀ t, r ≤ t → t ≤ r + ε → θ t = θ r

/-- 3.1 The function of a dendrogram: the least nonnegative scale at which two points share a
block. -/
def dendrogramUltra (θ : ℝ → Setoid X) (x y : X) : ℝ :=
  sInf {r | 0 ≤ r ∧ θ r x y}

/-- 3.1 Single linkage at scale `r`: the equivalence relation generated by `d x y ≤ r`. -/
def singleLinkage (d : X → X → ℝ) (r : ℝ) : Setoid X :=
  Relation.EqvGen.setoid fun x y => d x y ≤ r

/-- 3.1 The single-linkage ultrametric: the function of the single-linkage dendrogram. -/
def singleLinkageUltra (d : X → X → ℝ) : X → X → ℝ :=
  dendrogramUltra (singleLinkage d)

/-- 3.2 The function of a dendrogram is an ultrametric, and its closed balls of radius `r ≥ 0`
are the blocks of the dendrogram at scale `r`. -/
theorem isUltrametric_dendrogramUltra {θ : ℝ → Setoid X} (hθ : IsDendrogram θ) :
    IsUltrametric (dendrogramUltra θ) ∧
      ∀ r, 0 ≤ r → ∀ x y, θ r x y ↔ dendrogramUltra θ x y ≤ r := by
  sorry

/-- 3.2 On a finite set, single linkage of an ultrametric is a dendrogram whose blocks at scale
`r ≥ 0` are the closed balls of radius `r`. -/
theorem isDendrogram_singleLinkage [Finite X] {u : X → X → ℝ} (hu : IsUltrametric u) :
    IsDendrogram (singleLinkage u) ∧ ∀ r, 0 ≤ r → ∀ x y, singleLinkage u r x y ↔ u x y ≤ r := by
  sorry

/-- 3.2 The two constructions are inverse to each other. -/
theorem singleLinkage_dendrogramUltra {θ : ℝ → Setoid X} (hθ : IsDendrogram θ) :
    singleLinkage (dendrogramUltra θ) = θ := by
  sorry

/-- 3.2 The two constructions are inverse to each other. -/
theorem dendrogramUltra_singleLinkage {u : X → X → ℝ} (hu : IsUltrametric u) :
    dendrogramUltra (singleLinkage u) = u := by
  sorry

/-- 3.3 On a finite set, for a nonnegative `d` vanishing only on the diagonal, the
single-linkage ultrametric is the greatest ultrametric below `d`. -/
theorem isGreatest_singleLinkageUltra [Finite X] {d : X → X → ℝ}
    (hd0 : ∀ x y, d x y = 0 → x = y) (hd : ∀ x y, 0 ≤ d x y) :
    IsGreatest {u | IsUltrametric u ∧ u ≤ d} (singleLinkageUltra d) := by
  sorry

/-- 3.4 A hierarchical clustering method on the metrics of `Fin n`, `n : ℕ`, is functorial when
it sends every finite metric space to an ultrametric on it, sends the two-point space at distance
`δ` to itself and does not increase values along distance-nonincreasing maps. -/
def IsFunctorialMethod (T : (n : ℕ) → (Fin n → Fin n → ℝ) → Fin n → Fin n → ℝ) : Prop :=
  (∀ n (d : Fin n → Fin n → ℝ), IsMetricDist d → IsUltrametric (T n d)) ∧
    (∀ δ : ℝ, 0 < δ → T 2 (fun i j => if i = j then 0 else δ) 0 1 = δ) ∧
    ∀ n m (dX : Fin n → Fin n → ℝ) (dY : Fin m → Fin m → ℝ) (φ : Fin n → Fin m),
      IsMetricDist dX → IsMetricDist dY → (∀ x x', dY (φ x) (φ x') ≤ dX x x') →
        ∀ x x', T m dY (φ x) (φ x') ≤ T n dX x x'

/-- 3.4 Characterization of single linkage: a method satisfies the three conditions exactly when
it agrees with single linkage on every finite metric space. -/
theorem isFunctorialMethod_iff (T : (n : ℕ) → (Fin n → Fin n → ℝ) → Fin n → Fin n → ℝ) :
    IsFunctorialMethod T ↔
      ∀ n (d : Fin n → Fin n → ℝ), IsMetricDist d → T n d = singleLinkageUltra d := by
  sorry

/-- 3.5 Stability of single linkage: for `d_X` and `d_Y` vanishing on the diagonal and a relation
between `X` and `Y` that relates every point of each to some point of the other, if `d_X` and
`d_Y` differ by at most `η` on related pairs, so do the single-linkage ultrametrics. -/
theorem abs_singleLinkageUltra_sub_le (dX : X → X → ℝ) (dY : Y → Y → ℝ)
    (hX0 : ∀ x, dX x x = 0) (hY0 : ∀ y, dY y y = 0) (R : X → Y → Prop)
    (hX : ∀ x, ∃ y, R x y) (hY : ∀ y, ∃ x, R x y) (η : ℝ)
    (hη : ∀ x y x' y', R x y → R x' y' → |dX x x' - dY y y'| ≤ η)
    (x : X) (y : Y) (x' : X) (y' : Y) (hxy : R x y) (hxy' : R x' y') :
    |singleLinkageUltra dX x x' - singleLinkageUltra dY y y'| ≤ η := by
  sorry

end Hierarchical

/-! ## Layer 4: Kleinberg's axioms -/

section Kleinberg

variable {n : ℕ}

/-- 4.1 Scale-invariance: multiplying a distance function by `α > 0` does not change the
clustering. -/
def ScaleInvariant (F : (Fin n → Fin n → ℝ) → Setoid (Fin n)) : Prop :=
  ∀ d, IsDistance d → ∀ α : ℝ, 0 < α → F (fun i j => α * d i j) = F d

/-- 4.1 Richness: every partition is the clustering of some distance function. -/
def Rich (F : (Fin n → Fin n → ℝ) → Setoid (Fin n)) : Prop :=
  ∀ Γ : Setoid (Fin n), ∃ d, IsDistance d ∧ F d = Γ

/-- 4.1 `d'` is a `Γ`-transformation of `d`: no larger inside the blocks of `Γ`, no smaller
across them. -/
def IsTransformation (Γ : Setoid (Fin n)) (d d' : Fin n → Fin n → ℝ) : Prop :=
  ∀ i j, (Γ i j → d' i j ≤ d i j) ∧ (¬ Γ i j → d i j ≤ d' i j)

/-- 4.1 Consistency: a transformation of `d` adapted to `F d` has the same clustering. -/
def Consistent (F : (Fin n → Fin n → ℝ) → Setoid (Fin n)) : Prop :=
  ∀ d d', IsDistance d → IsDistance d' → IsTransformation (F d) d d' → F d' = F d

/-- 4.1 The range of a clustering function on distance functions. -/
def clusterRange (F : (Fin n → Fin n → ℝ) → Setoid (Fin n)) : Set (Setoid (Fin n)) :=
  F '' {d | IsDistance d}

/-- 4.2 The range of a scale-invariant consistent clustering function is an antichain for
refinement. -/
theorem isAntichain_clusterRange {F : (Fin n → Fin n → ℝ) → Setoid (Fin n)}
    (hs : ScaleInvariant F) (hc : Consistent F) : IsAntichain (· ≤ ·) (clusterRange F) := by
  sorry

/-- 4.2 Kleinberg's impossibility theorem: on at least two points no clustering function is
scale-invariant, rich and consistent. -/
theorem not_scaleInvariant_rich_consistent (hn : 2 ≤ n)
    (F : (Fin n → Fin n → ℝ) → Setoid (Fin n)) :
    ¬ (ScaleInvariant F ∧ Rich F ∧ Consistent F) := by
  sorry

/-- 4.3 Every nonempty antichain of partitions is the range of a scale-invariant consistent
clustering function. -/
theorem exists_clusterRange_eq {A : Set (Setoid (Fin n))} (hA : A.Nonempty)
    (hanti : IsAntichain (· ≤ ·) A) :
    ∃ F : (Fin n → Fin n → ℝ) → Setoid (Fin n),
      ScaleInvariant F ∧ Consistent F ∧ clusterRange F = A := by
  sorry

/-- 4.4 Single linkage at a fixed scale `r > 0` is rich and consistent. -/
theorem rich_consistent_singleLinkage {r : ℝ} (hr : 0 < r) :
    Rich (fun d : Fin n → Fin n → ℝ => singleLinkage d r) ∧
      Consistent (fun d : Fin n → Fin n → ℝ => singleLinkage d r) := by
  sorry

/-- 4.4 On at least three points, single linkage at the scale `α` times the largest distance,
with `0 < α < 1`, is scale-invariant and rich. -/
theorem scaleInvariant_rich_singleLinkage (hn : 3 ≤ n) {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1) :
    ScaleInvariant (fun d : Fin n → Fin n → ℝ => singleLinkage d (α * ⨆ i, ⨆ j, d i j)) ∧
      Rich (fun d : Fin n → Fin n → ℝ => singleLinkage d (α * ⨆ i, ⨆ j, d i j)) := by
  sorry

end Kleinberg

end TauCetiRoadmap.KMeansAndHierarchicalClustering
