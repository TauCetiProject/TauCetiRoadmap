/-!
# Diamonds and v-stacks: representative target signatures

The README is the definitive specification. These are suggested forms for the targets that can be
stated against Mathlib, Tau Ceti and the PerfectoidSpaces roadmap as they stand: the spectral
quotients, inverse topology and size foundations of D0, the topological part of the disconnected
perfectoid spaces of D1, the v-topology
on Tau Ceti's perfectoid spaces with its descent theorems (D2–D3), the size obstructions for
torsors and compact Hausdorff realization (D3–D4), and the Berkovich spectrum and the component
formula of D5, and the shared affine seminormality, subintegrality and seminormal-reflection
API of D6.9, including seminormal equalizers for compatible branch functions. Applications use
this predicate, reflection carrier and unit; exchanging square–cube variables gives the equivalent convention, and `sn_compare` identifies reflection presentations.
Constructions that are themselves formalisation targets (pro-étale
morphisms and sites, stackification, diamonds, their underlying spaces, spatial diamonds, marked
untilts and `Spd`) are specified in the README only.
The relative analytic comparison for supplied characteristic-zero resolutions, smooth
completed-function recovery and seminormal compatible-section descent are also README targets.
-/

noncomputable section

namespace TauCetiRoadmap.DiamondsAndVStacks

open CategoryTheory Topology TauCeti TauCeti.Huber TauCeti.ValuationSpectrum
open TauCetiRoadmap.PerfectoidSpaces.Perfectoid TauCetiRoadmap.PerfectoidSpaces.PerfectoidSpace

universe u

/-! ## Layer D0: spectral, categorical and size foundations -/

/-- The categorical pullback of the interval category over a point retains a noninvertible
arrow (Stacks 02X9 and 003R; README D0.26). Thus a 2-fibre product of category-valued stacks
need not be groupoid-valued, even when its comparison arrows are isomorphisms. -/
theorem categoricalPullback_interval_noninvertible :
    let F : Fin 2 ⥤ Discrete PUnit := (Functor.const (Fin 2)).obj (Discrete.mk PUnit.unit)
    let P := Limits.CategoricalPullback F (𝟭 (Discrete PUnit))
    ∃ (a b : P) (f : a ⟶ b), ¬ IsIso f := sorry

/-- **The spectral quotient criterion** (ECD Lemma 2.9, pp. 12–13). For a spectral space `X` and an
equivalence relation whose graph is pro-constructible in `X × X` and whose two projections are
generalizing, if the quotient topology has a basis of opens with quasicompact preimages then the
quotient is spectral and the projection is spectral and generalizing. -/
theorem spectralSpace_quotient {X : Type u} [TopologicalSpace X] [SpectralSpace X] (r : Setoid X)
    (hR : IsProConstructible {q : X × X | r q.1 q.2})
    (hs : GeneralizingMap fun q : {q : X × X // r q.1 q.2} ↦ q.1.1)
    (ht : GeneralizingMap fun q : {q : X × X // r q.1 q.2} ↦ q.1.2)
    (hB : ∃ B : Set (Set (Quotient r)), TopologicalSpace.IsTopologicalBasis B ∧
      ∀ V ∈ B, IsCompact (Quotient.mk r ⁻¹' V)) :
    SpectralSpace (Quotient r) ∧ IsSpectralMap (Quotient.mk r) ∧
      GeneralizingMap (Quotient.mk r) := sorry

/-- **Hochster's theorem**: a topological space is spectral exactly when it is homeomorphic to the
prime spectrum of a commutative ring (ECD Theorem 2.2 (i)⇔(ii), p. 10). -/
theorem spectralSpace_iff_nonempty_homeomorph_primeSpectrum (X : Type u) [TopologicalSpace X] :
    SpectralSpace X ↔ ∃ (A : Type u) (_ : CommRing A), Nonempty (X ≃ₜ PrimeSpectrum A) := sorry

-- Check: the Sierpiński space is the spectrum of `ℤ_p`, with `True` the generic point.
example (p : ℕ) [Fact p.Prime] : Nonempty (Prop ≃ₜ PrimeSpectrum ℤ_[p]) := sorry

-- Negative control: no finite ring realizes the Sierpiński space (finite rings have discrete
-- spectra).
example (A : Type) [CommRing A] [Finite A] : IsEmpty (Prop ≃ₜ PrimeSpectrum A) := sorry

/-- The *inverse* (Hochster dual) topology, generated by the complements of the quasicompact opens
(KL15 remark in Definition 8.1.4, p. 157, after Hochster). -/
@[instance_reducible]
def inverseTopology (X : Type u) [TopologicalSpace X] : TopologicalSpace X :=
  TopologicalSpace.generateFrom {U | ∃ V : Set X, IsOpen V ∧ IsCompact V ∧ U = Vᶜ}

/-- The inverse topology of a spectral space is spectral, and it reverses specialization
(KL15 Definition 8.1.4, p. 157). -/
theorem spectralSpace_inverseTopology (X : Type u) [t : TopologicalSpace X] [SpectralSpace X] :
    @SpectralSpace X (inverseTopology X) ∧
      ∀ x y : X, @Specializes X (inverseTopology X) x y ↔ @Specializes X t y x := sorry

-- Check: in the inverse Sierpiński topology the closed point `False` becomes open.
example : IsOpen[inverseTopology Prop] {False} ∧ ¬ IsOpen {False} := sorry

-- Negative control: on discrete `ℕ` the inverse topology is cofinite and not quasi-sober.
example : ¬ @QuasiSober ℕ (inverseTopology ℕ) := sorry

-- Check `s0_5_inverse_discrete_finite`: complements of finite discrete opens are again open.
example (X : Type u) [t : TopologicalSpace X] [DiscreteTopology X] [Finite X] :
    inverseTopology X = t := sorry

-- Check `definition_inverseTopology_2`: finite discrete duality fixes Bool and changes Prop.
example : inverseTopology Bool = (inferInstance : TopologicalSpace Bool) ∧
    inverseTopology Prop ≠ (inferInstance : TopologicalSpace Prop) := sorry

-- Check `definition_inverseTopology_3`: the dual two-point chain is not its discrete patch.
example : inverseTopology Prop ≠ constructibleTopology Prop := sorry

-- Check `s0_5_inverse_point_and_empty`: the inverse topology reverses singleton closures.
example : closure[inverseTopology Prop] ({False} : Set Prop) = Set.univ ∧
    closure[inverseTopology Prop] ({True} : Set Prop) = {True} := sorry

/-- The space of connected components of a spectral space is Hausdorff, hence profinite with
Mathlib's `Quotient.compactSpace` and `ConnectedComponents.totallyDisconnectedSpace` (ECD proof of
Lemma 7.3(i), p. 31). -/
theorem t2Space_connectedComponents (X : Type u) [TopologicalSpace X] [SpectralSpace X] :
    T2Space (ConnectedComponents X) := sorry

/-- The quotient of a compact Hausdorff space by a closed equivalence relation is Hausdorff
(ECD Remark 2.8, p. 12, where compact Hausdorff spaces arise this way from profinite sets). -/
theorem t2Space_quotient_of_isClosed {S : Type u} [TopologicalSpace S] [CompactSpace S]
    [T2Space S] (r : Setoid S) (hr : IsClosed {q : S × S | r q.1 q.2}) :
    T2Space (Quotient r) := sorry

-- Negative control: the relation `x - y ∈ ℤ` on `ℤ_p` is not closed and the quotient is not
-- Hausdorff.
example (p : ℕ) [Fact p.Prime] : ¬ T2Space (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range) := sorry

-- Check `residueSystem_prime_three`: the precision-two carrier and reduction depend on the prime.
example : Nat.card (ZMod 9) = 9 ∧
    ZMod.castHom (show 3 ∣ 9 by decide) (ZMod 3) (3 : ZMod 9) = 0 := sorry

/-- On an irreducible space the constant sheaf is flasque (proof of Stacks Tag 02UW); its
positive-degree cohomology then vanishes by Tau Ceti's
`TauCeti.Topology.subsingleton_H_succ_of_isFlasque`. -/
theorem isFlasque_constantSheaf (X : TopCat.{u}) [IrreducibleSpace X]
    [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}] (A : AddCommGrpCat.{u}) :
    TopCat.Presheaf.IsFlasque
      ((constantSheaf (Opens.grothendieckTopology X) AddCommGrpCat.{u}).obj A).obj := sorry

/-- A *cutoff cardinal* (ECD Lemma 4.1, p. 19): an uncountable strong limit of uncountable
cofinality below which there are strong limits of arbitrarily large cofinality. -/
def IsCutoffCardinal (κ : Cardinal.{u}) : Prop :=
  Cardinal.aleph0 < κ ∧ κ.IsStrongLimit ∧ Cardinal.aleph0 < κ.ord.cof ∧
    ∀ lam < κ, ∃ μ < κ, μ.IsStrongLimit ∧ lam < μ.ord.cof

/-- Cutoff cardinals are cofinal (ECD Lemma 4.1, pp. 19–20). -/
theorem exists_isCutoffCardinal_gt (lam : Cardinal.{u}) : ∃ κ, lam < κ ∧ IsCutoffCardinal κ :=
  sorry

-- Negative control: `ℵ₀` is a strong limit but not a cutoff cardinal.
example : ¬ IsCutoffCardinal Cardinal.aleph0.{u} :=
  fun h ↦ lt_irrefl _ h.1

-- Negative control: `ℶ_ω` is an uncountable strong limit of countable cofinality.
example : ¬ IsCutoffCardinal (Cardinal.beth.{u} Ordinal.omega0) := sorry

-- Checks `s0_23_cutoff_zero` and `definition_IsCutoffCardinal_2`: zero fails uncountability.
example : ¬ IsCutoffCardinal (0 : Cardinal.{u}) := sorry

-- Check `definition_IsCutoffCardinal_1`: the stated continuous beth iteration gives a cutoff.
example : ∃ f : Ordinal.{u} → Cardinal.{u},
    f 0 = Cardinal.beth (Cardinal.aleph 1).ord ∧
    (∀ i, f (i + 1) = Cardinal.beth (Order.succ (f i)).ord) ∧
    (∀ i, Order.IsSuccLimit i → f i = sSup (f '' Set.Iio i)) ∧
    IsCutoffCardinal (f (Cardinal.aleph 1).ord) := sorry

/-! ## Layer D1: disconnected perfectoid spaces -/

/-- *Every open cover splits*: for every open cover there is a locally constant choice of a member
containing each point, i.e. a section of `⨆ Uᵢ → X` (ECD Definition 7.1, p. 29). -/
def OpenCoversSplit (X : Type u) [TopologicalSpace X] : Prop :=
  ∀ 𝒰 : Set (Set X), (∀ U ∈ 𝒰, IsOpen U) → ⋃₀ 𝒰 = Set.univ →
    ∃ s : X → Set X, (∀ x, s x ∈ 𝒰 ∧ x ∈ s x) ∧ ∀ U, IsOpen (s ⁻¹' {U})

-- Check: open covers of the connected Sierpiński space split (the closed point forces the member
-- `univ`); negative control: the cover of `ℝ` by `(-∞, 1)` and `(0, ∞)` does not split.
example : OpenCoversSplit Prop ∧ ¬ OpenCoversSplit ℝ := sorry

-- Check `open_covers_profinite`: compactness gives a finite subordinate clopen partition.
example (X : Type u) [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [TotallyDisconnectedSpace X] : OpenCoversSplit X := sorry

/-- **Fargues' characterisation** (ECD Lemma 7.2 (i)⇔(ii), pp. 29–30): every open cover of a
spectral space splits iff every connected component has a unique closed point. -/
theorem openCoversSplit_iff (X : Type u) [TopologicalSpace X] [SpectralSpace X] :
    OpenCoversSplit X ↔ ∀ x : X, ∃! y : X, y ∈ connectedComponent x ∧ IsClosed {y} := sorry

/-- A pre-adic space is *totally disconnected* if it is quasicompact, quasiseparated and every open
cover splits (ECD Definition 7.1, p. 29, for perfectoid spaces). -/
def isTotallyDisconnected : ObjectProperty PreAdicSpace.{u} := fun X ↦
  CompactSpace X ∧ QuasiSeparatedSpace X ∧ OpenCoversSplit X

-- Negative control: splitting alone does not give quasicompactness (discrete `ℕ`).
example : OpenCoversSplit ℕ ∧ ¬ CompactSpace ℕ := sorry

-- Check: an empty pre-adic space is totally disconnected.
example (X : PreAdicSpace.{u}) [IsEmpty X] : isTotallyDisconnected X := sorry

/-- A *w-local* space (BS15 Definition 2.1.1, p. 6; ECD Definition 7.4, p. 31): a spectral space
all of whose open covers split and whose closed points form a closed subset. -/
def IsWLocalSpace (X : Type u) [TopologicalSpace X] : Prop :=
  SpectralSpace X ∧ OpenCoversSplit X ∧ IsClosed {x : X | IsClosed ({x} : Set X)}

-- Checks `w_local_empty` and `definition_IsWLocalSpace_2`: the closed-point locus is empty.
example : IsWLocalSpace Empty := sorry

-- Check `w_local_profinite`: all points are closed and the closed-point locus is the whole space.
example (X : Type u) [TopologicalSpace X] [CompactSpace X] [T2Space X]
    [TotallyDisconnectedSpace X] : IsWLocalSpace X := sorry

/-- In a w-local space the closed points map homeomorphically onto the space of connected
components (BS15 Lemma 2.1.4, p. 6). -/
theorem IsWLocalSpace.isHomeomorph_connectedComponentsMk {X : Type u} [TopologicalSpace X]
    (hX : IsWLocalSpace X) :
    IsHomeomorph fun x : {x : X | IsClosed ({x} : Set X)} ↦ ConnectedComponents.mk (x : X) := sorry

-- Check: the Sierpiński space is w-local; discrete `ℕ` is not (it is not spectral).
example : IsWLocalSpace Prop ∧ ¬ IsWLocalSpace ℕ := sorry

-- Check `s1_11_doubled_limit` (ECD Definition 7.20, Remark 7.21 and Corollary 7.22):
-- two open profinite charts glued along ℕ give a quasicompact non-Hausdorff space.
-- The unrestricted point-case classification retains this space.
example :
    ∃ (T : TopCat.{0}) (ePlus eMinus : OnePoint ℕ → T),
      IsOpenEmbedding ePlus ∧ IsOpenEmbedding eMinus ∧
      (∀ n : ℕ, ePlus n = eMinus n) ∧
      ePlus OnePoint.infty ≠ eMinus OnePoint.infty ∧
      Set.range ePlus ∪ Set.range eMinus = Set.univ ∧
      CompactSpace T ∧ ¬ T2Space T ∧
      ¬ IsCompact (Set.range ePlus ∩ Set.range eMinus) := sorry

variable (p : ℕ) [Fact p.Prime]

/-- **Totally disconnected perfectoid spaces are affinoid** (ECD Lemma 7.5, p. 31). -/
theorem isAffinoidPerfectoid_of_isTotallyDisconnected (X : Perfd.{u} p)
    (hX : isTotallyDisconnected X.obj) : isAffinoidPerfectoid p X.obj := sorry

-- Check `Affinoid_ulift_cyclotomic_selector`: the lifted cyclotomic field is small in the
-- chart universe and has nonzero p (ECD Example 3.4(i), pp. 14–15).
example : Small.{0} (ULift.{1} (padicCyclotomic p)) ∧
    (p : ULift.{1} (padicCyclotomic p)) ≠ 0 := by
  refine ⟨inferInstance, fun hp ↦ ?_⟩
  have h : (p : padicCyclotomic p) = 0 := congrArg ULift.down hp
  exact (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero) h

section Flatness

variable {R S : Type u} [CommRing R] [UniformSpace R] [IsUniformAddGroup R] [IsTopologicalRing R]
  [IsTateRing R] [CompleteSpace R] [T2Space R]
  [CommRing S] [UniformSpace S] [IsUniformAddGroup S] [IsTopologicalRing S] [IsTateRing S]
  [CompleteSpace S] [T2Space S]

/-- **Automatic flatness** (ECD Proposition 7.23, pp. 38–39). Let `Spa(R, R⁺)` be totally
disconnected (its underlying space is spectral, so this is the splitting of open covers) and
`φ : (R, R⁺) → (S, S⁺)` a continuous map of perfectoid Tate pairs. For every pseudouniformiser
`ϖ ∈ R⁺`, the map `R⁺/ϖ → S⁺/ϖ` is flat. -/
theorem flat_quotientMap_of_openCoversSplit [IsPerfectoidTateRing p R]
    [IsPerfectoidTateRing p S] (PR : Pair R) (PS : Pair S)
    (hX : OpenCoversSplit (spa PR.plus)) (φ : R →+* S) (hφ : Continuous φ)
    (hplus : ∀ x ∈ PR.plus, φ x ∈ PS.plus) (ϖ : PR.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    (Ideal.quotientMap ((Ideal.span {ϖ}).map (φ.restrict PR.plus PS.plus hplus))
      (φ.restrict PR.plus PS.plus hplus) Ideal.le_comap_map).Flat := sorry

/-- The faithfully flat case of ECD Proposition 7.23: if moreover `Spa(S, S⁺) → Spa(R, R⁺)` is
surjective, then `R⁺/ϖ → S⁺/ϖ` is faithfully flat. -/
theorem faithfullyFlat_quotientMap_of_openCoversSplit [IsPerfectoidTateRing p R]
    [IsPerfectoidTateRing p S] (PR : Pair R) (PS : Pair S)
    (hX : OpenCoversSplit (spa PR.plus)) (φ : R →+* S) (hφ : Continuous φ)
    (hplus : ∀ x ∈ PR.plus, φ x ∈ PS.plus)
    (hsurj : ∀ x ∈ spa PR.plus, ∃ y ∈ spa PS.plus, comap φ y = x)
    (ϖ : PR.plus) (hϖ : IsPseudoUniformizer (ϖ : R)) :
    (Ideal.quotientMap ((Ideal.span {ϖ}).map (φ.restrict PR.plus PS.plus hplus))
      (φ.restrict PR.plus PS.plus hplus) Ideal.le_comap_map).FaithfullyFlat := sorry

end Flatness

/-! ## Layer D2: the pro-étale and v-topologies -/

/-- The *v-precoverage* on a category with an underlying-space functor `F`: a presieve on `X`
covers if every quasicompact open `U` of `F X` is a finite union of images of quasicompact opens
of members of the presieve (ECD Definition 8.1(iii), p. 39). -/
def vPrecoverage {C : Type*} [Category C] (F : C ⥤ TopCat.{u}) : Precoverage C where
  coverings X := {R | ∀ U : Set (F.obj X), IsOpen U → IsCompact U →
    IsCompactOpenCovered (fun i : R.uncurry ↦ ((F.map i.1.2).hom : F.obj i.1.1 → F.obj X)) U}

-- Check `definition_vPrecoverage_1`: the proper arrow of the two-element chain covers a point.
example :
    let F := (Functor.const (Fin 2)).obj (TopCat.of PUnit)
    Presieve.singleton (homOfLE (show (0 : Fin 2) ≤ 1 by decide)) ∈ vPrecoverage F 1 := sorry

-- Check `definition_vPrecoverage_2`: the empty presieve covers the empty constant space.
example :
    let F := (Functor.const (Discrete PUnit)).obj (TopCat.of Empty)
    (⊥ : Presieve (Discrete.mk PUnit.unit)) ∈ vPrecoverage F (Discrete.mk PUnit.unit) := sorry

-- Check `definition_vPrecoverage_3`: the empty presieve fails to cover a point.
example :
    let F := (Functor.const (Discrete PUnit)).obj (TopCat.of PUnit)
    (⊥ : Presieve (Discrete.mk PUnit.unit)) ∉ vPrecoverage F (Discrete.mk PUnit.unit) := sorry

-- Negative Check `s2_1_vPrecoverage_rational_empty_cover`: ℚ has no nonempty compact open.
example :
    let F := (Functor.const (Discrete PUnit)).obj (TopCat.of ℚ)
    (⊥ : Presieve (Discrete.mk PUnit.unit)) ∈ vPrecoverage F (Discrete.mk PUnit.unit) := sorry

/-- The underlying topological space of a perfectoid space. -/
abbrev perfdToTop : Perfd.{u} p ⥤ TopCat.{u} :=
  ObjectProperty.ι _ ⋙ PreAdicSpace.forgetToTop

/-- The *v-topology* on the category of perfectoid spaces (ECD Definition 8.1(iii)). -/
def vTopology : GrothendieckTopology (Perfd.{u} p) :=
  (vPrecoverage (perfdToTop p)).toGrothendieck

-- Negative control: the point inclusions of an infinite profinite set are jointly surjective but
-- no finite subfamily covers by images of quasicompact opens.
example (T : Type) [TopologicalSpace T] [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]
    [Infinite T] : ¬ IsCompactOpenCovered (fun (t : T) (_ : PUnit.{1}) ↦ t) Set.univ := sorry

-- Check `s2_1_finite_profinite_point_family`: finitely many singleton images cover, also for Empty.
example (T : Type) [TopologicalSpace T] [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T]
    [Finite T] : IsCompactOpenCovered (fun (t : T) (_ : PUnit.{1}) ↦ t) Set.univ := sorry

-- Check: the empty presieve covers a perfectoid space exactly when the space is empty.
example (X : Perfd.{u} p) :
    (⊥ : Presieve X) ∈ vPrecoverage (perfdToTop p) X ↔ IsEmpty X.obj := sorry

/-- A map from a quasicompact perfectoid space to a quasiseparated one is a v-cover iff it is
surjective (ECD Definition 8.1(iii), p. 39, as used in the proof of Theorem 8.7, p. 43).
Surjectivity is detected on quasicompact open neighbourhoods of target points. -/
theorem singleton_mem_vPrecoverage_iff_surjective {X Y : Perfd.{u} p} (f : Y ⟶ X)
    [CompactSpace Y.obj] [QuasiSeparatedSpace X.obj] :
    Presieve.singleton f ∈ vPrecoverage (perfdToTop p) X ↔
      Function.Surjective ((perfdToTop p).map f).hom := sorry

/-- The structure presheaf `X ↦ O_X(X)` on perfectoid spaces. -/
def structurePresheaf : (Perfd.{u} p)ᵒᵖ ⥤ CommRingCat.{u} :=
  (ObjectProperty.ι _ ⋙ PreAdicSpace.forgetToPresheafedSpace).op ⋙
    AlgebraicGeometry.PresheafedSpace.Γ ⋙ TopCommRingCat.isCompleteSeparated.ι ⋙
      forget₂ TopCommRingCat CommRingCat

-- Check: the value at `X` is the ring of global sections `O_X(X)`, not a stalk.
example (X : Perfd.{u} p) :
    ((structurePresheaf p).obj (Opposite.op X) : Type u) =
      X.obj.toRingPresheafedSpace.presheaf.obj (Opposite.op ⊤) := rfl

-- Check `structurePresheaf_empty`: on an empty perfectoid space the value is a subsingleton ring,
-- by the sheaf condition for the empty cover (the zero ring maps to the terminal value `O_X(∅)`).
example (X : Perfd.{u} p) [IsEmpty X.obj] :
    Subsingleton ((structurePresheaf p).obj (Opposite.op X)) := by
  have hX : PreAdicSpace.isSheafy X.obj := X.property.1
  let Z : CompleteSeparatedTopCommRingCat.{u} :=
    ⟨TopCommRingCat.of PUnit, TopCommRingCat.isCompleteSeparated_of_completeSpace_of_t0Space _⟩
  have hT := TopCat.Sheaf.isTerminalOfEqEmpty ⟨_, hX⟩ (U := ⊤) (Subsingleton.elim _ _)
  let f := (hT.from Z).hom.1
  exact subsingleton_of_zero_eq_one
    ((map_zero f).symm.trans ((congrArg f (Subsingleton.elim 0 1)).trans (map_one f)))

-- Check `structurePresheaf_map`: the map along `f : Y ⟶ X` is the pullback of global sections
-- `O_X(X) → O_Y(Y)`, the component of `f` at the top open, so the presheaf is not constant in `X`.
example {X Y : Perfd.{u} p} (f : Y ⟶ X) :
    (structurePresheaf p).map f.op = (forget₂ TopCommRingCat CommRingCat).map
      (TopCommRingCat.isCompleteSeparated.ι.map (f.hom.c.app (Opposite.op ⊤))) := rfl

/-- **`O` is a v-sheaf** (ECD Theorem 8.7, p. 43). -/
theorem isSheaf_structurePresheaf : Presheaf.IsSheaf (vTopology p) (structurePresheaf p) := sorry

/-- **The v-topology is subcanonical** (ECD Theorem 8.7, p. 43). -/
theorem vTopology_subcanonical : (vTopology.{u} p).Subcanonical := sorry

/-! ## Layer D3: effective descent and morphisms of stacks -/

/-- For every topological space `T`, the presheaf `T̲ : X ↦ C(|X|, T)` is a v-sheaf (ECD §10,
before Definition 10.12, p. 53). -/
theorem isSheaf_yonedaPresheaf (T : Type u) [TopologicalSpace T] :
    Presieve.IsSheaf (vTopology p) (ContinuousMap.yonedaPresheaf (perfdToTop p) T) := sorry

-- Check `s3_10_large_group_escape`: the large compact Boolean group admits a sequence
-- supported on disjoint blocks that converges to zero and escapes every small set containing
-- zero. This supplies the open-neighbourhood obstruction to charted torsor representability
-- in README D3.10; the bounded representability theorem is ECD Lemma 10.13, pp. 53–54.
example (B : Set ((ℕ × Type) → ZMod 2)) (hB : Small.{0} B)
    (hzero : (0 : (ℕ × Type) → ZMod 2) ∈ B) :
    ∃ h : OnePoint ℕ → ((ℕ × Type) → ZMod 2), Continuous h ∧ h OnePoint.infty = 0 ∧
      ∀ n : ℕ, h (n : OnePoint ℕ) ∉ B ∧
        ∀ i : ℕ × Type, i.1 ≠ n → h (n : OnePoint ℕ) i = 0 := sorry

/-! ## Layer D4: the size boundary of compact Hausdorff realization -/

-- Check `compHaus_large_cube_dense`: finite-support points lie in the small-support subset,
-- which is dense in the large Boolean cube (README D4.6; ECD Example 11.12, pp. 58–59).
example : Dense {t : Type → ZMod 2 | Small.{0} {i : Type // t i ≠ 0}} := sorry

-- Check `compHaus_large_cube_not_closed`: the all-ones point is outside the dense subset.
example : ¬ IsClosed {t : Type → ZMod 2 | Small.{0} {i : Type // t i ≠ 0}} := sorry

-- Check `compHaus_large_cube_small_preimage`: the union of the supports at points in the
-- preimage is small, and the corresponding coordinate subcube is closed. Realization on the
-- charted site therefore cannot recover the original topology of this large compact space.
example (S : Type) [TopologicalSpace S] (h : C(S, Type → ZMod 2)) :
    IsClosed (h ⁻¹' {t : Type → ZMod 2 | Small.{0} {i : Type // t i ≠ 0}}) := sorry

-- Check `s4_11_large_profinite_quotient`: a finite union of chart-small subsets misses an
-- element of the large compact Boolean group. Its constant section obstructs a finite
-- epimorphic subfamily of the charted product cover in README D4.11 (Berkeley, proof of
-- Lemma 18.1.2, p. 162, with the chart-universe hypothesis).
example (n : ℕ) (A : Fin n → Set (Type → ZMod 2)) (hA : ∀ i, Small.{0} (A i)) :
    ∃ g : Type → ZMod 2, ∀ i, g ∉ A i := sorry

/-! ## Layer D5: spatial geometry and Hausdorff reduction -/

/-- Finite-subset product diagrams have a total arrow type small in the chart universe exactly
when their generating set is small there (ECD proof of Proposition 11.24, p. 65; README D5.3).
Singleton identity arrows give the reverse implication. -/
theorem small_finset_arrow_iff (I : Type u) :
    Small.{0} (Arrow (Finset I)ᵒᵖ) ↔ Small.{0} I := sorry

-- Check `small_finset_arrow_empty`: the empty generating set gives one object and one arrow.
example : Small.{0} (Arrow (Finset Empty)ᵒᵖ) := sorry

-- Check `small_finset_arrow_nat`: ordinary finite-coordinate towers meet the chart-universe bound.
example : Small.{0} (Arrow (Finset ℕ)ᵒᵖ) := sorry

-- Negative control `small_finset_arrow_type`: the large Boolean-product diagram of README D5.3
-- fails the lower-universe hypothesis, independently of its bound below a cutoff in Cardinal.{1}.
example : ¬ Small.{0} (Arrow (Finset (Type))ᵒᵖ) := sorry

/-- The normalised *Berkovich spectrum* of a topological ring `R` at `ϖ`: continuous
nonarchimedean multiplicative seminorms `α` with `α ϖ = 1/2`, with the topology of pointwise
convergence (ECD Definition 13.7, p. 79; for a Tate ring continuity is boundedness). -/
def BerkovichSpectrum (R : Type u) [CommRing R] [TopologicalSpace R] (ϖ : R) : Type u :=
  {α : MulRingSeminorm R // Continuous α ∧ IsNonarchimedean (α : R → ℝ) ∧ α ϖ = 1 / 2}

instance (R : Type u) [CommRing R] [TopologicalSpace R] (ϖ : R) :
    TopologicalSpace (BerkovichSpectrum R ϖ) :=
  TopologicalSpace.induced (fun α : BerkovichSpectrum R ϖ ↦ (α.1 : R → ℝ)) inferInstance

-- Negative control: the normaliser `ϖ = 0` gives the empty spectrum.
example (R : Type u) [CommRing R] [TopologicalSpace R] : IsEmpty (BerkovichSpectrum R 0) :=
  ⟨fun α ↦ by have := α.2.2.2; rw [map_zero] at this; norm_num at this⟩

-- Check: for `ℚ_p` at `ϖ = p` the spectrum is one point, the `p`-adic norm raised to
-- `log 2 / log p`.
example (p : ℕ) [Fact p.Prime] :
    Nonempty (BerkovichSpectrum ℚ_[p] p) ∧ Subsingleton (BerkovichSpectrum ℚ_[p] p) := sorry

-- Negative Check `definition_BerkovichSpectrum_3`: every multiplicative seminorm sends 1 to 1.
example (R : Type u) [CommRing R] [TopologicalSpace R] : IsEmpty (BerkovichSpectrum R 1) := sorry

-- Negative Check `archimedean_empty`: continuity at zero contradicts the strong triangle inequality.
example (ϖ : ℝ) : IsEmpty (BerkovichSpectrum ℝ ϖ) := sorry

-- Check `s5_13_product_fields`: the two seminorms are distinguished by the complementary idempotents.
example (p : ℕ) [Fact p.Prime] :
    Nonempty (BerkovichSpectrum (ℚ_[p] × ℚ_[p]) (p, p) ≃ Bool) ∧
      (∀ α : BerkovichSpectrum (ℚ_[p] × ℚ_[p]) (p, p),
        (α.1 (1, 0) = 1 ∧ α.1 (0, 1) = 0) ∨ (α.1 (1, 0) = 0 ∧ α.1 (0, 1) = 1)) ∧
      (∃ α : BerkovichSpectrum (ℚ_[p] × ℚ_[p]) (p, p), α.1 (1, 0) = 1) ∧
      (∃ α : BerkovichSpectrum (ℚ_[p] × ℚ_[p]) (p, p), α.1 (0, 1) = 1) := sorry

/-- **The Berkovich spectrum is the maximal Hausdorff quotient of `Spa`** (ECD Proposition 13.9,
p. 79). For a complete Hausdorff Tate ring `R` with a ring of integral elements `R⁺` and a
pseudouniformiser `ϖ`, the maximal Hausdorff quotient of `Spa(R, R⁺)` is the normalised Berkovich
spectrum, which is compact Hausdorff. -/
theorem nonempty_t2Quotient_spa_homeomorph {R : Type u} [CommRing R] [UniformSpace R]
    [IsUniformAddGroup R] [IsTopologicalRing R] [IsTateRing R] [CompleteSpace R] [T2Space R]
    (P : Pair R) {ϖ : R} (hϖ : IsPseudoUniformizer ϖ) :
    CompactSpace (BerkovichSpectrum R ϖ) ∧ T2Space (BerkovichSpectrum R ϖ) ∧
      Nonempty (T2Quotient (spa P.plus) ≃ₜ BerkovichSpectrum R ϖ) := sorry

/-- The quotient of `ℤ_p` by integer translations has multiple points and only empty and full
opens. Every singleton is dense, and the quotient fails `T₀`. This gives the topological space
of the Frobenius-twisted dense-orbit diamond in README D5.15, using Mathlib's
`PadicInt.denseRange_intCast`; the Berkovich colimit is ECD Proposition 13.10, pp. 79–80. -/
theorem padicInteger_denseOrbitQuotient (p : ℕ) [Fact p.Prime] :
    Nontrivial (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range) ∧
      (∀ U : Set (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range),
        IsOpen U → U = ∅ ∨ U = Set.univ) ∧
      (∀ x : ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range,
        closure ({x} : Set (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range)) = Set.univ) ∧
      ¬ T0Space (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range) := sorry

/-- **Components of a quotient by a compact group** (GLX Lemma 3.2, corrected; the spectral case of
README §D5.16). For a compact group acting continuously on a spectral space, two points have the
same component in the orbit space iff one lies in the component of a translate of the other. -/
theorem connectedComponents_mk_quotient_eq_iff {G X : Type u} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [TopologicalSpace X] [SpectralSpace X]
    [MulAction G X] [ContinuousSMul G X] (x y : X) :
    ConnectedComponents.mk (Quotient.mk (MulAction.orbitRel G X) x) =
        ConnectedComponents.mk (Quotient.mk (MulAction.orbitRel G X) y) ↔
      ∃ g : G, ConnectedComponents.mk (g • x) = ConnectedComponents.mk y := sorry

-- Negative control: compactness cannot be dropped. The translation orbits of the discrete group
-- `ℤ` on the totally disconnected `ℤ_p` are dense, so the orbit space `ℤ_p/ℤ` (uncountably many
-- orbits) is connected.
example (p : ℕ) [Fact p.Prime] :
    TotallyDisconnectedSpace ℤ_[p] ∧ PreconnectedSpace (ℤ_[p] ⧸ (Int.castAddHom ℤ_[p]).range) :=
  sorry

/-! ## Layer D6: affine inputs for seminormal rigid geometry -/

/-- Seminormality is reducedness together with unique square–cube lifting: `x² = y³`
has a unique root `z` with `x = z³` and `y = z²` (Stacks 0EUL, 0EUQ). -/
def IsSeminormalRing (A : Type u) [CommRing A] : Prop :=
  IsReduced A ∧ ∀ x y : A, x ^ 2 = y ^ 3 → ∃! z : A, x = z ^ 3 ∧ y = z ^ 2

/-- On arbitrary commutative rings, seminormality is equivalent to unique square–cube lifting
(Stacks 0EUL, 0EUQ; KL16 Definition 1.4.1, p. 19). -/
theorem IsSeminormalRing.iff_unique (A : Type u) [CommRing A] :
    IsSeminormalRing A ↔
      ∀ x y : A, x ^ 2 = y ^ 3 → ∃! z : A, x = z ^ 3 ∧ y = z ^ 2 := sorry

-- Checks: a field is seminormal, nilpotents obstruct it, and reducedness alone is insufficient.
example : IsSeminormalRing ℚ := sorry
example : ¬ IsSeminormalRing (ZMod 4) := sorry
example (k : Type u) [Field k] : ¬ IsSeminormalRing
    (Algebra.adjoin k ({Polynomial.X ^ 2, Polynomial.X ^ 3} : Set (Polynomial k))) := sorry

/-- Integrally closed domains have the square–cube lifting property
(KL16 Remark 1.4.2, p. 20). -/
theorem IsSeminormalRing.of_isIntegrallyClosed (A : Type u) [CommRing A]
    [IsDomain A] [IsIntegrallyClosed A] : IsSeminormalRing A := sorry

/-- Seminormality of a product is equivalent to seminormality of both factors
(KL16 Definition 1.4.1, componentwise). -/
theorem IsSeminormalRing.prod_iff (A B : Type u) [CommRing A] [CommRing B] :
    IsSeminormalRing (A × B) ↔ IsSeminormalRing A ∧ IsSeminormalRing B := sorry

-- Checks: normal domains and disconnected normal rings satisfy the same criterion.
example : IsSeminormalRing ℤ := sorry
example : IsSeminormalRing (ℚ × ℚ) := sorry
example : ¬ IsSeminormalRing (ℚ × ZMod 4) := sorry

/-- Equalizers of maps from a seminormal ring to a reduced ring are seminormal:
the images of a square–cube root coincide in the reduced codomain
(KL16 Definition 1.4.1, p. 19; Stacks 0EUL). -/
theorem IsSeminormalRing.eqLocus {A B : Type u} [CommRing A] [CommRing B] [IsReduced B]
    (hA : IsSeminormalRing A) (f g : A →+* B) : IsSeminormalRing (f.eqLocus g) := sorry

-- Checks: identity equalizers and matching constant terms on two branches are seminormal;
-- the section with different branch constants is excluded.
example : IsSeminormalRing ((RingHom.id ℚ).eqLocus (RingHom.id ℚ)) := sorry
example (k : Type u) [Field k] : IsSeminormalRing
    (((Polynomial.evalRingHom (0 : k)).comp (RingHom.fst (Polynomial k) (Polynomial k))).eqLocus
      ((Polynomial.evalRingHom (0 : k)).comp (RingHom.snd (Polynomial k) (Polynomial k)))) := sorry
example (k : Type u) [Field k] :
    (1, 0) ∉
      ((Polynomial.evalRingHom (0 : k)).comp (RingHom.fst (Polynomial k) (Polynomial k))).eqLocus
        ((Polynomial.evalRingHom (0 : k)).comp (RingHom.snd (Polynomial k) (Polynomial k))) := sorry

/-- A noetherian ring whose prime localizations are normal domains is a finite product of
integrally closed domains, allowing the empty product (Stacks 030C). -/
theorem Affine.normal_finiteProduct (A : Type u) [CommRing A] [IsNoetherianRing A]
    (hA : ∀ q : PrimeSpectrum A,
      IsDomain (Localization.AtPrime q.asIdeal) ∧
        IsIntegrallyClosed (Localization.AtPrime q.asIdeal)) :
    ∃ (n : ℕ) (B : Fin n → CommRingCat.{u}),
      (∀ i, IsDomain (B i) ∧ IsIntegrallyClosed (B i)) ∧
        Nonempty (A ≃+* ∀ i, B i) := sorry

/-- A subintegral map is integral, bijective on prime spectra, and an isomorphism on
all induced residue fields (KL16 Lemma 1.4.5, p. 20; Stacks 0CND). -/
def IsSubintegral {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) : Prop :=
  f.IsIntegral ∧ Function.Bijective (PrimeSpectrum.comap f) ∧
    ∀ q : PrimeSpectrum S,
      Function.Bijective (Ideal.ResidueField.map (q.asIdeal.comap f) q.asIdeal f rfl)

/-- Maps into a seminormal ring extend uniquely across a subintegral map
(Stacks 0CND, 0EUR; KL16 Definition 1.4.1 and Lemma 1.4.5). -/
theorem subintegral_lift {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    (f : R →+* S) (hf : IsSubintegral f) (hT : IsSeminormalRing T) (g : R →+* T) :
    ∃! l : S →+* T, l.comp f = g := sorry

/-- A subintegral map from a seminormal ring to a reduced ring is bijective
(Stacks 0H3G). -/
theorem subintegral_bijective_of_seminormal {R S : Type u} [CommRing R] [CommRing S]
    [IsReduced S] (f : R →+* S) (hf : IsSubintegral f) (hR : IsSeminormalRing R) :
    Function.Bijective f := sorry

-- Checks: the cusp inclusion is subintegral; a nilpotent target prevents bijectivity;
-- a quotient by nilpotents still has unique lifts into seminormal rings.
example (k : Type u) [Field k] :
    let A := Algebra.adjoin k ({Polynomial.X ^ 2, Polynomial.X ^ 3} : Set (Polynomial k))
    IsSubintegral A.val.toRingHom := sorry
example : IsSubintegral (algebraMap ℚ (TrivSqZeroExt ℚ ℚ)) ∧
    ¬ Function.Bijective (algebraMap ℚ (TrivSqZeroExt ℚ ℚ)) := sorry
example {T : Type u} [CommRing T] (hT : IsSeminormalRing T) (g : ZMod 4 →+* T) :
    ∃! l : ZMod 2 →+* T, l.comp (ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2)) = g := sorry

/-- The seminormalization of a commutative ring (KL16 Definition 1.4.1, p. 19;
Stacks 0EUR(3)–(4)). -/
def snRing (A : Type u) [CommRing A] : Type u := sorry

/-- The commutative ring structure on the seminormalization. -/
instance snRing.commRing (A : Type u) [CommRing A] : CommRing (snRing A) := sorry

/-- The unit from a ring to its seminormalization (Stacks 0EUR(3)). -/
def snMap (A : Type u) [CommRing A] : A →+* snRing A := sorry

/-- The seminormalization satisfies the square–cube criterion (Stacks 0EUR(4)). -/
theorem snRing_seminormal (A : Type u) [CommRing A] : IsSeminormalRing (snRing A) := sorry

/-- Every map to a seminormal ring extends uniquely across the subintegral unit
(Stacks 0CND, 0EUR; KL16 Definition 1.4.1, p. 19). -/
theorem sn_lift {A B : Type u} [CommRing A] [CommRing B]
    (hB : IsSeminormalRing B) (f : A →+* B) :
    ∃! g : snRing A →+* B, g.comp (snMap A) = f := sorry

-- Checks: the cusp gains its missing parameter, nilpotents disappear, and seminormal rings
-- and disconnected seminormal rings are fixed.
example (k : Type u) [Field k] :
    let A := Algebra.adjoin k ({Polynomial.X ^ 2, Polynomial.X ^ 3} : Set (Polynomial k))
    ∃ e : snRing A ≃+* Polynomial k, e.toRingHom.comp (snMap A) = A.val.toRingHom := sorry
example : Nonempty (snRing (ZMod 4) ≃+* ZMod 2) := sorry
example : Nonempty (snRing ℚ ≃+* ℚ) := sorry
example : Nonempty (snRing (ℚ × ℚ) ≃+* (ℚ × ℚ)) := sorry

/-- The seminormalization unit is subintegral, including for rings with nilpotents
(Stacks 0EUR(3); KL16 Lemma 1.4.5, p. 20). -/
theorem snMap_subintegral (A : Type u) [CommRing A] : IsSubintegral (snMap A) := sorry

/-- The seminormalization unit is integral (Stacks 0EUR(3); KL16 Lemma 1.4.5, p. 20). -/
theorem snMap_isIntegral (A : Type u) [CommRing A] : (snMap A).IsIntegral := sorry

/-- The unit preserves points valued in every field, including imperfect fields; together with
integrality this expresses subintegrality (KL16 Lemma 1.4.5, p. 20; Stacks 0EUR(3)). -/
theorem snMap_fieldPoints (A K : Type u) [CommRing A] [Field K] :
    Function.Bijective (fun g : snRing A →+* K ↦ g.comp (snMap A)) := sorry

-- Checks: a zero ring remains empty on field-valued points, and the nilpotent thickening has
-- exactly the same field-valued points as its reduction, in both characteristics.
example (K : Type u) [Field K] : IsEmpty (snRing PUnit →+* K) := sorry
example : Function.Bijective
    (fun g : snRing (ZMod 4) →+* ZMod 2 ↦ g.comp (snMap (ZMod 4))) := sorry
example : IsEmpty (snRing (ZMod 4) →+* ℚ) := sorry

/-- The unit is an isomorphism on seminormal rings (Stacks 0EUR(4)). -/
theorem snMap_bijective (A : Type u) [CommRing A] (hA : IsSeminormalRing A) :
    Function.Bijective (snMap A) := sorry

/-- Any subintegral unit with seminormal codomain identifies that codomain uniquely with
the seminormal reflection, compatibly with the unit (Stacks 0EUR(3)–(4), 0H3G). -/
theorem sn_compare {A B : Type u} [CommRing A] [CommRing B]
    (f : A →+* B) (hf : IsSubintegral f) (hB : IsSeminormalRing B) :
    ∃! e : snRing A ≃+* B, e.toRingHom.comp (snMap A) = f := sorry

-- Checks: identity units, the cusp, and reduction all identify the reflection over the source.
example : ∃! e : snRing ℚ ≃+* ℚ, e.toRingHom.comp (snMap ℚ) = RingHom.id ℚ := sorry
example (k : Type u) [Field k] :
    let A := Algebra.adjoin k ({Polynomial.X ^ 2, Polynomial.X ^ 3} : Set (Polynomial k))
    ∃! e : snRing A ≃+* Polynomial k, e.toRingHom.comp (snMap A) = A.val.toRingHom := sorry
example : ∃! e : snRing (ZMod 4) ≃+* ZMod 2,
    e.toRingHom.comp (snMap (ZMod 4)) =
      ZMod.castHom (by decide : 2 ∣ 4) (ZMod 2) := sorry

/-- Seminormalization commutes with principal localization, compatibly with its unit
(Stacks 0EUM, 0EUS, restricted to principal affine opens). -/
theorem snRing_localization (A : Type u) [CommRing A] (f : A) :
    ∃ e : snRing (Localization.Away f) ≃+* Localization.Away (snMap A f),
      ∀ a : A, e (snMap (Localization.Away f) (algebraMap A (Localization.Away f) a)) =
        algebraMap (snRing A) (Localization.Away (snMap A f)) (snMap A a) := sorry

-- Checks: the zero ring is fixed, seminormalization is idempotent, and localization at zero
-- agrees with the empty affine open.
example : Function.Bijective (snMap PUnit) := sorry
example (A : Type u) [CommRing A] : Function.Bijective (snMap (snRing A)) := sorry
example (A : Type u) [CommRing A] : Subsingleton (snRing (Localization.Away (0 : A))) := sorry

end TauCetiRoadmap.DiamondsAndVStacks
